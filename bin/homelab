#!/usr/bin/env bash
#
# homelab - one entry point for managing the stacks, from an SSH session on the NAS.
#
#   homelab stacks                   the stacks this CLI can act on
#   homelab status [stack]           what is running, everywhere
#   homelab ps <stack>               docker compose ps for one stack
#   homelab logs <stack> [svc] [-f]  recent logs, -f to follow
#   homelab deploy <stack> [args]    pull + verify provenance + recreate
#   homelab restart <stack> [svc]    recreate without pulling
#   homelab preflight <stack> [--fix]
#   homelab env check|get|set <stack> [KEY [VALUE]]
#   homelab url                      the connector URL
#   homelab attach [claude|research] attach to an agent's tmux session
#
#   homelab update                   git pull this checkout
#   homelab git <args...>            git against this checkout
#   homelab snapshots [args...]      git against the vault's snapshot repo
#
#   --no-color                       force plain output (also honours NO_COLOR)
#
# The three git commands exist because Container Station gives QTS a docker
# binary but no git, and installing one via Entware is a documented way to break
# the SSH PATH that docker itself depends on. They use host git when it is there
# and a pinned container when it is not, so the NAS never needs git installed.
#
# Bash rather than Go on purpose: this is glue whose job is running docker and
# git and checking exit codes, which is the case DECISIONS.md#runtime-node-not-bun-or-go
# already argued and rejected Go for. Correctness comes from `set -euo pipefail`
# plus shellcheck in CI, not from a compiler.
#
# Every command takes an EXPLICIT stack. There is deliberately no `--all`:
# README.md's shared contract says never restart another stack's containers, and
# the cheapest way to honour that is to make the dangerous thing unexpressible.
#
# ---------------------------------------------------------------------------
# QTS COMPATIBILITY. QNAP is busybox userland with a real bash; the output layer
# assumes nothing beyond that:
#
#   * ASCII only, enforced in CI. No box-drawing characters, no emoji, no tick
#     marks, not even an em-dash: a QTS session without a UTF-8 locale renders
#     those as mojibake, and status output that looks broken is worse than
#     status output that is plain. This applies to the header comment too,
#     because --help prints it.
#   * ANSI colour only when stdout is a terminal, TERM is not "dumb", and
#     NO_COLOR is unset. Piping to a file or `less -R`-less pager gets clean text.
#   * tput is used only if present, with a hardcoded fallback width. busybox
#     ships a tput that does not always know the terminal.
#   * Container state comes from `docker ps --filter label=` with a pipe
#     delimiter, NOT `docker compose ps --format '{{...}}'`: the Go-template form
#     is version-dependent, and a literal \t in a template is emitted literally
#     rather than as a tab.
#   * No process substitution and no arrays in the hot paths, so the parsing
#     works the same if this is ever run under a more limited shell.
#   * stat -c, grep -oE, mktemp, tr, cut: all busybox-supported, and all already
#     relied on by obsidian-vault/scripts/preflight.sh.
# ---------------------------------------------------------------------------

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STACKS="obsidian-vault vault-mcp dashboard"

# --- presentation -----------------------------------------------------------

USE_COLOR=1
if [ -n "${NO_COLOR:-}" ]; then USE_COLOR=0; fi
if [ ! -t 1 ]; then USE_COLOR=0; fi
if [ "${TERM:-dumb}" = "dumb" ]; then USE_COLOR=0; fi

C_RESET=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_RED=""; C_YELLOW=""; C_CYAN=""

set_colors() {
    if [ "${USE_COLOR}" = "1" ]; then
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
    else
        C_RESET=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_RED=""; C_YELLOW=""; C_CYAN=""
    fi
}

# Clamped: a 200-column window should not produce a 200-character rule, and a
# tput that reports nothing must not produce a zero-width one.
term_width() {
    local c=""
    if command -v tput >/dev/null 2>&1; then
        c="$(tput cols 2>/dev/null)" || c=""
    fi
    case "${c}" in
        ''|*[!0-9]*) c=76 ;;
    esac
    if [ "${c}" -gt 100 ]; then c=100; fi
    if [ "${c}" -lt 48 ]; then c=48; fi
    printf '%s' "${c}"
}

W="$(term_width)"
LABEL_W=16
VALUE_W=$(( W - 2 - 6 - 1 - LABEL_W - 1 ))

# Sections whose labels are .env keys need a wider column - MCP_CLIENT_IP_HEADER
# is 20 characters and would otherwise push its value out of alignment, which is
# exactly the ragged output this layer exists to avoid.
set_label_width() {
    LABEL_W="$1"
    VALUE_W=$(( W - 2 - 6 - 1 - LABEL_W - 1 ))
    if [ "${VALUE_W}" -lt 12 ]; then VALUE_W=12; fi
}

# GNU/busybox `stat -c` on the NAS, BSD `stat -f` if this is ever run from the
# Mac. Returns empty rather than a placeholder so callers can say "could not
# read" instead of printing a mode of 0???.
file_mode() {
    local f="$1" m
    m="$(stat -c '%a' "${f}" 2>/dev/null)" || m=""
    if [ -z "${m}" ]; then
        m="$(stat -f '%Lp' "${f}" 2>/dev/null)" || m=""
    fi
    printf '%s' "${m}"
}

# Keys that may legitimately be empty, so `env check` does not cry wolf.
# MCP_ALLOWED_CIDRS in particular MUST be empty on the Funnel path - Funnel does
# not forward the caller's IP, so any value there rejects every request.
# MCP_EXCLUDE empty is a posture, not an unfilled blank: it means voice can read
# the whole vault, which is a choice the operator is allowed to make. `status`
# reports which folders are hidden, so it stays visible either way.
# Is this .env value a "yes"?
#
# MUST match dashboard/main.go's envBool and dashboard/scripts/preflight.sh: the
# three parse the same files, and this one used to accept only a literal 1. The
# cost of that was not a cosmetic wrong row - DASH_ALLOW_ANY_TAILNET_USER=true
# is honoured by the binary and suppressed the one warning whose job is to say
# "armed for EVERY account on this tailnet".
env_is_true() {
    case "${1:-}" in
        1|true|TRUE|True|yes|YES|Yes) return 0 ;;
        *)                            return 1 ;;
    esac
}

env_key_optional() {
    case "$1:$2" in
        vault-mcp:MCP_ALLOWED_CIDRS)  return 0 ;;
        # TZ is inherited from the host clock via /etc/localtime; a value here
        # is an override, not a requirement.
        vault-mcp:TZ)                 return 0 ;;
        vault-mcp:TS_EXTRA_ARGS)      return 0 ;;
        vault-mcp:MCP_EXCLUDE)        return 0 ;;
        # The stamp keys all have working built-in defaults, and blank means
        # "stamp, under the default name" on both sides rather than "off" - so
        # an .env predating the convention is fine and must not read as a fault.
        vault-mcp:MCP_STAMP)              return 0 ;;
        vault-mcp:MCP_STAMP_AGENT)        return 0 ;;
        obsidian-vault:VAULT_STAMP)       return 0 ;;
        obsidian-vault:VAULT_AGENT_NAME)  return 0 ;;
        # Defaults to 1 (the repo's settings.json AND .mcp.json are installed
        # on every agent start). Absent means managed, which is the wanted
        # behaviour for both.
        obsidian-vault:VAULT_SETTINGS_MANAGED) return 0 ;;
        # The dashboard's three OVERRIDES. Each is off when blank, and blank is
        # the recommended setting - so reporting them as faults would make the
        # documented configuration fail its own check, on a button the page
        # offers without a sign-in. DASH_ALLOWED_LOGINS is deliberately NOT
        # here: blank means the web container refuses to start, which is real.
        #
        # (dashboard:DASH_TOKEN used to sit here for the same reason. The token
        # no longer exists, so the case was unreachable and its rationale -
        # "blank means read-only" - was the belief the tailnet-identity change
        # deleted. Removed rather than left standing.)
        dashboard:DASH_ALLOW_ANY_TAILNET_USER)   return 0 ;;
        dashboard:DASH_READ_ONLY)                return 0 ;;
        dashboard:DASH_ALLOW_UNVERIFIED_EXPOSURE) return 0 ;;
        dashboard:TZ)                 return 0 ;;
        # Defaults to 4 in the binary; blank means the default, not "no limit".
        dashboard:DASH_MAX_READS)     return 0 ;;
        obsidian-vault:AGE_RECIPIENT) return 0 ;;
        # EMPTY IS THE DEFAULT AND THE POSTURE, not an unfilled blank: it means
        # fetch_attachment may reach any public host, which is what makes
        # research work without a per-topic allowlist. Private, loopback and
        # tailnet addresses are refused in Go regardless. Reporting this as a
        # fault would contradict .env.example, which ships it blank.
        obsidian-vault:FETCH_ALLOW_HOSTS) return 0 ;;
        *)                            return 1 ;;
    esac
}

# ASCII ellipsis on purpose - see the compatibility note above.
fit() {
    local s="$1" max="$2"
    if [ "${#s}" -le "${max}" ]; then
        printf '%s' "${s}"
    else
        printf '%s...' "$(printf '%s' "${s}" | cut -c1-$(( max - 3 )))"
    fi
}

rule() {
    local line
    line="$(printf '%*s' "${W}" '' | tr ' ' '-')"
    printf '%s%s%s\n' "${C_DIM}" "${line}" "${C_RESET}"
}

section() {
    printf '\n%s%s%s\n' "${C_BOLD}" "$1" "${C_RESET}"
    rule
}

# row <ok|bad|warn|info> <label> [value]
#
# Fixed-width tag and label so a screenful of these scans vertically. The tag is
# bracketed rather than coloured-only, so the meaning survives --no-color and a
# copy-paste into a chat window.
row() {
    local kind="$1" label="$2" value="${3:-}" tag color
    case "${kind}" in
        ok)   tag="ok  "; color="${C_GREEN}" ;;
        bad)  tag="FAIL"; color="${C_RED}" ;;
        warn) tag="warn"; color="${C_YELLOW}" ;;
        *)    tag="    "; color="" ;;
    esac
    printf '  %s[%s]%s %-*s %s\n' \
        "${color}" "${tag}" "${C_RESET}" "${LABEL_W}" "${label}" "$(fit "${value}" "${VALUE_W}")"
}

log() { printf '%s[homelab]%s %s\n' "${C_CYAN}" "${C_RESET}" "$*" >&2; }
die() { printf '%s[homelab]%s %s\n' "${C_RED}" "${C_RESET}" "$*" >&2; exit 1; }

# Strips the leading comment marker so `--help` reads as help rather than as a
# quoted source file.
usage() { sed -n '3,21p' "$0" | sed 's/^#\{1\} \{0,1\}//'; }

# --- config -----------------------------------------------------------------

# Parse one key out of a .env. Deliberately NOT `. .env`: those files hold values
# with spaces (AGENT_GIT_NAME=Claude Code) that sourcing would run as a command.
# Same reasoning, and same implementation, as obsidian-vault/scripts/preflight.sh -
# kept local so this script has no dependency on that stack being present.
env_get() {
    local file="$1" key="$2" line value
    line="$(grep -E "^[[:space:]]*${key}=" "${file}" 2>/dev/null | tail -n1)" || true
    if [ -z "${line}" ]; then
        printf ''
        return 0
    fi
    value="${line#*=}"
    value="${value%%[[:space:]]#*}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "${value}"
}

# Resolve and validate a stack argument. Everything that touches docker goes
# through here, so an unknown or half-installed stack fails before any action.
stack_dir() {
    local stack="${1:-}" s found=0 dir
    if [ -z "${stack}" ]; then die "which stack? one of: ${STACKS}"; fi
    for s in ${STACKS}; do
        if [ "${s}" = "${stack}" ]; then found=1; fi
    done
    if [ "${found}" != "1" ]; then die "unknown stack '${stack}' - one of: ${STACKS}"; fi
    dir="${REPO_ROOT}/${stack}"
    if [ ! -f "${dir}/docker-compose.yml" ]; then die "${dir}/docker-compose.yml not found"; fi
    printf '%s' "${dir}"
}

# compose, scoped to one stack.
#
# -p pins the project name so it cannot drift with the directory name, and
# --project-directory keeps relative bind mounts (vault-mcp's ./funnel.json)
# resolving against the stack rather than the caller's cwd.
compose() {
    local stack="$1" dir="$2"
    shift 2
    docker compose -p "${stack}" --project-directory "${dir}" -f "${dir}/docker-compose.yml" "$@"
}

require_env() {
    local dir="$1"
    if [ ! -f "${dir}/.env" ]; then die "no .env in ${dir} - copy .env.example and fill it in"; fi
}

# --- status -----------------------------------------------------------------

# High-signal facts only. Anything that inspects the filesystem, checks ownership
# or asserts an invariant belongs in preflight.sh, where the expensive checks
# already live.
status_one() {
    local stack="$1" dir mode image containers line name state st
    dir="${REPO_ROOT}/${stack}"

    section "${stack}"

    if [ ! -f "${dir}/docker-compose.yml" ]; then
        row warn "stack" "not present in this checkout"
        return 0
    fi

    if [ ! -f "${dir}/.env" ]; then
        row bad ".env" "missing - copy .env.example"
        return 0
    fi

    mode="$(file_mode "${dir}/.env")"
    if [ "${mode}" = "600" ]; then
        row ok ".env" "0600"
    elif [ -z "${mode}" ]; then
        row warn ".env" "present, could not read its mode"
    else
        row bad ".env" "0${mode}, want 0600 (it holds tokens)"
    fi

    image="$(env_get "${dir}/.env" IMAGE)"
    if [ -n "${image}" ]; then row ok "image" "${image}"; else row warn "image" "IMAGE not set"; fi

    if ! command -v docker >/dev/null 2>&1; then
        row warn "docker" "not on PATH"
        return 0
    fi

    # Label filter rather than a compose template: stable across compose
    # versions, and it only ever returns this stack's containers.
    if ! containers="$(docker ps -a \
            --filter "label=com.docker.compose.project=${stack}" \
            --format '{{.Names}}|{{.State}}|{{.Status}}' 2>/dev/null)"; then
        row warn "docker" "cannot query the daemon (are you root?)"
        return 0
    fi

    if [ -z "${containers}" ]; then
        row warn "containers" "none - homelab deploy ${stack}"
    else
        printf '%s\n' "${containers}" | sort | while IFS='|' read -r name state st; do
            if [ -z "${name}" ]; then continue; fi
            case "${state}" in
                running) row ok "${name}" "${st}" ;;
                *)       row bad "${name}" "${state} - ${st}" ;;
            esac
        done
    fi

    case "${stack}" in
        obsidian-vault) status_vault_extra "${dir}" ;;
        vault-mcp)      status_mcp_extra "${dir}" ;;
        dashboard)      status_dashboard_extra "${dir}" ;;
    esac
}

# Query the snapshot repo WITHOUT requiring git on the host.
#
# Container Station gives QTS a docker binary but no git, and installing one via
# Entware is a bad trade: Entware is a documented way to break the SSH PATH, and
# the PATH is how you reach docker in the first place. Nothing in the running
# system needs host git either - every snapshot commit happens inside a container
# whose image already has it.
#
# So: use host git if it happens to exist, otherwise borrow it from any running
# container that already mounts /snapshots. The in-container path is always
# /snapshots/vault.git regardless of where it lives on the host.
vault_git() {
    local gitdir="$1" c
    shift
    if command -v git >/dev/null 2>&1; then
        git --git-dir="${gitdir}" "$@"
        return
    fi
    if ! command -v docker >/dev/null 2>&1; then
        return 1
    fi
    for c in vault-mcp vault-sync vault-claude; do
        if docker ps --filter "name=^${c}\$" --filter status=running --format '{{.Names}}' 2>/dev/null | grep -q .; then
            docker exec "${c}" git --git-dir=/snapshots/vault.git "$@"
            return
        fi
    done
    return 1
}

# Git against THIS CHECKOUT, for a NAS that has docker but no git.
#
# Pinned by digest like every other image here: this one is handed write access
# to the checkout that the deploy commands then run.
GIT_IMAGE="alpine/git:v2.54.0@sha256:3b44767883ac77bddae0160cc27b6b039345e23fa3504f4159efaa32264ab57f"

repo_git() {
    if command -v git >/dev/null 2>&1; then
        git -C "${REPO_ROOT}" "$@"
        return
    fi
    if ! command -v docker >/dev/null 2>&1; then
        die "neither git nor docker found - cannot reach the repo"
    fi
    # -u matters: without it every file git writes lands owned by root, and the
    # account the stacks run as can no longer read its own checkout.
    # HOME is set because git wants somewhere to look for a config it will not find.
    docker run --rm \
        -v "${REPO_ROOT}:/git" -w /git \
        -u "$(id -u):$(id -g)" -e HOME=/tmp \
        "${GIT_IMAGE}" "$@"
}

cmd_git() {
    if [ "$#" -eq 0 ]; then die "usage: homelab git <git args...>"; fi
    repo_git "$@"
}

# There is deliberately no `clone`: this script lives inside the repo, so by the
# time you can run it the clone has already happened. The one-liner for the
# initial clone is in README.md#getting-the-repo-onto-the-nas-without-host-git.
#
# Overwriting this file while it is running is safe: `main "$@"` is the last line
# of the script, so bash has necessarily read the whole thing before any of this
# executes.
cmd_update() {
    if [ "$#" -ne 0 ]; then die "usage: homelab update"; fi
    log "updating ${REPO_ROOT}"
    # --ff-only so a divergence stops here rather than opening a merge in a
    # shell you did not intend to resolve conflicts in.
    # A rewritten upstream history cannot fast-forward, and git's own advice
    # ("git merge --no-ff, or git rebase") is wrong here: this is a deploy
    # checkout with no local commits, so the answer is to take upstream whole.
    # .env is gitignored and untracked, so a hard reset does not touch it.
    if ! repo_git pull --ff-only; then
        die "cannot fast-forward - upstream history was probably rewritten.
  This checkout has no local commits, so take upstream as-is:
      homelab git fetch origin
      homelab git reset --hard origin/main
  Your .env files are untracked and survive a reset. Do NOT re-clone."
    fi
    log "now at $(repo_git rev-parse --short HEAD 2>/dev/null || printf '?')"
    log "deploy the change with: homelab deploy <stack>"
}

# Read the vault's own history - the audit trail that makes the snapshot design
# worth having. Works with no host git, same borrow-from-a-container trick.
#
#   homelab snapshots log -5
#   homelab snapshots log --author='Claude Voice' --stat
cmd_snapshots() {
    local dir gitdir snapshots
    dir="$(stack_dir obsidian-vault)"
    require_env "${dir}"
    snapshots="$(env_get "${dir}/.env" SNAPSHOT_HOST_PATH)"
    if [ -z "${snapshots}" ]; then die "SNAPSHOT_HOST_PATH not set in ${dir}/.env"; fi
    gitdir="${snapshots}/vault.git"
    if [ ! -d "${gitdir}" ]; then die "no snapshot repo at ${gitdir}"; fi
    if [ "$#" -eq 0 ]; then set -- log --oneline -10; fi
    vault_git "${gitdir}" "$@" \
        || die "no git available - install none, just start a stack that mounts /snapshots"
}

# The snapshot repo is the thing that silently stops working: hooks fire inside a
# container nobody watches, and a stalled backstop looks identical to an idle
# vault until you need a restore.
status_vault_extra() {
    local dir="$1" snapshots gitdir last
    snapshots="$(env_get "${dir}/.env" SNAPSHOT_HOST_PATH)"
    if [ -z "${snapshots}" ]; then return 0; fi
    gitdir="${snapshots}/vault.git"

    if [ ! -d "${gitdir}" ]; then
        row warn "snapshot" "no repo at ${gitdir} yet"
        return 0
    fi
    last="$(vault_git "${gitdir}" log -1 --format='%cr by %an' 2>/dev/null)" || last=""
    if [ -n "${last}" ]; then
        row ok "snapshot" "${last}"
    else
        row warn "snapshot" "no commits yet, or no git available to read it"
    fi
}

# The two things invisible from `docker ps`: whether the Funnel is actually
# published, and whether a voice write has ever reached the repo. The second is
# the end-to-end proof that this stack does what it exists to do.
status_mcp_extra() {
    local dir="$1" issuer resource url snapshots gitdir last excl
    # One scheme, deliberately. Two shared-secret schemes preceded it and were
    # removed; see vault-mcp/README.md#how-this-authenticates.
    issuer="$(env_get "${dir}/.env" OAUTH_ISSUER)"
    resource="$(env_get "${dir}/.env" OAUTH_RESOURCE)"
    if [ -n "${issuer}" ] && [ -n "${resource}" ]; then
        row ok "auth" "oauth via ${issuer}"
    elif [ -n "${issuer}" ]; then
        row bad "auth" "OAUTH_ISSUER set but OAUTH_RESOURCE empty - the server will not start"
    else
        row bad "auth" "OAUTH_ISSUER not set - the server will not start"
    fi

    # A leftover secret from the pre-OAuth schemes is a live credential nobody
    # is watching. The server ignores these now; the warning is about .env
    # hygiene, not about behaviour.
    if [ -n "$(env_get "${dir}/.env" MCP_PATH_SECRET)" ] || [ -n "$(env_get "${dir}/.env" MCP_TOKEN)" ]; then
        row warn "stale secret" "MCP_TOKEN/MCP_PATH_SECRET still in .env - unused, delete the lines"
    fi

    # Worth a row of its own: the exclusion list is the only thing keeping notes
    # you did not write out of a conversation that has web access, and a rename
    # in Obsidian can quietly stop it matching. The server logs that at startup;
    # this puts it where it will actually be looked at.
    excl="$(env_get "${dir}/.env" MCP_EXCLUDE)"
    if [ -n "${excl}" ]; then
        row ok "hidden from voice" "${excl}"
    else
        row warn "hidden from voice" "nothing - voice reads the whole vault"
    fi

    url="$(mcp_url_full 2>/dev/null)" || url=""
    if [ -n "${url}" ]; then url="$(redact_url "${url}")"; fi
    if [ -n "${url}" ]; then
        row ok "connector url" "${url}"
    else
        row warn "connector url" "funnel not reporting a hostname yet"
    fi

    snapshots="$(env_get "${dir}/.env" SNAPSHOT_HOST_PATH)"
    if [ -n "${snapshots}" ] && [ -d "${snapshots}/vault.git" ]; then
        gitdir="${snapshots}/vault.git"
        last="$(vault_git "${gitdir}" log -1 --author='Claude Voice' --format='%cr' 2>/dev/null)" || last=""
        if [ -n "${last}" ]; then
            row ok "voice write" "${last}"
        else
            row warn "voice write" "none yet - expected until you capture something"
        fi
    fi
}

# The three things about the dashboard that `docker ps` cannot tell you: where
# it is answering, whether the buttons are armed, and whether the checkout it
# mounts is the one you are reading this from.
#
# It never prints DASH_TOKEN or DASH_AGENT_TOKEN, only whether they are set. A
# status command that pastes a live credential into a terminal is a status
# command that pastes it into a chat window ten seconds later.
status_dashboard_extra() {
    local dir="$1" port repo allowed any ro ts serve url

    port="$(env_get "${dir}/.env" DASH_PORT)"
    if [ -z "${port}" ]; then port="8088"; fi

    # Locate the tailscale binary first: it answers both the URL and the proxy
    # rows below, and without it neither question has an honest answer.
    ts=""
    if command -v tailscale >/dev/null 2>&1; then
        ts=tailscale
    else
        url="$(getcfg Tailscale Install_Path -f /etc/config/qpkg.conf 2>/dev/null)" || url=""
        if [ -n "${url}" ] && [ -x "${url}/tailscale" ]; then ts="${url}/tailscale"; fi
    fi

    serve=""
    if [ -n "${ts}" ]; then
        serve="$("${ts}" serve status 2>/dev/null)" || serve=""
    fi

    # THE URL COMES FROM SERVE, NOT FROM `hostname`.
    #
    # This printed "https://$(hostname)/", which on QTS is the SHORT name - and
    # that URL fails twice: the certificate Serve holds is for the full
    # <host>.<tailnet>.ts.net name, so the handshake fails even where MagicDNS
    # resolves the short one; and off the tailnet the name resolves to the LAN
    # address, where nothing listens on 443. This is the command you run when
    # the page will not load, which is the moment a wrong URL costs most.
    #
    # Serve prints the hostname it actually serves, which is the only source
    # that cannot disagree with the certificate. If it cannot be read, say so
    # rather than guessing: a named uncertainty beats a confident wrong answer.
    url="$(printf '%s' "${serve}" | grep -oE 'https://[A-Za-z0-9.-]+\.ts\.net' | head -n1)" || url=""
    if [ -n "${url}" ]; then
        row ok "url" "${url}/"
    else
        row warn "url" "unknown - ask 'tailscale serve status' on the NAS (proxies to 127.0.0.1:${port})"
    fi

    allowed="$(env_get "${dir}/.env" DASH_ALLOWED_LOGINS)"
    any="$(env_get "${dir}/.env" DASH_ALLOW_ANY_TAILNET_USER)"
    ro="$(env_get "${dir}/.env" DASH_READ_ONLY)"

    if env_is_true "${ro}"; then
        row ok "buttons" "read-only - DASH_READ_ONLY is set"
    elif env_is_true "${any}"; then
        row warn "buttons" "armed for EVERY account on this tailnet"
    elif [ -n "${allowed}" ]; then
        row ok "buttons" "armed for ${allowed}"
    else
        # Not a warning: the web container refuses to start on this, so the
        # stack is down rather than merely restricted.
        row bad "buttons" "DASH_ALLOWED_LOGINS is blank - the web container will not start"
    fi

    if [ -n "$(env_get "${dir}/.env" DASH_TOKEN)" ]; then
        row warn "DASH_TOKEN" "set but no longer read by anything - delete the line"
    fi

    # Identity is a header `tailscale serve` adds, so a missing proxy is not a
    # degraded dashboard, it is an unreachable one. Checked here as well as in
    # preflight.sh because this is what you type when something looks wrong.
    if [ -z "${ts}" ]; then
        row warn "serve" "tailscale not found - cannot check the proxy"
    elif printf '%s' "${serve}" | grep -q "127.0.0.1:${port}"; then
        row ok "serve" "proxying to 127.0.0.1:${port}"
    else
        row bad "serve" "not proxying to 127.0.0.1:${port} - run: tailscale serve --bg --https 443 http://127.0.0.1:${port}"
    fi

    if [ -z "$(env_get "${dir}/.env" DASH_AGENT_TOKEN)" ]; then
        row bad "agent token" "DASH_AGENT_TOKEN is blank - the agent will not start"
    fi

    # The mount has to be the checkout's real path on the host, or every
    # relative bind mount in every other stack resolves to a path the daemon
    # cannot see. See dashboard/docker-compose.yml.
    repo="$(env_get "${dir}/.env" REPO_HOST_PATH)"
    if [ -z "${repo}" ]; then
        row bad "checkout" "REPO_HOST_PATH not set"
    elif [ "${repo}" = "${REPO_ROOT}" ]; then
        row ok "checkout" "${repo}"
    else
        row bad "checkout" "REPO_HOST_PATH=${repo} but this is ${REPO_ROOT}"
    fi
}

# The stack list, one per line, for anything that needs to know what this CLI
# will accept.
#
# It exists because STACKS was becoming a second source of truth. The dashboard
# used to discover stacks by scanning the checkout for docker-compose.yml, which
# is a DIFFERENT answer to this question: a directory can have a compose file and
# still not be in STACKS, and the dashboard would then draw buttons for a stack
# every command here rejects. Asking rather than guessing means there is one
# list, and adding a stack stays a one-line edit.
#
# Machine-readable on purpose: no colour, no header, no section rule.
cmd_stacks() {
    local s
    for s in ${STACKS}; do
        printf '%s\n' "${s}"
    done
}

cmd_status() {
    local stack="${1:-}" s
    if [ -n "${stack}" ]; then
        stack_dir "${stack}" >/dev/null
        status_one "${stack}"
    else
        for s in ${STACKS}; do
            status_one "${s}"
        done
    fi
    printf '\n'
}

# --- lifecycle --------------------------------------------------------------

# Delegates to the stack's own deploy.sh when it has one. obsidian-vault's
# understands --sync-only and warns about restarting vault-claude; reimplementing
# that here would eventually drift from it.
cmd_deploy() {
    local stack dir image owner
    stack="${1:-}"
    dir="$(stack_dir "${stack}")"
    shift
    require_env "${dir}"

    if [ -x "${dir}/scripts/deploy.sh" ]; then
        log "delegating to ${stack}/scripts/deploy.sh"
        ( cd "${dir}" && ./scripts/deploy.sh "$@" )
        return
    fi

    if [ "$#" -ne 0 ]; then die "no options supported for ${stack}: $*"; fi

    image="$(env_get "${dir}/.env" IMAGE)"
    if [ -z "${image}" ]; then die "IMAGE not set in ${dir}/.env"; fi

    log "pulling ${image}"
    compose "${stack}" "${dir}" pull

    # Same posture as obsidian-vault/scripts/deploy.sh, and deliberately in step
    # with it rather than merely similar: refuse images that did not come from the
    # workflow, but do not block a fresh NAS that has no gh CLI.
    #
    # The two reasons this can skip are NOT the same reason, and this used to
    # treat them as one. No gh is an environment without the tool - QNAP does not
    # ship one, and the dashboard image deliberately does not either, so it warns
    # and proceeds. A gh that IS here with no GITHUB_OWNER to check against is a
    # misconfiguration of this checkout: every deploy silently downgrades to
    # unverified while the log line blames a missing tool that is sitting right
    # there. deploy.sh has always refused that case; this now does too.
    owner="$(env_get "${dir}/.env" GITHUB_OWNER)"
    if command -v gh >/dev/null 2>&1; then
        if [ -z "${owner}" ]; then
            die "GITHUB_OWNER not set in ${dir}/.env - cannot verify provenance, not deploying"
        fi
        log "verifying build provenance"
        gh attestation verify "oci://${image}" --owner "${owner}" \
            || die "provenance verification failed - not deploying"
    else
        log "WARNING: gh CLI not found - skipping provenance verification"
        log "WARNING: install gh here to have deploys refuse unattested images"
    fi

    compose "${stack}" "${dir}" up -d
    printf '\n'
    cmd_status "${stack}"
}

cmd_ps() {
    local stack dir
    stack="${1:-}"; dir="$(stack_dir "${stack}")"
    compose "${stack}" "${dir}" ps
}

# Follow is opt-in. Defaulting to -f meant every quick look hung until Ctrl-C,
# which is the wrong default for the thing you reach for while debugging.
cmd_logs() {
    local stack dir follow=0 args
    stack="${1:-}"; dir="$(stack_dir "${stack}")"; shift
    args=""
    for a in "$@"; do
        if [ "${a}" = "-f" ] || [ "${a}" = "--follow" ]; then follow=1; else args="${args} ${a}"; fi
    done
    # shellcheck disable=SC2086
    if [ "${follow}" = "1" ]; then
        compose "${stack}" "${dir}" logs -f --tail 200 ${args}
    else
        compose "${stack}" "${dir}" logs --tail 200 ${args}
    fi
}

cmd_restart() {
    local stack dir
    stack="${1:-}"; dir="$(stack_dir "${stack}")"; shift
    compose "${stack}" "${dir}" up -d --force-recreate "$@"
}

cmd_preflight() {
    local stack dir
    stack="${1:-}"; dir="$(stack_dir "${stack}")"; shift
    if [ ! -x "${dir}/scripts/preflight.sh" ]; then die "${stack} has no preflight.sh"; fi
    ( cd "${dir}" && ./scripts/preflight.sh "$@" )
}

# --- env --------------------------------------------------------------------

# Rewrites via temp-then-rename, preserving 0600. These files hold the MCP token
# and the Tailscale auth key; a truncated .env from an interrupted write is a
# stack that will not start and a secret that may be half on disk.
env_set() {
    local file="$1" key="$2" value="$3" tmp line
    tmp="$(mktemp "${file}.XXXXXX")"
    chmod 600 "${tmp}"
    if grep -qE "^[[:space:]]*${key}=" "${file}" 2>/dev/null; then
        # No sed substitution: the value can contain slashes and ampersands.
        while IFS= read -r line || [ -n "${line}" ]; do
            case "${line}" in
                "${key}="*) printf '%s=%s\n' "${key}" "${value}" ;;
                *)          printf '%s\n' "${line}" ;;
            esac
        done < "${file}" > "${tmp}"
    else
        cat "${file}" > "${tmp}"
        printf '%s=%s\n' "${key}" "${value}" >> "${tmp}"
    fi
    mv "${tmp}" "${file}"
    chmod 600 "${file}"
}

env_check() {
    local dir="$1" stack="$2" mode keys key val missing=0 optional=0
    section "${stack} .env"
    set_label_width 22

    mode="$(file_mode "${dir}/.env")"
    if [ "${mode}" = "600" ]; then
        row ok "mode" "0600"
    elif [ -z "${mode}" ]; then
        row warn "mode" "could not read"
    else
        row bad "mode" "0${mode}, want 0600"
    fi

    if [ ! -f "${dir}/.env.example" ]; then
        row warn "keys" "no .env.example to compare against"
        set_label_width 16
        printf '\n'
        return 0
    fi

    # Every key the example declares but .env leaves blank. Catches the common
    # failure: a copied example with the secrets never filled in. Key names have
    # no spaces, so plain word-splitting is safe and avoids a subshell.
    keys="$(grep -oE '^[A-Z_][A-Z0-9_]*=' "${dir}/.env.example" | tr -d '=' | sort -u)"
    for key in ${keys}; do
        val="$(env_get "${dir}/.env" "${key}")"
        if [ -n "${val}" ]; then continue; fi
        if env_key_optional "${stack}" "${key}"; then
            row info "${key}" "empty (optional)"
            optional=$(( optional + 1 ))
        else
            row bad "${key}" "empty"
            missing=$(( missing + 1 ))
        fi
    done
    if [ "${missing}" -eq 0 ]; then
        row ok "keys" "every required key has a value"
    fi

    set_label_width 16
    printf '\n'
}

cmd_env() {
    local action="${1:-}" stack dir
    case "${action}" in
        check)
            stack="${2:-}"; dir="$(stack_dir "${stack}")"; require_env "${dir}"
            env_check "${dir}" "${stack}"
            ;;
        get)
            stack="${2:-}"; dir="$(stack_dir "${stack}")"; require_env "${dir}"
            if [ -z "${3:-}" ]; then die "usage: homelab env get <stack> KEY"; fi
            env_get "${dir}/.env" "$3"
            printf '\n'
            ;;
        set)
            stack="${2:-}"; dir="$(stack_dir "${stack}")"; require_env "${dir}"
            if [ -z "${3:-}" ]; then die "usage: homelab env set <stack> KEY VALUE"; fi
            env_set "${dir}/.env" "$3" "${4:-}"
            log "set $3 in ${dir}/.env - recreate the stack for it to take effect"
            ;;
        *)
            die "usage: homelab env check|get|set <stack> [KEY [VALUE]]"
            ;;
    esac
}

# --- vault-mcp specifics ----------------------------------------------------

# `tailscale funnel status` is the authoritative answer: it reports what is
# actually published, not what funnel.json asks for.
mcp_url() {
    local out host
    out="$(docker exec vault-mcp-funnel tailscale funnel status 2>/dev/null)" || return 1
    host="$(printf '%s' "${out}" | grep -oE 'https://[a-zA-Z0-9.-]+' | head -1)" || true
    if [ -z "${host}" ]; then return 1; fi
    printf '%s/mcp' "${host}"
}

cmd_url() {
    local url
    url="$(mcp_url)" || die "funnel is not reporting a hostname - check: homelab logs vault-mcp vault-mcp-funnel"
    printf '%s\n' "${url}"
}

# Both agents run `claude remote-control` inside tmux, so attaching is how you
# see the pairing QR or an expiring-login warning. Never start a second claude
# against the same credentials volume - see ARCHITECTURE.md#invariants. The two
# agents have SEPARATE credential volumes precisely so both can run at once;
# that is why this takes an argument rather than assuming one of them.
#
# Defaults to claude, because the vault agent is the one you reach for most and
# was the only one this command had for its first three weeks.
cmd_attach() {
    case "${1:-claude}" in
        claude)   docker exec -it vault-claude tmux attach -t "${TMUX_SESSION:-vault}" ;;
        research) docker exec -it vault-research tmux attach -t "${RESEARCH_TMUX_SESSION:-research}" ;;
        *) die "attach: expected 'claude' or 'research', got '${1}'" ;;
    esac
}

# ---------------------------------------------------------------------------

main() {
    # Global flags first, so `homelab --no-color status` works.
    while [ "$#" -gt 0 ]; do
        case "${1:-}" in
            --no-color) USE_COLOR=0; shift ;;
            *) break ;;
        esac
    done
    set_colors

    local cmd="${1:-}"
    if [ "$#" -gt 0 ]; then shift; fi

    case "${cmd}" in
        stacks)    cmd_stacks "$@" ;;
        status)    cmd_status "$@" ;;
        ps)        cmd_ps "$@" ;;
        logs)      cmd_logs "$@" ;;
        deploy)    cmd_deploy "$@" ;;
        restart)   cmd_restart "$@" ;;
        preflight) cmd_preflight "$@" ;;
        env)       cmd_env "$@" ;;
        url)       cmd_url "$@" ;;
        attach)    cmd_attach "$@" ;;
        update)    cmd_update "$@" ;;
        git)       cmd_git "$@" ;;
        snapshots) cmd_snapshots "$@" ;;
        -h|--help|help|"") usage ;;
        *)         die "unknown command '${cmd}' - try: homelab --help" ;;
    esac
}

main "$@"
