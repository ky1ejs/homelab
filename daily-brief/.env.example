# Copy to .env on the NAS and chmod 600. .env is gitignored at the repo root.
#
#   cp .env.example .env && chmod 600 .env
#
# Placeholders only. This repo is public: real addresses, ids and keys go in
# .env and nowhere else. What the brief covers goes in interests.md, which is
# gitignored too (cp interests.example.md interests.md).
#
# docker-compose.yml passes each container only the variables below that it
# needs, so the one that reads the web never sees the Gmail client or its key.

# Published by .github/workflows/build-daily-brief.yml.
IMAGE=ghcr.io/ky1ejs/homelab/daily-brief:latest

# Whose GitHub Actions built IMAGE. `bin/homelab deploy` checks the image's
# provenance against it and warns, rather than refusing, when it is unset.
GITHUB_OWNER=ky1ejs

# Three directories, not one: each container is given only the ones it needs.
# `./scripts/preflight.sh --fix` (or `homelab preflight daily-brief --fix`)
# creates and chowns them from these values.
ISSUES_HOST_PATH=/share/CE_CACHEDEV4_DATA/daily-brief/issues
AUDIO_HOST_PATH=/share/CE_CACHEDEV4_DATA/daily-brief/audio
STATE_HOST_PATH=/share/CE_CACHEDEV4_DATA/daily-brief/state

APP_UID=1002
APP_GID=100

# Your time zone. It sets when the schedule runs and what "today" is.
BRIEF_TZ=Europe/London

# --- Writing it (brief-agent) --------------------------------------------------

# A long-lived token for your Claude subscription, from `claude setup-token`
# run on any machine where you are logged in. It can only make model
# requests. See README.md#setting-up.
CLAUDE_CODE_OAUTH_TOKEN=

# When to write, five-field cron in BRIEF_TZ. A second time is a retry: a run
# for a day that is already published exits at once.
# BRIEF_SCHEDULE=30 5,8 * * *

# Blank uses Claude Code's default model. Any name `claude --model` takes.
# BRIEF_MODEL=

# How long one session may run before it is stopped. A day is up to three.
# BRIEF_TIMEOUT=45m

# --- Reading it aloud (brief-voice) ---------------------------------------------

# A Kokoro voice. Names starting a are American English, b British English:
# af_heart, af_bella, am_michael, bf_emma, bf_isabella, bm_george, bm_lewis.
# BRIEF_VOICE=af_heart
# BRIEF_VOICE_SPEED=1.0

# Days of MP3s kept on the NAS. The small timings file stays.
# AUDIO_RETENTION_DAYS=30

# --- Sending it (brief-publisher) ------------------------------------------------
#
# See README.md#google-cloud.

# The mailbox the brief is sent from. gmail-login refuses (and revokes the
# grant) if you sign in as anything else.
GMAIL_ACCOUNT=you@example.com

# Where it goes. Usually the same address.
BRIEF_TO=you@example.com

# A Desktop OAuth client in a Google Cloud project of this stack's own, not
# gmail-mcp's. Revoking one client's token can revoke every client's in the
# same project, so sharing one would let a revoke here cut gmail-mcp off.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Seals the refresh token on disk (AES-256-GCM). 32 random bytes:
#   openssl rand -base64 32
# Changing it orphans the stored token: run gmail-login again afterwards.
BRIEF_TOKEN_KEY=

# The show episodes go to, from `save-to-spotify --json shows`. Blank sends
# the email with no podcast.
SPOTIFY_SHOW_ID=

# How long the email waits for the podcast after the issue is written, before
# it goes without one and says why. 0 never waits.
# PODCAST_WAIT=4h

# Days an episode stays on the show before it is deleted. Spotify's free tier
# keeps 30 per show. 0 keeps them all.
# RETENTION_DAYS=21

# How many days back the voice job and the publisher look for work, so a day
# missed while the NAS was down is caught up.
# LOOKBACK_DAYS=2

# A healthchecks.io check, pinged after each email. Set its period to one day
# and it alerts when a brief does not go out. Optional.
# HC_PING_URL=

# Memory and CPU caps.
# AGENT_MEM_LIMIT=1g
# VOICE_MEM_LIMIT=2g
# VOICE_CPUS=2
# PUBLISHER_MEM_LIMIT=256m
