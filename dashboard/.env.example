# Copy to .env on the NAS and chmod 600. .env is gitignored at the repo root.
#
#   cp .env.example .env && chmod 600 .env
#
# 0600 still matters, though for a narrower reason than it used to: this file no
# longer holds a secret you type. It holds DASH_AGENT_TOKEN, which is the secret
# between the two containers, and the allow list that decides who may deploy.

# Published by .github/workflows/build-dashboard.yml. Pin to a digest once the
# stack is stable; `latest` is fine while iterating.
IMAGE=ghcr.io/ky1ejs/homelab/dashboard:latest

# Used by `homelab deploy` to verify build provenance with the gh CLI. This
# image does not ship gh, so a deploy triggered from the dashboard logs a
# WARNING and proceeds unverified where the same command over SSH would check.
# That is a real difference, and README.md#what-it-cannot-do says so plainly.
#
# Leaving this blank does NOT reproduce that on the SSH path: where gh exists,
# an empty value refuses the deploy instead of skipping the check. The warning
# means "this environment has no gh", and nothing else.
GITHUB_OWNER=ky1ejs

# --- The checkout ----------------------------------------------------------

# Where this repo is cloned on the NAS. The agent container mounts it AT THIS
# SAME ABSOLUTE PATH, read-only, and docker-compose.yml explains at length why
# that is not cosmetic: `docker compose` running inside a container hands the
# host daemon the client-side path for every relative bind mount, so a checkout
# mounted anywhere else silently breaks vault-mcp's ./funnel.json mount.
#
# Note the volume: the repo is on CE_CACHEDEV4_DATA, which is NOT the volume
# either QPKG lives on. See the root README on finding QPKG paths per package.
REPO_HOST_PATH=/share/CE_CACHEDEV4_DATA/homelab

# --- Reaching it -----------------------------------------------------------

# The one published port in this repo, and it is published ON LOOPBACK ONLY --
# docker-compose.yml binds 127.0.0.1:${DASH_PORT}. `tailscale serve` on the host
# is what makes it reachable, at https://kyles-nas.tail3df177.ts.net/ with a real
# certificate. Deliberately not 8080: QTS and Container Station both have
# opinions about the low ports.
#
# Set it up once, on the NAS:
#
#   tailscale serve --bg --https 443 http://127.0.0.1:8088
#
# THERE IS NO LONGER A LAN PATH, and that is the point rather than a regression.
# Identity comes from a header Serve adds, so a listener anything on the LAN
# could reach would be a listener anything on the LAN could authenticate to.
DASH_PORT=8088

# --- Authentication --------------------------------------------------------
#
# See README.md#who-can-press-the-buttons.

# WHO may press the buttons: your tailnet login, comma-separated for more than
# one. This is the value of the Tailscale-User-Login header `tailscale serve`
# adds, which for a personal tailnet is the email address you signed up with.
# Find it with:
#
#   tailscale status --json | grep -i userid   # then look the id up in the admin console
#
# A BLANK VALUE REFUSES TO START. It is not "allow everybody", and it must never
# become that: an empty value silently meaning "allow" is how vault-mcp was once
# wide open on a public hostname. See vault-mcp/README.md#pinning-the-subject.
# The two ways to mean something permissive are both below, and both are said
# out loud.
#
# Reading the page needs no identity at all -- it shows what is running and what
# is out of date, and putting a wall in front of that would mean proving who you
# are to answer "is vault-sync up". Deploy, restart, logs and connector url all
# need one.
DASH_ALLOWED_LOGINS=

# Honour every account on this tailnet instead of an allow list. Reasonable for
# a personal tailnet with one human on it; not reasonable the moment you share a
# node with anyone. Deliberately a separate variable rather than "leave the list
# blank", for the reason above.
DASH_ALLOW_ANY_TAILNET_USER=

# Run with no actions at all: the dashboard shows everything and refuses every
# mutating action with an explanation rather than a 403 that looks like a bug.
# This used to be spelled "leave DASH_TOKEN blank"; a mode worth supporting is
# worth stating.
DASH_READ_ONLY=

# Act even when the agent CANNOT DETERMINE how this stack is published.
#
# Normally the agent asks the daemon whether homelab-dash is bound to loopback
# and refuses every mutating and sensitive action if it is not -- that check is
# what makes the identity header a credential. If the daemon is unreachable or
# the containers cannot be found, the honest answer is "I cannot tell", and the
# safe response is still to refuse.
#
# This unlocks ONLY that unverifiable case. It CANNOT unlock a stack that is
# positively published beyond loopback; there is no setting for that, because
# the cheapest way to honour a rule is to make the wrong thing unexpressible.
# Asserted in agent_test.go.
DASH_ALLOW_UNVERIFIED_EXPOSURE=

# The secret between the two containers. Not something you ever type: the web
# half proves with it that a request came from the web half.
#
# It is defence in depth rather than the primary control -- the agent publishes
# no port, so nothing outside this compose network can reach it at all. It
# exists because "unreachable" is a property of the compose file, and a compose
# file is exactly the kind of thing this dashboard makes it easy to change. The
# agent refuses to start without one.
#
#   openssl rand -hex 32
DASH_AGENT_TOKEN=

# --- Behaviour -------------------------------------------------------------

# How often the page reloads itself while you are not looking at anything. The
# refresh is skipped whenever a command's output is on screen, so this cannot
# eat a deploy log you are reading.
DASH_REFRESH=60s

# How long a registry digest lookup is cached before the "update available"
# badge asks GHCR again. Minutes, not seconds: the answer only changes when CI
# publishes, and every page load would otherwise be a round trip per stack.
DASH_REGISTRY_TTL=15m

# How long the "your checkout is N commits behind" answer is cached.
#
# This one has a hard floor for a reason: it is an UNAUTHENTICATED GitHub API
# call, and those are limited to 60 an hour per address. The page refreshes
# itself every DASH_REFRESH, so a phone left open on it would exhaust the budget
# inside an hour at a short TTL. Fifteen minutes costs four calls an hour, and
# the answer only changes when someone pushes.
DASH_GITHUB_TTL=15m

# How many read commands may run at once. Reads are deliberately concurrent --
# watching logs during a deploy is the point -- but each one forks bash and
# docker compose inside the container that holds the daemon socket, so the
# number is finite. Callers beyond this get a 429 telling them to retry.
DASH_MAX_READS=4

# --- Identity and limits ---------------------------------------------------

# The WEB container only. The agent runs as root, deliberately and unavoidably:
# the daemon socket is root-owned. See docker-compose.yml.
# Same real QNAP account as every other stack -- see
# obsidian-vault/DECISIONS.md#identity-1002-not-1000.
APP_UID=1002
APP_GID=100

# Small by construction: a Go binary rendering one page. The caps exist to
# protect QTS and the other containers, not because they are expected to be
# approached. The agent's is larger because a `docker compose pull` runs in its
# process tree.
DASH_MEM_LIMIT=128m
DASHD_MEM_LIMIT=512m

# Inherited from the host clock via /etc/localtime, so this is only an override.
# Left blank the container follows the NAS, which is what you want for a page
# that prints wall-clock times.
TZ=
