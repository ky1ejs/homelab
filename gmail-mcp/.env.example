# Copy to .env on the NAS and chmod 600. .env is gitignored at the repo root.
#
#   cp .env.example .env && chmod 600 .env
#
# Placeholders only. This repo is public: real addresses, ids and keys go in
# .env and nowhere else.

# Published by .github/workflows/build-gmail-mcp.yml.
IMAGE=ghcr.io/ky1ejs/homelab/gmail-mcp:latest

# Whose GitHub Actions built IMAGE. `bin/homelab deploy` checks the image's
# provenance against it and warns, rather than refusing, when it is unset.
GITHUB_OWNER=ky1ejs

# On the encrypted CE_ volume, beside vault-mcp's own directory. Both must
# exist and be owned by APP_UID:APP_GID before -login or the first run;
# `./scripts/preflight.sh --fix` (or `homelab preflight gmail-mcp --fix`)
# creates and chowns them from these values.
DATA_HOST_PATH=/share/CE_CACHEDEV4_DATA/gmail-mcp/data
TS_STATE_HOST_PATH=/share/CE_CACHEDEV4_DATA/gmail-mcp/ts-state

APP_UID=1002
APP_GID=100

# --- The Gmail account -------------------------------------------------------
#
# See README.md#google-cloud.

# A Google Cloud OAuth client of type "Desktop app". Desktop clients accept any
# loopback redirect, which is what keeps Google's callback off the internet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The mailbox this server serves. -login refuses (and revokes the grant) if
# you sign in as anything else, so a wrong click in Google's account picker
# cannot quietly connect another mailbox.
GMAIL_ACCOUNT=you@example.com

# Seals the refresh token on disk (AES-256-GCM). 32 random bytes, hex:
#   openssl rand -hex 32
# Changing it orphans the stored token: run -login again afterwards.
GMAIL_TOKEN_KEY=

# --- Who may call it -----------------------------------------------------------
#
# The same WorkOS AuthKit tenant as vault-mcp. See README.md#how-this-authenticates.

OAUTH_ISSUER=

# Must equal the connector URL exactly, path included:
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net/mcp
# This is also the audience every token must carry. vault-mcp shares the
# tenant, so this value is what stops a vault token opening your mail.
OAUTH_RESOURCE=

# Your WorkOS user id (user_...). Comma-separated if there is ever more than
# one. Required: unlike vault-mcp there is no allow-any-subject switch, and a
# blank value refuses to start.
OAUTH_ALLOWED_SUBJECTS=

# The claude.ai connector's WorkOS client id (client_...). Comma-separated if
# more than one. Required, and blank refuses to start.
#
# Why: anything registered on the tenant (dynamic client registration lets
# any MCP client register itself) can get a token for this resource with your
# subject in it, if you can be talked into one consent click. Pinning the
# client means only the connector you added can read and send your mail.
#
# You learn the value from the first connect: set any placeholder, add the
# connector in claude.ai, and the refused request logs
#   token client_id is not on the allow list (client_id "client_...")
# Put that id here and `docker compose up -d` again.
OAUTH_ALLOWED_CLIENTS=

# The address Google sends -login's code back to. It must be loopback; the
# server refuses anything else, so a typo cannot register a public callback.
# Change it only if 8765 is taken on the NAS, and change the -p and ssh -L
# ports in README.md#signing-in to match.
# LOGIN_REDIRECT=http://127.0.0.1:8765/callback
#
# MCP_ADDR, TOKEN_FILE and LOGIN_ADDR are fixed in docker-compose.yml, not set
# here: funnel.json, the Dockerfile and the port forward all assume them.

# Memory caps. The server holds one thread at a time (100,000 characters at
# most); 256m is generous. The Funnel is tailscaled in userspace mode.
# MCP_MEM_LIMIT=256m
# FUNNEL_MEM_LIMIT=128m

# --- Funnel --------------------------------------------------------------------

# A tagged, non-ephemeral, single-use key for tag:gmail-mcp. Funnel also needs
# the funnel nodeAttr granted to that tag. See README.md#tailscale.
TS_AUTHKEY=
TS_HOSTNAME=gmail-mcp
TS_EXTRA_ARGS=--advertise-tags=tag:gmail-mcp
