#!/bin/bash
# mac/app-store/test-app-store - checks ./app-store on Linux in CI: its ES256
# tokens against openssl's own verify, its refusal of a key others can read,
# and what each command sends to App Store Connect and asks of xcodebuild,
# against stand-ins for curl, xcodebuild and plutil. None can check
# that Apple's API or Xcode still answer as the stand-ins do; docs/mac-studio.md
# lists what is untested on the mac studio.
#
# Usage: mac/app-store/test-app-store. Exits 1 on the first failed check.
#
# The stand-ins are scripts written in single quotes, to expand when they run.
# shellcheck disable=SC2016
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }
pass() { echo "ok: $*"; }

fake="$tmp/bin"
mkdir -p "$fake"
keydir="$tmp/asc"
key="$keydir/admin-key.p8"

# The installed script fixes the API host, the key's folder and the tools
# that see the token, so no caller can redirect them. Check it still does,
# then rewrite exactly those lines to point at this test's stand-ins.
for line in 'CURL=/usr/bin/curl' 'XCODEBUILD=/usr/bin/xcodebuild' 'PLUTIL=/usr/bin/plutil' \
  'API=https://api.appstoreconnect.apple.com' 'KEY_DIR="@keyDir@"' 'WORKER="@worker@"' \
  'BUILDS_DIR="@buildsDir@"' 'BUILDS_URL="@buildsUrl@"'; do
  grep -qxF "$line" "$here/app-store" || fail "app-store no longer has the line $line"
done
if grep -n 'APP_STORE_\|\$HOME\|\${HOME' "$here/app-store"; then fail "app-store reads a setting from the environment"; fi
script="$tmp/app-store"
sed -e "s|@jq@|$(command -v jq)|" -e "s|@openssl@|$(command -v openssl)|" \
  -e "s|@keyDir@|$keydir|" -e "s|@worker@|no-such-user|" \
  -e "s|@buildsDir@|$tmp/builds|" -e "s|@buildsUrl@|https://builds.test|" -e "s|@keepDays@|7|" \
  -e "s|^CURL=.*|CURL=$fake/curl|" -e "s|^XCODEBUILD=.*|XCODEBUILD=$fake/xcodebuild|" \
  -e "s|^PLUTIL=.*|PLUTIL=$fake/plutil|" -e "s|^API=.*|API=https://asc.test|" \
  "$here/app-store" >"$script"
chmod +x "$script"
pass "the API host, key folder, builds folder and tools are fixed in the script"

# Stand-ins know this test's folder without the environment: curl runs with
# none.
stub() { printf '#!/bin/bash\nT=%q\n%s\n' "$tmp" "$2" >"$fake/$1"; chmod +x "$fake/$1"; }

# What a session might set to redirect the token. The script must ignore all
# of it.
export APP_STORE_API="https://elsewhere.test" APP_STORE_KEY_DIR="$tmp/elsewhere" CURL_HOME="$tmp/curlhome"

# A throwaway P-256 key, as App Store Connect's .p8 files are.
mkdir -p "$keydir"
openssl ecparam -name prime256v1 -genkey -noout 2>/dev/null | openssl pkcs8 -topk8 -nocrypt -out "$key"
openssl pkey -in "$key" -pubout -out "$tmp/pub.pem" 2>/dev/null
printf 'key_id=ABCDE12345\nissuer_id=57246542-96fe-1a63-e053-0824d011072a\nteam_id=TEAM123456\n' \
  >"$keydir/app-store.conf"
chmod -R go= "$keydir"
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$tmp/rsa.p8" 2>/dev/null
export TMPDIR="$tmp/tmpdir"
mkdir -p "$TMPDIR"

# --- tokens ------------------------------------------------------------------------

b64d() {
  local s
  s="$(printf '%s' "$1" | tr -- '-_' '+/')"
  while [ $((${#s} % 4)) -ne 0 ]; do s="$s="; done
  printf '%s' "$s" | openssl base64 -d -A
}

# DER for an ECDSA signature from its 64 raw bytes, to hand openssl's verify.
der_int() {
  local h="$1"
  while [ "${h:0:2}" = 00 ] && [ ${#h} -gt 2 ]; do h="${h:2}"; done
  case "${h:0:1}" in [89a-f]) h="00$h" ;; esac
  printf '02%02x%s' $((${#h} / 2)) "$h"
}
raw_to_der() {
  local hex r s body
  hex="$(od -An -v -tx1 | tr -d ' \n')"
  [ ${#hex} -eq 128 ] || fail "signature is $((${#hex} / 2)) bytes, not 64"
  r="$(der_int "${hex:0:64}")"
  s="$(der_int "${hex:64:64}")"
  body="$r$s"
  printf '%b' "$(printf '30%02x%s' $((${#body} / 2)) "$body" | sed 's/../\\x&/g')"
}

(
  # shellcheck source=/dev/null
  . "$script"
  # Read by token(), from the sourced script.
  # shellcheck disable=SC2034
  KEY_ID=ABCDE12345
  # shellcheck disable=SC2034
  ISSUER_ID=57246542-96fe-1a63-e053-0824d011072a
  # shellcheck disable=SC2034
  KEY_FILE="$key"
  # Enough signatures that some r or s has leading zero bytes, a byte that
  # reads as % or a NUL.
  for i in $(seq 1 150); do
    t="$(token)"
    h="${t%%.*}"; rest="${t#*.}"; p="${rest%%.*}"; sig="${rest#*.}"
    b64d "$sig" | raw_to_der >"$tmp/sig.der"
    printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -verify "$tmp/pub.pem" -signature "$tmp/sig.der" >/dev/null ||
      fail "token $i: openssl does not verify its signature"
  done
  [ "$(b64d "$h" | jq -r '.alg + " " + .kid + " " + .typ')" = "ES256 ABCDE12345 JWT" ] || fail "token header: $(b64d "$h")"
  b64d "$p" | jq -e '.aud == "appstoreconnect-v1" and .iss == "57246542-96fe-1a63-e053-0824d011072a" and (.exp - .iat) == 600' >/dev/null ||
    fail "token payload: $(b64d "$p")"
)
pass "150 tokens verify, with the right header and claims"

# verify_token <jwt>: its signature verifies with the test key.
verify_token() {
  local h rest p sig
  h="${1%%.*}"; rest="${1#*.}"; p="${rest%%.*}"; sig="${rest#*.}"
  [ -n "$sig" ] || return 1
  b64d "$sig" | raw_to_der >"$tmp/sig.der"
  printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -verify "$tmp/pub.pem" -signature "$tmp/sig.der" >/dev/null
}

# --- stand-ins ----------------------------------------------------------------------

# curl: answers from $T/routes, lines of "METHOD URL-glob STATUS FILE", first
# match wins. Logs each call's arguments, environment and any body, and
# copies the header file it is given.
stub curl '
printf "%s\n" "$*" >>"$T/curl.args"
printf "HOME=%s CURL_HOME=%s\n" "${HOME-unset}" "${CURL_HOME-unset}" >>"$T/curl.env"
out=""; method=GET; body=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -X) method="$2"; shift 2 ;;
    -H) case "$2" in @*) cp "${2#@}" "$T/auth.seen" ;; esac; shift 2 ;;
    -w|--max-time|--proto) shift 2 ;;
    --data-binary) body="$2"; shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
echo "$method $url" >>"$T/curl.log"
[ -z "$body" ] || printf "%s\n" "$body" >>"$T/bodies.log"
while read -r m glob status file; do
  [ "$m" = "$method" ] || continue
  case "$url" in
    $glob) cat "$T/$file" >"$out"; printf "%s" "$status"; exit 0 ;;
  esac
done <"$T/routes"
echo "{}" >"$out"; printf 404
'
stub xcodebuild '
printf "%s\n" "$*" >>"$T/xcodebuild.log"
case " $* " in
  " -help ")
    echo "Available keys for -exportOptionsPlist:"
    if [ -n "${OLD_XCODE:-}" ]; then echo "  method : app-store, ad-hoc, development"
    else echo "  method : app-store-connect, release-testing, debugging, ad-hoc (deprecated)"; fi
    # The real help goes on for pages, so a reader that stops at the match
    # would kill xcodebuild with SIGPIPE.
    seq 1 100000 ;;
  *" -showBuildSettings "*) cat "$T/settings.json" ;;
  *" archive "*)
    while [ $# -gt 0 ]; do [ "$1" = -archivePath ] && mkdir -p "$2"; shift; done
    exit "${ARCHIVE_STATUS:-0}" ;;
  *" -exportArchive "*)
    while [ $# -gt 0 ]; do
      case "$1" in
        -exportOptionsPlist) cp "$2" "$T/export-options.plist" ;;
        -exportPath) dest="$2" ;;
      esac
      shift
    done
    [ "${EXPORT_STATUS:-0}" -eq 0 ] || exit "$EXPORT_STATUS"
    mkdir -p "$dest"
    for i in $(seq 1 "${EXPORT_IPAS:-1}"); do echo "ipa $i" >"$dest/Demo$i.ipa"; done ;;
esac
'
stub plutil '
case "$*" in
  *ApplicationProperties.CFBundleIdentifier*) echo dev.kylejs.demo ;;
  *"ApplicationProperties.ApplicationPath raw -o - "*/Info.plist) echo Applications/Demo.app ;;
  *"CFBundleShortVersionString raw -o - "*/Products/Applications/Demo.app/Info.plist) echo 1.2 ;;
  *"CFBundleVersion raw -o - "*/Products/Applications/Demo.app/Info.plist) echo 34 ;;
  *"CFBundleDisplayName raw -o - "*/Products/Applications/Demo.app/Info.plist) echo "Demo & <Co>" ;;
  *) exit 1 ;;
esac
'

# Embedded targets first, as -showBuildSettings can list them: an App Clip
# and a watch app also build a .app, but are not the app to ship.
settings() {
  jq -n --arg style "$1" --arg team "$2" '[
    {target: "DemoKit", buildSettings: {WRAPPER_EXTENSION: "framework", PRODUCT_TYPE: "com.apple.product-type.framework",
      PLATFORM_NAME: "iphoneos", PRODUCT_BUNDLE_IDENTIFIER: "dev.kylejs.demokit"}},
    {target: "DemoClip", buildSettings: {WRAPPER_EXTENSION: "app", PRODUCT_TYPE: "com.apple.product-type.application.on-demand-install-capable",
      PLATFORM_NAME: "iphoneos", PRODUCT_BUNDLE_IDENTIFIER: "dev.kylejs.demo.Clip"}},
    {target: "DemoWatch", buildSettings: {WRAPPER_EXTENSION: "app", PRODUCT_TYPE: "com.apple.product-type.application",
      PLATFORM_NAME: "watchos", PRODUCT_BUNDLE_IDENTIFIER: "dev.kylejs.demo.watchkitapp"}},
    {target: "Demo", buildSettings: {WRAPPER_EXTENSION: "app", PRODUCT_TYPE: "com.apple.product-type.application",
      PLATFORM_NAME: "iphoneos", PRODUCT_BUNDLE_IDENTIFIER: "dev.kylejs.demo",
      CODE_SIGN_STYLE: $style, DEVELOPMENT_TEAM: $team}}]' >"$tmp/settings.json"
}

echo '{"data":[]}' >"$tmp/empty.json"
echo '{"data":[{"id":"6400000001","attributes":{"bundleId":"dev.kylejs.demo","name":"Demo"}}]}' >"$tmp/app.json"
echo '{"data":[{"id":"6400000002","attributes":{"bundleId":"dev.kylejs.demo.extra","name":"Other"}}]}' >"$tmp/near.json"
echo '{"data":{"id":"B1"}}' >"$tmp/created.json"
echo '{"errors":[{"title":"Unauthorized","detail":"Authentication credentials are missing or invalid."}]}' >"$tmp/401.json"

reset() {
  rm -f "$tmp/curl.args" "$tmp/curl.env" "$tmp/curl.log" "$tmp/bodies.log" "$tmp/xcodebuild.log" \
    "$tmp/export-options.plist" "$tmp/auth.seen"
  : >"$tmp/routes"
}
route() { echo "$*" >>"$tmp/routes"; }
project="$tmp/Demo.xcodeproj"
mkdir -p "$project"

# --- the key's files ----------------------------------------------------------------

reset
chmod g+r "$keydir/app-store.conf"
if out="$("$script" check 2>&1)"; then fail "check ran with a group-readable config"; fi
case "$out" in *"chmod -R go="*) ;; *) fail "check's refusal: $out" ;; esac
[ ! -s "$tmp/curl.log" ] || fail "check called the API with an exposed key"
chmod -R go= "$keydir"
pass "refuses a key others can read"

mv "$keydir" "$keydir.off"
if out="$("$script" check 2>&1)"; then fail "check ran with no key"; fi
case "$out" in *"setup"*) ;; *) fail "no-key message: $out" ;; esac
mv "$keydir.off" "$keydir"
pass "says so when there is no key"

reset
cp "$key" "$tmp/ec.p8"
cp "$tmp/rsa.p8" "$key"; chmod 600 "$key"
if out="$("$script" check 2>&1)"; then fail "check ran with an RSA key"; fi
case "$out" in *"P-256"*) ;; *) fail "RSA key message: $out" ;; esac
[ ! -s "$tmp/curl.log" ] || fail "check called the API with an RSA key"
cp "$tmp/ec.p8" "$key"; chmod 600 "$key"
pass "refuses a key that is not P-256, before any API call"

if "$script" setup </dev/null 2>/dev/null; then fail "setup ran without a terminal"; fi
pass "setup needs a terminal"

# --- the API ------------------------------------------------------------------------

reset
route GET 'https://asc.test/v1/apps?*' 401 401.json
if out="$("$script" check 2>&1)"; then fail "check passed on a 401"; fi
case "$out" in *"Authentication credentials are missing"*"key_id and issuer_id"*) ;; *) fail "check's 401 message: $out" ;; esac
pass "a refused key shows Apple's error and what to check"

reset
route GET 'https://asc.test/v1/apps?*' 200 app.json
"$script" check >"$tmp/out" 2>&1 || fail "check: $(cat "$tmp/out")"
grep -q 'dev.kylejs.demo  Demo' "$tmp/out" || fail "check lists no apps: $(cat "$tmp/out")"
grep -q Bearer "$tmp/curl.args" && fail "the token was on curl's command line"
grep -q -- "-H @$TMPDIR/app-store\." "$tmp/curl.args" || fail "curl got no header file: $(cat "$tmp/curl.args")"
[ "$(wc -l <"$tmp/auth.seen")" -eq 1 ] || fail "the header file: $(cat "$tmp/auth.seen")"
jwt="$(sed -n 's/^Authorization: Bearer \([^ ]*\)$/\1/p' "$tmp/auth.seen")"
verify_token "$jwt" || fail "the header file holds no token that verifies: $(cat "$tmp/auth.seen")"
[ -z "$(ls -A "$TMPDIR")" ] || fail "check left $(ls -A "$TMPDIR") behind"
pass "check lists the records, sends a signed token from a file and cleans up"

grep -q '^-q ' "$tmp/curl.args" || fail "curl's first argument is not -q, so it reads ~/.curlrc: $(cat "$tmp/curl.args")"
grep -q -- '--proto =https' "$tmp/curl.args" || fail "curl may follow a protocol other than https"
grep -qx 'HOME=unset CURL_HOME=unset' "$tmp/curl.env" || fail "curl ran with the caller's environment: $(cat "$tmp/curl.env")"
grep -v '^GET https://asc.test/' "$tmp/curl.log" && fail "a call went to a host other than the fixed one"
pass "curl skips its config, runs with an empty environment and goes only to the fixed host"

reset
route GET 'https://asc.test/v1/apps?filter*' 200 near.json
code=0; "$script" record dev.kylejs.demo 2>/dev/null || code=$?
[ "$code" -eq 3 ] || fail "record of a missing app exited $code, not 3"
reset
route GET 'https://asc.test/v1/apps?filter*' 200 app.json
"$script" record dev.kylejs.demo 2>/dev/null || fail "record of an existing app failed"
grep -q 'filter\[bundleId\]=dev.kylejs.demo&' "$tmp/curl.log" || fail "record's query: $(cat "$tmp/curl.log")"
pass "record matches the bundle ID exactly, and exits 3 when there is none"

reset
route GET 'https://asc.test/v1/devices?*' 200 empty.json
route POST 'https://asc.test/v1/devices' 201 created.json
"$script" register-device "Kyle's iPhone" 00008110-001A2B3C4D5E801E 2>/dev/null || fail "register-device failed"
jq -e '.data.type == "devices" and .data.attributes == {name: "Kyle'"'"'s iPhone", udid: "00008110-001A2B3C4D5E801E", platform: "IOS"}' \
  "$tmp/bodies.log" >/dev/null || fail "register-device sent $(cat "$tmp/bodies.log")"
if "$script" register-device phone 'not a udid' 2>/dev/null; then fail "register-device took a bad UDID"; fi
pass "register-device sends the name, UDID and platform, and checks the UDID"

# --- testflight ---------------------------------------------------------------------

# No record: registers the bundle ID, builds nothing, exits 3.
reset
settings Automatic ""
route GET 'https://asc.test/v1/apps?filter*' 200 empty.json
route GET 'https://asc.test/v1/bundleIds?*' 200 empty.json
route POST 'https://asc.test/v1/bundleIds' 201 created.json
code=0; "$script" testflight --project "$project" --scheme Demo >"$tmp/out" 2>&1 || code=$?
[ "$code" -eq 3 ] || fail "testflight without a record exited $code: $(cat "$tmp/out")"
grep -q 'appstoreconnect.apple.com/apps' "$tmp/out" || fail "no steps for making the record: $(cat "$tmp/out")"
jq -e '.data.attributes == {identifier: "dev.kylejs.demo", name: "dev kylejs demo", platform: "IOS"}' "$tmp/bodies.log" >/dev/null ||
  fail "bundle ID registration sent $(cat "$tmp/bodies.log")"
grep -q ' archive ' "$tmp/xcodebuild.log" && fail "it archived with no record"
pass "testflight without a record registers the bundle ID, builds nothing and exits 3"

# A record: archive and upload, with the key and the team.
reset
route GET 'https://asc.test/v1/apps?filter*' 200 app.json
"$script" testflight --project "$project" --scheme Demo >"$tmp/out" 2>&1 || fail "testflight: $(cat "$tmp/out")"
auth="-allowProvisioningUpdates -authenticationKeyPath $key -authenticationKeyID ABCDE12345 -authenticationKeyIssuerID 57246542-96fe-1a63-e053-0824d011072a"
grep -q "^archive -project $project -scheme Demo -configuration Release -destination generic/platform=iOS -archivePath .* $auth DEVELOPMENT_TEAM=TEAM123456$" "$tmp/xcodebuild.log" ||
  fail "archive call: $(cat "$tmp/xcodebuild.log")"
grep -q "^-exportArchive .* $auth$" "$tmp/xcodebuild.log" || fail "export call: $(cat "$tmp/xcodebuild.log")"
for want in '<string>app-store-connect</string>' '<string>upload</string>' '<string>TEAM123456</string>' \
  '<key>manageAppVersionAndBuildNumber</key><true/>'; do
  grep -qF "$want" "$tmp/export-options.plist" || fail "export options lack $want"
done
[ -z "$(ls -A "$TMPDIR")" ] || fail "a successful upload left $(ls -A "$TMPDIR")"
pass "testflight archives and uploads with the key and team, and cleans up"

# A failed archive keeps nothing.
reset
route GET 'https://asc.test/v1/apps?filter*' 200 app.json
if ARCHIVE_STATUS=65 "$script" testflight --project "$project" --scheme Demo >"$tmp/out" 2>&1; then fail "testflight passed a failed archive"; fi
grep -q -- '-exportArchive' "$tmp/xcodebuild.log" && fail "it exported a failed archive"
[ -z "$(ls -A "$TMPDIR")" ] || fail "a failed archive left $(ls -A "$TMPDIR")"
pass "a failed archive uploads nothing and leaves nothing"

# A failed upload keeps the archive for --archive.
reset
route GET 'https://asc.test/v1/apps?filter*' 200 app.json
if EXPORT_STATUS=70 "$script" testflight --project "$project" --scheme Demo >"$tmp/out" 2>&1; then fail "testflight passed a failed upload"; fi
kept="$(sed -n 's/.*testflight --archive \(.*\)$/\1/p' "$tmp/out")"
[ -n "$kept" ] && [ -d "$kept" ] || fail "no archive kept: $(cat "$tmp/out")"
[ ! -e "$(dirname "$kept")/auth" ] || fail "the token stayed in the kept folder"
reset
route GET 'https://asc.test/v1/apps?filter*' 200 app.json
"$script" testflight --archive "$kept" >"$tmp/out" 2>&1 || fail "testflight --archive: $(cat "$tmp/out")"
grep -q ' archive ' "$tmp/xcodebuild.log" && fail "--archive archived again"
grep -q "^-exportArchive -archivePath $kept " "$tmp/xcodebuild.log" || fail "--archive's export: $(cat "$tmp/xcodebuild.log")"
rm -rf "$(dirname "$kept")"
pass "a failed upload keeps its archive, and --archive uploads it"

reset
settings Manual TEAM123456
route GET 'https://asc.test/v1/apps?filter*' 200 app.json
if "$script" testflight --project "$project" --scheme Demo 2>/dev/null; then fail "testflight took a manually signed scheme"; fi
settings Automatic OTHERTEAM1
if "$script" testflight --project "$project" --scheme Demo 2>/dev/null; then fail "testflight took another team's scheme"; fi
[ ! -s "$tmp/curl.log" ] || [ -z "$(grep -v 'v1/apps' "$tmp/curl.log" || true)" ] || fail "it wrote to the API for a refused scheme"
pass "testflight refuses manual signing and another team"

if "$script" testflight --project "$project" --scheme Demo --platform macOS 2>/dev/null; then fail "took --platform macOS"; fi
if "$script" testflight --scheme Demo 2>/dev/null; then fail "took no project"; fi
pass "testflight checks its arguments"

reset
jq '. + [.[-1] | .buildSettings.PRODUCT_BUNDLE_IDENTIFIER = "dev.kylejs.other"]' "$tmp/settings.json" >"$tmp/two.json"
mv "$tmp/two.json" "$tmp/settings.json"
if out="$("$script" testflight --project "$project" --scheme Demo 2>&1)"; then fail "testflight picked one of two apps"; fi
case "$out" in *"dev.kylejs.demo, dev.kylejs.other"*) ;; *) fail "two-app message: $out" ;; esac
[ ! -s "$tmp/curl.log" ] || fail "it called the API for a scheme with two apps"
pass "testflight skips App Clips and watch apps, and stops at a scheme with two apps"

# --- adhoc --------------------------------------------------------------------------

echo '{"data":[{"id":"D1","attributes":{"name":"Kyle iPhone","deviceClass":"IPHONE"}},{"id":"D2","attributes":{"name":"Mac","deviceClass":"MAC"}}]}' >"$tmp/devices.json"
echo '{"data":[{"id":"D2","attributes":{"name":"Mac","deviceClass":"MAC"}}]}' >"$tmp/no-phones.json"
builds="$tmp/builds"
settings Automatic ""

reset
route GET 'https://asc.test/v1/devices?*' 200 devices.json
if out="$("$script" adhoc --project "$project" --scheme Demo 2>&1)"; then fail "adhoc ran with no builds folder"; fi
case "$out" in *"no $builds"*) ;; *) fail "no-folder message: $out" ;; esac
grep -q ' archive ' "$tmp/xcodebuild.log" && fail "adhoc archived with no builds folder"
mkdir -m 755 "$builds"
pass "adhoc stops before the build when the builds folder is missing"

reset
route GET 'https://asc.test/v1/devices?*' 200 no-phones.json
if out="$("$script" adhoc --project "$project" --scheme Demo 2>&1)"; then fail "adhoc ran with no registered iPhone"; fi
case "$out" in *"register-device"*) ;; *) fail "no-device message: $out" ;; esac
grep -q ' archive ' "$tmp/xcodebuild.log" && fail "adhoc archived with no registered iPhone"
grep -q 'filter\[platform\]=IOS&filter\[status\]=ENABLED' "$tmp/curl.log" || fail "the devices query: $(cat "$tmp/curl.log")"
pass "adhoc stops before the build when no iPhone or iPad is registered"

if "$script" adhoc --project "$project" --scheme Demo --platform tvOS 2>/dev/null; then fail "adhoc took tvOS"; fi
pass "adhoc refuses platforms other than iOS"

# A build: archived, exported for release testing with no upload, and
# published under a random folder name.
reset
route GET 'https://asc.test/v1/devices?*' 200 devices.json
"$script" adhoc --project "$project" --scheme Demo >"$tmp/out" 2>"$tmp/err" || fail "adhoc: $(cat "$tmp/err")"
grep -q "^archive -project $project -scheme Demo -configuration Release -destination generic/platform=iOS -archivePath .* $auth DEVELOPMENT_TEAM=TEAM123456$" "$tmp/xcodebuild.log" ||
  fail "adhoc's archive call: $(cat "$tmp/xcodebuild.log")"
grep -q "^-exportArchive .* $auth$" "$tmp/xcodebuild.log" || fail "adhoc's export call: $(cat "$tmp/xcodebuild.log")"
for want in '<string>release-testing</string>' '<string>export</string>' '<string>automatic</string>' '<string>TEAM123456</string>'; do
  grep -qF "$want" "$tmp/export-options.plist" || fail "adhoc's export options lack $want"
done
grep -qF 'upload' "$tmp/export-options.plist" && fail "adhoc's export options upload"
grep -qF 'app-store-connect' "$tmp/export-options.plist" && fail "adhoc's export options use the App Store method"
python3 -c 'import plistlib, sys; plistlib.load(open(sys.argv[1], "rb"))' "$tmp/export-options.plist" || fail "adhoc's export options are not a plist"
link="$(cat "$tmp/out")"
id="$(printf '%s' "$link" | sed -n 's|^https://builds\.test/\([0-9a-f]\{32\}\)/$|\1|p')"
[ -n "$id" ] || fail "adhoc printed $link, not one link to a random folder"
dir="$builds/$id"
[ "$(ls -A "$builds")" = "$id" ] || fail "the builds folder holds $(ls -A "$builds"), not just the build"
[ "$(cat "$dir/app.ipa")" = "ipa 1" ] || fail "app.ipa is not the exported .ipa"
for f in app.ipa manifest.plist index.html; do
  [ "$(stat -c %a "$dir/$f")" = 644 ] || fail "$f is $(stat -c %a "$dir/$f"), not 644"
done
[ "$(stat -c %a "$dir")" = 755 ] || fail "the build's folder is $(stat -c %a "$dir"), not 755"
python3 - "$dir/manifest.plist" "$id" <<'EOF' || fail "manifest.plist: $(cat "$dir/manifest.plist")"
import plistlib, sys
item = plistlib.load(open(sys.argv[1], "rb"))["items"][0]
assert item["assets"] == [{"kind": "software-package", "url": "https://builds.test/%s/app.ipa" % sys.argv[2]}], item["assets"]
assert item["metadata"] == {"bundle-identifier": "dev.kylejs.demo", "bundle-version": "1.2",
                            "kind": "software", "title": "Demo & <Co>"}, item["metadata"]
EOF
grep -qF "href=\"itms-services://?action=download-manifest&amp;url=https://builds.test/$id/manifest.plist\"" "$dir/index.html" ||
  fail "index.html has no install link: $(cat "$dir/index.html")"
grep -qF '<h1>Demo &amp; &lt;Co&gt;</h1>' "$dir/index.html" || fail "index.html does not escape the app's name"
grep -qF '1.2 (34)' "$dir/index.html" || fail "index.html lacks the version"
grep -q 'stops working after 7 days' "$tmp/err" || fail "adhoc does not say when the link stops working: $(cat "$tmp/err")"
[ -z "$(ls -A "$TMPDIR")" ] || fail "adhoc left $(ls -A "$TMPDIR") behind"
pass "adhoc exports for release testing, uploads nothing and publishes the .ipa, manifest and page under a random name"

reset
route GET 'https://asc.test/v1/devices?*' 200 devices.json
OLD_XCODE=1 "$script" adhoc --project "$project" --scheme Demo >"$tmp/out" 2>"$tmp/err" || fail "adhoc on an old Xcode: $(cat "$tmp/err")"
grep -qF '<string>ad-hoc</string>' "$tmp/export-options.plist" || fail "an Xcode without release-testing did not get ad-hoc"
id2="$(sed -n 's|^https://builds\.test/\([0-9a-f]\{32\}\)/$|\1|p' "$tmp/out")"
[ -n "$id2" ] && [ "$id2" != "$id" ] || fail "a second build did not get a new folder: $(cat "$tmp/out")"
pass "an Xcode from before the rename gets the ad-hoc method, and each build its own folder"

# A failed export keeps the archive for --archive and publishes nothing.
reset
rm -rf "${builds:?}"/*
route GET 'https://asc.test/v1/devices?*' 200 devices.json
if EXPORT_STATUS=70 "$script" adhoc --project "$project" --scheme Demo >"$tmp/out" 2>"$tmp/err"; then fail "adhoc passed a failed export"; fi
grep -q 'provisioning error' "$tmp/err" || fail "the failed export does not say what a provisioning error means: $(cat "$tmp/err")"
[ -z "$(ls -A "$builds")" ] || fail "a failed export left $(ls -A "$builds")"
kept="$(sed -n 's/.*adhoc --archive \(.*\)$/\1/p' "$tmp/err")"
[ -n "$kept" ] && [ -d "$kept" ] || fail "no archive kept: $(cat "$tmp/err")"
reset
route GET 'https://asc.test/v1/devices?*' 200 devices.json
"$script" adhoc --archive "$kept" >"$tmp/out" 2>"$tmp/err" || fail "adhoc --archive: $(cat "$tmp/err")"
grep -q ' archive ' "$tmp/xcodebuild.log" && fail "adhoc --archive archived again"
grep -q "^-exportArchive -archivePath $kept " "$tmp/xcodebuild.log" || fail "adhoc --archive's export: $(cat "$tmp/xcodebuild.log")"
grep -q '^https://builds\.test/[0-9a-f]\{32\}/$' "$tmp/out" || fail "adhoc --archive printed $(cat "$tmp/out")"
rm -rf "$(dirname "$kept")"
pass "a failed export keeps its archive and publishes nothing, and --archive exports it"

reset
rm -rf "${builds:?}"/*
route GET 'https://asc.test/v1/devices?*' 200 devices.json
if EXPORT_IPAS=2 "$script" adhoc --project "$project" --scheme Demo >"$tmp/out" 2>"$tmp/err"; then fail "adhoc published one of two .ipa files"; fi
[ -z "$(ls -A "$builds")" ] || fail "an export with two .ipa files left $(ls -A "$builds")"
pass "adhoc publishes nothing when the export is not exactly one .ipa"

echo "all app-store checks passed"
