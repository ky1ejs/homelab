#!/bin/bash
# mac/ci/build-image - build the VM image the CI runners clone for each job.
# Run it as worker, in `worker-shell`, the first time and then monthly with
# the Xcode chore (docs/mac-studio.md, "iOS CI").
#
# It pulls Cirrus Labs' Xcode image for this Mac's macOS, boots a copy, runs
# ./image-setup in it and saves it as $CI_IMAGE, replacing the old one. Jobs
# already running keep their own clones; new jobs get the new image.
#
# Usage: build-image [--source <oci image>]
# The environment comes from the wrapper in mac/ci/default.nix: CI_IMAGE,
# CI_CPU, CI_MEMORY_MB, XCODE_VERSION, XCODEGEN_VERSION, APOLLO_CLI_VERSION,
# PERIPHERY_VERSION, PERIPHERY_SHA256, CI_IMAGE_SETUP, CI_SLOTS, CI_DRAIN.
#
# macOS runs at most two macOS VMs at once, and each runner slot keeps one
# booted while it waits for a job. So before booting, it drains the last slot
# (./drain): that slot finishes any job, deletes its VM and parks. The other
# slot keeps taking jobs. The slot takes jobs again when this exits, however
# it exits; if this is killed outright, the drain request runs out by itself.
set -euo pipefail

: "${CI_IMAGE:?}" "${CI_CPU:?}" "${CI_MEMORY_MB:?}" "${XCODE_VERSION:?}"
: "${XCODEGEN_VERSION:?}" "${APOLLO_CLI_VERSION:?}" "${CI_IMAGE_SETUP:?}"
: "${PERIPHERY_VERSION:?}" "${PERIPHERY_SHA256:?}"
: "${CI_SLOTS:?}" "${CI_DRAIN:?}"

die() { echo "build-image: $*" >&2; exit 1; }

[ "$(id -un)" = worker ] || die "run this as worker (ssh -t ms worker-shell): the runners use worker's ~/.tart"

source=""
case "${1:-}" in
  --source) source="${2:?--source needs an image}" ;;
  "") ;;
  *) die "usage: build-image [--source <oci image>]" ;;
esac

# The guest's macOS must not be newer than the host's.
if [ -z "$source" ]; then
  major="$(sw_vers -productVersion | cut -d. -f1)"
  case "$major" in
    26) name=tahoe ;;
    27) name=golden-gate ;;
    *) die "no Cirrus Labs image name known for macOS $major: pass --source" ;;
  esac
  source="ghcr.io/cirruslabs/macos-${name}-xcode:${XCODE_VERSION}"
fi

new="${CI_IMAGE}-new"
# A local VM is a folder in Tart's home. `tart list` would also read each
# disk's size, which fails while any VM runs, so it can't answer this.
vm_exists() {
  [ -f "${TART_HOME:-$HOME/.tart}/vms/$1/config.json" ]
}

echo "== pulling $source"
tart pull "$source"

if vm_exists "$new"; then
  tart stop "$new" >/dev/null 2>&1 || true
  tart delete "$new"
fi
tart clone "$source" "$new"
tart set "$new" --cpu "$CI_CPU" --memory "$CI_MEMORY_MB"

# The slot this borrows. The wait is longer than the runner's own job limit
# (CI_MAX_JOB_SECONDS, 2 hours), so a job is never cut short. A drain request
# lasts its wait plus 5 minutes, so once the slot is parked a second request
# restarts that clock for the boot and setup below; asking a parked slot
# returns at once.
slot="dev.kylejs.ci-runner-$CI_SLOTS"
drain_minutes=150
hold_minutes=120
echo "== freeing runner slot $CI_SLOTS: macOS runs two macOS VMs at most"
release_slot() { "$CI_DRAIN" release "$slot" || true; }
trap release_slot EXIT
"$CI_DRAIN" wait "$slot" "$drain_minutes" || die "slot $CI_SLOTS still had a job after $drain_minutes minutes"
"$CI_DRAIN" wait "$slot" "$hold_minutes" || die "slot $CI_SLOTS took a job before its VM could be borrowed"

echo "== booting $new"
tart run --no-graphics "$new" &
vm_pid=$!
cleanup() {
  tart stop "$new" >/dev/null 2>&1 || kill "$vm_pid" 2>/dev/null || true
  wait "$vm_pid" 2>/dev/null || true
}
trap 'cleanup; release_slot' EXIT

waited=0
until tart exec "$new" /usr/bin/true >/dev/null 2>&1; do
  kill -0 "$vm_pid" 2>/dev/null || die "$new exited while booting"
  waited=$((waited + 5))
  [ "$waited" -le 300 ] || die "$new's guest agent did not answer in 5 minutes"
  sleep 5
done

echo "== setting up $new"
remote="exec env XCODE_VERSION=$(printf %q "$XCODE_VERSION") XCODEGEN_VERSION=$(printf %q "$XCODEGEN_VERSION") APOLLO_CLI_VERSION=$(printf %q "$APOLLO_CLI_VERSION")"
remote+=" PERIPHERY_VERSION=$(printf %q "$PERIPHERY_VERSION") PERIPHERY_SHA256=$(printf %q "$PERIPHERY_SHA256") /bin/bash -s"
tart exec -i "$new" /bin/zsh -l -c "$remote" <"$CI_IMAGE_SETUP"

cleanup
trap release_slot EXIT

if vm_exists "$CI_IMAGE"; then
  tart delete "$CI_IMAGE"
fi
tart rename "$new" "$CI_IMAGE"
# The pulled copy is not needed once the image is built from it.
tart delete "$source" 2>/dev/null || true

echo "== $CI_IMAGE is ready, from $source"
