#!/bin/bash
# mac/ci/drain - park a runner slot, letting any job finish first, before an
# apply restarts it or build-image borrows its VM. The activation script runs
# it for each slot whose plist an apply changes (mac/claude/default.nix), and
# ./build-image for the last slot. On PATH as ci-drain, also by hand.
#
#   ci-drain wait <label> <minutes> [holder]  stop the slot taking new jobs,
#                     then wait until it has no job. Exits 0 once it is parked
#                     or failed, 1 after <minutes>, when it drops the request.
#   ci-drain hold <label> <minutes> <holder>  renew a request without waiting.
#   ci-drain release <label> [holder]         drop the request.
#
# <label> is the slot's launchd label, dev.kylejs.ci-runner-<slot>.
#
# A request is a file in ~/Library/Caches/ci holding the epoch until which
# ./runner takes no new job: the end of the wait plus 5 minutes. The apply's
# is drain-<slot>; a named holder's is drain-<slot>.<holder>. The runner parks
# while any of them is live, and release removes only the caller's own, so an
# apply and build-image never drop each other's request. A request ends by
# itself at its deadline, so a holder cut off (Ctrl-C, a dropped SSH session)
# leaves no slot parked for long. ./runner writes its phase beside them;
# `parked` and `failed` mean no job and no runner registered with GitHub.
#
# The rest comes from the environment, set by mac/ci/default.nix: CI_STATE,
# CI_IMAGE, TART_HOME.
# macOS's /bin/bash is 3.2, so no bash 4 features.
set -euo pipefail

usage() { sed -n '7,11p' "$0" | sed 's/^# \{0,1\}//'; }

action="${1:-}"
label="${2:-}"
case "$action" in
  -h | --help)
    usage
    exit 0
    ;;
  wait | hold | release) ;;
  *)
    usage >&2
    exit 2
    ;;
esac
: "${CI_STATE:?}" "${CI_IMAGE:?}" "${TART_HOME:?}"

slot="${label#dev.kylejs.ci-runner-}"
case "$slot" in
  '' | *[!0-9]*)
    echo "ci-drain: '$label' is not a runner slot's label" >&2
    usage >&2
    exit 2
    ;;
esac
name="ci-runner-$slot"
case "$action" in
  release) holder="${3:-}" ;;
  *) holder="${4:-}" ;;
esac
case "$holder" in
  *[!a-z0-9-]*)
    echo "ci-drain: a holder is lower-case letters, digits and hyphens" >&2
    exit 2
    ;;
esac
if [ -n "$holder" ]; then
  drain_file="$CI_STATE/drain-$slot.$holder"
else
  drain_file="$CI_STATE/drain-$slot"
fi
phase_file="$CI_STATE/runner-$slot.phase"

release() { rm -f "$drain_file"; }

# Through a temporary file whose name ./runner never reads, so it never sees
# half a number.
request_until() {
  local tmp="$CI_STATE/.request-$slot.$$"
  mkdir -p "$CI_STATE"
  printf '%s\n' "$1" >"$tmp"
  mv -f "$tmp" "$drain_file"
}

minutes_arg() {
  case "$2" in
    '' | *[!0-9]*)
      echo "ci-drain: $1 needs a number of minutes" >&2
      usage >&2
      exit 2
      ;;
  esac
  minutes="$2"
}

# A runner from before draining (2026-11-14) writes no phase file. Then the
# VM decides: Runner.Worker runs only while a job does. If tart exec fails,
# count the slot as busy: waiting too long beats killing a deploy.
legacy_idle() {
  local vm="$CI_IMAGE-$slot" status=0
  [ -f "$TART_HOME/vms/$vm/config.json" ] || return 0
  tart exec "$vm" /usr/bin/pgrep -q -f Runner.Worker >/dev/null 2>&1 || status=$?
  [ "$status" -eq 1 ]
}

safe_to_restart() {
  local phase=""
  [ -f "$phase_file" ] || {
    legacy_idle
    return
  }
  read -r phase _ <"$phase_file" || true
  case "$phase" in
    parked | failed) return 0 ;;
    *) return 1 ;;
  esac
}

case "$action" in
  release)
    release
    ;;
  hold)
    minutes_arg hold "${3:-}"
    [ -n "$holder" ] || { echo "ci-drain: hold needs a holder" >&2; exit 2; }
    request_until $(($(date +%s) + minutes * 60))
    ;;
  wait)
    minutes_arg wait "${3:-}"
    started="$(date +%s)"
    give_up=$((started + minutes * 60))
    request_until $((give_up + 300))

    if [ -n "$holder" ]; then
      lever="launchctl kickstart -k gui/\$(id -u)/$label stops its job now"
    else
      lever="mac/apply --no-wait restarts the slots at once and kills their jobs"
    fi
    next_note=0
    until safe_to_restart; do
      now="$(date +%s)"
      if [ "$next_note" -eq 0 ]; then
        echo "$name: waiting for its job, if it has one, to finish (up to $minutes minutes; $lever)" >&2
        next_note=$((started + 60))
      fi
      if [ "$now" -ge "$give_up" ]; then
        release
        echo "$name: still busy after $minutes minutes, so it takes jobs again" >&2
        exit 1
      fi
      if [ "$now" -ge "$next_note" ]; then
        echo "$name: still busy after $(((now - started) / 60)) minutes" >&2
        next_note=$((next_note + 60))
      fi
      sleep 5
    done
    echo "$name: no job running" >&2
    ;;
esac
