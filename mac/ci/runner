#!/bin/bash
# mac/ci/runner - run one GitHub Actions job in a fresh Tart VM, then delete
# the VM. launchd runs one copy per slot, in worker's session, and starts it
# again when it exits, so each slot takes one job after another.
#
# One run:
# 1. Checks the disk has room and the image and GitHub App files exist.
# 2. Deletes this slot's VM if a crash left one behind, clones the image to it
#    and boots it headless on Softnet, so it reaches the internet but not the
#    LAN, the tailnet or the other VM. Beside it, it boots a Linux VM cloned
#    from the services image, also on Softnet, which serves Docker for the
#    job (see "Docker for the job" below).
# 3. Once the VM's guest agent answers, copies this slot's SwiftPM cache into
#    it, so the job's package resolve fetches only what changed instead of
#    cloning every package again.
# 4. Asks GitHub for a just-in-time runner config in the org's runner group.
#    That runner takes one job and is gone.
# 5. Runs the runner in the VM until its job ends, copies the VM's SwiftPM
#    cache back for the next job, then stops and deletes both VMs, and
#    removes the runner from GitHub if it never took a job.
#
# Docker for the job. macOS guests can't run Docker: Apple's Virtualization
# framework has no nested virtualization for them. So the Linux VM runs it,
# and the CI VM reaches it in two hops, because Softnet lets the CI VM reach
# no private address but the bridge's gateway, the Mac itself:
# - on the Mac, one socat per port listens on the gateway address, slot N's
#   copy of port P on N * 10000 + P, takes connections only from this slot's
#   CI VM, whose address Softnet stops it faking, and forwards them to the
#   Linux VM's port P;
# - in the CI VM, two socats per port listen on 127.0.0.1:P and [::1]:P and
#   forward to the gateway's N * 10000 + P.
# The ports are Docker's API (2375) and those Cut's Compose file publishes
# (CI_SERVICES_PORTS). The job's environment gets DOCKER_HOST=tcp://
# 127.0.0.1:2375, so `docker compose` runs its containers in the Linux VM and
# they answer on the job's localhost, as on a laptop. Docker is a convenience,
# not a requirement: if the Linux VM or a forwarder fails, the job runs
# without it, and Cut's end-to-end job skips with a warning.
#
# An apply that changes a slot's plist drains the slot first (./drain): the
# slot takes no new job, a job already running finishes, and only then does
# the apply restart it. build-image drains the last slot the same way to
# borrow its VM. While draining:
# - at the start of a run, it parks, taking no job, until the request ends;
# - with a VM booted but no runner registered yet, it deletes the VM and
#   exits, so its next run parks;
# - with a runner registered, it asks GitHub whether the runner has a job. An
#   idle runner it removes from GitHub, then stops the VM. A busy one it
#   leaves to finish its job, and its next run parks.
# It writes where it is to ~/Library/Caches/ci/runner-<slot>.phase, which
# ./drain reads: `parked` and `failed` are safe to restart.
#
# Usage: runner <slot>. The rest comes from the environment, set by
# mac/ci/default.nix: CI_ORG, CI_GROUP, CI_LABEL, CI_IMAGE, CI_CPU,
# CI_MEMORY_MB, CI_MIN_FREE_GB, CI_MAX_JOB_SECONDS, CI_SERVICES_IMAGE,
# CI_SERVICES_CPU, CI_SERVICES_MEMORY_MB, CI_SERVICES_PORTS.
#
# Files in worker's home, outside this repo (docs/mac-studio.md, "iOS CI"):
# - ~/.config/ci/github-app-client-id: the GitHub App's client ID;
# - ~/.config/ci/github-app.pem: its private key, mode 600.
#
# It writes this slot's last result to ~/Library/Caches/ci/runner-<slot>.status
# for ./heartbeat, and keeps the slot's SwiftPM cache in
# ~/Library/Caches/ci/swiftpm-<slot>. Deleting that folder resets the cache.
# macOS's /bin/bash is 3.2, so no bash 4 features.
#
# Logs, in ~/Library/Logs:
# - ci-runner-<slot>.log: this script's own lines (launchd sends stdout there);
# - ci-vm-<slot>.log: Tart's and Softnet's output, each line timestamped;
# - ci-net-<slot>.log: Softnet's CPU and memory and the Mac's load every 30
#   seconds while the VM runs, to match a slow download in a job to them;
# - ci-services-<slot>.log: the Linux VM's Tart and Softnet output, and the
#   forwarders' errors, each line timestamped.
set -euo pipefail

slot="${1:?usage: runner <slot>}"
: "${CI_ORG:?}" "${CI_GROUP:?}" "${CI_LABEL:?}" "${CI_IMAGE:?}"
: "${CI_CPU:?}" "${CI_MEMORY_MB:?}" "${CI_MIN_FREE_GB:?}" "${CI_MAX_JOB_SECONDS:?}"
: "${CI_SERVICES_IMAGE:?}" "${CI_SERVICES_CPU:?}" "${CI_SERVICES_MEMORY_MB:?}" "${CI_SERVICES_PORTS:?}"

conf="$HOME/.config/ci"
state="$HOME/Library/Caches/ci"
vm="${CI_IMAGE}-${slot}"
svc_vm="${CI_SERVICES_IMAGE}-${slot}"
svc_log="$HOME/Library/Logs/ci-services-$slot.log"
status_file="$state/runner-$slot.status"
# ./drain's requests: each holds the epoch until which this slot takes no new
# job. The apply's is drain-<slot>; a named holder's (build-image's) is
# drain-<slot>.<holder>. Any live one parks the slot.
phase_file="$state/runner-$slot.phase"
# Written when this run removed its idle runner for a drain.
drained_file="$state/drained-$slot"
# The slot's SwiftPM cache. Tart shares it with the VM, which sees it at
# $guest_share. The VM copies it to and from its own disk rather than using it
# in place, so git never works over the share.
cache_dir="$state/swiftpm-$slot"
# The copy goes in a folder inside the share: the VM may not set the share's
# own times, and rsync fails when it can't.
guest_share="/Volumes/My Shared Files/swiftpm"
guest_store="$guest_share/cache"
# shellcheck disable=SC2016 # $HOME expands in the VM's shell.
guest_cache='$HOME/Library/Caches/org.swift.swiftpm'
api_url="https://api.github.com"

mkdir -p "$state" "$cache_dir"
chmod 700 "$state"

log() { printf '%s slot %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$slot" "$*"; }

# Prefixes each line it reads with the UTC time.
stamp() {
  local line
  while IFS= read -r line; do
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line"
  done
}

# Where this run is, for ./drain: parked, starting, registered, saving, failed.
set_phase() { printf '%s %s\n' "$1" "$(date +%s)" >"$phase_file"; }

drain_requested() {
  local f deadline now
  now="$(date +%s)"
  for f in "$state/drain-$slot" "$state/drain-$slot".*; do
    deadline="$(cat "$f" 2>/dev/null)" || continue
    case "$deadline" in '' | *[!0-9]*) continue ;; esac
    [ "$now" -ge "$deadline" ] || return 0
  done
  return 1
}

# Every 30 seconds, logs this VM's Softnet CPU and memory and the Mac's load.
# Tart starts Softnet through sudo, so it is Tart's child or, while sudo waits
# on it, its grandchild.
sample_softnet() {
  local sudo_pid softnet_pid
  while kill -0 "$vm_pid" 2>/dev/null; do
    softnet_pid="$(pgrep -P "$vm_pid" softnet | head -n 1 || true)"
    if [ -z "$softnet_pid" ]; then
      sudo_pid="$(pgrep -P "$vm_pid" sudo | head -n 1 || true)"
      [ -z "$sudo_pid" ] || softnet_pid="$(pgrep -P "$sudo_pid" softnet | head -n 1 || true)"
    fi
    if [ -n "$softnet_pid" ]; then
      printf '%s softnet pid %s cpu %s%% rss %s KB, load %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$softnet_pid" \
        "$(ps -o %cpu= -p "$softnet_pid" | tr -d ' ')" \
        "$(ps -o rss= -p "$softnet_pid" | tr -d ' ')" \
        "$(sysctl -n vm.loadavg | tr -d '{}' | awk '{ print $1, $2, $3 }')"
    else
      printf '%s softnet not running\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi
    sleep 30
  done
}

# Records the error for the heartbeat, then waits before exiting, so launchd
# does not restart a slot that cannot work every 10 seconds.
fail() {
  log "error: $*"
  set_phase failed
  printf 'error %s %s\n' "$(date +%s)" "$*" >"$status_file"
  sleep 120
  exit 1
}

# Runs a command, and kills it if it runs longer than $1 seconds. Returns the
# command's status, or 143 when it was killed. The command must be a program,
# not a function, so the kill reaches it.
with_timeout() {
  local seconds="$1" pid killer status
  shift
  "$@" &
  pid=$!
  ( sleep "$seconds"; kill "$pid" 2>/dev/null ) &
  killer=$!
  wait "$pid" && status=0 || status=$?
  kill "$killer" 2>/dev/null || true
  wait "$killer" 2>/dev/null || true
  return "$status"
}

# Runs a shell command in the VM. $HOME there is the VM's admin user's.
in_vm() { tart exec "$vm" /bin/sh -c "$1"; }
rsync_in_vm() { with_timeout 600 tart exec "$vm" /bin/sh -c "$1"; }

# A local VM is a folder in Tart's home. `tart list` would also read each
# disk's size, which fails while any VM runs, so it can't answer this.
vm_exists() {
  [ -f "${TART_HOME:-$HOME/.tart}/vms/$1/config.json" ]
}

# Slot N's port on the gateway for port P of the Linux VM.
host_port() { echo $((slot * 10000 + $1)); }

# Boots this slot's Linux VM. Any failure here is a warning: the job runs
# without Docker. Sets svc_pid.
start_services_vm() {
  if ! vm_exists "$CI_SERVICES_IMAGE"; then
    log "warning: no $CI_SERVICES_IMAGE image (build-services-image in worker-shell): no Docker for this job"
    return 1
  fi
  if ! { tart clone "$CI_SERVICES_IMAGE" "$svc_vm" &&
    tart set "$svc_vm" --cpu "$CI_SERVICES_CPU" --memory "$CI_SERVICES_MEMORY_MB"; }; then
    log "warning: could not clone $CI_SERVICES_IMAGE: no Docker for this job"
    return 1
  fi
  printf '%s booting %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$svc_vm" >>"$svc_log"
  tart run --no-graphics --net-softnet "$svc_vm" > >(stamp >>"$svc_log") 2>&1 &
  svc_pid=$!
}

# Once both VMs are up: waits for the Linux VM's Docker, starts the Mac's
# forwarders, and sets svc_ready to the gateway address the CI VM's own
# forwarders point at. Returns 1, with a warning, if any of it fails.
connect_services() {
  local ci_ip svc_ip iface gw port pid waited
  [ -n "$svc_pid" ] || return 1
  ci_ip="$(tart ip --wait 60 "$vm" 2>/dev/null)" || { log "warning: no address for $vm: no Docker for this job"; return 1; }
  svc_ip="$(tart ip --wait 120 "$svc_vm" 2>/dev/null)" || { log "warning: no address for $svc_vm: no Docker for this job"; return 1; }
  # The bridge both VMs are on, and the Mac's address on it.
  iface="$(route -n get "$ci_ip" 2>/dev/null | awk '/interface:/ { print $2 }')"
  gw="$(ipconfig getifaddr "$iface" 2>/dev/null)" || true
  [ -n "$gw" ] || { log "warning: no host address on the bridge to $ci_ip ($iface): no Docker for this job"; return 1; }
  waited=0
  until curl -fsS --max-time 3 "http://$svc_ip:2375/_ping" >/dev/null 2>&1; do
    kill -0 "$svc_pid" 2>/dev/null || { log "warning: $svc_vm exited while booting (ci-services-$slot.log): no Docker for this job"; return 1; }
    waited=$((waited + 3))
    [ "$waited" -le 120 ] || { log "warning: Docker in $svc_vm did not answer in 2 minutes: no Docker for this job"; return 1; }
    sleep 3
  done
  # -t: once one side closes its half, socat waits this long for the other
  # side's rest before closing both. Its default, half a second, cuts off a
  # `docker exec` whose client closes its stdin first, as a step's does.
  for port in $CI_SERVICES_PORTS; do
    socat -t 3600 "TCP-LISTEN:$(host_port "$port"),bind=$gw,reuseaddr,fork,range=$ci_ip/32" "TCP:$svc_ip:$port" \
      2> >(stamp >>"$svc_log") &
    forwarder_pids="$forwarder_pids $!"
  done
  # A forwarder that could not bind exits at once.
  sleep 1
  for pid in $forwarder_pids; do
    kill -0 "$pid" 2>/dev/null || { log "warning: a forwarder on $gw did not start (ci-services-$slot.log): no Docker for this job"; return 1; }
  done
  log "Docker for the job: $svc_vm at $svc_ip, through $gw for $ci_ip"
  svc_ready="$gw"
}

# Called with errexit on (`connect_services || stop_services`), on the paths
# where a forwarder or the VM has already died, so nothing here may fail. The
# VM is thrown away, so it gets 2 seconds to shut down, not Tart's 30: the
# whole cleanup must fit launchd's ExitTimeOut.
stop_services() {
  local pid
  for pid in $forwarder_pids; do kill "$pid" 2>/dev/null || true; done
  forwarder_pids=""
  if [ -n "$svc_pid" ]; then
    tart stop --timeout 2 "$svc_vm" >/dev/null 2>&1 || kill "$svc_pid" 2>/dev/null || true
    wait "$svc_pid" 2>/dev/null || true
    svc_pid=""
  fi
  if vm_exists "$svc_vm"; then tart delete "$svc_vm" || log "warning: could not delete $svc_vm"; fi
  return 0
}

# 0. An apply is waiting to restart this slot, or build-image is borrowing its
# VM: take no job until the request ends. A request ends by itself at its
# deadline, so a holder cut off mid-wait leaves the slot taking jobs again.
if drain_requested; then
  log "a drain request holds this slot (an apply or build-image): taking no job until it ends"
  while drain_requested; do
    set_phase parked
    sleep 5
  done
  log "the drain request ended: carrying on"
fi
set_phase starting
rm -f "$drained_file"

# 1. Room and files.
free_gb="$(df -g "$HOME" | awk 'NR == 2 { print $4 }')"
if [ "$free_gb" -lt "$CI_MIN_FREE_GB" ]; then
  fail "only ${free_gb} GB free, under ${CI_MIN_FREE_GB} GB"
fi
vm_exists "$CI_IMAGE" || fail "no $CI_IMAGE image: run build-image in worker-shell"
[ -s "$conf/github-app-client-id" ] || fail "no $conf/github-app-client-id"
[ -s "$conf/github-app.pem" ] || fail "no $conf/github-app.pem"

# GitHub API calls. The Authorization header goes in a file, not on curl's
# command line, which any user on the Mac can read with ps.
auth_file="$state/auth-$slot"
umask 077
api() {
  curl -fsS --max-time 30 --retry 3 --retry-all-errors \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -H @"$auth_file" "$@"
}

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# An installation token for the App, limited to the org's self-hosted
# runners. The App's JWT lasts 9 minutes and the token an hour, so each run
# makes its own.
github_login() {
  local client_id now header payload sig installation token
  client_id="$(tr -d '[:space:]' <"$conf/github-app-client-id")"
  now="$(date +%s)"
  header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$client_id" | b64url)"
  sig="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$conf/github-app.pem" -binary | b64url)"
  printf 'Authorization: Bearer %s.%s.%s\n' "$header" "$payload" "$sig" >"$auth_file"

  installation="$(api "$api_url/app/installations" |
    jq -r --arg o "$CI_ORG" '.[] | select(.account.login == $o) | .id')"
  [ -n "$installation" ] || return 1
  token="$(api -X POST "$api_url/app/installations/$installation/access_tokens" \
    -d '{"permissions":{"organization_self_hosted_runners":"write"}}' | jq -r .token)"
  [ -n "$token" ] && [ "$token" != null ] || return 1
  printf 'Authorization: Bearer %s\n' "$token" >"$auth_file"
}

# While the runner waits, a drain request removes it from GitHub, if it has
# no job, and stops the VM. GitHub's `busy` says whether it has one. A job
# assigned between that check and the DELETE would be lost, a window of about
# a second; GitHub is said to refuse to remove a busy runner, which would
# close it (not tested here). Logs in again before the hour-long token runs
# out.
watch_for_drain() {
  local busy
  while sleep 10; do
    drain_requested || continue
    if [ $(($(date +%s) - login_at)) -gt 3000 ]; then
      github_login || continue
      login_at="$(date +%s)"
    fi
    busy="$(api "$api_url/orgs/$CI_ORG/actions/runners/$runner_id" | jq -r .busy)" || continue
    if [ "$busy" != false ]; then
      sleep 20
      continue
    fi
    if api -X DELETE "$api_url/orgs/$CI_ORG/actions/runners/$runner_id" >/dev/null 2>&1; then
      touch "$drained_file"
      log "a drain request holds this slot: removed idle runner $name, stopping $vm"
      tart stop "$vm" >/dev/null 2>&1 || true
      return 0
    fi
  done
}

runner_id=""
vm_pid=""
svc_pid=""
svc_ready=""
forwarder_pids=""
watchdog_pid=""
sampler_pid=""
drain_watch_pid=""
# Set while the cache folder may be half written; cleanup then deletes it, so
# the next job starts with no cache rather than a broken one.
drop_cache=""
cleanup() {
  set +e
  [ -n "$watchdog_pid" ] && kill "$watchdog_pid" 2>/dev/null
  [ -n "$sampler_pid" ] && kill "$sampler_pid" 2>/dev/null
  [ -n "$drain_watch_pid" ] && kill "$drain_watch_pid" 2>/dev/null
  if [ -n "$vm_pid" ]; then
    tart stop "$vm" >/dev/null 2>&1 || kill "$vm_pid" 2>/dev/null
    wait "$vm_pid" 2>/dev/null
  fi
  vm_exists "$vm" && tart delete "$vm"
  stop_services
  if [ -n "$drop_cache" ]; then
    log "deleting the SwiftPM cache: $drop_cache"
    rm -rf "$cache_dir"
  fi
  # A runner that ran its job has already removed itself, and this is a 404.
  if [ -n "$runner_id" ]; then
    api -X DELETE "$api_url/orgs/$CI_ORG/actions/runners/$runner_id" >/dev/null 2>&1
  fi
  rm -f "$auth_file"
}
trap cleanup EXIT
trap 'exit 143' TERM INT

# 2. Fresh VMs.
for v in "$vm" "$svc_vm"; do
  if vm_exists "$v"; then
    log "deleting $v, left by an earlier run"
    tart stop "$v" >/dev/null 2>&1 || true
    tart delete "$v"
  fi
done
start_services_vm || true
tart clone "$CI_IMAGE" "$vm"
tart set "$vm" --cpu "$CI_CPU" --memory "$CI_MEMORY_MB"
log "booting $vm"
vm_log="$HOME/Library/Logs/ci-vm-$slot.log"
net_log="$HOME/Library/Logs/ci-net-$slot.log"
printf '%s booting %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$vm" | tee -a "$net_log" >>"$vm_log"
# Process substitution, not a pipe, so $! is Tart's PID rather than stamp's.
tart run --no-graphics --net-softnet --dir "swiftpm:$cache_dir" "$vm" > >(stamp >>"$vm_log") 2>&1 &
vm_pid=$!
sample_softnet >>"$net_log" 2>&1 &
sampler_pid=$!

waited=0
until tart exec "$vm" /usr/bin/true >/dev/null 2>&1; do
  kill -0 "$vm_pid" 2>/dev/null || fail "$vm exited while booting (ci-vm-$slot.log)"
  waited=$((waited + 5))
  [ "$waited" -le 300 ] || fail "$vm's guest agent did not answer in 5 minutes"
  sleep 5
done

# 3. The SwiftPM cache. Any failure here leaves the job to resolve packages
# from scratch, as it would with no cache.
waited=0
until in_vm "test -d '$guest_share'" >/dev/null 2>&1; do
  waited=$((waited + 5))
  [ "$waited" -le 60 ] || break
  sleep 5
done
started="$(date +%s)"
if [ "$waited" -gt 60 ]; then
  log "warning: $guest_share did not appear in $vm: no SwiftPM cache for this job"
else
  rsync_in_vm "mkdir -p \"\$HOME/Library/Caches\" && { [ ! -d '$guest_store' ] || /usr/bin/rsync -a --delete '$guest_store/' \"$guest_cache/\"; }" &&
    status=0 || status=$?
  if [ "$status" -eq 0 ]; then
    log "SwiftPM cache copied in ($(du -sh "$cache_dir" | awk '{ print $1 }')) in $(($(date +%s) - started)) seconds"
  elif [ "$status" -eq 143 ]; then
    # The copy may still be running in the VM, so this VM can't be trusted
    # to start clean. Give up on it, and on the cache.
    drop_cache="copying it in took over 10 minutes"
    fail "copying the SwiftPM cache into $vm took over 10 minutes"
  else
    log "warning: copying the SwiftPM cache in failed ($status): no cache for this job"
    in_vm "rm -rf \"$guest_cache\"" || fail "could not clear $vm's SwiftPM cache"
  fi
fi

# Docker for the job, or a warning and none.
connect_services || stop_services

# 4. A one-job runner in the org's runner group, unless an apply is waiting
# to restart this slot. Then the VM goes, and the next run parks.
if drain_requested; then
  log "a drain request holds this slot: deleting $vm instead of taking a job"
  exit 0
fi
github_login || fail "GitHub App sign-in failed: check the App is installed on $CI_ORG"
login_at="$(date +%s)"
group_id="$(api "$api_url/orgs/$CI_ORG/actions/runner-groups?per_page=100" |
  jq -r --arg g "$CI_GROUP" '.runner_groups[] | select(.name == $g) | .id')"
[ -n "$group_id" ] || fail "no runner group $CI_GROUP in $CI_ORG"

name="mac-studio-$slot-$(date +%Y%m%d%H%M%S)"
jit="$(jq -n --arg name "$name" --argjson group "$group_id" --arg label "$CI_LABEL" \
  '{name: $name, runner_group_id: $group, labels: [$label], work_folder: "_work"}' |
  api -X POST "$api_url/orgs/$CI_ORG/actions/runners/generate-jitconfig" -d @-)" ||
  fail "GitHub refused a runner config"
runner_id="$(jq -r .runner.id <<<"$jit")"
config="$(jq -r .encoded_jit_config <<<"$jit")"
unset jit

# A job that runs past every workflow's own timeout is stuck: stop the VM.
( sleep "$CI_MAX_JOB_SECONDS"; log "job over $CI_MAX_JOB_SECONDS seconds: stopping $vm"; tart stop "$vm" ) &
watchdog_pid=$!

# 5. The config goes in on stdin, not the command line. A login shell, so
# Homebrew's tools are on PATH as they are for a person at the VM. With
# Docker, the same shell first starts the VM's forwarders and adds
# DOCKER_HOST to the runner's .env, which the runner reads at start and puts
# in every step's environment. The forwarders live until the VM goes.
vm_prelude=""
if [ -n "$svc_ready" ]; then
  for port in $CI_SERVICES_PORTS; do
    # Both loopbacks: Cut's URLs say localhost, which macOS tries as ::1
    # first, and Docker on a laptop publishes on both.
    to="TCP:$svc_ready:$(host_port "$port")"
    vm_prelude="${vm_prelude}socat -t 3600 TCP-LISTEN:$port,bind=127.0.0.1,reuseaddr,fork $to </dev/null >/dev/null 2>&1 & "
    vm_prelude="${vm_prelude}socat -t 3600 TCP6-LISTEN:$port,bind=[::1],ipv6only=1,reuseaddr,fork $to </dev/null >/dev/null 2>&1 & "
  done
  vm_prelude="${vm_prelude}grep -v '^DOCKER_HOST=' ~/actions-runner/.env >~/actions-runner/.env.new; echo DOCKER_HOST=tcp://127.0.0.1:2375 >>~/actions-runner/.env.new; mv ~/actions-runner/.env.new ~/actions-runner/.env; "
  if ! tart exec "$vm" /bin/zsh -l -c 'command -v socat && command -v docker' >/dev/null 2>&1; then
    log "warning: $vm has no socat or docker (build-image again): no Docker for this job"
    vm_prelude=""
    stop_services
    svc_ready=""
  fi
fi
log "runner $name waiting for a job"
printf '%s runner %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" >>"$net_log"
printf 'ok %s waiting\n' "$(date +%s)" >"$status_file"
set_phase registered
watch_for_drain &
drain_watch_pid=$!
if printf '%s\n' "$config" |
  tart exec -i "$vm" /bin/zsh -l -c "read -r c; ${vm_prelude}cd ~/actions-runner && exec ./run.sh --jitconfig \"\$c\""; then
  log "runner $name finished"
  printf 'ok %s finished\n' "$(date +%s)" >"$status_file"
  kill "$drain_watch_pid" 2>/dev/null || true
  drain_watch_pid=""
  set_phase saving
  # Whatever the job resolved goes back for the next job on this slot. A VM
  # with no cache folder left the share untouched, so it stays as it was.
  if in_vm "test -d \"$guest_cache\"" && in_vm "test -d '$guest_share'"; then
    started="$(date +%s)"
    drop_cache="copying it back did not finish"
    if rsync_in_vm "mkdir -p '$guest_store' && /usr/bin/rsync -a --delete \"$guest_cache/\" '$guest_store/'"; then
      drop_cache=""
      log "SwiftPM cache copied back ($(du -sh "$cache_dir" | awk '{ print $1 }')) in $(($(date +%s) - started)) seconds"
    else
      log "warning: copying the SwiftPM cache back failed"
    fi
  fi
elif [ -e "$drained_file" ]; then
  # watch_for_drain removed the idle runner and stopped the VM.
  rm -f "$drained_file"
  runner_id=""
  exit 0
else
  # A failing job does not land here: run.sh exits 0 after any job. This is
  # the runner itself failing, or the watchdog stopping the VM.
  fail "runner $name exited with an error"
fi
