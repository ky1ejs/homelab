#!/bin/bash
# mac/ci/runner - run one GitHub Actions job in a fresh Tart VM, then delete
# the VM. launchd runs one copy per slot, in worker's session, and starts it
# again when it exits, so each slot takes one job after another.
#
# One run:
# 1. Checks the disk has room and the image and GitHub App files exist.
# 2. Deletes this slot's VM if a crash left one behind, clones the image to it
#    and boots it headless on Softnet, so it reaches the internet but not the
#    LAN, the tailnet or the other VM.
# 3. Once the VM's guest agent answers, copies this slot's SwiftPM cache into
#    it, so the job's package resolve fetches only what changed instead of
#    cloning every package again.
# 4. Asks GitHub for a just-in-time runner config in the org's runner group.
#    That runner takes one job and is gone.
# 5. Runs the runner in the VM until its job ends, copies the VM's SwiftPM
#    cache back for the next job, then stops and deletes the VM, and removes
#    the runner from GitHub if it never took a job.
#
# Usage: runner <slot>. The rest comes from the environment, set by
# mac/ci/default.nix: CI_ORG, CI_GROUP, CI_LABEL, CI_IMAGE, CI_CPU,
# CI_MEMORY_MB, CI_MIN_FREE_GB, CI_MAX_JOB_SECONDS.
#
# Files in worker's home, outside this repo (docs/mac-studio.md, "iOS CI"):
# - ~/.config/ci/github-app-client-id: the GitHub App's client ID;
# - ~/.config/ci/github-app.pem: its private key, mode 600.
#
# It writes this slot's last result to ~/Library/Caches/ci/runner-<slot>.status
# for ./heartbeat, and keeps the slot's SwiftPM cache in
# ~/Library/Caches/ci/swiftpm-<slot>. Deleting that folder resets the cache.
# macOS's /bin/bash is 3.2, so no bash 4 features.
#
# Logs, in ~/Library/Logs:
# - ci-runner-<slot>.log: this script's own lines (launchd sends stdout there);
# - ci-vm-<slot>.log: Tart's and Softnet's output, each line timestamped;
# - ci-net-<slot>.log: Softnet's CPU and memory and the Mac's load every 30
#   seconds while the VM runs, to match a slow download in a job to them.
set -euo pipefail

slot="${1:?usage: runner <slot>}"
: "${CI_ORG:?}" "${CI_GROUP:?}" "${CI_LABEL:?}" "${CI_IMAGE:?}"
: "${CI_CPU:?}" "${CI_MEMORY_MB:?}" "${CI_MIN_FREE_GB:?}" "${CI_MAX_JOB_SECONDS:?}"

conf="$HOME/.config/ci"
state="$HOME/Library/Caches/ci"
vm="${CI_IMAGE}-${slot}"
status_file="$state/runner-$slot.status"
# The slot's SwiftPM cache. Tart shares it with the VM, which sees it at
# $guest_share. The VM copies it to and from its own disk rather than using it
# in place, so git never works over the share.
cache_dir="$state/swiftpm-$slot"
# The copy goes in a folder inside the share: the VM may not set the share's
# own times, and rsync fails when it can't.
guest_share="/Volumes/My Shared Files/swiftpm"
guest_store="$guest_share/cache"
# shellcheck disable=SC2016 # $HOME expands in the VM's shell.
guest_cache='$HOME/Library/Caches/org.swift.swiftpm'
api_url="https://api.github.com"

mkdir -p "$state" "$cache_dir"
chmod 700 "$state"

log() { printf '%s slot %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$slot" "$*"; }

# Prefixes each line it reads with the UTC time.
stamp() {
  local line
  while IFS= read -r line; do
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line"
  done
}

# Every 30 seconds, logs this VM's Softnet CPU and memory and the Mac's load.
# Tart starts Softnet through sudo, so it is Tart's child or, while sudo waits
# on it, its grandchild.
sample_softnet() {
  local sudo_pid softnet_pid
  while kill -0 "$vm_pid" 2>/dev/null; do
    softnet_pid="$(pgrep -P "$vm_pid" softnet | head -n 1 || true)"
    if [ -z "$softnet_pid" ]; then
      sudo_pid="$(pgrep -P "$vm_pid" sudo | head -n 1 || true)"
      [ -z "$sudo_pid" ] || softnet_pid="$(pgrep -P "$sudo_pid" softnet | head -n 1 || true)"
    fi
    if [ -n "$softnet_pid" ]; then
      printf '%s softnet pid %s cpu %s%% rss %s KB, load %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$softnet_pid" \
        "$(ps -o %cpu= -p "$softnet_pid" | tr -d ' ')" \
        "$(ps -o rss= -p "$softnet_pid" | tr -d ' ')" \
        "$(sysctl -n vm.loadavg | tr -d '{}' | awk '{ print $1, $2, $3 }')"
    else
      printf '%s softnet not running\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi
    sleep 30
  done
}

# Records the error for the heartbeat, then waits before exiting, so launchd
# does not restart a slot that cannot work every 10 seconds.
fail() {
  log "error: $*"
  printf 'error %s %s\n' "$(date +%s)" "$*" >"$status_file"
  sleep 120
  exit 1
}

# Runs a command, and kills it if it runs longer than $1 seconds. Returns the
# command's status, or 143 when it was killed. The command must be a program,
# not a function, so the kill reaches it.
with_timeout() {
  local seconds="$1" pid killer status
  shift
  "$@" &
  pid=$!
  ( sleep "$seconds"; kill "$pid" 2>/dev/null ) &
  killer=$!
  wait "$pid" && status=0 || status=$?
  kill "$killer" 2>/dev/null || true
  wait "$killer" 2>/dev/null || true
  return "$status"
}

# Runs a shell command in the VM. $HOME there is the VM's admin user's.
in_vm() { tart exec "$vm" /bin/sh -c "$1"; }
rsync_in_vm() { with_timeout 600 tart exec "$vm" /bin/sh -c "$1"; }

# A local VM is a folder in Tart's home. `tart list` would also read each
# disk's size, which fails while any VM runs, so it can't answer this.
vm_exists() {
  [ -f "${TART_HOME:-$HOME/.tart}/vms/$1/config.json" ]
}

# 1. Room and files.
free_gb="$(df -g "$HOME" | awk 'NR == 2 { print $4 }')"
if [ "$free_gb" -lt "$CI_MIN_FREE_GB" ]; then
  fail "only ${free_gb} GB free, under ${CI_MIN_FREE_GB} GB"
fi
vm_exists "$CI_IMAGE" || fail "no $CI_IMAGE image: run build-image in worker-shell"
[ -s "$conf/github-app-client-id" ] || fail "no $conf/github-app-client-id"
[ -s "$conf/github-app.pem" ] || fail "no $conf/github-app.pem"

# GitHub API calls. The Authorization header goes in a file, not on curl's
# command line, which any user on the Mac can read with ps.
auth_file="$state/auth-$slot"
umask 077
api() {
  curl -fsS --max-time 30 --retry 3 --retry-all-errors \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -H @"$auth_file" "$@"
}

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# An installation token for the App, limited to the org's self-hosted
# runners. The App's JWT lasts 9 minutes and the token an hour, so each run
# makes its own.
github_login() {
  local client_id now header payload sig installation token
  client_id="$(tr -d '[:space:]' <"$conf/github-app-client-id")"
  now="$(date +%s)"
  header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$client_id" | b64url)"
  sig="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$conf/github-app.pem" -binary | b64url)"
  printf 'Authorization: Bearer %s.%s.%s\n' "$header" "$payload" "$sig" >"$auth_file"

  installation="$(api "$api_url/app/installations" |
    jq -r --arg o "$CI_ORG" '.[] | select(.account.login == $o) | .id')"
  [ -n "$installation" ] || return 1
  token="$(api -X POST "$api_url/app/installations/$installation/access_tokens" \
    -d '{"permissions":{"organization_self_hosted_runners":"write"}}' | jq -r .token)"
  [ -n "$token" ] && [ "$token" != null ] || return 1
  printf 'Authorization: Bearer %s\n' "$token" >"$auth_file"
}

runner_id=""
vm_pid=""
watchdog_pid=""
sampler_pid=""
# Set while the cache folder may be half written; cleanup then deletes it, so
# the next job starts with no cache rather than a broken one.
drop_cache=""
cleanup() {
  set +e
  [ -n "$watchdog_pid" ] && kill "$watchdog_pid" 2>/dev/null
  [ -n "$sampler_pid" ] && kill "$sampler_pid" 2>/dev/null
  if [ -n "$vm_pid" ]; then
    tart stop "$vm" >/dev/null 2>&1 || kill "$vm_pid" 2>/dev/null
    wait "$vm_pid" 2>/dev/null
  fi
  vm_exists "$vm" && tart delete "$vm"
  if [ -n "$drop_cache" ]; then
    log "deleting the SwiftPM cache: $drop_cache"
    rm -rf "$cache_dir"
  fi
  # A runner that ran its job has already removed itself, and this is a 404.
  if [ -n "$runner_id" ]; then
    api -X DELETE "$api_url/orgs/$CI_ORG/actions/runners/$runner_id" >/dev/null 2>&1
  fi
  rm -f "$auth_file"
}
trap cleanup EXIT
trap 'exit 143' TERM INT

# 2. A fresh VM.
if vm_exists "$vm"; then
  log "deleting $vm, left by an earlier run"
  tart stop "$vm" >/dev/null 2>&1 || true
  tart delete "$vm"
fi
tart clone "$CI_IMAGE" "$vm"
tart set "$vm" --cpu "$CI_CPU" --memory "$CI_MEMORY_MB"
log "booting $vm"
vm_log="$HOME/Library/Logs/ci-vm-$slot.log"
net_log="$HOME/Library/Logs/ci-net-$slot.log"
printf '%s booting %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$vm" | tee -a "$net_log" >>"$vm_log"
# Process substitution, not a pipe, so $! is Tart's PID rather than stamp's.
tart run --no-graphics --net-softnet --dir "swiftpm:$cache_dir" "$vm" > >(stamp >>"$vm_log") 2>&1 &
vm_pid=$!
sample_softnet >>"$net_log" 2>&1 &
sampler_pid=$!

waited=0
until tart exec "$vm" /usr/bin/true >/dev/null 2>&1; do
  kill -0 "$vm_pid" 2>/dev/null || fail "$vm exited while booting (ci-vm-$slot.log)"
  waited=$((waited + 5))
  [ "$waited" -le 300 ] || fail "$vm's guest agent did not answer in 5 minutes"
  sleep 5
done

# 3. The SwiftPM cache. Any failure here leaves the job to resolve packages
# from scratch, as it would with no cache.
waited=0
until in_vm "test -d '$guest_share'" >/dev/null 2>&1; do
  waited=$((waited + 5))
  [ "$waited" -le 60 ] || break
  sleep 5
done
started="$(date +%s)"
if [ "$waited" -gt 60 ]; then
  log "warning: $guest_share did not appear in $vm: no SwiftPM cache for this job"
else
  rsync_in_vm "mkdir -p \"\$HOME/Library/Caches\" && { [ ! -d '$guest_store' ] || /usr/bin/rsync -a --delete '$guest_store/' \"$guest_cache/\"; }" &&
    status=0 || status=$?
  if [ "$status" -eq 0 ]; then
    log "SwiftPM cache copied in ($(du -sh "$cache_dir" | awk '{ print $1 }')) in $(($(date +%s) - started)) seconds"
  elif [ "$status" -eq 143 ]; then
    # The copy may still be running in the VM, so this VM can't be trusted
    # to start clean. Give up on it, and on the cache.
    drop_cache="copying it in took over 10 minutes"
    fail "copying the SwiftPM cache into $vm took over 10 minutes"
  else
    log "warning: copying the SwiftPM cache in failed ($status): no cache for this job"
    in_vm "rm -rf \"$guest_cache\"" || fail "could not clear $vm's SwiftPM cache"
  fi
fi

# 4. A one-job runner in the org's runner group.
github_login || fail "GitHub App sign-in failed: check the App is installed on $CI_ORG"
group_id="$(api "$api_url/orgs/$CI_ORG/actions/runner-groups?per_page=100" |
  jq -r --arg g "$CI_GROUP" '.runner_groups[] | select(.name == $g) | .id')"
[ -n "$group_id" ] || fail "no runner group $CI_GROUP in $CI_ORG"

name="mac-studio-$slot-$(date +%Y%m%d%H%M%S)"
jit="$(jq -n --arg name "$name" --argjson group "$group_id" --arg label "$CI_LABEL" \
  '{name: $name, runner_group_id: $group, labels: [$label], work_folder: "_work"}' |
  api -X POST "$api_url/orgs/$CI_ORG/actions/runners/generate-jitconfig" -d @-)" ||
  fail "GitHub refused a runner config"
runner_id="$(jq -r .runner.id <<<"$jit")"
config="$(jq -r .encoded_jit_config <<<"$jit")"
unset jit

# A job that runs past every workflow's own timeout is stuck: stop the VM.
( sleep "$CI_MAX_JOB_SECONDS"; log "job over $CI_MAX_JOB_SECONDS seconds: stopping $vm"; tart stop "$vm" ) &
watchdog_pid=$!

# 5. The config goes in on stdin, not the command line. A login shell, so
# Homebrew's tools are on PATH as they are for a person at the VM.
log "runner $name waiting for a job"
printf '%s runner %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" >>"$net_log"
printf 'ok %s waiting\n' "$(date +%s)" >"$status_file"
# shellcheck disable=SC2016 # $c expands in the VM's shell.
if printf '%s\n' "$config" |
  tart exec -i "$vm" /bin/zsh -l -c 'read -r c; cd ~/actions-runner && exec ./run.sh --jitconfig "$c"'; then
  log "runner $name finished"
  printf 'ok %s finished\n' "$(date +%s)" >"$status_file"
  # Whatever the job resolved goes back for the next job on this slot. A VM
  # with no cache folder left the share untouched, so it stays as it was.
  if in_vm "test -d \"$guest_cache\"" && in_vm "test -d '$guest_share'"; then
    started="$(date +%s)"
    drop_cache="copying it back did not finish"
    if rsync_in_vm "mkdir -p '$guest_store' && /usr/bin/rsync -a --delete \"$guest_cache/\" '$guest_store/'"; then
      drop_cache=""
      log "SwiftPM cache copied back ($(du -sh "$cache_dir" | awk '{ print $1 }')) in $(($(date +%s) - started)) seconds"
    else
      log "warning: copying the SwiftPM cache back failed"
    fi
  fi
else
  # A failing job does not land here: run.sh exits 0 after any job. This is
  # the runner itself failing, or the watchdog stopping the VM.
  fail "runner $name exited with an error"
fi
