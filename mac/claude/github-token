#!/bin/bash
# mac/claude/github-token - hands worker's GitHub tokens to git and gh, the
# right one for each repo.
#
# A fine-grained token covers one owner, with the same permissions on every
# repo it covers. So worker has up to three, each a file in
# ~/.config/github-tokens, mode 600:
#
#   cut-watch     every cut-watch repo, read and write, and can create repos
#   ky1ejs        ky1ejs repos picked in GitHub's settings, read and write
#   ky1ejs-read   every ky1ejs repo, new ones included, read only
#
# For an owner with both OWNER and OWNER-read, it asks GitHub whether the
# OWNER token can see the repo, and uses it if so; otherwise the read-only one.
# docs/mac-studio.md says why the ky1ejs write token never covers homelab or
# kylejs-macOS-bootstrap.
#
# Run as git's credential helper (`github-token get`), it reads the repo's
# path from git and prints its token. git sends the path only with
# credential.https://github.com.useHttpPath on.
#
# Run as `gh` (it is the Studio's only gh, a link to this script), it sets
# GH_TOKEN and runs the real gh. It takes the first of these that names a repo
# whose owner has a token file:
#
#   1. the -R or --repo value: `-R ky1ejs/x`, `-Rky1ejs/x`, `--repo=ky1ejs/x`
#   2. each argument in turn that is wholly a github.com URL or a REST API
#      path, such as `repos/ky1ejs/x/issues`, `/repos/ky1ejs/x` or
#      `https://api.github.com/repos/ky1ejs/x`, or, after `gh repo`, an
#      OWNER/REPO. Values of free-text flags such as --title, --body and -f
#      are skipped.
#   3. GH_REPO
#   4. the current repo's origin
#
# Otherwise it uses cut-watch's. A user with no token files, such as kylejs,
# gets the plain gh and its own login. `gh api` has no -R: it names the repo
# in its path, or its {owner}/{repo} placeholders and graphql go by GH_REPO
# or origin, as gh's own do.
#
# bash 3.2: this runs under macOS's /bin/bash.
set -euo pipefail

tokens="$HOME/.config/github-tokens"
default_owner=cut-watch
# mac/claude/default.nix puts the real gh's store path here.
real_gh="@realGh@"
# test-github-token swaps in a stand-in.
curl=/usr/bin/curl

# A GitHub owner or repo name: letters, digits, '-', '_' and '.'.
valid_name() {
  case "$1" in
    "" | . | .. | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

# OWNER REPO from a GitHub URL or OWNER/REPO, or nothing. For git's path and
# a checkout's origin.
parse_repo() {
  local s="$1" owner repo
  s="${s#https://github.com/}"
  s="${s#git@github.com:}"
  s="${s#ssh://git@github.com/}"
  case "$s" in */*) ;; *) return 1 ;; esac
  owner="${s%%/*}"
  repo="${s#*/}"
  repo="${repo%%/*}"
  repo="${repo%.git}"
  valid_name "$owner" || return 1
  valid_name "$repo" || repo=""
  printf '%s %s\n' "$owner" "$repo"
}

# OWNER REPO from a gh argument that is wholly a repo, or nothing: a
# github.com URL, a REST API path, or, with "bare", [github.com/]OWNER/REPO.
# Text with spaces, an unreadable repo part, or more after a bare OWNER/REPO
# names nothing, so a title such as "ky1ejs/orca#3 again" picks no token.
gh_repo() {
  local s="$1" bare="${2:-}" whole="" owner rest repo
  case "$s" in "" | *[[:space:]]*) return 1 ;; esac
  case "$s" in
    https://api.github.com/repos/*) s="${s#https://api.github.com/repos/}" ;;
    /repos/*) s="${s#/repos/}" ;;
    repos/*) s="${s#repos/}" ;;
    https://github.com/*) s="${s#https://github.com/}" ;;
    *)
      [ -n "$bare" ] || return 1
      whole=yes
      s="${s#github.com/}"
      ;;
  esac
  case "$s" in */*) ;; *) return 1 ;; esac
  owner="${s%%/*}"
  rest="${s#*/}"
  repo="${rest%%[/?#]*}"
  # A bare OWNER/REPO ends at the repo; a URL or API path may go on.
  [ -z "$whole" ] || [ "$repo" = "$rest" ] || return 1
  repo="${repo%.git}"
  valid_name "$owner" && valid_name "$repo" || return 1
  printf '%s %s\n' "$owner" "$repo"
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# The token file for OWNER and REPO (REPO may be empty), or nothing.
#
# A fine-grained token can read every public repo, picked or not, so the
# probe below says yes for a public ky1ejs repo the write token can't push
# to. GitHub still holds the token to read only there, so that costs nothing,
# except on homelab and kylejs-macOS-bootstrap, which never get a write token
# from this script whatever GitHub says.
token_for() {
  local owner repo write read
  owner=$(lower "$1")
  repo=$(lower "${2:-}")
  write="$tokens/$owner" read="$tokens/$owner-read"
  valid_name "$owner" || return 1
  case "$owner/$repo" in
    ky1ejs/homelab | ky1ejs/kylejs-macos-bootstrap)
      [ -r "$read" ] || return 1
      printf '%s\n' "$read"
      return
      ;;
  esac
  if [ -r "$write" ] && [ -r "$read" ]; then
    # With no repo to ask about, the read token, which reaches every repo.
    if [ -n "$repo" ] && "$curl" -fsS -o /dev/null -m 5 \
      -H "Authorization: Bearer $(cat "$write")" \
      "https://api.github.com/repos/$owner/$repo" 2>/dev/null; then
      printf '%s\n' "$write"
    else
      printf '%s\n' "$read"
    fi
  elif [ -r "$write" ]; then
    printf '%s\n' "$write"
  elif [ -r "$read" ]; then
    printf '%s\n' "$read"
  else
    return 1
  fi
}

# Sets file to the token file for OWNER REPO ($1), if the owner has one.
use_parsed() {
  # shellcheck disable=SC2086 # OWNER REPO
  file=$(token_for $1) || { file=""; return 1; }
}

if [ "$(basename "$0")" = gh ]; then
  if [ -z "${GH_TOKEN:-}" ]; then
    file=""
    prev=""
    for arg in "$@"; do
      case "$prev" in
        -R | --repo)
          if p=$(gh_repo "$arg" bare) && use_parsed "$p"; then break; fi
          ;;
      esac
      case "$arg" in
        --repo=*) if p=$(gh_repo "${arg#--repo=}" bare) && use_parsed "$p"; then break; fi ;;
        -R?*) if p=$(gh_repo "${arg#-R}" bare) && use_parsed "$p"; then break; fi ;;
      esac
      prev="$arg"
    done
    # URLs and API paths anywhere, bare OWNER/REPO only after `gh repo`, and
    # never the value of a flag that takes free text.
    if [ -z "$file" ]; then
      bare=""
      [ "${1:-}" != repo ] || bare=bare
      prev=""
      for arg in "$@"; do
        case "$prev" in
          -t | --title | -b | --body | -F | --body-file | -m | --message | --subject | \
            -f | --field | -r | --raw-field | -q | --jq | -H | --header | -T | --template) ;;
          *) if p=$(gh_repo "$arg" "$bare") && use_parsed "$p"; then break; fi ;;
        esac
        prev="$arg"
      done
    fi
    if [ -z "$file" ] && [ -n "${GH_REPO:-}" ]; then
      if p=$(gh_repo "$GH_REPO" bare); then use_parsed "$p" || true; fi
    fi
    if [ -z "$file" ]; then
      if p=$(parse_repo "$(git remote get-url origin 2>/dev/null || true)"); then
        use_parsed "$p" || true
      fi
    fi
    if [ -z "$file" ]; then
      file=$(token_for "$default_owner" "") || file=""
    fi
    if [ -n "$file" ]; then
      GH_TOKEN=$(cat "$file")
      export GH_TOKEN
    fi
  fi
  exec "$real_gh" "$@"
fi

# git's credential helper: answer `get`, ignore `store` and `erase`.
[ "${1:-}" = get ] || exit 0

host="" path=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
  esac
done
[ "$host" = github.com ] || exit 0

file=""
if parsed=$(parse_repo "$path"); then
  # shellcheck disable=SC2086 # OWNER REPO
  file=$(token_for $parsed) || file=""
fi
[ -n "$file" ] || file=$(token_for "$default_owner" "") || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$file")"
