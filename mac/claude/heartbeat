#!/bin/bash
# mac/claude/heartbeat - check worker's Claude Remote Control servers and ping
# Healthchecks.io. launchd runs it in worker's session every 5 minutes.
#
# The checks come in two groups. Remote Control's say whether a session can
# start: the servers, their sign-in and the repo sync. The host's say whether
# the mac studio is healthy for the sessions and CI it runs: memory, disk,
# Docker and what sessions left behind. Each group pings its own Healthchecks
# check: Remote Control's ~/.config/claude-rc/ping-url, the host's
# ~/.config/claude-rc/host-ping-url. Each pings the success URL when its
# checks pass, and /fail with its problems as the body when one does not.
# Without host-ping-url, both groups ping the first check, and the body's first
# line says which group failed, so a memory warning does not read as the
# servers being down. A group whose file is missing only logs. Healthchecks.io notices
# the silence when the mac studio is off, locked, or worker is not logged in.
#
# Remote Control's checks:
# - each server's launchd job is running;
# - no server has written a sign-in or trust error since the last run;
# - no server has written a TLS certificate error since the last run, nor
#   the process still running at an earlier run: a server that cannot verify
#   claude.ai's certificate stays running and connected but starts no
#   session, so its job alone looks healthy;
# - the last repo sync (./sync-repos) ran in the last 30 minutes, and failed
#   for no repo, since each session starts from the synced checkout.
#
# The host's checks:
# - the last sweep of session folders (./sweep-sessions) ran in the last 6
#   hours, and kept no folder it should have swept;
# - no xcodebuild of worker's has run over 2 hours (it is killed);
# - `xcrun metal` finds the Metal toolchain, mounting it again if not;
# - simslim's watch agent runs (mac/simslim);
# - Colima's Docker answers (mac/colima), and no Postgres, Redis or S3 server
#   runs on the host instead, for any user, nor listens on one of their ports
#   for worker;
# - worker has installed no tools for itself: no Nix profile, no commands in
#   ~/.local/bin and the like, no version manager, shell startup file or
#   LaunchAgent not from homelab. Only a new one pings /fail; ones already
#   reported go with the success ping;
# - no process with no parent has run in a kept session folder for over a
#   day, as a server a session left running would, listed by the last sweep
#   (./sweep-sessions) and still running. Only a new one pings /fail, as for
#   tools. The sweep stops those in a folder no session has worked in for 4
#   days, and each it stopped is reported once;
# - swap use is under 8 GB;
# - memory pressure is not critical, and has not been at warning for two runs
#   in a row. macOS's own level, kern.memorystatus_vm_pressure_level, which
#   mac/usage samples every minute: 1 normal, 2 warning, 4 critical. Warning
#   means it is compressing and swapping hard; critical, that it may kill
#   processes to free memory. Used GB means little on macOS, which keeps memory
#   full of cache;
# - mac/usage's root sampler wrote a host sample in the last 10 minutes, so
#   its launchd daemon is still running;
# - the disk has at least 150 GB free. Under that it names worker's biggest
#   folders from the last sweep (./sweep-sessions). Cut's CI stops taking jobs
#   at 50 GB (mac/ci), so this gives time to clear space first. Only a fall
#   under 150 GB, or later under 75 GB, pings /fail; while it stays low it
#   goes with the success ping.
#
# Each run logs a line for each group, "<time> remote control: ..." and
# "<time> host: ...", which `hl status` reads.
#
# It never runs `claude auth status` or anything else that touches the
# sign-in. The ping URLs are mode 600, outside this repo. macOS's /bin/bash is
# 3.2, so no bash 4 features.
set -euo pipefail

ping_file="$HOME/.config/claude-rc/ping-url"
host_ping_file="$HOME/.config/claude-rc/host-ping-url"
state_dir="$HOME/Library/Caches/claude-rc"
logs="$HOME/Library/Logs"
uid="$(id -u)"

max_log_bytes=$((10 * 1024 * 1024))
max_xcodebuild_seconds=$((2 * 60 * 60))
# mac/cli/homelab's status_host() copies max_swap_mb and min_free_gb, and
# mac/diagnose/mac-diagnose copies min_free_gb and critical_free_gb.
max_swap_mb=$((8 * 1024))
max_sample_age_seconds=$((10 * 60))
min_free_gb=150
critical_free_gb=75
max_sync_age_seconds=$((30 * 60))
# The sweep runs every hour; 6 hours allows for a slow run or two.
max_sweep_age_seconds=$((6 * 60 * 60))

# The strings Claude Code prints when its sign-in is gone or a folder is not
# trusted. Correct them against a real log when one turns up.
auth_errors='(status|error)[: ]+401|401 unauthorized|not logged in|please run /login|only available with claude\.ai|workspace not trusted|oauth token (has )?expired'
# Node's errors for a certificate chain it cannot verify, as message or
# code. The first is what the cut server logged on 2026-11-25, when the
# launchd agents had no NIX_SSL_CERT_FILE (mac/claude/default.nix).
tls_errors='unable to get local issuer certificate|unable to verify the first certificate|self[- ]signed certificate in certificate chain|UNABLE_TO_GET_ISSUER_CERT_LOCALLY|UNABLE_TO_VERIFY_LEAF_SIGNATURE|SELF_SIGNED_CERT_IN_CHAIN'

mkdir -p "$state_dir"
# Remote Control's problems, and the host's.
rc_problems=""
add_rc_problem() { rc_problems="${rc_problems}$1"$'\n'; }
problems=""
add_problem() { problems="${problems}$1"$'\n'; }

# Seconds from ps's etime, [[dd-]hh:]mm:ss.
etime_seconds() {
  local t="$1" days=0 h=0 m=0 s=0
  case "$t" in *-*) days="${t%%-*}"; t="${t#*-}" ;; esac
  IFS=: read -r a b c <<<"$t"
  if [ -n "${c:-}" ]; then h="$a"; m="$b"; s="$c"; else m="$a"; s="$b"; fi
  echo $(( 10#$days * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s ))
}

for plist in "$HOME"/Library/LaunchAgents/dev.kylejs.claude-rc.*.plist; do
  [ -e "$plist" ] || continue
  label="$(basename "$plist" .plist)"
  name="${label#dev.kylejs.claude-rc.}"

  job="$(launchctl print "gui/$uid/$label" 2>/dev/null || true)"
  if ! grep -q 'state = running' <<<"$job"; then
    add_rc_problem "$name: server not running"
  fi
  # The job's pid, while it runs: launchctl prints "pid = 123".
  pid="$(awk '$1 == "pid" && $2 == "=" { print $3; exit }' <<<"$job")"

  log="$logs/claude-rc-$name.log"
  [ -f "$log" ] || continue
  offset_file="$state_dir/$name.offset"
  offset=0
  [ -f "$offset_file" ] && offset="$(cat "$offset_file")"
  size="$(stat -f %z "$log")"
  # The log was cut: read it from the start.
  [ "$size" -lt "$offset" ] && offset=0

  # What the server wrote since the last run, in a file: grep -q on a pipe
  # stops reading at its first match, and with pipefail the tail it cut off
  # would make a match read as none.
  new_lines="$state_dir/$name.new"
  tail -c +"$((offset + 1))" "$log" >"$new_lines"

  if grep -Eiq "$auth_errors" "$new_lines"; then
    add_rc_problem "$name: sign-in or trust error in $(basename "$log"). Run: ssh -t ms relogin"
  fi

  # A certificate error lasts as long as the process that hit it, so it is
  # kept with that process's pid and reported on every run until the server
  # runs as another process: a server that logged it once and went quiet is
  # still broken. It is kept only when the server ran as the same process at
  # the last run too, so the lines can only be that process's. After a
  # restart, lines the old process left are reported for this run alone, and
  # the new process is kept only once it logs the error again. A new process
  # that logs it only before this run is reported once, a single failed ping.
  tls_file="$state_dir/$name.tls-error-pid"
  pid_file="$state_dir/$name.pid"
  last_pid=""
  [ -f "$pid_file" ] && last_pid="$(cat "$pid_file")"
  tls=false
  if grep -Eiq "$tls_errors" "$new_lines"; then
    tls=true
    if [ -n "$pid" ] && [ "$pid" = "$last_pid" ]; then
      echo "$pid" >"$tls_file"
    else
      rm -f "$tls_file"
    fi
  elif [ -f "$tls_file" ]; then
    if [ -n "$pid" ] && [ "$(cat "$tls_file")" = "$pid" ]; then
      tls=true
    else
      rm -f "$tls_file"
    fi
  fi
  echo "$pid" >"$pid_file"
  if $tls; then
    add_rc_problem "$name: TLS certificate error in $(basename "$log"), so it starts no sessions. Check NIX_SSL_CERT_FILE in ~/Library/LaunchAgents/$label.plist (docs/mac-studio.md, Claude Remote Control)"
  fi
  # The next run starts after what this one read, not at the size stat saw
  # before it: the server may have written more in between.
  next_offset=$((offset + $(wc -c <"$new_lines")))
  rm -f "$new_lines"

  # launchd appends and never rotates, so keep the newest 2000 lines.
  if [ "$next_offset" -gt "$max_log_bytes" ]; then
    tail -n 2000 "$log" >"$state_dir/$name.tail"
    cat "$state_dir/$name.tail" >"$log"
    rm -f "$state_dir/$name.tail"
    next_offset="$(stat -f %z "$log")"
  fi
  echo "$next_offset" >"$offset_file"
done

# sync-repos and sweep-sessions each write when they last ran, and a line
# per thing they failed on. A last-run time counts from the restart at the
# latest: the file outlives one, and right after it this can run before the
# job's first run ends. kern.boottime reads
# "{ sec = 1763000000, usec = 0 } Thu Nov 13 ...".
now="$(date +%s)"
boot="$(sysctl -n kern.boottime | sed -n 's/^{ sec = \([0-9]*\),.*/\1/p')"

# $1: the job's name, which prefixes its state files and failures. $2: the
# most seconds since its last run. $3: what the problem says when it is late.
# $4: the function that records a problem.
check_job() {
  local last="$state_dir/$1-last" since="${boot:-0}" line
  if [ -f "$last" ] && [ "$(stat -f %m "$last")" -gt "$since" ]; then
    since="$(stat -f %m "$last")"
  fi
  if [ "$((now - since))" -gt "$2" ]; then
    "$4" "$3"
  fi
  if [ -f "$state_dir/$1-failed" ]; then
    while IFS= read -r line; do
      if [ -n "$line" ]; then "$4" "$1: $line"; fi
    done <"$state_dir/$1-failed"
  fi
}
check_job sync "$max_sync_age_seconds" \
  "repo sync has not finished in 30 minutes (dev.kylejs.claude-sync)" add_rc_problem
check_job sweep "$max_sweep_age_seconds" \
  "session sweep has not finished in 6 hours (dev.kylejs.claude-sweep)" add_problem

# A hung build holds a session and the CPU; 2 hours is far past any of Cut's.
while read -r pid etime; do
  [ -n "$pid" ] || continue
  if [ "$(etime_seconds "$etime")" -gt "$max_xcodebuild_seconds" ]; then
    kill "$pid" 2>/dev/null && add_problem "killed xcodebuild $pid after $etime"
  fi
done < <(pgrep -u "$uid" -x xcodebuild | while read -r p; do echo "$p $(ps -o etime= -p "$p" | tr -d ' ')"; done)

# The Metal toolchain is a downloaded asset that xcodebuild mounts. On
# 2026-11-13, after a restart, `xcrun metal` found none although the asset
# was still on disk, and `xcodebuild -downloadComponent MetalToolchain` as
# worker mounted it again. That the restart unmounted it is inferred from
# timestamps. The download's first try failed with "Failed fetching
# catalog" and a retry worked, so a failure here is retried at the next run.
if ! xcrun metal --version >/dev/null 2>&1; then
  if ! xcodebuild -downloadComponent MetalToolchain >/dev/null 2>&1; then
    add_problem "Metal toolchain missing, and xcodebuild -downloadComponent MetalToolchain failed"
  elif ! xcrun metal --version >/dev/null 2>&1; then
    add_problem "Metal toolchain missing after xcodebuild -downloadComponent MetalToolchain"
  fi
fi

# Docker, from Colima's VM (mac/colima sets DOCKER_HOST). This runs at
# login while the VM is still booting, so Docker counts as down only when two
# runs in a row, 5 minutes apart, find it so: each failing run marks the time,
# and reports when the last run's mark is under 15 minutes old and from since
# boot. An older mark is left from a logout and starts the count again.
docker_down="$state_dir/docker-down"
if docker info >/dev/null 2>&1; then
  rm -f "$docker_down"
else
  if [ -f "$docker_down" ] &&
    [ "$(stat -f %m "$docker_down")" -gt "${boot:-0}" ] &&
    [ "$((now - $(stat -f %m "$docker_down")))" -le $((15 * 60)) ]; then
    if launchctl print "gui/$uid/dev.kylejs.colima" 2>/dev/null | grep -q 'state = running'; then
      add_problem "Docker is not answering, though Colima's agent runs (dev.kylejs.colima; see ~/Library/Logs/colima.log)"
    else
      add_problem "Colima is not running (dev.kylejs.colima), so sessions have no Docker"
    fi
  fi
  touch "$docker_down"
fi

# simslim's watch agent (mac/simslim). Without it every simulator a session
# boots runs stock, at about 13 GB instead of about 2.3.
if [ -e "$HOME/Library/LaunchAgents/dev.kylejs.simslim-watch.plist" ] &&
  ! launchctl print "gui/$uid/dev.kylejs.simslim-watch" 2>/dev/null | grep -q 'state = running'; then
  add_problem "simslim's watch agent is not running (dev.kylejs.simslim-watch; see ~/Library/Logs/simslim-watch.log), so new simulators boot stock"
fi

# Repos run these in containers on Colima, whose processes the host cannot
# see, so one seen here was installed on the host: on 2026-11-13 an agent
# with no Docker installed Postgres and Redis, which every session then
# shared. pgrep sees every user's processes. Only the oldest process of each
# is reported; docs/mac-studio.md, "Linux containers", has the cleanup.
for name in postgres redis-server valkey-server minio rustfs mysqld mariadbd mongod; do
  pid="$(pgrep -o -x "$name" || true)"
  [ -n "$pid" ] || continue
  owner="$(ps -o user= -p "$pid" | tr -d ' ')"
  add_problem "$name runs on the host as ${owner:-unknown} (pid $pid), not in Docker"
done

# The same services' ports, held by one of worker's processes that is not
# Colima's port forwarder: ssh by default, or Lima's host agent with the grpc
# forwarder, whose command nixpkgs' wrapper names .limactl-wrapped. lsof
# without root lists only worker's own sockets. Fields: c the command, n the
# address.
lsof -nP -a -u "$uid" -iTCP:5432,6379,9000,9001 -sTCP:LISTEN -Fcn 2>/dev/null |
  awk '/^c/ { cmd = substr($0, 2) } /^n/ && cmd !~ /limactl/ && cmd != "ssh" { print cmd " " substr($0, 2) }' |
  sort -u >"$state_dir/listeners" || true
while IFS= read -r line; do
  if [ -n "$line" ]; then add_problem "$line listens on the host, outside Colima"; fi
done <"$state_dir/listeners"

# Tools worker installed for itself. worker has no dotfiles and gets every
# tool from the Mac Studio's Nix config, so a tool in its home was most
# likely installed by a session, and a later session can run it at a version
# no repo chose. Matches docs/mac-studio.md, "Tools installed outside the Nix
# config".
#
# These are housekeeping, not an outage, and stay until someone cleans up:
# a run pings /fail only when one appears that the last run did not see, and
# otherwise pings success with them in the body. Healthchecks.io emails only
# when the check changes state, so a lasting /fail would hide a later real
# failure.
#
# Paths under worker's home the check skips, one a line: what the setup or a
# repo's own scripts put there on purpose. Cut's ios/scripts/bootstrap.sh
# installs ~/apollo-ios-cli, which no check below looks at.
allowed_tools=""
tools=""
add_tool() {
  case $'\n'"$allowed_tools"$'\n' in *$'\n'"$1"$'\n'*) return 0 ;; esac
  tools="${tools}$2"$'\n'
}
# "a b c d e f and 2 more" from one name a line.
some_names() {
  local n
  n="$(wc -l <<<"$1" | tr -d ' ')"
  printf '%s' "$(head -n 6 <<<"$1" | paste -s -d ' ' -)"
  if [ "$n" -gt 6 ]; then printf ' and %s more' "$((n - 6))"; fi
}
# The paths below are relative to worker's home, and so are their globs.
cd "$HOME"

# A Nix profile, first on PATH. `nix profile` keeps a manifest.json, whose
# packages are named; `nix-env` keeps a manifest.nix, so its commands are
# named instead, as they are for a manifest jq cannot read.
for profile in .nix-profile .local/state/nix/profiles/profile; do
  [ -e "$profile" ] || continue
  # One line per package: its name, a tab, what `nix profile remove` takes.
  # Version 3 manifests key packages by name; older ones list attribute
  # paths, or only store paths for packages added by path.
  pkgs=""
  if [ -f "$profile/manifest.json" ]; then
    pkgs="$(jq -r '.elements | if type == "object" then keys[] | "\(.)\t\(.)"
      else .[] | "\(.attrPath // (.storePaths[0] | sub("^/nix/store/[a-z0-9]+-"; "")))\t\(.attrPath // .storePaths[0])" end' \
      "$profile/manifest.json" 2>/dev/null || true)"
  fi
  if [ -n "$pkgs" ]; then
    add_tool "$profile" "worker's Nix profile has $(cut -f 1 <<<"$pkgs" | paste -s -d ' ' -). Remove with: sudo -iu worker nix profile remove $(cut -f 2 <<<"$pkgs" | paste -s -d ' ' -)"
  else
    # shellcheck disable=SC2012 # names only, for the message
    cmds="$(ls -A "$profile/bin" 2>/dev/null || true)"
    if [ -n "$cmds" ]; then
      add_tool "$profile" "worker's Nix profile (~/$profile) has commands: $(some_names "$cmds")"
    fi
  fi
  break
done

# Folders where language tools and downloads put commands, one finding per
# command. ~/.local/bin is where uv and pipx put them; Claude Code from Nix
# never does, since nixpkgs turns its updater off. pip --user and gem
# --user-install write under ~/Library/Python and ~/.gem; pnpm's global
# commands go in ~/Library/pnpm, beside its package store, which a plain
# `pnpm install` makes and is skipped.
for dir in .local/bin bin .bun/bin .npm-global/bin .cargo/bin go/bin .deno/bin .mint/bin \
  Library/pnpm .local/share/gh/extensions Library/Python/*/bin .gem/ruby/*/bin; do
  [ -d "$dir" ] || continue
  found=""
  # shellcheck disable=SC2012 # names only, for the message
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    case "$dir/$name" in Library/pnpm/store | Library/pnpm/.tools) continue ;; esac
    case $'\n'"$allowed_tools"$'\n' in *$'\n'"$dir/$name"$'\n'*) continue ;; esac
    found="${found}${name}"$'\n'
  done <<<"$(ls -A "$dir" 2>/dev/null || true)"
  if [ -n "$found" ]; then
    add_tool "$dir" "commands installed in ~/$dir: $(some_names "${found%$'\n'}")"
  fi
done

# Cut's ios-build.yaml installs Periphery in ~/periphery. In the CI image
# that is on purpose (mac/ci/image-setup); on the host, periphery is on PATH
# from mac/periphery, so a folder there is a session's own copy.
if [ -d periphery ]; then add_tool "periphery" "a Periphery folder exists: ~/periphery"; fi

# mac/periphery/release.nix copies Cut's Periphery pin by hand, and nothing
# else here notices when Cut moves it: periphery-scan.sh warns only in a
# session's own output, and CI then downloads its own copy on every job
# until the image is rebuilt. Read the pin
# from the origin/main that sync-repos fetches, not the checkout, which may
# be on another branch. The CI image is built from the same release.nix, so
# this covers its copy too.
cut_pin="$(git -C code/cut show origin/main:.github/workflows/ios-build.yaml 2>/dev/null |
  sed -n "s/^[[:space:]]*PERIPHERY_VERSION:[[:space:]]*[\"']\{0,1\}\([^\"'[:space:]]*\)[\"']\{0,1\}.*/\1/p" | head -n 1 || true)"
if [ -n "$cut_pin" ]; then
  have="$(periphery version 2>/dev/null || echo none)"
  if [ "$have" != "$cut_pin" ]; then
    add_tool "periphery-pin" "Cut's main pins Periphery $cut_pin, the Mac Studio has $have: update mac/periphery/release.nix and rebuild the CI image"
  fi
fi

# Version managers, which install whole toolchains under worker's home.
for dir in .nvm .volta .fnm "Library/Application Support/fnm" .nodenv .pyenv .rbenv .asdf \
  .local/share/mise .rustup .sdkman; do
  if [ -d "$dir" ]; then add_tool "$dir" "a version manager's folder exists: ~/$dir"; fi
done

# Shell startup files, which installers write to put the folders above on
# PATH. Sessions' shells build PATH from nix-darwin's profiles, so these are
# what make a tool there run in every later session.
for f in .profile .bash_profile .bashrc .zshenv .zprofile .zshrc .zlogin \
  .config/fish/config.fish .config/fish/conf.d/*; do
  if [ -f "$f" ]; then add_tool "$f" "a shell startup file exists: ~/$f"; fi
done
if grep -qs '^[[:space:]]*prefix[[:space:]]*=' .npmrc; then
  add_tool ".npmrc" "worker's .npmrc sets npm's global prefix"
fi

# LaunchAgents this repo did not install: the activation script installs and
# removes only dev.kylejs.* ones, so another keeps a service or tool running.
for plist in Library/LaunchAgents/*.plist; do
  [ -e "$plist" ] || continue
  case "$(basename "$plist")" in dev.kylejs.*) continue ;; esac
  add_tool "$plist" "a LaunchAgent not from homelab: ~/$plist"
done

# Findings that last until someone cleans up, one a line in $2. $1 keeps the
# ones the last run saw. When one is new, they all ping /fail; otherwise they
# go in lasting_notes for the success ping.
lasting_notes=""
report_lasting() {
  local file="$1" line
  printf '%s' "$2" | sort -u >"$file.new"
  touch "$file"
  if [ -n "$(comm -13 "$file" "$file.new")" ]; then
    while IFS= read -r line; do
      if [ -n "$line" ]; then add_problem "$line"; fi
    done <"$file.new"
  elif [ -s "$file.new" ]; then
    lasting_notes="${lasting_notes}$(cat "$file.new")"$'\n'
  fi
  mv "$file.new" "$file"
}
report_lasting "$state_dir/tools" "$tools"

# Processes the last sweep found running with no parent in a kept folder for
# over a day. Each holds the folder from being swept, and a server holds its
# port and memory too. The sweep runs every hour, so this keeps only those
# still running with the same start time and still no parent: a pid that has
# since gone to another process is left out.
leftovers=""
if [ -f "$state_dir/leftover-processes" ]; then
  while IFS=$'\t' read -r pid start line; do
    [ -n "$pid" ] || continue
    if [ "$(ps -o ppid= -o lstart= -p "$pid" 2>/dev/null | awk '{ $1 = $1; print }')" = "1 $start" ]; then
      leftovers="${leftovers}$line"$'\n'
    fi
  done <"$state_dir/leftover-processes"
fi
report_lasting "$state_dir/leftovers-reported" "$leftovers"

# Processes the sweep stopped, each reported once, with a success ping: the
# sweep has already dealt with them. The sweep adds to stopped-processes, so
# this moves it aside before reading it, into stopped-processes.reading, which
# goes once a ping has carried it. After a failed ping the next run sends it
# again.
stopped_notes=""
reading="$state_dir/stopped-processes.reading"
if [ -f "$state_dir/stopped-processes" ]; then
  mv "$state_dir/stopped-processes" "$state_dir/stopped-processes.new"
  cat "$state_dir/stopped-processes.new" >>"$reading"
  rm -f "$state_dir/stopped-processes.new"
fi
if [ -f "$reading" ]; then
  stopped_notes="$(cat "$reading")"
  if [ -n "$stopped_notes" ]; then stopped_notes="${stopped_notes%$'\n'}"$'\n'; fi
fi

# A warning at one run is often a build's link step; at two runs in a row it
# is the working set. The level is kept for the next run, and counts only if
# that run was the last one: a level left from before a reboot, a logout or a
# FileVault wait says nothing about now. Runs are 5 minutes apart.
pressure="$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null || echo 0)"
pressure_file="$state_dir/memory-pressure"
last_pressure=0
if [ -f "$pressure_file" ] && [ $(( $(date +%s) - $(stat -f %m "$pressure_file") )) -le 600 ]; then
  last_pressure="$(cat "$pressure_file")"
fi
case "$last_pressure" in 1 | 2 | 4) ;; *) last_pressure=0 ;; esac
case "$pressure" in
  4) add_problem "memory pressure critical: macOS may kill processes to free memory. mac-usage report names what ran" ;;
  2) if [ "$last_pressure" -ge 2 ]; then
       add_problem "memory pressure at warning on two runs in a row: macOS is compressing and swapping hard. mac-usage report names what ran"
     fi ;;
esac
echo "$pressure" >"$pressure_file"

# mac/usage's daemon appends to host-<UTC day>.jsonl every minute. The newest
# file, not today's, so midnight UTC does not read as a stop; the dates sort
# as text, so the glob's last match is the newest.
newest_sample=""
for f in /var/log/mac-usage/host-*.jsonl; do
  if [ -e "$f" ]; then newest_sample="$f"; fi
done
if [ -z "$newest_sample" ]; then
  add_problem "mac-usage has no host samples in /var/log/mac-usage: its daemon is not running"
elif [ $(( $(date +%s) - $(stat -f %m "$newest_sample") )) -gt "$max_sample_age_seconds" ]; then
  add_problem "mac-usage last sampled the host at $(date -r "$(stat -f %m "$newest_sample")" '+%Y-%m-%d %H:%M'): its daemon has stopped"
fi

# vm.swapusage reads "total = 2048.00M  used = 512.25M  free = ...".
swap_mb="$(sysctl -n vm.swapusage | awk '{for (i = 1; i <= NF; i++) if ($i == "used") { sub(/M$/, "", $(i + 2)); print int($(i + 2)) }}')"
if [ "${swap_mb:-0}" -gt "$max_swap_mb" ]; then
  add_problem "swap at ${swap_mb} MB"
fi

# df -g's fourth column is the free space in GB. disk-usage lines read
# "<KB> <path>", largest first. Like the tools check, low disk is a state that
# lasts: a run pings /fail only when the disk falls to a lower level than the
# last run saw (under 150 GB, then under 75 GB), and otherwise sends it as a
# note with a success ping, so a later real failure still emails.
free_gb="$(df -g "$HOME" | awk 'NR == 2 { print $4 }')"
disk_level_file="$state_dir/disk-level"
disk_level=0
if [ "${free_gb:-0}" -lt "$critical_free_gb" ]; then
  disk_level=2
elif [ "${free_gb:-0}" -lt "$min_free_gb" ]; then
  disk_level=1
fi
last_disk_level=0
[ -f "$disk_level_file" ] && last_disk_level="$(cat "$disk_level_file")"
case "$last_disk_level" in 0 | 1 | 2) ;; *) last_disk_level=0 ;; esac
disk_note=""
if [ "$disk_level" -gt 0 ]; then
  biggest=""
  if [ -s "$state_dir/disk-usage" ]; then
    biggest="$(awk -v home="$HOME" '{ p = $2; if (index(p, home) == 1) p = "~" substr(p, length(home) + 1); printf "%s%s %d GB", (NR > 1 ? ", " : ""), p, $1 / 1048576 }' "$state_dir/disk-usage")"
    biggest=". Biggest at the last sweep: $biggest"
  fi
  disk_line="only ${free_gb} GB free on disk, under ${min_free_gb} GB; CI stops at 50 GB$biggest"
  if [ "$disk_level" -gt "$last_disk_level" ]; then
    add_problem "$disk_line"
  else
    disk_note="$disk_line"$'\n'
  fi
fi
echo "$disk_level" >"$disk_level_file"

stamp="$(date '+%Y-%m-%d %H:%M:%S')"
# Tools, leftover processes and low disk already reported on an earlier run,
# and processes the sweep stopped, ride along as the host's notes, with a
# success ping when nothing else is wrong.
notes="${disk_note}${lasting_notes}${stopped_notes}"
if [ -z "$rc_problems" ]; then
  echo "$stamp remote control: ok"
else
  printf '%s remote control: problems:\n%s' "$stamp" "$rc_problems"
fi
if [ -n "$problems" ]; then
  printf '%s host: problems:\n%s%s' "$stamp" "$problems" "$notes"
elif [ -n "$notes" ]; then
  printf '%s host: ok, with notes:\n%s' "$stamp" "$notes"
else
  echo "$stamp host: ok"
fi

# send_ping <url> <problems> <notes>: /fail with both as the body when there are
# problems, otherwise success with the notes. Fails when the ping does.
send_ping() {
  if [ -n "$2" ]; then
    curl -fsS -m 10 --retry 3 -o /dev/null --data-raw "$2$3" "$1/fail" && return 0
  else
    curl -fsS -m 10 --retry 3 -o /dev/null ${3:+--data-raw "$3"} "$1" && return 0
  fi
  echo "$stamp ping failed"
  return 1
}

url=""
host_url=""
if [ -s "$ping_file" ]; then url="$(cat "$ping_file")"; fi
if [ -s "$host_ping_file" ]; then host_url="$(cat "$host_ping_file")"; fi
# The notes went out, or there is no check to send them to.
sent=1
if [ -n "$host_url" ]; then
  if [ -n "$url" ]; then send_ping "$url" "$rc_problems" "" || true; fi
  send_ping "$host_url" "$problems" "$notes" || sent=0
elif [ -z "$url" ]; then
  :
elif [ -n "$rc_problems" ]; then
  # One check for both: the first line says which group failed.
  send_ping "$url" "Remote Control has problems:"$'\n'"$rc_problems${problems:+Host problems too:$'\n'$problems}" "$notes" || sent=0
elif [ -n "$problems" ]; then
  send_ping "$url" "Remote Control servers are up. The mac studio itself has problems:"$'\n'"$problems" "$notes" || sent=0
else
  send_ping "$url" "" "$notes" || sent=0
fi
if [ "$sent" = 1 ]; then rm -f "$reading"; fi
