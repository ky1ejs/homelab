#!/bin/bash
# mac/claude/sweep-sessions - clear out the session folders, build output,
# simulators and Periphery cache that worker's Remote Control sessions leave
# behind. launchd runs it in worker's session every hour.
#
#   sweep-sessions NAME...
#
# A server keeps a session's folder when the session ends with work in it
# that exists nowhere else: uncommitted changes, untracked files, stashes or
# commits no remote has. Claude Code does this for a repo server's git
# worktrees (~/code/NAME/.claude/worktrees), and ./any-session for the any-repo
# server's folders (~/code/any/sessions). A session cut off by a restart can
# leave its folder too. Each kept folder holds a full checkout.
#
# Most kept folders hold nothing a remote does not: Claude Code keeps a
# subagent's worktree (agent-<hex>, from `isolation: worktree`) when the
# subagent made commits, even once they are pushed, and its own sweep of them
# waits for cleanupPeriodDays (30 by default). On 2026-11-22 a day of Cut
# sessions left 60 worktrees, 263 GB, in ~/code/cut/.claude/worktrees. So a
# folder with nothing to lose goes soon: no changes, staged or not, no
# untracked files git does not ignore, no commits on HEAD that no
# remote-tracking branch has (for an any-repo folder: every entry a clone, and
# no such commits on any branch or the stash). It goes once no process of
# worker's works in it, nothing in it has changed, and no transcript has
# recorded working in it (see below) for:
# - 1 hour for a subagent's worktree, named agent-*: the subagent is done, and
#   its parent session does not go back in;
# - 24 hours for any other: a Remote Control session's (bridge-<session>) or
#   any-repo folder, which a session left open may come back to.
# A worktree Claude Code has locked for a process still running, its lock
# reason naming that process's pid, is not swept this way. ./sync-repos
# fetches with --prune every 5 minutes, so a branch squash-merged and deleted
# on GitHub reads as commits no remote has: it waits for the 14-day rule
# below, after its DerivedData has gone.
#
# Otherwise a folder that no process of worker's is working in, with nothing
# in it changed for 14 days, is swept: what only it holds is saved to
# ~/code/salvage/DATE-SERVER-SESSION/, then it is deleted. For each checkout
# in it, the salvage holds:
# - CHECKOUT.txt: its path, origin, branch and HEAD;
# - CHECKOUT.bundle: the commits no remote has, a git bundle. For an any-repo
#   clone this is every ref, stashes included; for a worktree, its branch
#   only (HEAD, if detached), since the stash belongs to the repo all its
#   worktrees share. `git bundle list-heads` shows what a bundle holds;
# - CHECKOUT.patch: its changes against HEAD, staged or not;
# - CHECKOUT-untracked.tar.gz: its untracked files. Ignored files, such as
#   build output and node_modules, are not saved.
# Anything in an any-repo folder that is not a git clone goes whole into
# other.tar.gz. A worktree's branch is deleted with it: its commits are on a
# remote or in the bundle. Salvage over 30 days old is deleted.
#
# To get work back, in a clone of the same repo:
#   git fetch ~/code/salvage/.../CHECKOUT.bundle 'refs/*:refs/salvage/*'
#   git apply ~/code/salvage/.../CHECKOUT.patch
#   tar -xzf ~/code/salvage/.../CHECKOUT-untracked.tar.gz
#
# Build output goes sooner. A folder with nothing in it changed for 2 hours,
# and no command running in it, has its DerivedData folders deleted:
# those named .derivedData or DerivedData, at most three levels down, that git
# ignores. Xcode rebuilds them, and they are most of a kept folder's size: on
# 2026-11-15, 174 GB of the 180 GB in 18 Cut worktrees (Cut's scripts build
# into ios/.derivedData). The trim keeps the times of the folders that held
# them, so it does not restart the other clocks. A session left open but idle
# for 2 hours rebuilds from scratch once.
#
# Processes working in a folder come in two kinds. A command a session is
# running, such as a build, a test run or a shell, has a parent. A server a
# session started in the background and left running has none: launchd, pid
# 1, holds it, along with anything it started. Only the first kind stops the
# trim, and each folder is checked again just before its DerivedData goes.
# Either kind stops the sweep.
#
# A parentless process running for over a day keeps its folder from ever
# being swept. On 2026-11-15 a Cut backend server (bun) had held a worktree
# for two days, and on 2026-11-17 a bun server and an Xcode DTServiceHub had
# held one for three. ./session-cleanup stops these when a session ends, but
# not when the session was cut off, as by a restart. So when no command runs
# in the folder and no session has worked there for 4 days, this stops them:
# SIGTERM to each and what it started, then SIGKILL to what is left 10
# seconds later. It checks first that each is still the process it found,
# working in the folder with no parent.
#
# Whether a session has worked there is read from Claude Code's transcripts,
# ~/.claude/projects/*/*.jsonl, which record each step's working directory
# ("cwd"). A session's own process does not work in its folder (lsof on
# 2026-11-15 listed no claude process there), so lsof cannot tell. An open
# session writes nothing while it waits for a prompt, so 4 days is long enough
# to cover a weekend: a session idle that long that still wants its server
# can start it again. A folder no transcript names is never stopped in, since
# then it cannot tell; nor is one any transcript changed in the last 4 days
# names, wherever that transcript is kept (a session that starts in the repo
# and moves into its worktree keeps its transcript under the repo's name).
#
# Each stop is added to ~/Library/Caches/claude-rc/stopped-processes, which
# the heartbeat reports once. The rest are listed in
# ~/Library/Caches/claude-rc/leftover-processes, one "<pid><tab><start
# time><tab><what to tell Kyle>" a line, for the heartbeat to report: an open
# session may still use them. So is one that did not stop, which is also a
# failure.
#
# Simulators that test runs left behind, when they were killed before their
# own cleanup, go too: those shut down with nothing in their folder changed
# for 6 hours, among xcodebuild's clones for parallel testing (the "testing"
# set, ~/Library/Developer/XCTestDevices; 12 GB on 2026-11-15) and the
# "Cut Tests <pid>-<n>" devices Cut's ios/scripts/test-modules.sh makes,
# and the "<name> @<ID>" devices that ./worker-CLAUDE.md has sessions make
# (ID: NAME/X for a worktree of repo NAME, any/X for an any-repo folder). One
# whose session folder is gone goes whatever its state: its session ended without running ./session-cleanup, as when a
# restart cut it off.
# Xcode's own devices, which Cut's test script copies its device from, are
# left alone. That rules out `simctl delete unavailable` here: it also takes
# devices whose runtime is only unmounted for now, as after a restart, or
# that the Xcode of the moment does not support, as midway through an Xcode
# move, and CoreSimulator does not make them again. docs/mac-studio.md runs
# it by hand after an Xcode move instead.
#
# Periphery keeps a DerivedData folder per project path and Xcode version in
# ~/Library/Caches/com.github.peripheryapp, so each worktree that runs it adds
# one, and none goes when its worktree does: 95 GB on 2026-11-22. Each run
# keeps the newest of them, warm for the next scan, and any changed in the
# last 10 minutes, as by a scan under way. Of the rest, those unchanged for
# 24 hours go, then the oldest until the whole cache is under 20 GB.
# Periphery makes one again when it needs it.
#
# Each run ends by writing the sizes of worker's biggest folders to
# ~/Library/Caches/claude-rc/disk-usage, which the heartbeat quotes when the
# disk runs low.
#
# When a folder's work cannot all be saved, the folder is kept. The heartbeat
# reports that: this writes one line per folder kept, or anything else it
# could not delete, to ~/Library/Caches/claude-rc/sweep-failed, and the time
# of each run to sweep-last. macOS's /bin/bash is 3.2, so no bash 4 features.
set -uo pipefail

code="$HOME/code"
sessions="$code/any/sessions"
salvage="$code/salvage"
state_dir="$HOME/Library/Caches/claude-rc"
periphery_cache="$HOME/Library/Caches/com.github.peripheryapp"
stale_days=14
session_idle_days=4
term_wait_seconds=10
trim_minutes=120
trim_recheck_minutes=10
subagent_done_minutes=60
session_done_minutes=$((24 * 60))
simulator_idle_minutes=$((6 * 60))
salvage_days=30
periphery_keep_hours=24
periphery_max_gb=20
periphery_busy_minutes=10

mkdir -p "$salvage" "$state_dir"
failures=""

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >&2; }
fail() {
  failures="${failures}$1"$'\n'
  log "$1"
}

# Every process of worker's and its working directory. lsof prints a
# "p<pid>" line for each, then "c<command>", "R<parent pid>" and
# "n<working directory>"; this keeps one
# "<pid><tab><parent pid><tab><command><tab><directory>" line per process.
live_procs="$(lsof -a -u "$(id -u)" -d cwd -R -FpcRn 2>/dev/null | awk '
  /^p/ { pid = substr($0, 2); ppid = ""; cmd = "" }
  /^c/ { cmd = substr($0, 2) }
  /^R/ { ppid = substr($0, 2) }
  /^n/ { printf "%s\t%s\t%s\t%s\n", pid, ppid, cmd, substr($0, 2) }')"

# True when no session has worked in folder $1 for $session_idle_days days: a
# transcript records a working directory in it, and none changed since then
# does. A path a transcript would write with escapes (a quote or backslash)
# matches nothing, so nothing is stopped there.
folder_idle() {
  local projects="$HOME/.claude/projects" exact="\"cwd\":\"$1\"" inside="\"cwd\":\"$1/"
  [ -d "$projects" ] || return 1
  [ -z "$(find "$projects" -name '*.jsonl' -mmin -$((session_idle_days * 24 * 60)) \
    -exec grep -lF -e "$exact" -e "$inside" {} + 2>/dev/null | head -n 1)" ] || return 1
  [ -n "$(find "$projects" -name '*.jsonl' \
    -exec grep -lF -e "$exact" -e "$inside" {} + 2>/dev/null | head -n 1)" ]
}

# Running, not gone or a zombie waiting for its parent to reap it.
alive() {
  kill -0 "$1" 2>/dev/null || return 1
  case "$(ps -o stat= -p "$1" 2>/dev/null)" in Z*) return 1 ;; esac
}

# Stops process $1 and everything it started, after checking that it is still
# the process found earlier: launchd its parent, started at $2, working in
# folder $3. SIGTERM, then SIGKILL for what is left after $term_wait_seconds
# seconds. Returns 0 once all are gone, 1 if it was no longer that process,
# 2 if any is still running.
stop_tree() {
  local top="$1" start="$2" dir="$3" cwd all pid ppid tree more=1 left waited=0
  [ "$(ps -o ppid= -o lstart= -p "$top" 2>/dev/null | awk '{ $1 = $1; print }')" = "1 $start" ] || return 1
  cwd="$(lsof -a -p "$top" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
  case "$cwd/" in "$dir"/*) ;; *) return 1 ;; esac
  all="$(ps -axo pid=,ppid= 2>/dev/null)"
  tree=" $top "
  while [ "$more" = 1 ]; do
    more=0
    while read -r pid ppid; do
      [ -n "$pid" ] || continue
      case "$tree" in *" $pid "*) continue ;; esac
      case "$tree" in *" $ppid "*) tree="$tree$pid "; more=1 ;; esac
    done <<<"$all"
  done
  for pid in $tree; do kill -TERM "$pid" 2>/dev/null || true; done
  while :; do
    left=""
    for pid in $tree; do
      if alive "$pid"; then left="$left $pid"; fi
    done
    [ -n "$left" ] || return 0
    [ "$waited" -lt "$term_wait_seconds" ] || break
    sleep 1
    waited=$((waited + 1))
  done
  for pid in $left; do kill -KILL "$pid" 2>/dev/null || true; done
  sleep 1
  for pid in $left; do
    if alive "$pid"; then return 2; fi
  done
  return 0
}

# Sorts the processes working in folder $1 (its working directory, or one
# inside it). Sets folder_procs (any at all: 1 or 0) and running (1 when one
# has a parent other than launchd or such a process). Of the parentless ones
# running for over a day, it stops those in a folder no session has worked in
# for $session_idle_days days and adds the rest to leftovers.
leftovers=""
stopped=""
look_in() {
  local dir="$1" pid ppid cmd d held=" 1 " more=1 etime start lines="" old="" idle=0 what rc
  folder_procs=0
  running=0
  while IFS=$'\t' read -r pid ppid cmd d; do
    case "$d/" in "$dir"/*) lines="$lines$pid"$'\t'"$ppid"$'\t'"$cmd"$'\t'"$d"$'\n' ;; esac
  done <<<"$live_procs"
  [ -n "$lines" ] || return 0
  folder_procs=1
  # held: launchd, and the processes it holds here and what they started.
  while [ "$more" = 1 ]; do
    more=0
    while IFS=$'\t' read -r pid ppid cmd d; do
      [ -n "$pid" ] || continue
      case "$held" in *" $pid "*) continue ;; esac
      case "$held" in *" $ppid "*) held="$held$pid "; more=1 ;; esac
    done <<<"$lines"
  done
  while IFS=$'\t' read -r pid ppid cmd d; do
    [ -n "$pid" ] || continue
    case "$held" in *" $pid "*) ;; *) running=1; continue ;; esac
    [ "$ppid" = 1 ] || continue
    # etime is [[dd-]hh:]mm:ss, so a dash means over a day.
    etime="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')"
    case "$etime" in *-*) ;; *) continue ;; esac
    start="$(ps -o lstart= -p "$pid" 2>/dev/null | awk '{ $1 = $1; print }')"
    [ -n "$start" ] || continue
    old="$old$pid"$'\t'"$start"$'\t'"$cmd"$'\t'"$d"$'\n'
  done <<<"$lines"
  [ -n "$old" ] || return 0
  # A command running in the folder means a session is at work there,
  # whatever its transcripts say.
  if [ "$running" = 0 ] && folder_idle "$dir"; then idle=1; fi
  while IFS=$'\t' read -r pid start cmd d; do
    [ -n "$pid" ] || continue
    what="$cmd (pid $pid, started $start)"
    if [ "$idle" = 1 ]; then
      rc=0
      stop_tree "$pid" "$start" "$dir" || rc=$?
      case "$rc" in
        0)
          stopped="$stopped$(date '+%Y-%m-%d %H:%M') stopped $what in $d: it had no parent, and no session had worked there for $session_idle_days days"$'\n'
          log "stopped $what in $d"
          continue
          ;;
        1)
          log "$what in $d had already stopped"
          continue
          ;;
        *) fail "could not stop $what in $d" ;;
      esac
    fi
    leftovers="$leftovers$pid"$'\t'"$start"$'\t'"$what is still running in $d with no parent, as when a session starts a server in the background. It keeps the folder from being swept. If no open session needs it, stop it: sudo -u worker kill $pid"$'\n'
  done <<<"$old"
}

# True when nothing in folder $1 matches find's test in the rest of the
# arguments: `untouched DIR -mtime -14` is true when nothing in DIR has
# changed for 14 days.
untouched() {
  local dir="$1"
  shift
  [ -z "$(find "$dir" "$@" -print -quit 2>/dev/null)" ]
}

# A file's modification time in seconds since 1970: BSD stat on macOS, GNU
# stat in the tests on Linux.
if stat -c %Y / >/dev/null 2>&1; then mtime_args=(-c %Y); else mtime_args=(-f %m); fi

# Every working directory recorded by a transcript changed in the last $1
# minutes, one '"cwd":"<path>"' a line.
recent_cwds() {
  local projects="$HOME/.claude/projects"
  [ -d "$projects" ] || return 0
  find "$projects" -name '*.jsonl' -mmin -"$1" -exec grep -ho '"cwd":"[^"]*"' {} + 2>/dev/null | sort -u
}

# True when the list $2, from recent_cwds, holds a working directory in
# folder $1.
worked_in() {
  printf '%s\n' "$2" | grep -qF -e "\"cwd\":\"$1\"" -e "\"cwd\":\"$1/"
}

# True when a git worktree lock, with reason $1, belongs to a process still
# running: a reason naming a pid, such as "(pid 123)", whose process is alive.
# A lock without one, or whose process is gone, says nothing either way: a
# session run with -p leaves its locks behind.
lock_held() {
  local pid
  pid="$(printf '%s' "$1" | sed -n 's/.*[Pp][Ii][Dd][^0-9]*\([0-9][0-9]*\).*/\1/p' | head -n 1)"
  [ -n "$pid" ] && alive "$pid"
}

# True when checkout $1 holds nothing that is not on a remote: no changes,
# staged or not, no untracked files that git does not ignore, and no commits
# on HEAD that no remote-tracking branch has. $2 is "all" to count every
# local branch and the stash too, for an any-repo clone. False if git fails.
nothing_to_lose() {
  local repo="$1" changes count
  changes="$(git -C "$repo" status --porcelain --untracked-files=normal 2>/dev/null)" || return 1
  [ -z "$changes" ] || return 1
  if [ "${2:-head}" = all ]; then
    count="$(git -C "$repo" rev-list --count --all --not --remotes 2>/dev/null)" || return 1
  else
    count="$(git -C "$repo" rev-list --count HEAD --not --remotes 2>/dev/null)" || return 1
  fi
  [ "$count" = 0 ]
}

# True when every entry of any-repo folder $1 is a git clone with nothing to
# lose. Anything else in it, such as a loose file, is kept for the 14-day
# rule, which saves it.
session_has_nothing_to_lose() {
  local entry found=0
  for entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    [ ! -L "$entry" ] && [ -d "$entry/.git" ] || return 1
    nothing_to_lose "$entry" all || return 1
    found=1
  done
  [ "$found" = 1 ]
}

# The newest modification time of the folders in $1, in seconds since 1970.
# Folders only: adding or replacing a file changes its folder's time, and a
# build's tree has far fewer folders than files.
newest_change() {
  find "$1" -type d -print0 2>/dev/null | xargs -0 stat "${mtime_args[@]}" 2>/dev/null | sort -n | tail -n 1
}

# Caps Periphery's cache (see the header): keeps the newest entry and any
# changed in the last $periphery_busy_minutes minutes, then deletes those
# unchanged for $periphery_keep_hours hours and, oldest first, those past
# $periphery_max_gb GB in all.
sweep_periphery() {
  local entry t kb now list sorted age first=1 total_kb=0
  local max_kb=$((periphery_max_gb * 1024 * 1024))
  [ -d "$periphery_cache" ] || return 0
  now="$(date +%s)"
  list=""
  for entry in "$periphery_cache"/*; do
    [ -d "$entry" ] && [ ! -L "$entry" ] || continue
    t="$(newest_change "$entry")"
    [ -n "$t" ] || continue
    list="$list$t"$'\t'"$entry"$'\n'
  done
  sorted="$(printf '%s' "$list" | sort -rn)"
  while IFS=$'\t' read -r t entry; do
    [ -n "$entry" ] || continue
    age=$((now - t))
    kb="$(du -xsk "$entry" 2>/dev/null | awk '{ print $1 }')"
    kb="${kb:-0}"
    if [ "$first" = 1 ] || [ "$age" -lt $((periphery_busy_minutes * 60)) ] \
      || { [ "$age" -lt $((periphery_keep_hours * 60 * 60)) ] && [ $((total_kb + kb)) -le "$max_kb" ]; }; then
      first=0
      total_kb=$((total_kb + kb))
      continue
    fi
    if rm -rf "$entry"; then
      log "deleted Periphery's $(basename "$entry") ($((kb / 1024)) MB, unchanged for $((age / 3600)) hours)"
    else
      fail "could not delete all of $entry"
    fi
  done <<<"$sorted"
}

# Deletes the DerivedData folders in checkout $1 that git ignores. Each
# holder's time is put back afterwards: deleting a folder changes the time of
# the one holding it, which would count as a change to the session's work.
trim_build_output() {
  local repo="$1" out rel parent kb ref="$state_dir/trim-time"
  while IFS= read -r out; do
    rel="${out#"$repo"/}"
    git -C "$repo" check-ignore -q -- "$rel" || continue
    kb="$(du -xsk "$out" 2>/dev/null | awk '{ print $1 }')"
    # A build that started since the folder was checked has written here.
    if ! untouched "$out" -mmin -"$trim_recheck_minutes"; then
      log "kept $out: a build wrote to it in the last $trim_recheck_minutes minutes"
      continue
    fi
    parent="$(dirname "$out")"
    touch -r "$parent" "$ref"
    if rm -rf "$out"; then
      log "trimmed $out ($((${kb:-0} / 1024)) MB)"
    else
      fail "could not delete all of $out"
    fi
    touch -r "$ref" "$parent"
  done < <(find "$repo" -maxdepth 3 \( -name .git -o -name node_modules \) -prune \
    -o -type d \( -name .derivedData -o -name DerivedData \) -print -prune 2>/dev/null)
  rm -f "$ref"
}

# simctl for set $1: "default" or "testing".
simctl_in() {
  local set="$1"
  shift
  if [ "$set" = testing ]; then
    xcrun simctl --set testing "$@"
  else
    xcrun simctl "$@"
  fi
}

# True when the session folder for ID $1 exists: any/X for an any-repo
# folder, NAME/X for a worktree of repo NAME.
session_folder_exists() {
  case "$1" in
    any/*) [ -d "$sessions/${1#any/}" ] ;;
    *) [ -d "$code/${1%%/*}/.claude/worktrees/${1#*/}" ] ;;
  esac
}

# Deletes the simulators test runs and sessions left behind (see the header).
sweep_simulators() {
  local set udid state name data tag list
  for set in default testing; do
    # .devices maps each runtime to its devices. dataPath is the device's
    # folder plus /data.
    list="$(simctl_in "$set" list devices --json 2>/dev/null | jq -r --arg set "$set" '
      .devices[][]
      | select($set == "testing" or (.name | startswith("Cut Tests ")) or (.name | test(" @[A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*$")))
      | [.udid, .state, .name, .dataPath] | @tsv')" || {
      fail "simulators: could not list the $set set"
      continue
    }
    while IFS=$'\t' read -r udid state name data; do
      [ -n "$udid" ] || continue
      tag=""
      case "$set:$name" in
        "default:Cut Tests "*) ;;
        default:*" @"*/*) tag="${name##* @}" ;;
      esac
      if [ -n "$tag" ] && ! session_folder_exists "$tag"; then
        # Its session is over and its folder gone.
        if [ "$state" != Shutdown ]; then
          xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
        fi
      else
        [ "$state" = Shutdown ] || continue
        [ -d "$data" ] || continue
        untouched "$(dirname "$data")" -mmin -"$simulator_idle_minutes" || continue
      fi
      if simctl_in "$set" delete "$udid" >/dev/null 2>&1; then
        log "deleted simulator $name ($udid) from the $set set"
      else
        fail "simulators: could not delete $name ($udid) from the $set set"
      fi
    done <<<"$list"
  done
}

# A new folder for one swept session's salvage, named $1, printed.
new_salvage_dir() {
  local out n=1
  out="$salvage/$(date +%Y-%m-%d)-$1"
  while [ -e "$out" ]; do
    n=$((n + 1))
    out="$salvage/$(date +%Y-%m-%d)-$1-$n"
  done
  mkdir -p "$out" && echo "$out"
}

# Saves what only the checkout $1 holds into folder $2, as $3.* files. $4 is
# "all" to bundle every ref, or "head" for the checked-out branch alone (or
# HEAD, if detached). Fails if any part cannot be saved.
salvage_checkout() {
  local repo="$1" out="$2" base="$3" count list branch
  local revs=(--all)
  if [ "$4" = head ]; then
    if branch="$(git -C "$repo" symbolic-ref --quiet HEAD)"; then revs=("$branch"); else revs=(HEAD); fi
  fi

  {
    echo "path: $repo"
    echo "origin: $(git -C "$repo" remote get-url origin 2>/dev/null || echo none)"
    echo "branch: $(git -C "$repo" symbolic-ref --quiet --short HEAD || echo detached)"
    echo "head: $(git -C "$repo" rev-parse HEAD)"
  } >"$out/$base.txt" || return 1

  count="$(git -C "$repo" rev-list --count "${revs[@]}" --not --remotes)" || return 1
  if [ "$count" -gt 0 ]; then
    git -C "$repo" bundle create --quiet "$out/$base.bundle" "${revs[@]}" --not --remotes || return 1
  fi

  git -C "$repo" diff --binary HEAD >"$out/$base.patch" || return 1
  [ -s "$out/$base.patch" ] || rm -f "$out/$base.patch"

  list="$out/.$base.untracked"
  git -C "$repo" ls-files -z --others --exclude-standard >"$list" || return 1
  if [ -s "$list" ]; then
    tar -czf "$out/$base-untracked.tar.gz" -C "$repo" --null -T "$list" || return 1
  fi
  rm -f "$list"
}

# An any-repo session's folder: every entry is saved, then the folder goes.
sweep_session() {
  local dir="$1" name out entry base others=()
  name="$(basename "$dir")"
  out="$(new_salvage_dir "any-$name")" || { fail "kept $dir: could not make its salvage folder"; return; }

  for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    base="$(basename "$entry")"
    if [ ! -L "$entry" ] && [ -d "$entry/.git" ]; then
      salvage_checkout "$entry" "$out" "$base" all || {
        rm -rf "$out"
        fail "kept $dir: could not save the work in $base"
        return
      }
    else
      others+=("$base")
    fi
  done
  if [ "${#others[@]}" -gt 0 ]; then
    tar -czf "$out/other.tar.gz" -C "$dir" "${others[@]}" || {
      rm -rf "$out"
      fail "kept $dir: could not save the files that are not in a clone"
      return
    }
  fi

  rm -rf "$dir"
  log "swept $dir into $out"
}

# A repo server's worktree: its work is saved, then the worktree and its
# branch go.
sweep_worktree() {
  local main="$1" name="$2" wt="$3" out branch
  branch="$(git -C "$wt" symbolic-ref --quiet --short HEAD)" || branch=""
  out="$(new_salvage_dir "$name-$(basename "$wt")")" || { fail "kept $wt: could not make its salvage folder"; return; }

  salvage_checkout "$wt" "$out" "$name" head || {
    rm -rf "$out"
    fail "kept $wt: could not save its work"
    return
  }
  # Twice --force: removes a worktree with changes, or one left locked.
  git -C "$main" worktree remove --force --force "$wt" || {
    fail "kept $wt: git worktree remove failed; its work is saved in $out"
    return
  }
  if [ -n "$branch" ]; then
    git -C "$main" branch --quiet -D "$branch" || fail "$name: could not delete branch $branch of $wt"
  fi
  log "swept $wt into $out"
}

if [ -z "$live_procs" ]; then
  # This script's own process always has one, so lsof failed: without it a
  # folder in use cannot be told from an idle one.
  fail "lsof listed no working directories, so nothing was swept"
else
  # Working directories sessions recorded lately, read once for every folder.
  cwds_subagent="$(recent_cwds "$subagent_done_minutes")"
  cwds_session="$(recent_cwds "$session_done_minutes")"

  for dir in "$sessions"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    look_in "$dir"
    [ "$running" = 0 ] || continue
    if [ "$folder_procs" = 0 ] && ! worked_in "$dir" "$cwds_session" \
      && untouched "$dir" -mmin -"$session_done_minutes" && session_has_nothing_to_lose "$dir"; then
      sweep_session "$dir"
      continue
    fi
    untouched "$dir" -mmin -"$trim_minutes" || continue
    if [ "$folder_procs" = 0 ] && untouched "$dir" -mtime -"$stale_days"; then
      sweep_session "$dir"
      continue
    fi
    for clone in "$dir"/*; do
      [ ! -L "$clone" ] && [ -d "$clone/.git" ] || continue
      trim_build_output "$clone"
    done
  done

  for name in "$@"; do
    main="$code/$name"
    [ -d "$main/.git" ] || continue
    # Forgets worktrees whose folders are already gone.
    git -C "$main" worktree prune || fail "$name: git worktree prune failed"
    # One "<path><tab><lock reason>" line per worktree; the reason is empty
    # when it is not locked or locked without one.
    while IFS=$'\t' read -r wt lock; do
      case "$wt" in "$main/.claude/worktrees/"*) ;; *) continue ;; esac
      [ -d "$wt" ] || continue
      look_in "$wt"
      [ "$running" = 0 ] || continue
      case "$(basename "$wt")" in
        agent-*) done_minutes="$subagent_done_minutes" cwds="$cwds_subagent" ;;
        *) done_minutes="$session_done_minutes" cwds="$cwds_session" ;;
      esac
      if [ "$folder_procs" = 0 ] && ! lock_held "$lock" && ! worked_in "$wt" "$cwds" \
        && untouched "$wt" -mmin -"$done_minutes" && nothing_to_lose "$wt"; then
        sweep_worktree "$main" "$name" "$wt"
        continue
      fi
      untouched "$wt" -mmin -"$trim_minutes" || continue
      if [ "$folder_procs" = 0 ] && untouched "$wt" -mtime -"$stale_days"; then
        sweep_worktree "$main" "$name" "$wt"
        continue
      fi
      trim_build_output "$wt"
    done < <(git -C "$main" worktree list --porcelain | awk '
      /^worktree / { if (p != "") print p "\t" r; p = substr($0, 10); r = "" }
      /^locked / { r = substr($0, 8) }
      END { if (p != "") print p "\t" r }')
  done
fi

sweep_simulators
sweep_periphery

find "$salvage" -mindepth 1 -maxdepth 1 -type d -mtime +"$salvage_days" -exec rm -rf {} + \
  || fail "could not delete salvage over $salvage_days days old"

if [ -n "$failures" ]; then
  printf '%s' "$failures" >"$state_dir/sweep-failed"
else
  rm -f "$state_dir/sweep-failed"
fi
printf '%s' "$leftovers" >"$state_dir/leftover-processes"
# The heartbeat reports and removes these; it may not have run since the last
# sweep, so add to what is there.
if [ -n "$stopped" ]; then printf '%s' "$stopped" >>"$state_dir/stopped-processes"; fi
date +%s >"$state_dir/sweep-last"

# For the heartbeat's low-disk report, largest first, in KB. du counts a CI
# job's VM clone in full, though it shares most of its blocks with the image,
# so ~/.tart reads high while a job runs. A missing folder is left out.
for d in "$HOME/.tart" "$code" "$HOME/Library/Developer" "$HOME/Library/Caches" "$HOME/.colima"; do
  [ -d "$d" ] && du -xsk "$d" 2>/dev/null
done | sort -rn >"$state_dir/disk-usage.new"
mv "$state_dir/disk-usage.new" "$state_dir/disk-usage"
