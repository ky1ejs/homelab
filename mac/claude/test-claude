#!/bin/bash
# mac/claude/test-claude - checks, on Linux in CI, the parts of the session
# scripts that act on their own: the sweep's stop of processes left in a
# session folder (./sweep-sessions) and its drop of the Cut databases and
# Redis keys no checkout has, which Healthchecks check the heartbeat
# pings with what (./heartbeat), and what ./session-cleanup stops.
#
# The sweep runs whole, against stand-ins for lsof and ps that report real
# test processes as launchd's, over a day old. It sends real signals to those
# processes only. The heartbeat's checks need a Mac, so this runs only its
# server log checks and its last part, the stopped-process notes and the
# pings, cut out of the script, against stand-ins for launchctl, stat and
# curl. The drops run against a stand-in for docker. session-cleanup runs
# whole, from a stand-in
# for a Claude Code session, against stand-ins for lsof and xcrun. None can
# check that macOS prints what the stand-ins do.
#
# Usage: mac/claude/test-claude. Exits 1 on the first failed check. Linux
# only: the fixtures use GNU touch and ps.
#
# The stand-ins are scripts written in single quotes, to expand when they run.
# shellcheck disable=SC2016
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
tmp="$(mktemp -d)"
pids=""
# Each test process and all it started, such as the shells' sleeps, listed
# before any is killed, since a child whose parent dies leaves the tree.
descendants() {
  local c
  for c in $(pgrep -P "$1"); do
    echo "$c"
    descendants "$c"
  done
}
cleanup() {
  local all="" p
  for p in $pids; do all="$all $p $(descendants "$p")"; done
  for p in $all; do kill -KILL "$p" 2>/dev/null || true; done
  rm -rf "$tmp"
}
trap cleanup EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }
real_ps="$(command -v ps)"
real_sleep="$(command -v sleep)"
fake="$tmp/bin"
mkdir -p "$fake" "$tmp/ps" "$tmp/cwd"
stub() { printf '#!/bin/bash\n%s\n' "$2" >"$fake/$1"; chmod +x "$fake/$1"; }

# --- the sweep -------------------------------------------------------------------

export HOME="$tmp/home"
code="$HOME/code"
projects="$HOME/.claude/projects"
caches="$HOME/Library/Caches/claude-rc"
mkdir -p "$code/any/sessions" "$projects"
git -c init.defaultBranch=main init -q "$code/cut"
git -C "$code/cut" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
wts="$code/cut/.claude/worktrees"
for w in idle stubborn fresh unknown busy reused; do
  git -C "$code/cut" worktree add -q "$wts/$w" -b "$w"
done

# transcript <folder name under ~/.claude/projects> <cwd> <touch -d date>
transcript() {
  mkdir -p "$projects/$1"
  printf '{"type":"user","cwd":"%s","message":{"content":"hi"}}\n' "$2" >"$projects/$1/$RANDOM.jsonl"
  touch -d "$3" "$projects/$1"/*.jsonl
}
dashed() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

# Not used for 5 days, by a session that worked in the worktree itself and
# one that started in the repo and moved in.
transcript "$(dashed "$wts/idle")" "$wts/idle" "5 days ago"
transcript "$(dashed "$code/cut")" "$wts/idle/ios" "6 days ago"
transcript "$(dashed "$wts/stubborn")" "$wts/stubborn" "5 days ago"
transcript "$(dashed "$wts/reused")" "$wts/reused" "5 days ago"
transcript "$(dashed "$wts/busy")" "$wts/busy" "5 days ago"
# Its own folder is stale, but a session working there now keeps its
# transcript under the repo's name.
transcript "$(dashed "$wts/fresh")" "$wts/fresh" "9 days ago"
transcript "$(dashed "$code/cut")-2" "$wts/fresh" "1 hour ago"
# A folder whose name only starts the same does not count for "unknown".
transcript "$(dashed "$wts/unknown2")" "${wts}/unknown2" "5 days ago"

# start <worktree> <ignore TERM: 1 or 0>: a stand-in for a server a session
# left running: a shell holding a child. Prints the shell's pid.
start() {
  local trap_cmd=""
  [ "$2" = 1 ] && trap_cmd='trap "" TERM;'
  (cd "$1" && exec bash -c "$trap_cmd $real_sleep 300 & wait") >/dev/null 2>&1 &
  echo $!
}
p_idle="$(start "$wts/idle" 0)"
p_stubborn="$(start "$wts/stubborn" 1)"
p_fresh="$(start "$wts/fresh" 0)"
p_unknown="$(start "$wts/unknown" 0)"
p_busy="$(start "$wts/busy" 0)"
p_reused="$(start "$wts/reused" 0)"
pids="$p_idle $p_stubborn $p_fresh $p_unknown $p_busy $p_reused"
"$real_sleep" 0.5

lsof_out=""
while read -r w p; do
  printf 'Mon Nov 10 09:00:00 2026\n' >"$tmp/ps/$p.lstart"
  printf '%s\n' "$wts/$w" >"$tmp/cwd/$p"
  lsof_out="${lsof_out}p$p"$'\n'"cbash"$'\n'"R1"$'\n'"n$wts/$w"$'\n'
done <<EOF
idle $p_idle
stubborn $p_stubborn
fresh $p_fresh
unknown $p_unknown
busy $p_busy
reused $p_reused
EOF
# A shell with a parent in "busy": a session at work there.
lsof_out="${lsof_out}p999999"$'\n'"czsh"$'\n'"R4242"$'\n'"n$wts/busy"$'\n'
printf '%s' "$lsof_out" >"$tmp/lsof"
# "reused": its pid now belongs to a process that started later.
printf 'Mon Nov 17 12:00:00 2026\n' >"$tmp/ps/$p_reused.lstart.now"

stub lsof 'case " $* " in
  *" -u "*) cat '"$tmp"'/lsof ;;
  *" -p "*) while [ "$1" != -p ]; do shift; done; f='"$tmp"'/cwd/$2
    [ -f "$f" ] && printf "p%s\nn%s\n" "$2" "$(cat "$f")" ;;
esac'
stub ps 'f='"$tmp"'/ps; pid="${!#}"
case "$*" in
  "-o etime= -p "*) [ -f "$f/$pid.lstart" ] && echo "2-01:00:00" ;;
  "-o lstart= -p "*) [ -f "$f/$pid.lstart" ] && cat "$f/$pid.lstart" ;;
  "-o ppid= -o lstart= -p "*)
    if [ -f "$f/$pid.lstart.now" ]; then echo "1 $(cat "$f/$pid.lstart.now")"
    elif [ -f "$f/$pid.lstart" ]; then echo "1 $(cat "$f/$pid.lstart")"; fi ;;
  "-axo pid=,ppid=") exec '"$real_ps"' -eo pid=,ppid= ;;
  *) exec '"$real_ps"' "$@" ;;
esac'
stub xcrun 'exit 1'
stub sleep 'exec '"$real_sleep"' 0.1'

PATH="$fake:$PATH" "$here/sweep-sessions" cut 2>"$tmp/sweep.log" || true

running() { kill -0 "$1" 2>/dev/null && ! "$real_ps" -o stat= -p "$1" | grep -q Z; }
check_stopped() {
  running "$2" && fail "sweep: $1's process is still running"
  grep -q "stopped bash (pid $2, .*in $wts/$1: it had no parent, and no session had worked there for 4 days" "$caches/stopped-processes" \
    || fail "sweep: no stop note for $1"
  grep -q "^$2	" "$caches/leftover-processes" && fail "sweep: $1 is still listed as left over"
  true
}
check_kept() {
  running "$2" || fail "sweep: $1's process was stopped"
  grep -q "^$2	" "$caches/leftover-processes" || fail "sweep: $1 is not listed as left over"
  grep -q "pid $2," "$caches/stopped-processes" && fail "sweep: $1 has a stop note"
  true
}
wait "$p_idle" "$p_stubborn" 2>/dev/null || true
check_stopped idle "$p_idle"
check_stopped stubborn "$p_stubborn"
check_kept fresh "$p_fresh"
check_kept unknown "$p_unknown"
check_kept busy "$p_busy"
# Not the process it found: left alone, and no failure.
running "$p_reused" || fail "sweep: reused's process was stopped"
grep -q "pid $p_reused," "$caches/leftover-processes" "$caches/stopped-processes" && fail "sweep: reused is listed"
grep -q "had already stopped" "$tmp/sweep.log" || fail "sweep: no log line for reused"
grep -q "could not stop" "$caches/sweep-failed" 2>/dev/null && fail "sweep: a stop failed: $(cat "$caches/sweep-failed")"
# The children went too: the shells are gone, and no sleep 300 of theirs.
for p in $p_idle $p_stubborn; do
  "$real_ps" -eo ppid= | grep -qx " *$p" && fail "sweep: a child of $p is still running"
done
echo "ok   sweep stops only what idle folders hold"

# --- the sweep's quick rule and Periphery's cache --------------------------------

export HOME="$tmp/home2"
code="$HOME/code"
projects="$HOME/.claude/projects"
caches="$HOME/Library/Caches/claude-rc"
mkdir -p "$code/any/sessions" "$projects" "$HOME/.claude/sessions"
git -c init.defaultBranch=main init -q --bare "$tmp/origin.git"
git -c init.defaultBranch=main init -q "$code/cut"
printf 'ios/.derivedData/\n' >"$code/cut/.gitignore"
# A stand-in for Cut's scripts/teardown: it notes which folder it ran in.
mkdir -p "$code/cut/scripts"
printf '#!/bin/bash\ntouch "$HOME/teardown-$(basename "$PWD")"\n' >"$code/cut/scripts/teardown"
chmod +x "$code/cut/scripts/teardown"
git -C "$code/cut" add .gitignore scripts/teardown
git -C "$code/cut" -c user.name=t -c user.email=t@t commit -q -m init
git -C "$code/cut" remote add origin "$tmp/origin.git"
git -C "$code/cut" push -q origin main
# A tag on a commit that no branch has, as when a branch is deleted after
# tagging. Every clone of origin fetches it.
git -C "$code/cut" checkout -q -b gone
git -C "$code/cut" -c user.name=t -c user.email=t@t commit -q --allow-empty -m tagged
git -C "$code/cut" tag v1
git -C "$code/cut" push -q origin v1
git -C "$code/cut" checkout -q main
git -C "$code/cut" branch -q -D gone
git -C "$code/cut" tag -d v1 >/dev/null
git -C "$code/cut" fetch -q origin
wts="$code/cut/.claude/worktrees"
# Each on its own branch at main, which origin has, unless changed below.
for w in agent-pushed agent-local agent-dirty agent-recent agent-touched agent-locked \
  agent-stale-lock agent-busy agent-server bridge-old bridge-young bridge-open; do
  git -C "$code/cut" worktree add -q "$wts/$w" -b "$w"
done
git -C "$wts/agent-local" -c user.name=t -c user.email=t@t commit -q --allow-empty -m local
touch "$wts/agent-dirty/notes.txt"
# The lock reasons Claude Code writes.
git -C "$code/cut" worktree lock --reason "claude agent agent-a1b2c3 (pid $$ start 1795370848)" "$wts/agent-locked"
git -C "$code/cut" worktree lock --reason "claude agent agent-d4e5f6 (pid 4194300 start 1795370848)" "$wts/agent-stale-lock"
mkdir -p "$wts/bridge-young/ios/.derivedData/Build"
transcript "$(dashed "$wts/agent-recent")" "$wts/agent-recent" "10 minutes ago"
# An open session, waiting for a prompt: no recent transcript, but Claude
# Code lists it, with this shell's pid as a live one.
printf '{"pid":%s,"cwd":"%s"}\n' "$$" "$wts/bridge-open" >"$HOME/.claude/sessions/$$.json"
# Any-repo folders: a pushed clone; a clone beside a loose file; one with a
# stash only; one with an unpushed commit on a branch it is not on.
for s in s-clean s-loose s-stash s-branch; do
  git clone -q "$tmp/origin.git" "$code/any/sessions/$s/cut"
done
touch "$code/any/sessions/s-loose/notes.txt"
echo x >"$code/any/sessions/s-stash/cut/.gitignore"
git -C "$code/any/sessions/s-stash/cut" -c user.name=t -c user.email=t@t stash -q
git -C "$code/any/sessions/s-branch/cut" checkout -q -b side
git -C "$code/any/sessions/s-branch/cut" -c user.name=t -c user.email=t@t commit -q --allow-empty -m side
git -C "$code/any/sessions/s-branch/cut" checkout -q main
backdate() { find "$1" -exec touch -h -d "$2" {} +; }
for w in agent-pushed agent-local agent-dirty agent-recent agent-touched agent-locked agent-stale-lock agent-busy agent-server; do
  backdate "$wts/$w" "2 hours ago"
done
touch -d "30 minutes ago" "$wts/agent-touched/.gitignore"
backdate "$wts/bridge-old" "5 days ago"
backdate "$wts/bridge-young" "3 days ago"
backdate "$wts/bridge-open" "5 days ago"
backdate "$code/any/sessions" "5 days ago"
# Periphery: one being written now, one used within the day, and two older
# ones, the newer of which is the newest once the others are new too.
pc="$HOME/Library/Caches/com.github.peripheryapp"
mkdir -p "$pc/DerivedData-busy/x" "$pc/DerivedData-recent/x" "$pc/DerivedData-old/x"
backdate "$pc/DerivedData-busy" "50 hours ago"
touch "$pc/DerivedData-busy/x"
backdate "$pc/DerivedData-recent" "20 hours ago"
backdate "$pc/DerivedData-old" "48 hours ago"

# Processes of worker's: one in no session folder, so lsof's output is not
# empty; a command a session runs in agent-busy; a server left running in
# agent-server. Neither pid exists, so neither is stopped.
printf 'p1\ncbash\nR0\nn/\np999997\nczsh\nR4242\nn%s\np999998\ncbun\nR1\nn%s\n' \
  "$wts/agent-busy" "$wts/agent-server" >"$tmp/lsof"
PATH="$fake:$PATH" "$here/sweep-sessions" cut 2>"$tmp/sweep2.log" || true

gone() { [ -d "$1" ] && fail "sweep: $1 was kept"; true; }
kept() { [ -d "$1" ] || fail "sweep: $1 was deleted"; true; }
gone "$wts/agent-pushed"
gone "$wts/agent-stale-lock"
gone "$wts/bridge-old"
kept "$wts/agent-local"
kept "$wts/agent-dirty"
kept "$wts/agent-recent"
kept "$wts/agent-touched"
kept "$wts/agent-locked"
kept "$wts/agent-busy"
kept "$wts/agent-server"
kept "$wts/bridge-young"
kept "$wts/bridge-open"
[ -d "$wts/bridge-young/ios/.derivedData" ] && fail "sweep: bridge-young's DerivedData was not trimmed"
gone "$code/any/sessions/s-clean"
kept "$code/any/sessions/s-loose"
kept "$code/any/sessions/s-stash"
kept "$code/any/sessions/s-branch"
git -C "$code/cut" show-ref --verify --quiet refs/heads/agent-pushed && fail "sweep: agent-pushed's branch was kept"
git -C "$code/cut" show-ref --verify --quiet refs/heads/agent-local || fail "sweep: agent-local's branch was deleted"
# Teardown ran in what was swept, and not in what was kept.
for f in agent-pushed bridge-old cut; do
  [ -f "$HOME/teardown-$f" ] || fail "sweep: scripts/teardown did not run for $f"
done
[ -f "$HOME/teardown-agent-local" ] && fail "sweep: scripts/teardown ran in a kept worktree"
# Nothing to save, so no salvage.
[ -z "$(find "$code/salvage" -mindepth 1 -maxdepth 1)" ] \
  || fail "sweep: made salvage for folders with nothing to lose: $(ls "$code/salvage")"
kept "$pc/DerivedData-busy"
kept "$pc/DerivedData-recent"
gone "$pc/DerivedData-old"

# Alone and old, the newest entry stays, warm for the next scan.
rm -rf "${pc:?}"/*
mkdir -p "$pc/DerivedData-last/x"
backdate "$pc/DerivedData-last" "72 hours ago"
PATH="$fake:$PATH" "$here/sweep-sessions" cut 2>>"$tmp/sweep2.log" || true
kept "$pc/DerivedData-last"

# The cap goes oldest first: once the entries kept so far fill it, every
# older one goes, even one small enough to fit.
rm -rf "${pc:?}"/*
for e in a:200:1 b:600:2 c:100:3; do
  IFS=: read -r name kb hours <<<"$e"
  mkdir -p "$pc/DerivedData-$name"
  dd if=/dev/zero of="$pc/DerivedData-$name/f" bs=1024 count="$kb" 2>/dev/null
  backdate "$pc/DerivedData-$name" "$hours hours ago"
done
SWEEP_PERIPHERY_MAX_KB=700 PATH="$fake:$PATH" "$here/sweep-sessions" cut 2>>"$tmp/sweep2.log" || true
kept "$pc/DerivedData-a"
gone "$pc/DerivedData-b"
gone "$pc/DerivedData-c"

# xcrun's stand-in fails, so the simulators' lines are expected.
if [ -f "$caches/sweep-failed" ] && grep -v '^simulators: ' "$caches/sweep-failed" | grep -q .; then
  fail "sweep: $(cat "$caches/sweep-failed")"
fi
echo "ok   sweep deletes idle folders with nothing to lose, and caps Periphery's cache"

# --- the sweep's drop of Cut's databases and Redis keys --------------------------

export HOME="$tmp/home3"
code="$HOME/code"
caches="$HOME/Library/Caches/claude-rc"
mkdir -p "$code/any/sessions" "$HOME/.claude/projects"
git -c init.defaultBranch=main init -q "$code/cut"
derive="$code/cut/scripts/lib/derive-resources.sh"
mkdir -p "${derive%/*}"
# A stand-in for Cut's scripts/lib/derive-resources.sh that gives the same
# names.
cat >"$derive" <<'EOF'
DERIVED_HASH=$(echo -n "$1" | shasum -a 256 | cut -c1-8)
DERIVED_DB_NAME="${2:-cut_local}_${DERIVED_HASH}"
DERIVED_TEST_DB_PREFIX="tests_${DERIVED_HASH}"
DERIVED_REDIS_KEY_PREFIX="wt:${DERIVED_HASH}:"
EOF
cp "$derive" "$tmp/derive-resources.sh"
git -C "$code/cut" add scripts
git -C "$code/cut" -c user.name=t -c user.email=t@t commit -q -m init
wts="$code/cut/.claude/worktrees"
for w in live gone; do git -C "$code/cut" worktree add -q "$wts/$w" -b "$w"; done
git clone -q "$code/cut" "$code/any/sessions/s1/cut"
# shellcheck disable=SC1091 # written above.
hash_of() { (. "$tmp/derive-resources.sh" "$1" cut_wt && echo "$DERIVED_HASH"); }
h_main="$(hash_of "$code/cut")"
h_live="$(hash_of "$wts/live")"
h_any="$(hash_of "$code/any/sessions/s1/cut")"
h_gone="$(hash_of "$wts/gone")"
# A worktree gone too, whose database a process still has open.
h_open="$(hash_of "$wts/open")"
git -C "$code/cut" worktree remove "$wts/gone"

# A stand-in for docker: Cut's containers pg1 and rd1, the databases in
# $dk/dbs, connection counts in $dk/conns-<db>, each Redis database's key
# prefixes in $dk/redis-<n>. It notes drops in $dk/dropped and unlinks, as
# "<n> <pattern>", in $dk/unlinked.
dk="$tmp/dk"
mkdir -p "$dk"
stub docker 'd='"$dk"'
case "$1" in
  info) exit 0 ;;
  ps) case "$*" in *service=postgres*) echo pg1 ;; *service=redis*) echo rd1 ;; esac ;;
  exec)
    c="$2"; shift 2
    case "$c:$1" in
      pg1:psql) q="${!#}"
        case "$q" in
          "SELECT datname"*) cat "$d/dbs" ;;
          *count*) db="$(printf %s "$q" | sed "s/.*datname = '"'"'\(.*\)'"'"'/\1/")"
            cat "$d/conns-$db" 2>/dev/null || echo 0 ;;
          *) exit 1 ;;
        esac ;;
      pg1:dropdb) echo "${!#}" >>"$d/dropped" ;;
      rd1:redis-cli)
        if [ $# = 7 ]; then echo "$3 $7" >>"$d/unlinked"; echo 4
        else cat "$d/redis-$3" 2>/dev/null || true; fi ;;
      *) exit 1 ;;
    esac ;;
  *) exit 1 ;;
esac'
# postgres and cut_local_* match no Cut checkout's form: the query leaves
# them out, and the sweep would skip them if it did not.
printf '%s\n' "cut_wt_$h_main" "cut_wt_$h_live" "cut_wt_$h_any" "cut_wt_$h_gone" "cut_wt_$h_open" \
  "tests_${h_gone}_worker_1" "tests_${h_live}_worker_2" postgres "cut_local_$h_gone" >"$dk/dbs"
echo 2 >"$dk/conns-cut_wt_$h_open"
n_gone=$(( (16#$h_gone % 15) + 1 ))
printf '%s\n' "wt:$h_gone:" "wt:$h_live:" "wt:$h_any:" >"$dk/redis-$n_gone"

sweep3() {
  rm -f "$dk/dropped" "$dk/unlinked" "$caches/sweep-failed"
  PATH="$fake:$PATH" "$here/sweep-sessions" cut 2>>"$tmp/sweep3.log" || true
}
cut_failures() { grep '^Cut: ' "$caches/sweep-failed" 2>/dev/null || true; }

sweep3
[ -z "$(cut_failures)" ] || fail "sweep: $(cut_failures)"
[ "$(sort "$dk/dropped" 2>/dev/null | tr '\n' ' ')" = "cut_wt_$h_gone tests_${h_gone}_worker_1 " ] \
  || fail "sweep: dropped '$(cat "$dk/dropped" 2>/dev/null)', not only gone's databases"
[ "$(cat "$dk/unlinked" 2>/dev/null)" = "$n_gone wt:$h_gone:*" ] \
  || fail "sweep: unlinked '$(cat "$dk/unlinked" 2>/dev/null)', not only gone's Redis keys"
grep -q "kept Cut database cut_wt_$h_open: no checkout has it, but 2 connections use it" "$tmp/sweep3.log" \
  || fail "sweep: no log line for the database still in use"
grep -q "dropped Cut database cut_wt_$h_gone: no checkout has it" "$tmp/sweep3.log" \
  || fail "sweep: no log line for the drop"

# Names of another form from Cut's script: nothing dropped, and a failure.
printf '%s\n' 'DERIVED_DB_NAME="cut_wt_v2_$1"' 'DERIVED_TEST_DB_PREFIX=x' 'DERIVED_REDIS_KEY_PREFIX=x' >"$derive"
sweep3
[ -e "$dk/dropped" ] || [ -e "$dk/unlinked" ] && fail "sweep: dropped with names it did not expect"
cut_failures | grep -q "no longer gives the names" || fail "sweep: no failure for names of another form"
cp "$tmp/derive-resources.sh" "$derive"

# A checkout whose worktrees git cannot list: nothing dropped, and a failure.
mkdir -p "$code/broken"
echo "gitdir: $tmp/nowhere" >"$code/broken/.git"
sweep3
[ -e "$dk/dropped" ] || [ -e "$dk/unlinked" ] && fail "sweep: dropped though a checkout's worktrees were not listed"
cut_failures | grep -q "could not list every checkout's worktrees" || fail "sweep: no failure for the unlisted worktrees"
rm -rf "$code/broken"
echo "ok   sweep drops only the Cut databases and Redis keys no checkout has"

# --- the heartbeat's pings ---------------------------------------------------------

# The notes and the pings, from the script itself.
part="$tmp/heartbeat-part"
{
  sed -n '/^# Processes the sweep stopped/,/^# A warning at one run/p' "$here/heartbeat"
  echo 'notes="$stopped_notes"'
  sed -n '/^# send_ping <url>/,$p' "$here/heartbeat"
} >"$part"
grep -q 'send_ping "\$host_url"' "$part" || fail "heartbeat: could not cut out the pings"

stub curl 'url="${!#}"; body=""
while [ $# -gt 1 ]; do [ "$1" = --data-raw ] && body="$2"; shift; done
printf "%s|%s\n" "$url" "$(printf %s "$body" | head -n 1)" >>'"$tmp"'/pings
case "$url" in *down*) exit 7 ;; esac'

# ping <rc url or -> <host url or -> <rc problems> <host problems>
ping() {
  local cfg="$tmp/hb/.config/claude-rc"
  rm -rf "$tmp/hb" "$tmp/pings"
  mkdir -p "$cfg" "$tmp/hb/state"
  [ "$1" = - ] || echo "$1" >"$cfg/ping-url"
  [ "$2" = - ] || echo "$2" >"$cfg/host-ping-url"
  [ -z "${5:-}" ] || printf '%s\n' "$5" >"$tmp/hb/state/stopped-processes"
  : >"$tmp/pings"
  PATH="$fake:$PATH" bash -c 'set -euo pipefail
    ping_file="$1/.config/claude-rc/ping-url"; host_ping_file="$1/.config/claude-rc/host-ping-url"
    state_dir="$1/state"; stamp=T; rc_problems="$2"; problems="$3"
    source "$4"' _ "$tmp/hb" "$3" "$4" "$part" >"$tmp/hb/out" 2>&1 \
    || fail "heartbeat: the pings failed to run: $(cat "$tmp/hb/out")"
}
expect() { grep -qxF "$1" "$tmp/pings" || fail "heartbeat: no ping '$1' in: $(cat "$tmp/pings")"; }
pings() { [ "$(wc -l <"$tmp/pings")" = "$1" ] || fail "heartbeat: $(wc -l <"$tmp/pings") pings, not $1: $(cat "$tmp/pings")"; }

ping https://rc https://host "" "- swap over 8 GB"$'\n'
pings 2; expect "https://rc|"; expect "https://host/fail|- swap over 8 GB"
ping https://rc - "" "- swap over 8 GB"$'\n'
pings 1; expect "https://rc/fail|Remote Control servers are up. The mac studio itself has problems:"
ping https://rc - "- cut server is not running"$'\n' ""
pings 1; expect "https://rc/fail|Remote Control has problems:"
ping - https://host "- cut server is not running"$'\n' ""
pings 1; expect "https://host|"
ping - - "- cut server is not running"$'\n' ""
pings 0
echo "ok   heartbeat pings each check that has a URL"

ping https://rc https://host "" "" "2026-11-17 06:00 stopped bun (pid 1)"
expect "https://host|2026-11-17 06:00 stopped bun (pid 1)"
[ -e "$tmp/hb/state/stopped-processes.reading" ] && fail "heartbeat: notes kept after a ping that carried them"
ping https://rc https://host-down "" "" "2026-11-17 06:00 stopped bun (pid 1)"
grep -q "stopped bun" "$tmp/hb/state/stopped-processes.reading" 2>/dev/null \
  || fail "heartbeat: notes lost after a failed ping"
echo "ok   heartbeat keeps stop notes until a ping carries them"

# --- the heartbeat's server logs --------------------------------------------------

# The loop over the servers, from the script itself, against stand-ins for
# launchctl, which reports the job running with the pid in $tmp/hl/pid, and
# for BSD stat's -f %z, the file's size.
part="$tmp/heartbeat-servers"
{
  sed -n '/^auth_errors=/p; /^tls_errors=/p' "$here/heartbeat"
  sed -n '/^for plist in "\$HOME"\/Library\/LaunchAgents\/dev.kylejs.claude-rc/,/^done$/p' "$here/heartbeat"
} >"$part"
if ! grep -q 'tls_errors=' "$part" || ! grep -q '^done$' "$part"; then
  fail "heartbeat: could not cut out the server checks"
fi

stub launchctl 'printf "\tstate = running\n\tpid = %s\n" "$(cat '"$tmp"'/hl/pid)"'
stub stat '[ "$1" = -f ] && [ "$2" = %z ] && exec wc -c <"$3"; exit 1'

hl="$tmp/hl"
mkdir -p "$hl/Library/LaunchAgents" "$hl/Library/Logs" "$hl/state"
: >"$hl/Library/LaunchAgents/dev.kylejs.claude-rc.cut.plist"
log="$hl/Library/Logs/claude-rc-cut.log"
: >"$log"
# servers <pid> [log lines]: one run, which appends the lines first; prints
# its problems.
servers() {
  echo "$1" >"$hl/pid"
  if [ $# -gt 1 ]; then printf '%s\n' "$2" >>"$log"; fi
  PATH="$fake:$PATH" HOME="$hl" bash -c 'set -euo pipefail
    state_dir="$1/state"; logs="$1/Library/Logs"; uid=501; max_log_bytes=$((10 * 1024 * 1024))
    rc_problems=""; add_rc_problem() { rc_problems="${rc_problems}$1"$'"'"'\n'"'"'; }
    source "$2"; printf "%s" "$rc_problems"' _ "$hl" "$part" 2>&1 \
    || fail "heartbeat: the server checks failed to run"
}

out="$(servers 100 "Connected to claude.ai")"
[ -z "$out" ] || fail "heartbeat: problems from a healthy log: $out"
out="$(servers 100 "Error: unable to get local issuer certificate")"
grep -q '^cut: TLS certificate error' <<<"$out" || fail "heartbeat: missed the certificate error: $out"
out="$(servers 100)"
grep -q '^cut: TLS certificate error' <<<"$out" || fail "heartbeat: forgot the certificate error while the same process runs: $out"
out="$(servers 100)"
grep -q '^cut: TLS certificate error' <<<"$out" || fail "heartbeat: forgot the certificate error while the same process runs: $out"
out="$(servers 200)"
[ -z "$out" ] || fail "heartbeat: kept the certificate error after the server restarted: $out"
echo "ok   heartbeat reports a certificate error until the server restarts"

# An error the old process logged just before a restart: reported once, not
# kept for the new process.
servers 300 "Error: unable to get local issuer certificate" >/dev/null
out="$(servers 400)"
[ -z "$out" ] || fail "heartbeat: an earlier run's error came back after a restart: $out"
printf '%s\n' "Error: unable to get local issuer certificate" >>"$log"
out="$(servers 500)"
grep -q '^cut: TLS certificate error' <<<"$out" || fail "heartbeat: missed an error logged before a restart: $out"
out="$(servers 500)"
[ -z "$out" ] || fail "heartbeat: blamed the new process for the old one's error: $out"
echo "ok   heartbeat does not blame a restarted server for the old process's error"

# A match early in a long stretch of new log, which a grep -q on tail's pipe
# would lose to SIGPIPE under pipefail.
{ echo "error: not logged in"; head -c 1048576 /dev/zero | tr '\0' 'x'; echo; } >>"$log"
out="$(servers 200)"
grep -q '^cut: sign-in or trust error' <<<"$out" || fail "heartbeat: missed a sign-in error early in a long log: $out"
echo "ok   heartbeat finds a sign-in error early in a long stretch of log"

# --- session-cleanup ---------------------------------------------------------------

# A stand-in for a Claude Code session, run as ".../claude-code/claude
# <folder> <command>" so that session-cleanup finds it. Like Claude Code, it
# starts its tools (here an MCP server) in its own process group, and runs
# each command with setsid, in a shell that leads a group of its own. Its
# commands leave a server that `bash -c` exec'd, so that it is the session's
# child, and a shell holding a server in the background. A shell it started
# in its own group holds one too: a shell is never a tool.
session="$tmp/claude-code/claude"
mkdir -p "${session%/*}"
printf '#!/bin/bash\ncd "$1" || exit 1\n%s\n' '
'"$real_sleep"' 300 & echo "mcp $!" >>'"$tmp"'/session-pids
bash -c "'"$real_sleep"' 301 & wait" & echo "group-shell $!" >>'"$tmp"'/session-pids
setsid bash -c "exec '"$real_sleep"' 302" & echo "execd $!" >>'"$tmp"'/session-pids
setsid bash -c "'"$real_sleep"' 303 & wait" & echo "background $!" >>'"$tmp"'/session-pids
'"$real_sleep"' 0.5
setsid bash -c "$2"
wait 2>/dev/null' >"$session"
chmod +x "$session"

for w in one two; do
  git -C "$code/cut" worktree add -q "$wts/$w" -b "$w"
done
# Another session's server, in the other worktree.
(cd "$wts/two" && exec "$real_sleep" 304) &
p_other=$!
disown "$p_other"
pids="$pids $p_other"

cleanup_bin="$tmp/cleanup-bin"
mkdir -p "$cleanup_bin"
sed "s|^jq=\"@jq@\"|jq=\"$(command -v jq)\"|" "$here/session-cleanup" >"$cleanup_bin/session-cleanup"
chmod +x "$cleanup_bin/session-cleanup"
# lsof -a -u UID -d cwd -Fpcn, from /proc.
printf '#!/bin/bash\n%s\n' 'for p in /proc/[0-9]*; do
  c="$(readlink "$p/cwd" 2>/dev/null)" || continue
  printf "p%s\nc%s\nn%s\n" "${p#/proc/}" "$(cat "$p/comm")" "$c"
done' >"$cleanup_bin/lsof"
printf '#!/bin/bash\n%s\n' 'case "$2" in
  list) echo "{\"devices\":{\"r\":[{\"udid\":\"U1\",\"state\":\"Booted\",\"name\":\"E2E @cut/one\"},{\"udid\":\"U2\",\"state\":\"Booted\",\"name\":\"E2E @cut/two\"}]}}" ;;
  delete) echo "$3" >>'"$tmp"'/deleted ;;
esac' >"$cleanup_bin/xcrun"
chmod +x "$cleanup_bin/lsof" "$cleanup_bin/xcrun"

: >"$tmp/session-pids"
PATH="$cleanup_bin:$PATH" "$session" "$wts/one" \
  'session-cleanup 2>&1 | tail -n 50 >'"$tmp"'/cleanup.log; echo "exit ${PIPESTATUS[0]}" >>'"$tmp"'/cleanup.log' &
p_session=$!
disown "$p_session"
pids="$pids $p_session"
for _ in $(seq 50); do grep -q '^exit' "$tmp/cleanup.log" 2>/dev/null && break; "$real_sleep" 0.2; done
# Before any check can fail, so that the EXIT trap stops them.
while read -r _ p; do pids="$pids $p"; done <"$tmp/session-pids"
grep -qx 'exit 0' "$tmp/cleanup.log" || fail "session-cleanup: did not finish, or failed: $(cat "$tmp/cleanup.log" 2>/dev/null)"

session_pid() { awk -v n="$1" '$1 == n { print $2 }' "$tmp/session-pids"; }
# Only a `tail` it spared could write these.
if ! grep -q "^session-cleanup: stopping sleep (pid $(session_pid execd))\$" "$tmp/cleanup.log" \
  || ! grep -qxF 'session-cleanup: deleted simulator E2E @cut/one (U1)' "$tmp/cleanup.log"; then
  fail "session-cleanup: stopped the rest of its own command: $(cat "$tmp/cleanup.log")"
fi
running "$(session_pid mcp)" || fail "session-cleanup: stopped the session's MCP server"
for n in group-shell execd background; do
  running "$(session_pid "$n")" && fail "session-cleanup: did not stop $n: $(cat "$tmp/cleanup.log")"
done
"$real_ps" -eo args= | grep -q "^$real_sleep 30[13]\$" && fail "session-cleanup: a shell's server is still running"
running "$p_other" || fail "session-cleanup: stopped another session's server"
[ "$(cat "$tmp/deleted" 2>/dev/null)" = U1 ] || fail "session-cleanup: deleted $(cat "$tmp/deleted" 2>/dev/null), not only U1"
echo "ok   session-cleanup stops its session's servers, not its tools or other sessions'"
