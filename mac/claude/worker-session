#!/bin/bash
# mac/claude/worker-session - a tmux session inside worker's login session,
# where worker's keychain is unlocked, so the claude.ai sign-in can be stored.
#
#   worker-session start relogin   run by launchd's dev.kylejs.claude-relogin
#   worker-session start shell     run by launchd's dev.kylejs.claude-shell
#   worker-session relogin         what runs inside the relogin session: sign
#                                  in, then restart the Remote Control servers
#
# `relogin` and `worker-shell`, run as kylejs over SSH, start these and attach.
# macOS's /bin/bash is 3.2.
set -euo pipefail

socket="claude-worker"
claude="${CLAUDE_BIN:-/opt/homebrew/bin/claude}"

usage() { sed -n '5,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# tmux commands for the server both sessions share, as arguments to append
# to another tmux command. Mouse mode lets a laptop's trackpad scroll a
# session's history and a drag select text, instead of the terminal sending
# arrow keys. A selection reaches the laptop's clipboard through tmux's
# defaults: set-clipboard is external, and terminal-features give xterm*
# terminals OSC 52. With mouse mode on, tmux's default wheel bindings send a
# full-screen program (less, man, top) mouse events it never asked for, so
# it no longer scrolls; the two bindings send such a program arrow keys, as
# the terminal did before. Run on every start, so a server started before
# an apply gets them too.
options=(
  \; set-option -g mouse on
  \; bind-key -n WheelUpPane if-shell -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M' "if-shell -F '#{alternate_on}' 'send-keys -N 3 Up' 'copy-mode -e'"
  \; bind-key -n WheelDownPane if-shell -F '#{&&:#{alternate_on},#{!=:#{mouse_any_flag},1}}' 'send-keys -N 3 Down' 'send-keys -M'
)

case "${1:-}" in
  start)
    session="${2:-}"
    case "$session" in
      relogin) command=("$0" relogin) ;;
      shell) command=("${SHELL:-/bin/zsh}" -l) ;;
      *) usage ;;
    esac
    if tmux -L "$socket" has-session -t "$session" 2>/dev/null; then
      # A shell keeps its work; a sign-in starts over.
      # "${options[@]:1}" drops the leading separator.
      [ "$session" = shell ] && exec tmux -L "$socket" "${options[@]:1}"
      tmux -L "$socket" kill-session -t "$session"
    fi
    # The options go in the same tmux command, so they reach the server even
    # if the session's command exits at once and takes the server with it.
    exec tmux -L "$socket" new-session -d -s "$session" -x 120 -y 40 -c "$HOME" "${command[@]}" "${options[@]}"
    ;;
  relogin)
    echo "Signing worker in to claude.ai."
    echo "If no browser opens, open the link below on any device, sign in, and paste the code back here."
    echo
    if "$claude" auth login; then
      uid="$(id -u)"
      for label in $(launchctl list | awk '$3 ~ /^dev\.kylejs\.claude-rc\./ { print $3 }'); do
        launchctl kickstart -k "gui/$uid/$label"
        echo "restarted $label"
      done
      echo
      echo "Signed in. The servers are back in the Claude app within a minute."
    else
      echo
      echo "The sign-in did not finish. Run relogin again."
    fi
    echo "Press Enter to close."
    read -r _
    ;;
  *) usage ;;
esac
