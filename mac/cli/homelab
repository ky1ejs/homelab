#!/bin/bash
# homelab (also hl) - the mac studio's management CLI: one entry point for the
# commands that run it, from an SSH session or worker-shell. `hl help` prints
# the command list, from usage() below. The NAS's CLI is bin/homelab; this is
# its counterpart, with the same names where a command means the same thing
# (status, logs, update, git), and the mac studio's own where it does not.
#
# It wraps the existing commands rather than replacing them: mac/apply,
# mac-usage, build-image, build-services-image, ci-drain, worker-shell and
# relogin all still work by their own names, and docs/mac-studio.md still
# shows them. What it adds is `status`, `logs`, and knowing which user each
# command needs.
#
# Two users run it:
# - kylejs, the admin, over SSH. Anything of worker's (its launchd agents,
#   logs and CI state) is in worker's home, which only worker and root can
#   read, so those parts go through sudo: run it with `ssh -t` so sudo can ask
#   for the password once. Without a terminal, status leaves them out and says
#   so.
# - worker, in worker-shell. worker has no sudo, so it gets its own parts and
#   the commands that must run in its login session (image build).
# Each command checks for its user and names the right one when it is wrong.
#
# Installed by mac/cli/default.nix, which fills in the @...@ placeholders.
# It runs under macOS's /bin/bash 3.2: no bash 4 features. Output is ASCII
# only, enforced in CI, like bin/homelab's.
set -euo pipefail

ADMIN="@admin@"
WORKER="@worker@"
WORKER_HOME="@workerHome@"
CHECKOUT="@checkout@"
DOTFILES="@dotfiles@"
SLOTS="@slots@"
DRAIN_MINUTES="@drainMinutes@"
SW="@sw@"

PROG="$(basename "$0")"
ME="$(id -un)"

# --- presentation, the same layer as bin/homelab's ---------------------------

USE_COLOR=1
if [ -n "${NO_COLOR:-}" ]; then USE_COLOR=0; fi
if [ ! -t 1 ]; then USE_COLOR=0; fi
if [ "${TERM:-dumb}" = "dumb" ]; then USE_COLOR=0; fi

C_RESET=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_RED=""; C_YELLOW=""; C_CYAN=""
set_colors() {
  if [ "$USE_COLOR" = 1 ]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
  fi
}

LABEL_W=18
VALUE_W=56

# Values come from logs and state files other programs write, so control and
# non-ASCII bytes are dropped: an escape sequence in a log line must not reach
# the terminal, and the output stays ASCII.
fit() {
  local s max="$2"
  s="$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177-\377')"
  if [ "${#s}" -le "$max" ]; then
    printf '%s' "$s"
  else
    printf '%s...' "${s:0:$((max - 3))}"
  fi
}

section() {
  printf '\n%s%s%s\n' "$C_BOLD" "$1" "$C_RESET"
  printf '%s%s%s\n' "$C_DIM" "$(printf '%*s' 78 '' | tr ' ' '-')" "$C_RESET"
}

# row <ok|bad|warn|info> <label> [value]. The bracketed tag keeps its meaning
# without colour and in a copy-paste.
FAILS=0
row() {
  local kind="$1" label="$2" value="${3:-}" tag color
  case "$kind" in
    ok) tag="ok  "; color="$C_GREEN" ;;
    bad) tag="FAIL"; color="$C_RED"; FAILS=$((FAILS + 1)) ;;
    warn) tag="warn"; color="$C_YELLOW" ;;
    *) tag="    "; color="" ;;
  esac
  printf '  %s[%s]%s %-*s %s\n' "$color" "$tag" "$C_RESET" "$LABEL_W" "$label" "$(fit "$value" "$VALUE_W")"
}

log() { printf '%s[%s]%s %s\n' "$C_CYAN" "$PROG" "$C_RESET" "$*" >&2; }
die() { printf '%s[%s]%s %s\n' "$C_RED" "$PROG" "$C_RESET" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
$PROG - the mac studio's management CLI. The NAS's is bin/homelab.
homelab and hl are the same command.

  $PROG status                       config, worker, CI slots, heartbeats, disk
  $PROG logs [name] [-f] [-n <lines>] a log, -f to follow; no name lists them
  $PROG usage [args]                 mac-usage report: CI minutes, agent hours, payback

  $PROG apply [args]                 pull both checkouts, then apply (mac/apply --pull)
  $PROG apply --no-pull              apply the checkouts as they stand
  $PROG apply build                  pull, then build without switching
  $PROG apply --no-wait              restart CI slots at once, killing their jobs
  $PROG update                       pull ~/homelab and the dotfiles; no apply
  $PROG git <args...>                git against ~/homelab

  $PROG shell                        a shell as worker, in worker's session
  $PROG relogin                      sign worker in to claude.ai again

  $PROG image build [--source <img>] rebuild the CI VM image
  $PROG image services [--source <img>]
                                     rebuild the Linux image that runs a job's Docker
  $PROG drain wait <slot> [minutes]  hold a CI slot's next job until its current one
                                     ends (default $DRAIN_MINUTES minutes); see below
  $PROG drain release <slot>         drop this command's and an apply's hold on a slot

  --no-color                         plain output (also honours NO_COLOR)

Run as kylejs over SSH, with -t so sudo can ask:  ssh -t ms $PROG status
Run as worker in its session:  ssh -t ms $PROG shell, then $PROG image build

kylejs only: apply, update, git, shell, relogin.
worker only: image build, image services.
Either: status, logs, usage, drain (kylejs's goes through sudo).

drain wait stops the slot taking a new job for up to <minutes> plus 5, and
returns once the slot's current job, if any, has ended. The hold stays until
then: run drain release to end it sooner. If the job outlasts the wait, the
slot is released and drain wait exits 1. drain release also drops a hold a
cut-off apply left, but never build-image's.

docs/mac-studio.md, "The homelab command", has the detail.
EOF
}

# --- users and privilege -----------------------------------------------------

need_admin() {
  [ "$ME" = "$ADMIN" ] && return 0
  if [ "$ME" = "$WORKER" ]; then
    die "'$PROG $1' runs as $ADMIN, not $WORKER: leave worker-shell (Ctrl-b d) and run it over ssh ms"
  fi
  die "'$PROG $1' runs as $ADMIN"
}

need_worker() {
  [ "$ME" = "$WORKER" ] && return 0
  die "'$PROG $1' runs as $WORKER, in its login session: run 'ssh -t ms $PROG shell', then '$PROG $1' there"
}

# Can this run read worker's things? worker itself and root can. kylejs needs
# sudo, which asks for the password once when there is a terminal; after that
# both helpers below run without asking. SUDO_STATE: 0 unknown, 1 yes, 2 no.
SUDO_STATE=0
can_reach_worker() {
  if [ "$ME" = "$WORKER" ] || [ "$(id -u)" -eq 0 ]; then return 0; fi
  if [ "$SUDO_STATE" = 0 ]; then
    SUDO_STATE=2
    if sudo -n true 2>/dev/null; then
      SUDO_STATE=1
    elif [ -t 0 ] && [ -t 2 ]; then
      log "sudo, to read worker's agents, logs and CI state"
      if sudo -v; then SUDO_STATE=1; fi
    fi
  fi
  [ "$SUDO_STATE" = 1 ]
}

# Read worker's files as worker, never as root, even from root: a path under
# worker's home can be a symlink worker made, and root would follow it
# anywhere. From /, because worker cannot enter kylejs's home, where an SSH
# session starts. Callers check can_reach_worker first.
as_worker() {
  if [ "$ME" = "$WORKER" ]; then
    "$@"
  else
    (cd / && sudo -n -u "$WORKER" "$@")
  fi
}

# launchctl print of worker's gui domain and the system daemons, the one read
# that needs root. worker can print its own domain.
lc_print() {
  if [ "$ME" = "$WORKER" ] || [ "$(id -u)" -eq 0 ]; then
    launchctl print "$1"
  else
    sudo -n launchctl print "$1"
  fi
}

# --- small readers -----------------------------------------------------------

now() { date +%s; }

# Seconds since an epoch, as "3m", "2h", "4d".
ago() {
  local s=$(($(now) - $1))
  if [ "$s" -lt 0 ]; then s=0; fi
  if [ "$s" -lt 120 ]; then printf '%ss' "$s"
  elif [ "$s" -lt 7200 ]; then printf '%sm' $((s / 60))
  elif [ "$s" -lt 172800 ]; then printf '%sh' $((s / 3600))
  else printf '%sd' $((s / 86400)); fi
}

# An epoch as the local time of day.
clock() { date -r "$1" +%H:%M 2>/dev/null || date -d "@$1" +%H:%M 2>/dev/null || printf '?'; }

# to_epoch <local|utc> <stamp>: BSD date on the Mac, GNU date elsewhere (the
# tests run on Linux). Prints nothing when it cannot parse the stamp.
to_epoch() {
  local zone="$1" s="$2" fmt
  case "$s" in
    *T*Z) fmt='%Y-%m-%dT%H:%M:%SZ' ;;
    *) fmt='%Y-%m-%d %H:%M:%S' ;;
  esac
  if [ "$zone" = utc ]; then
    date -j -u -f "$fmt" "$s" +%s 2>/dev/null || date -u -d "${s%Z}" +%s 2>/dev/null || true
  else
    date -j -f "$fmt" "$s" +%s 2>/dev/null || date -d "$s" +%s 2>/dev/null || true
  fi
}

# One top-level field of `launchctl print`: its lines one tab in, `key = value`.
lc_field() {
  local key="$1"
  awk -v k="$key" 'BEGIN { p = "\t" k " = " } index($0, p) == 1 { print substr($0, length(p) + 1); exit }'
}

# A key of an XML plist, as plutil prints it raw: "true", a number, a string.
plist_get() {
  as_worker plutil -extract "$2" raw -o - "$1" 2>/dev/null || true
}

worker_uid() { id -u "$WORKER" 2>/dev/null || true; }

# kern.boottime: { sec = 1763300000, usec = 0 } ...
boot_epoch() { sysctl -n kern.boottime 2>/dev/null | sed -n 's/.*sec = \([0-9]*\),.*/\1/p'; }

# --- status --------------------------------------------------------------------

# Once per status, not under each of worker's sections.
ACCESS_NOTED=0
access_row() {
  if [ "$ACCESS_NOTED" = 0 ]; then
    row warn "access" "$WORKER's parts need sudo, which needs a terminal: ssh -t ms $PROG status"
    ACCESS_NOTED=1
  else
    row info "access" "left out, as above"
  fi
}

status_host() {
  local v boot up console load ncpu level swap used unit used_mb kb gb

  section "mac studio"

  v="$(sw_vers -productVersion 2>/dev/null || true)"
  row info "macOS" "${v:-?}"

  boot="$(boot_epoch)"
  if [ -n "$boot" ]; then up="up $(ago "$boot")"; else up="?"; fi
  row info "uptime" "$up"

  console="$(stat -f %Su /dev/console 2>/dev/null || true)"
  case "$console" in
    "$WORKER") row ok "console" "$WORKER is logged in at the console" ;;
    root) row bad "console" "login window: log $WORKER in with Screen Sharing" ;;
    "") row warn "console" "could not read /dev/console" ;;
    *) row info "console" "$console" ;;
  esac

  # vm.loadavg: { 1.50 2.00 3.00 }
  load="$(sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | awk '{ print $1 ", " $2 ", " $3 }')"
  ncpu="$(sysctl -n hw.ncpu 2>/dev/null || true)"
  row info "load" "${load:-?} on ${ncpu:-?} cores"

  # 1 normal, 2 warning, 4 critical: the same reading the heartbeat uses.
  level="$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null || true)"
  case "$level" in
    1) row ok "memory pressure" "normal" ;;
    2) row warn "memory pressure" "warning" ;;
    4) row bad "memory pressure" "critical" ;;
    *) row warn "memory pressure" "could not read it" ;;
  esac

  # vm.swapusage: total = 2048.00M  used = 1024.50M  free = ...
  swap="$(sysctl -n vm.swapusage 2>/dev/null || true)"
  used="$(printf '%s' "$swap" | sed -n 's/.*used = \([0-9.]*\)\([MG]\).*/\1/p')"
  unit="$(printf '%s' "$swap" | sed -n 's/.*used = \([0-9.]*\)\([MG]\).*/\2/p')"
  if [ -z "$used" ]; then
    row warn "swap" "could not read it"
  else
    used_mb="${used%%.*}"
    if [ "$unit" = G ]; then used_mb=$((used_mb * 1024)); fi
    # The heartbeat's threshold: over 8 GB.
    if [ "$used_mb" -gt 8192 ]; then
      row warn "swap" "${used}${unit} used, over 8 GB"
    else
      row ok "swap" "${used}${unit} used"
    fi
  fi

  kb="$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR == 2 { print $4 }')"
  case "$kb" in
    '' | *[!0-9]*) row warn "disk free" "could not read it" ;;
    *)
      gb=$((kb / 1024 / 1024))
      # The CI runners stop at 50 GB; the heartbeat warns under 150.
      if [ "$gb" -lt 50 ]; then
        row bad "disk free" "${gb} GB: the CI runners have stopped (under 50 GB)"
      elif [ "$gb" -lt 150 ]; then
        row warn "disk free" "${gb} GB, under the heartbeat's 150 GB"
      else
        row ok "disk free" "${gb} GB"
      fi
      ;;
  esac
}

status_config() {
  local applied head branch dirty behind fetched fetched_at
  # Status only reads: git status would otherwise refresh the index, and could
  # hold index.lock while an apply or a pull runs.
  export GIT_OPTIONAL_LOCKS=0

  section "config"

  # The commit nix-darwin recorded at the last switch (mac/flake.nix,
  # system.configurationRevision), "<rev>-dirty" for an uncommitted tree.
  applied="$(darwin-version --configuration-revision 2>/dev/null || true)"
  if ! printf '%s' "$applied" | grep -qE '^[0-9a-f]{40}(-dirty)?$'; then applied=""; fi
  case "$applied" in
    '') row warn "applied" "no revision recorded" ;;
    *-dirty) row warn "applied" "${applied:0:12}, with uncommitted changes" ;;
    *) row info "applied" "${applied:0:12}" ;;
  esac

  if [ ! -d "$CHECKOUT/.git" ] || ! git -C "$CHECKOUT" rev-parse HEAD >/dev/null 2>&1; then
    row info "checkout" "$CHECKOUT is $ADMIN's: run status as $ADMIN to see it"
    return 0
  fi

  head="$(git -C "$CHECKOUT" rev-parse HEAD)"
  branch="$(git -C "$CHECKOUT" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '?')"
  dirty=""
  if [ -n "$(git -C "$CHECKOUT" status --porcelain --untracked-files=normal -- mac 2>/dev/null)" ]; then
    dirty=", mac/ has uncommitted changes"
  fi
  if [ "$branch" != main ]; then
    row warn "checkout" "${head:0:12} on $branch, not main$dirty"
  elif [ -n "$dirty" ]; then
    row warn "checkout" "${head:0:12} on main$dirty"
  else
    row info "checkout" "${head:0:12} on main"
  fi

  if [ "$applied" = "$head" ]; then
    row ok "in sync" "the checkout's commit is what is applied"
  elif [ "${applied%-dirty}" = "$head" ]; then
    row warn "in sync" "applied from this commit plus uncommitted changes"
  elif [ -n "$applied" ] && [ "$branch" != main ]; then
    # A plain apply would pull first, and a branch may have no upstream.
    row warn "in sync" "the checkout's commit is not applied: $PROG apply --no-pull"
  elif [ -n "$applied" ]; then
    row warn "in sync" "the checkout's commit is not applied: $PROG apply"
  fi

  # From the last fetch only: status reads, it does not reach the network.
  if git -C "$CHECKOUT" rev-parse -q --verify origin/main >/dev/null 2>&1; then
    behind="$(git -C "$CHECKOUT" rev-list --count HEAD..origin/main 2>/dev/null || printf '?')"
    fetched=""
    if [ -f "$CHECKOUT/.git/FETCH_HEAD" ]; then
      fetched_at="$(stat -f %m "$CHECKOUT/.git/FETCH_HEAD" 2>/dev/null || stat -c %Y "$CHECKOUT/.git/FETCH_HEAD" 2>/dev/null || true)"
      if [ -n "$fetched_at" ]; then fetched=", fetched $(ago "$fetched_at") ago"; fi
    fi
    if [ "$behind" = 0 ]; then
      row ok "origin/main" "up to date$fetched"
    elif [ "$branch" != main ]; then
      # apply's pull would pull this branch, or fail with no upstream.
      row warn "origin/main" "$behind commits behind$fetched: git switch main, then $PROG apply"
    else
      row warn "origin/main" "$behind commits behind$fetched: $PROG apply"
    fi
  fi
}

# One worker agent's row, from its plist and `launchctl print`.
agent_row() {
  local uid="$1" plist="$2" label name out state pid exit keepalive interval
  label="$(basename "$plist" .plist)"
  name="${label#dev.kylejs.}"
  keepalive="$(plist_get "$plist" KeepAlive)"
  interval="$(plist_get "$plist" StartInterval)"

  if ! out="$(lc_print "gui/$uid/$label" 2>/dev/null)"; then
    if [ "$keepalive" = true ] || [ -n "$interval" ]; then
      row bad "$name" "not loaded"
    else
      row info "$name" "not loaded; starts on demand"
    fi
    return 0
  fi
  state="$(printf '%s\n' "$out" | lc_field state)"
  pid="$(printf '%s\n' "$out" | lc_field pid)"
  exit="$(printf '%s\n' "$out" | lc_field 'last exit code')"

  if [ "$state" = running ]; then
    row ok "$name" "running${pid:+, pid $pid}"
  elif [ "$keepalive" = true ]; then
    row bad "$name" "not running${exit:+, last exit $exit}"
  elif [ -n "$interval" ]; then
    case "$exit" in
      0 | '' | '(never exited)') row ok "$name" "every $((interval / 60))m, last run fine" ;;
      *) row warn "$name" "every $((interval / 60))m, last exit $exit" ;;
    esac
  else
    row info "$name" "idle; starts on demand"
  fi
}

status_worker() {
  local uid plist found=0

  section "$WORKER"

  uid="$(worker_uid)"
  if [ -z "$uid" ]; then
    row bad "user" "no $WORKER user on this Mac"
    return 0
  fi
  if ! can_reach_worker; then
    access_row
    return 0
  fi
  if ! lc_print "gui/$uid" >/dev/null 2>&1; then
    row bad "session" "not logged in: nothing of $WORKER's runs. Log it in with Screen Sharing"
    return 0
  fi
  row ok "session" "logged in"

  # Every agent mac/claude installs, whichever module added it.
  for plist in $(as_worker find "$WORKER_HOME/Library/LaunchAgents" -maxdepth 1 -type f -name 'dev.kylejs.*.plist' 2>/dev/null | sort || true); do
    found=1
    agent_row "$uid" "$plist"
  done
  if [ "$found" = 0 ]; then row bad "agents" "none installed: $PROG apply"; fi
}

# drain_hold <state dir> <slot>: the live drain request that lasts longest.
# mac/ci/drain writes one file per holder, each the epoch until which the
# slot takes no new job: drain-<slot> for an apply, drain-<slot>.<holder> for
# build-image, and drain-<slot>.hl for this command's. Sets HOLD_UNTIL (empty
# when none is live) and HOLD_BY.
HOLD_UNTIL=""; HOLD_BY=""
drain_hold() {
  local dir="$1" slot="$2" f d who t
  HOLD_UNTIL=""; HOLD_BY=""
  t="$(now)"
  for f in $(as_worker find "$dir" -maxdepth 1 -type f \( -name "drain-$slot" -o -name "drain-$slot.*" \) 2>/dev/null | sort || true); do
    d="$(as_worker cat "$f" 2>/dev/null || true)"
    case "$d" in '' | *[!0-9]*) continue ;; esac
    if [ "$d" -le "$t" ]; then continue; fi
    who="${f##*/drain-"$slot"}"
    case "$who" in
      '') who="an apply" ;;
      .hl) who="$PROG drain" ;;
      *) who="${who#.}" ;;
    esac
    if [ -z "$HOLD_UNTIL" ] || [ "$d" -gt "$HOLD_UNTIL" ]; then
      HOLD_UNTIL="$d"; HOLD_BY="$who"
    fi
  done
}

status_ci() {
  local state="$WORKER_HOME/Library/Caches/ci" uid boot slot phase since st t why out lstate

  section "CI slots"

  uid="$(worker_uid)"
  if [ -z "$uid" ] || ! can_reach_worker; then
    access_row
    return 0
  fi
  boot="$(boot_epoch)"

  for slot in $SLOTS; do
    # mac/ci/runner writes "<phase> <epoch>" and "<ok|error> <epoch> <text>".
    phase=""; since=""
    read -r phase since <<EOF || true
$(as_worker cat "$state/runner-$slot.phase" 2>/dev/null || true)
EOF
    drain_hold "$state" "$slot"
    st="$(as_worker cat "$state/runner-$slot.status" 2>/dev/null || true)"
    why=""
    case "$st" in
      "error "*) why="${st#error }"; why=": ${why#* }" ;;
    esac
    case "$since" in '' | *[!0-9]*) since="" ;; esac
    # A phase from before the last boot says nothing about this boot.
    if [ -n "$since" ] && [ -n "$boot" ] && [ "$since" -lt "$boot" ]; then
      phase="${phase:+$phase, }from before the restart"
      since=""
    fi

    # The files outlive the runner, so they count only while it runs.
    out="$(lc_print "gui/$uid/dev.kylejs.ci-runner-$slot" 2>/dev/null || true)"
    lstate="$(printf '%s\n' "$out" | lc_field state)"
    if [ "$lstate" != running ]; then
      row bad "slot $slot" "runner not running (last phase: ${phase:-none})"
      continue
    fi

    t=""
    if [ -n "$since" ]; then t=" for $(ago "$since")"; fi

    if [ -n "$HOLD_UNTIL" ]; then
      row warn "slot $slot" "${phase:-?}$t, held by $HOLD_BY until $(clock "$HOLD_UNTIL")"
      continue
    fi
    case "$phase" in
      registered) row ok "slot $slot" "registered$t: waiting for or running a job" ;;
      starting | saving) row ok "slot $slot" "$phase$t" ;;
      # The runner rewrites a parked phase every few seconds, so its time is
      # always now: no duration.
      parked) row warn "slot $slot" "parked$why" ;;
      failed) row bad "slot $slot" "failed$t$why" ;;
      '') row warn "slot $slot" "no phase file yet" ;;
      *) row info "slot $slot" "$phase$t" ;;
    esac
  done
}

status_heartbeats() {
  local logs="$WORKER_HOME/Library/Logs" out line detail stamp e rest i name

  section "heartbeats"

  if [ -z "$(worker_uid)" ] || ! can_reach_worker; then
    access_row
    return 0
  fi

  # mac/claude/heartbeat logs two lines a run, "<local time> remote control:
  # <result>" and "<local time> host: <result>". A result is "ok", "ok, with
  # notes:" or "problems:", with the details on the lines after, and sometimes
  # "<local time> ping failed" after those. For each, the result is the last
  # such line, and its detail the first line after it. A line with neither
  # name is from before the split, and counts as remote control's. A run
  # writes a few lines, so the last 200 hold the latest.
  out="$(as_worker tail -n 200 "$logs/claude-rc-heartbeat.log" 2>/dev/null | awk '
    /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] / {
      if ($0 ~ / ping failed$/) { k = ""; next }
      s = substr($0, 21)
      if (s ~ /^remote control: /) { k = "rc"; s = substr(s, 17) }
      else if (s ~ /^host: /) { k = "host"; s = substr(s, 7) }
      else k = "rc"
      r[k] = substr($0, 1, 20) s; d[k] = ""
      next
    }
    k != "" && d[k] == "" { d[k] = $0 }
    END { print r["rc"]; print d["rc"]; print r["host"]; print d["host"] }' || true)"
  for i in 1 3; do
    if [ "$i" = 1 ]; then name="remote control"; else name="host checks"; fi
    line="$(printf '%s\n' "$out" | sed -n "${i}p")"
    detail="$(printf '%s\n' "$out" | sed -n "$((i + 1))p")"
    if [ -z "$line" ]; then
      row warn "$name" "no runs logged"
    else
      stamp="${line:0:19}"
      rest="${line:20}"
      e="$(to_epoch local "$stamp")"
      heartbeat_row "$name" "$e" "$rest" "$detail"
    fi
  done

  # mac/ci/heartbeat: "<UTC time> ok, ..." or "<UTC time> fail: a;b". Its
  # ping's curl writes to the same log, unstamped, only when the ping fails.
  # The result is the last stamped line; an unstamped line after it is that
  # failure.
  out="$(as_worker tail -n 50 "$logs/ci-heartbeat.log" 2>/dev/null | awk '
    /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z / { r = $0; d = ""; next }
    r != "" && d == "" && $0 != "" { d = "ping failed: " $0 }
    END { print r; print d }' || true)"
  line="$(printf '%s\n' "$out" | sed -n 1p)"
  detail="$(printf '%s\n' "$out" | sed -n 2p)"
  if [ -z "$line" ]; then
    row warn "CI" "no runs logged"
  else
    stamp="${line%% *}"
    rest="${line#* }"
    e="$(to_epoch utc "$stamp")"
    if [ -n "$detail" ]; then rest="$rest; $detail"; fi
    heartbeat_row "CI" "$e" "$rest" ""
  fi
}

# heartbeat_row <name> <epoch> <result> <first detail line>. Both heartbeats
# run every 5 minutes (StartInterval 300 in mac/claude and mac/ci), so one
# older than 15 has stopped.
heartbeat_row() {
  local name="$1" e="$2" rest="$3" detail="$4" age="" kind
  if [ -n "$e" ]; then age="$(ago "$e") ago: "; fi
  case "$rest" in
    # Ran fine, but Healthchecks.io did not hear it.
    ok*"; ping failed"*) kind=warn ;;
    ok*) kind=ok ;;
    *) kind=bad ;;
  esac
  case "$rest" in
    *:) rest="${rest%:}${detail:+: $detail}" ;;
  esac
  if [ -n "$e" ] && [ $(($(now) - e)) -gt 900 ]; then
    row bad "$name" "last ran ${age%: }, so it has stopped"
  else
    row "$kind" "$name" "$age$rest"
  fi
}

status_daemons() {
  local name plist label out state f

  section "daemons"

  for name in tailscaled lock-screen mac-usage mac-diagnose mac-diag-collect mac-diag-mcp beszel-agent; do
    plist=""
    for f in /Library/LaunchDaemons/*."$name".plist; do
      if [ -e "$f" ]; then plist="$f"; break; fi
    done
    if [ -z "$plist" ]; then
      if [ "$name" = beszel-agent ]; then
        row info "$name" "not installed: mac/keys/beszel-hub.pub holds no hub key"
      else
        row bad "$name" "not installed"
      fi
      continue
    fi
    label="$(basename "$plist" .plist)"
    out="$(launchctl print "system/$label" 2>/dev/null || true)"
    if [ -z "$out" ] && [ "$ME" != "$WORKER" ] && can_reach_worker; then
      out="$(lc_print "system/$label" 2>/dev/null || true)"
    fi
    if [ -z "$out" ]; then
      row info "$name" "could not read its state as $ME"
      continue
    fi
    state="$(printf '%s\n' "$out" | lc_field state)"
    if [ "$name" = mac-usage ]; then
      # It samples once a minute and exits between samples.
      row ok "$name" "loaded, samples every minute"
    elif [ "$name" = mac-diagnose ]; then
      # It runs four times a day and exits between runs.
      row ok "$name" "loaded, checks four times a day"
    elif [ "$name" = mac-diag-collect ]; then
      # mac/diag-mcp's collector: it runs every 5 minutes and on request,
      # and exits between runs.
      row ok "$name" "loaded, collects every 5 minutes"
    elif [ "$name" = mac-diag-mcp ] && [ "$state" != running ] && [ ! -e /etc/homelab/diag-mcp ]; then
      # The diagnostics connector stays down until it is set up.
      row info "$name" "not set up: sudo mac-diag login"
    elif [ "$state" = running ]; then
      row ok "$name" "running"
    else
      row bad "$name" "${state:-not running}"
    fi
  done
}

cmd_status() {
  if [ "$#" -ne 0 ]; then die "usage: $PROG status"; fi
  status_host
  status_config
  status_worker
  status_ci
  status_heartbeats
  status_daemons
  printf '\n'
  if [ "$FAILS" -gt 0 ]; then exit 1; fi
}

# --- logs ----------------------------------------------------------------------

# The root daemons' logs, in /var/log, listed as daemon-<name> so they never
# share a name with worker's: mac-usage has a log in each.
ROOT_LOGS="lock-screen mac-usage mac-diagnose mac-diag-collect mac-diag-mcp beszel-agent"

list_logs() {
  local f n
  if can_reach_worker; then
    for f in $(as_worker find "$WORKER_HOME/Library/Logs" -maxdepth 1 -type f -name '*.log' 2>/dev/null | sort || true); do
      n="$(basename "$f" .log)"
      printf '  %s\n' "$n"
    done
  else
    log "worker's logs need sudo, which needs a terminal: ssh -t ms $PROG logs"
  fi
  for n in $ROOT_LOGS; do
    if [ -f "/var/log/$n.log" ]; then printf '  daemon-%s\n' "$n"; fi
  done
}

# A name to a log file: daemon-<name> to /var/log/<name>.log, otherwise
# worker's <name>.log, claude-rc-<name>.log or ci-<name>.log, so `logs cut`
# and `logs runner-1` work. Only regular files, not symlinks.
resolve_log() {
  local name="$1" p n f
  case "$name" in
    */* | .*) return 1 ;;
    daemon-*)
      for n in $ROOT_LOGS; do
        f="/var/log/$n.log"
        if [ "daemon-$n" = "$name" ] && [ -f "$f" ] && [ ! -L "$f" ]; then
          printf '%s' "$f"
          return 0
        fi
      done
      return 1
      ;;
  esac
  can_reach_worker || return 1
  for p in "$name" "claude-rc-$name" "ci-$name"; do
    f="$WORKER_HOME/Library/Logs/$p.log"
    if as_worker test -f "$f" && ! as_worker test -L "$f"; then
      printf '%s' "$f"
      return 0
    fi
  done
  return 1
}

cmd_logs() {
  local name="" follow=0 lines=50 file
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f) follow=1 ;;
      -n)
        case "${2:-}" in
          '' | *[!0-9]*) die "-n needs a number of lines" ;;
        esac
        lines="$2"
        shift
        ;;
      -*) die "usage: $PROG logs [name] [-f] [-n <lines>]" ;;
      *)
        if [ -n "$name" ]; then die "usage: $PROG logs [name] [-f] [-n <lines>]"; fi
        name="$1"
        ;;
    esac
    shift
  done

  if [ -z "$name" ]; then
    printf 'Logs, by name for %s logs <name>:\n' "$PROG"
    list_logs
    return 0
  fi
  if ! file="$(resolve_log "$name")"; then
    die "no log '$name': $PROG logs lists them"
  fi
  local opts=(-n "$lines")
  if [ "$follow" = 1 ]; then opts+=(-F); fi
  case "$file" in
    "$WORKER_HOME"/*) as_worker tail "${opts[@]}" "$file" ;;
    *)
      if [ -r "$file" ]; then exec tail "${opts[@]}" "$file"; fi
      exec sudo -n tail "${opts[@]}" "$file"
      ;;
  esac
}

# --- apply, update, git ----------------------------------------------------------

need_checkout() {
  if [ ! -x "$CHECKOUT/mac/apply" ]; then
    die "no checkout at $CHECKOUT (docs/mac-studio.md, day one)"
  fi
}

# The checkout's mac/apply, not a copy: it builds the flake beside itself, and
# a pull changes it. It pulls only with --pull, which this passes unless given
# --no-pull: the mac studio applies main, so applying a stale checkout is the
# surprise, not pulling. --pull itself is still taken, for old habits.
cmd_apply() {
  need_admin apply
  need_checkout
  local pull="" args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --pull | --no-pull)
        if [ -n "$pull" ] && [ "$pull" != "$1" ]; then die "apply: --pull and --no-pull: pick one"; fi
        pull="$1"
        ;;
      # Its value is mac/apply's to check, never one of the flags above.
      --wait-minutes)
        args+=("$1")
        if [ "$#" -gt 1 ]; then args+=("$2"); shift; fi
        ;;
      -h | --help)
        printf '%s apply pulls both checkouts first; --no-pull applies them as they stand.\nIt runs %s:\n\n' "$PROG" "$CHECKOUT/mac/apply"
        exec "$CHECKOUT/mac/apply" --help
        ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  if [ "$pull" != --no-pull ]; then args=(--pull ${args[@]+"${args[@]}"}); fi
  exec "$CHECKOUT/mac/apply" ${args[@]+"${args[@]}"}
}

cmd_update() {
  if [ "$#" -ne 0 ]; then die "usage: $PROG update"; fi
  need_admin update
  need_checkout
  log "updating $CHECKOUT"
  # --ff-only, as mac/apply --pull does: a deploy checkout has no local
  # commits, so a divergence stops here rather than opening a merge.
  git -C "$CHECKOUT" pull --ff-only
  log "now at $(git -C "$CHECKOUT" rev-parse --short HEAD)"
  if [ -d "$DOTFILES/.git" ]; then
    log "updating $DOTFILES"
    git -C "$DOTFILES" pull --ff-only
  else
    log "no $DOTFILES checkout; skipping the dotfiles"
  fi
  log "the dotfiles are live now; apply the config with: $PROG apply"
}

cmd_git() {
  need_admin git
  need_checkout
  exec git -C "$CHECKOUT" "$@"
}

# --- worker's session ------------------------------------------------------------

cmd_shell() {
  if [ "$#" -ne 0 ]; then die "usage: $PROG shell"; fi
  if [ "$ME" = "$WORKER" ]; then die "this is $WORKER already"; fi
  need_admin shell
  exec "$SW/worker-shell"
}

cmd_relogin() {
  if [ "$#" -ne 0 ]; then die "usage: $PROG relogin"; fi
  need_admin relogin
  exec "$SW/relogin"
}

cmd_usage() {
  exec "$SW/mac-usage" report "$@"
}

# --- CI ----------------------------------------------------------------------------

cmd_image() {
  local sub="${1:-}"
  if [ "$#" -gt 0 ]; then shift; fi
  case "$sub" in
    build)
      need_worker "image build"
      exec "$SW/build-image" "$@"
      ;;
    services)
      need_worker "image services"
      exec "$SW/build-services-image" "$@"
      ;;
    *) die "usage: $PROG image build|services [--source <oci image>]" ;;
  esac
}

# Takes a slot number and hands ci-drain the slot's launchd label. kylejs's
# runs as worker through sudo, as the apply's activation script does.
cmd_drain() {
  local action="${1:-}" slot="${2:-}" minutes s found=0 started
  case "$action" in
    wait)
      if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then die "usage: $PROG drain wait <slot> [minutes]"; fi
      minutes="${3:-$DRAIN_MINUTES}"
      case "$minutes" in
        '' | *[!0-9]* | 0) die "drain wait needs a number of minutes above 0" ;;
      esac
      ;;
    release)
      if [ "$#" -ne 2 ]; then die "usage: $PROG drain release <slot>"; fi
      ;;
    *) die "usage: $PROG drain wait <slot> [minutes] | $PROG drain release <slot>" ;;
  esac
  for s in $SLOTS; do
    if [ "$s" = "$slot" ]; then found=1; fi
  done
  if [ "$found" = 0 ]; then die "no slot '$slot': the slots are $SLOTS"; fi
  if [ "$ME" != "$WORKER" ] && [ "$ME" != "$ADMIN" ]; then
    die "'$PROG drain' runs as $ADMIN or $WORKER"
  fi

  # A wait holds under its own name, hl, beside an apply's and build-image's.
  # A release drops this command's hold and an apply's, which a cut-off apply
  # leaves behind, but never build-image's: it renews its hold every minute
  # while it uses the slot's VM.
  if [ "$action" = release ]; then
    run_drain release "dev.kylejs.ci-runner-$slot" hl
    run_drain release "dev.kylejs.ci-runner-$slot"
    return
  fi
  # ci-drain returns when the slot is idle but leaves the hold in place, to
  # the end of the wait plus 5 minutes, so a hand-run wait says when it ends.
  started="$(now)"
  run_drain wait "dev.kylejs.ci-runner-$slot" "$minutes" hl
  log "slot $slot is idle and takes no new job until $(clock $((started + minutes * 60 + 300))): $PROG drain release $slot lets it take one sooner"
}

run_drain() {
  if [ "$ME" = "$WORKER" ]; then
    "$SW/ci-drain" "$@"
  else
    sudo -H -u "$WORKER" "$SW/ci-drain" "$@"
  fi
}

# --- main --------------------------------------------------------------------------

main() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-color) USE_COLOR=0; shift ;;
      *) break ;;
    esac
  done
  set_colors

  local cmd="${1:-}"
  if [ "$#" -gt 0 ]; then shift; fi

  case "$cmd" in
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    usage) cmd_usage "$@" ;;
    apply) cmd_apply "$@" ;;
    update) cmd_update "$@" ;;
    git) cmd_git "$@" ;;
    shell) cmd_shell "$@" ;;
    relogin) cmd_relogin "$@" ;;
    image) cmd_image "$@" ;;
    drain) cmd_drain "$@" ;;
    -h | --help | help | "") usage ;;
    *) die "unknown command '$cmd': try $PROG help" ;;
  esac
}

main "$@"
