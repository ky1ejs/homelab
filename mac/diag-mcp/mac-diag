#!/usr/bin/env python3
# mac/diag-mcp/mac-diag - what the mac studio's diagnostics connector
# serves: one JSON file, SNAPSHOT, which root writes here and the connector
# (./main.go, as _macdiag) only reads. The connector runs no command and
# reads nothing else, so every command and every privacy choice is in this
# file.
#
#   mac-diag run              root, the launchd daemon mac-diag-collect:
#                             every RUN_EVERY_S, and whenever the connector
#                             drops a request in QUEUE
#   mac-diag show             root: prints the snapshot
#   mac-diag refresh [disk]   root: asks the daemon for a run, as the
#                             connector's request_refresh tool does
#   mac-diag login            root, once: the connector's sign-in settings
#                             and its tailnet node (docs/mac-studio.md,
#                             "Diagnostics connector")
#
# What it collects, reusing the other collectors rather than copying them:
# - host: the newest per-minute sample of mac/usage (load, CPU, memory and
#   pressure, swap, free disk, process groups, VM count, booted simulators,
#   console user, power and thermal), without its per-session part.
# - disk: mac/diagnose's scan, loaded from MAC_DIAGNOSE as a module, so its
#   folder list, its name filter (SAFE_NAME_RE) and its age buckets are the
#   ones the diagnostics email uses. Slow: minutes, so at most every
#   DISK_EVERY_H hours, or on request at most every DISK_MIN_GAP_MIN.
# - usage: mac/diagnose's subset of `mac-usage report --json` for the last
#   week, every USAGE_EVERY_MIN.
# - services: the CI slots' phase files (as `hl status` reads them), the CI
#   VM images by name, Colima and Docker's disk use, and Cut's Postgres
#   databases by kind, counted the way mac/claude/sweep-sessions names them.
# - versions: macOS's and the selected Xcode's.
#
# What it never writes: command lines, session ids or names, branch names,
# file names below the levels mac/diagnose lists, database names, or any
# text a command printed, apart from numbers and names that pass
# SAFE_NAME_RE. A session can name a folder, a container or a VM anything,
# up to an instruction to the model that reads this, so a name that fails
# the filter becomes "(other)". Failures are fixed strings.
#
# Python 3 standard library only, like mac/usage and mac/diagnose.

import argparse
import datetime as dt
import getpass
import importlib.machinery
import importlib.util
import json
import os
import plistlib
import re
import shutil
import subprocess
import sys
import tempfile
import time

SCHEMA = 1

# --- Where things are --------------------------------------------------------

DIR = "@dir@"
SNAPSHOT = DIR + "/snapshot.json"
# _macdiag's to write into: one empty file per request, named "fast" or
# "disk". launchd starts the daemon while it holds anything (QueueDirectories
# in ./default.nix), and the daemon empties it.
QUEUE = DIR + "/queue"
# Filled in by ./default.nix.
MAC_DIAGNOSE = "@macDiagnose@"
GROUP_GID = "@gid@"
SW = "@sw@"
# The connector: its binary, user, launchd label, tailnet node name and
# state, and the URL it serves, which is also the token audience.
SERVER = "@server@"
SERVER_USER = "@user@"
SERVER_LABEL = "@label@"
NODE_NAME = "@hostname@"
STATE_DIR = "@stateDir@"
RESOURCE = "@resource@"
# What `login` writes: the sign-in tenant and the one user it lets in. Not
# secrets, but this owner's, so kept out of the public repo.
SETTINGS = "@settings@"
ISSUER_RE = re.compile(r"^https://[a-z0-9.-]{1,200}(/[A-Za-z0-9._~-]{0,100})?$")
SUBJECT_RE = re.compile(r"^user_[A-Za-z0-9]{10,64}$")
AUTH_KEY_RE = re.compile(r"^tskey-auth-[A-Za-z0-9_-]{8,200}$")
WORKER = "@worker@"
WORKER_HOME = "/Users/" + WORKER
# mac/colima's socket: DOCKER_HOST for worker's sessions.
DOCKER_HOST = "@dockerHost@"
TART_VMS = WORKER_HOME + "/.tart/vms"
# mac/ci/runner's state, as mac/cli/homelab's status_ci reads it.
CI_STATE = WORKER_HOME + "/Library/Caches/ci"
# mac/usage's per-minute samples.
HOST_DIR = "/var/log/mac-usage"

# --- How often ---------------------------------------------------------------

# launchd's StartInterval in ./default.nix.
RUN_EVERY_S = 300
# A request sooner than this after the last fast run is answered by it.
FAST_MIN_GAP_S = 20
DISK_EVERY_H = 6
DISK_MIN_GAP_MIN = 15
USAGE_EVERY_MIN = 60
# A disk scan marked as running longer ago than this died with its process.
DISK_SCAN_MAX_MIN = 120
# The disk rows the overview lists.
TOP_DISK = 10

REQUESTS = ("fast", "disk")
# mac/claude/sweep-sessions's cut_project and cut_db_regex (homelab PR 133),
# split by kind. Keep them in step.
CUT_PROJECT = "cut"
CUT_WORKTREE_DB = re.compile(r"^cut_wt_([0-9a-f]{8})$")
CUT_TEST_DB = re.compile(r"^tests_([0-9a-f]{8})_worker_[0-9]+$")
OTHER = "(other)"


def load_diagnose(path=MAC_DIAGNOSE):
    loader = importlib.machinery.SourceFileLoader("mac_diagnose", path)
    spec = importlib.util.spec_from_loader("mac_diagnose", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


# --- Small helpers -----------------------------------------------------------


def utcnow():
    return dt.datetime.now(dt.timezone.utc)


def iso(t):
    return t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_time(s):
    try:
        t = dt.datetime.fromisoformat((s or "").replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return None
    return t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)


def age_s(section, now, key="collected"):
    t = parse_time((section or {}).get(key))
    return (now - t).total_seconds() if t else None


def run(cmd, timeout=60, env=None):
    """A command's stdout, or None when it fails. Never its stderr: that is
    text a command chose, and nothing here passes text on."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def as_worker(cmd, timeout=60):
    """cmd as worker, with worker's home and Colima's Docker. Root runs this,
    so sudo asks nothing."""
    return run(["/usr/bin/sudo", "-n", "-u", WORKER, "-H", "--", "/usr/bin/env",
                "DOCKER_HOST=" + DOCKER_HOST, "PATH=" + SW + ":/usr/bin:/bin"] + cmd, timeout=timeout)


def safe_name(name, pattern):
    return name if isinstance(name, str) and pattern.match(name) else OTHER


# --- host: mac/usage's newest sample -----------------------------------------

HOST_KEYS = ("t", "load", "cpu", "mem", "pressure", "mem_free_pct", "swap_gb", "boot",
             "disk_free_gb", "disk_total_gb", "groups", "sims_booted", "console", "power")
# What mac-usage's `pressure` means: kern.memorystatus_vm_pressure_level.
PRESSURE = {1: "normal", 2: "warning", 4: "critical"}
TAIL_BYTES = 256 * 1024


def last_line(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - TAIL_BYTES))
            lines = f.read().splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            return json.loads(line)
        except ValueError:
            continue
    return None


def host_sample(now, host_dir=HOST_DIR):
    try:
        names = sorted(n for n in os.listdir(host_dir) if re.match(r"^host-\d{4}-\d{2}-\d{2}\.jsonl$", n))
    except OSError:
        return {"error": "no mac-usage samples"}
    for name in reversed(names[-2:]):
        rec = last_line(os.path.join(host_dir, name))
        if rec:
            break
    else:
        return {"error": "no mac-usage samples"}
    out = {k: rec.get(k) for k in HOST_KEYS if k in rec}
    # The VMs one by one, without their pids.
    out["vms"] = [{k: v for k, v in vm.items() if k != "pid"} for vm in rec.get("vms") or []]
    out["pressure_level"] = PRESSURE.get(rec.get("pressure"))
    if isinstance(rec.get("boot"), int):
        out["uptime_days"] = round((now.timestamp() - rec["boot"]) / 86400, 1)
    t = parse_time(rec.get("t"))
    if t:
        out["age_s"] = int((now - t).total_seconds())
    return out


# --- versions ----------------------------------------------------------------


def versions():
    out = {}
    v = run(["/usr/bin/sw_vers", "-productVersion"])
    b = run(["/usr/bin/sw_vers", "-buildVersion"])
    out["macos"] = v.strip() if v else None
    out["macos_build"] = b.strip() if b else None
    dev = run(["/usr/bin/xcode-select", "-p"])
    out["xcode"] = out["xcode_build"] = None
    if dev:
        # <Xcode.app>/Contents/Developer -> <Xcode.app>/Contents/version.plist
        plist = os.path.join(os.path.dirname(dev.strip()), "version.plist")
        try:
            with open(plist, "rb") as f:
                p = plistlib.load(f)
            out["xcode"] = p.get("CFBundleShortVersionString")
            out["xcode_build"] = p.get("ProductBuildVersion")
        except Exception:  # noqa: BLE001 - no Xcode, or not where we look
            pass
    for k in ("macos", "macos_build", "xcode", "xcode_build"):
        if out[k] is not None and not re.match(r"^[A-Za-z0-9.]{1,32}$", str(out[k])):
            out[k] = None
    return out


# --- services ----------------------------------------------------------------


def ci_slots(slots, state_dir=CI_STATE, now=None, launchd_state=None):
    """Each slot's phase, as mac/ci/runner writes it ("<phase> <epoch>" and
    "<ok|error> <epoch> <text>"), and whether its runner agent runs. Phases
    and the status word are mac/ci/runner's own fixed words; its error text
    is left out."""
    now = now or utcnow()
    out = []
    for slot in slots:
        row = {"slot": slot}
        phase = read_small(os.path.join(state_dir, "runner-%s.phase" % slot))
        parts = (phase or "").split()
        if parts and re.match(r"^[a-z-]{1,24}$", parts[0]):
            row["phase"] = parts[0]
            if len(parts) > 1 and parts[1].isdigit():
                row["phase_since"] = iso(dt.datetime.fromtimestamp(int(parts[1]), dt.timezone.utc))
                row["phase_minutes"] = int((now.timestamp() - int(parts[1])) / 60)
        status = (read_small(os.path.join(state_dir, "runner-%s.status" % slot)) or "").split()
        if status and status[0] in ("ok", "error"):
            row["status"] = status[0]
        row["held"] = drain_held(state_dir, slot, now)
        if launchd_state:
            row["runner"] = launchd_state(slot)
        out.append(row)
    return out


def drain_held(state_dir, slot, now):
    """A drain hold on the slot that has not run out (mac/ci/drain)."""
    try:
        names = os.listdir(state_dir)
    except OSError:
        return None
    for n in names:
        if n == "drain-%s" % slot or n.startswith("drain-%s." % slot):
            v = (read_small(os.path.join(state_dir, n)) or "").strip()
            if v.isdigit() and int(v) > now.timestamp():
                return True
    return False


def read_small(path, limit=4096):
    try:
        with open(path, "rb") as f:
            return f.read(limit).decode("ascii", "replace")
    except OSError:
        return None


def runner_state(slot):
    uid = run(["/usr/bin/id", "-u", WORKER])
    if not uid or not uid.strip().isdigit():
        return None
    out = run(["/bin/launchctl", "print", "gui/%s/dev.kylejs.ci-runner-%s" % (uid.strip(), slot)])
    if out is None:
        return "not loaded"
    m = re.search(r"^\s*state = (\w+)", out, re.M)
    return m.group(1) if m else None


def tart_images(pattern, vms_dir=TART_VMS):
    """CI VM images and clones by name. A folder test, as mac/ci/runner's:
    `tart list` fails while a VM runs. Their sizes are in the disk scan's
    tart-vms row."""
    try:
        names = sorted(n for n in os.listdir(vms_dir) if os.path.isfile(os.path.join(vms_dir, n, "config.json")))
    except OSError:
        return None
    return [safe_name(n, pattern) for n in names]


SIZE_RE = re.compile(r"^([\d.]+)\s*([kMGTP]?B)$")
SIZE_UNITS = {"B": 1, "kB": 1e3, "MB": 1e6, "GB": 1e9, "TB": 1e12, "PB": 1e15}


def docker_gb(s):
    """docker's sizes, "1.23GB" or "1.2GB (40%)", in GB of 10^9 bytes as
    docker counts them."""
    m = SIZE_RE.match((s or "").split(" (")[0].strip())
    if not m:
        return None
    return round(float(m.group(1)) * SIZE_UNITS[m.group(2)] / 1e9, 2)


def parse_docker_df(out):
    rows = {}
    for line in (out or "").splitlines():
        try:
            r = json.loads(line)
        except ValueError:
            continue
        kind = {"Images": "images", "Containers": "containers", "Local Volumes": "volumes",
                "Build Cache": "build_cache"}.get(r.get("Type"))
        if not kind:
            continue
        rows[kind] = {
            "count": int(r["TotalCount"]) if str(r.get("TotalCount", "")).isdigit() else None,
            "active": int(r["Active"]) if str(r.get("Active", "")).isdigit() else None,
            "gb": docker_gb(r.get("Size")),
            "reclaimable_gb": docker_gb(r.get("Reclaimable")),
        }
    return rows


def parse_compose_projects(out, pattern):
    """Containers per Compose project: running and in all."""
    out_rows = {}
    for line in (out or "").splitlines():
        project, _, state = line.partition("\t")
        name = safe_name(project, pattern) if project else "(none)"
        acc = out_rows.setdefault(name, {"containers": 0, "running": 0})
        acc["containers"] += 1
        if state.strip() == "running":
            acc["running"] += 1
    return out_rows


def parse_colima(out):
    """`colima list --json`: one JSON object per profile. Sizes in bytes."""
    for line in (out or "").splitlines():
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("name") != "default":
            continue

        def gib(k):
            v = r.get(k)
            return round(v / 1024 ** 3, 1) if isinstance(v, (int, float)) else None

        status = r.get("status")
        return {"status": status.lower() if isinstance(status, str) and status.isalpha() else None,
                "cpus": r.get("cpus") if isinstance(r.get("cpus"), int) else None,
                "memory_gb": gib("memory"), "disk_gb": gib("disk")}
    return None


def parse_df(out):
    """The VM's own filesystems, from `df -kP` run inside it: "/" and the
    data disk Docker keeps its images and volumes on."""
    rows = []
    for line in (out or "").splitlines()[1:]:
        f = line.split()
        if len(f) < 6 or not f[1].isdigit() or not f[2].isdigit():
            continue
        mount = f[5]
        if mount != "/" and not mount.startswith("/mnt/lima-") and mount != "/var/lib/docker":
            continue
        rows.append({"mount": safe_name(mount, re.compile(r"^/[A-Za-z0-9/._-]{0,63}$")),
                     "size_gb": round(int(f[1]) / 1024 ** 2, 1), "used_gb": round(int(f[2]) / 1024 ** 2, 1)})
    return rows


def parse_pg_sizes(out):
    """`<name>|<bytes>` per database, counted and summed by kind: a Cut
    checkout's (cut_wt_<hash>), its test databases (tests_<hash>_worker_<n>)
    and the rest. Never the names: the hashes are worktree paths' and the
    rest are whatever a session made."""
    kinds = {k: {"count": 0, "gb": 0.0} for k in ("worktree", "test", "other")}
    worktrees, test_prefixes = set(), set()
    for line in (out or "").splitlines():
        name, _, size = line.partition("|")
        if not size.strip().isdigit():
            continue
        gb = int(size) / 1024 ** 3
        m = CUT_WORKTREE_DB.match(name)
        t = CUT_TEST_DB.match(name)
        kind = "worktree" if m else "test" if t else "other"
        if m:
            worktrees.add(m.group(1))
        if t:
            test_prefixes.add(t.group(1))
        kinds[kind]["count"] += 1
        kinds[kind]["gb"] += gb
    for k in kinds.values():
        k["gb"] = round(k["gb"], 2)
    kinds["test"]["checkouts"] = len(test_prefixes)
    return kinds


def docker_services(pattern):
    if as_worker(["docker", "info", "--format", "{{.ServerVersion}}"], timeout=20) is None:
        return {"error": "docker not answering"}
    out = {"df": parse_docker_df(as_worker(["docker", "system", "df", "--format", "{{json .}}"], timeout=120))}
    out["projects"] = parse_compose_projects(
        as_worker(["docker", "ps", "-a", "--format", '{{.Label "com.docker.compose.project"}}\t{{.State}}'], timeout=20),
        pattern)
    pg = as_worker(["docker", "ps", "-q", "--filter", "label=com.docker.compose.project=" + CUT_PROJECT,
                    "--filter", "label=com.docker.compose.service=postgres"], timeout=20)
    pg = (pg or "").split()
    if not pg or not re.match(r"^[0-9a-f]{6,64}$", pg[0]):
        out["cut_postgres"] = {"running": False}
    else:
        sizes = as_worker(["docker", "exec", pg[0], "psql", "-U", "postgres", "-tAc",
                           "SELECT datname, pg_database_size(datname) FROM pg_database WHERE NOT datistemplate"],
                          timeout=60)
        out["cut_postgres"] = ({"running": True, "error": "could not list databases"} if sizes is None
                               else dict(running=True, **parse_pg_sizes(sizes)))
    return out


def colima_services():
    out = parse_colima(as_worker(["colima", "list", "--json"], timeout=20)) or {"error": "colima not answering"}
    if out.get("status") == "running":
        out["filesystems"] = parse_df(as_worker(["colima", "ssh", "--", "df", "-kP"], timeout=30))
    return out


# --- The sections ------------------------------------------------------------


def collect_fast(now, diag, slots):
    return {
        "collected": iso(now),
        "host": host_sample(now),
        "versions": versions(),
        "ci": ci_slots(slots, now=now, launchd_state=runner_state),
        "tart_images": tart_images(diag.SAFE_NAME_RE),
        "colima": colima_services(),
        "docker": docker_services(diag.SAFE_NAME_RE),
    }


def collect_usage(now, diag):
    summary = diag.usage_summary(now)
    return {"collected": iso(now), "days": diag.REPORT_DAYS,
            "summary": summary if summary is not None else {"error": "mac-usage report failed"}}


def collect_disk(now, diag, previous=None):
    started = time.monotonic()
    disk = diag.scan(now)
    cats = disk["categories"]
    prev = previous or {}
    before = {diag.cat_id(r): r.get("gb") for r in prev.get("categories") or [] if r.get("gb") is not None}
    last = parse_time(prev.get("collected"))
    days = round((now - last).total_seconds() / 86400, 2) if last else None
    diag.add_growth(cats, before, days)
    diag.add_own(cats)
    top = [{k: r.get(k) for k in ("key", "label", "gb", "own") if r.get(k) is not None}
           for r in diag.leaves(cats)[:TOP_DISK]]
    return {"collected": iso(now), "seconds": int(time.monotonic() - started),
            "growth_since": prev.get("collected"), "apfs": disk["apfs"], "snapshots": disk["snapshots"],
            "top": top, "categories": cats}


def disk_due(snap, now, requested):
    scan = snap.get("disk_scan") or {}
    running = age_s(scan, now, "running_since")
    if running is not None and running < DISK_SCAN_MAX_MIN * 60:
        return False
    age = age_s(snap.get("disk"), now)
    if age is None or age >= DISK_EVERY_H * 3600:
        return True
    return requested and age >= DISK_MIN_GAP_MIN * 60


def fast_due(snap, now, requested):
    age = age_s(snap.get("fast"), now)
    if age is None:
        return True
    # launchd's interval, less a little so its own runs are never skipped.
    return age >= (FAST_MIN_GAP_S if requested else RUN_EVERY_S - 30)


def usage_due(snap, now):
    age = age_s(snap.get("usage"), now)
    return age is None or age >= USAGE_EVERY_MIN * 60


# --- The files ---------------------------------------------------------------


def drain_queue(path=QUEUE):
    """The requests waiting, by kind, with the queue emptied: launchd starts
    this again for as long as anything is left in it."""
    kinds = set()
    try:
        entries = list(os.scandir(path))
    except OSError:
        return kinds
    for e in entries:
        if e.name in REQUESTS:
            kinds.add(e.name)
        try:
            if e.is_dir(follow_symlinks=False):
                shutil.rmtree(e.path)
            else:
                os.unlink(e.path)
        except OSError as err:
            print("could not remove a queue entry: %s" % err.strerror, file=sys.stderr)
    return kinds


def read_snapshot(path=SNAPSHOT):
    try:
        with open(path) as f:
            snap = json.load(f)
    except (OSError, ValueError):
        return {}
    return snap if isinstance(snap, dict) and snap.get("schema") == SCHEMA else {}


def write_snapshot(snap, path=SNAPSHOT, gid=None):
    """Whole or not at all: the connector may read it at any moment."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".snapshot.")
    try:
        if gid is not None:
            os.fchown(fd, 0, gid)
        os.fchmod(fd, 0o640)
        with os.fdopen(fd, "w") as f:
            json.dump(snap, f, indent=1, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def group_gid():
    return int(GROUP_GID) if GROUP_GID.isdigit() else None


# --- Commands ----------------------------------------------------------------


def cmd_run(args, now=None, diag=None, write=None):
    now = now or utcnow()
    requested = drain_queue(QUEUE)
    snap = read_snapshot(SNAPSHOT)
    snap["schema"] = SCHEMA
    snap["host_name"] = "mac-studio"
    diag = diag or load_diagnose()
    write = write or (lambda s: write_snapshot(s, SNAPSHOT, gid=group_gid()))
    slots = [s for s in (args.slots or "").split(",") if s.isdigit()]
    changed = False
    if fast_due(snap, now, "fast" in requested or "disk" in requested):
        snap["fast"] = collect_fast(now, diag, slots)
        changed = True
    if usage_due(snap, now):
        snap["usage"] = collect_usage(now, diag)
        changed = True
    if disk_due(snap, now, "disk" in requested):
        snap["disk_scan"] = {"running_since": iso(now), "requested": "disk" in requested}
        write(snap)
        try:
            snap["disk"] = collect_disk(now, diag, snap.get("disk"))
        finally:
            snap.pop("disk_scan", None)
        changed = True
    if changed:
        write(snap)
        print("%s wrote the snapshot%s" % (iso(now), " (asked: %s)" % ",".join(sorted(requested)) if requested else ""))


def cmd_show(_args):
    try:
        with open(SNAPSHOT) as f:
            sys.stdout.write(f.read())
    except OSError as e:
        sys.exit("mac-diag: %s: %s" % (SNAPSHOT, e.strerror))


def cmd_refresh(args):
    if os.geteuid() != 0:
        sys.exit("mac-diag refresh: run it with sudo")
    kind = "disk" if args.what == "disk" else "fast"
    with open(os.path.join(QUEUE, kind), "a"):
        pass
    print("asked for a %s run; `sudo mac-diag show` has it when it is done" % kind)


def read_settings(path=SETTINGS):
    out = {}
    try:
        with open(path) as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep:
                    out[k] = v
    except OSError:
        pass
    return out


def ask(prompt, current, pattern, what):
    shown = " [%s]" % current if current else ""
    v = input("%s%s: " % (prompt, shown)).strip() or current or ""
    if not pattern.match(v):
        sys.exit("mac-diag login: not %s: %r" % (what, v))
    return v


def write_settings(issuer, subject, path=SETTINGS, gid=None):
    """root:_macdiag 0640, whole or not at all: the connector reads it at
    start and refuses a file anyone but root can change."""
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".diag-mcp.")
    try:
        if gid is not None:
            os.fchown(fd, 0, gid)
        os.fchmod(fd, 0o640)
        with os.fdopen(fd, "w") as f:
            f.write("# Written by `sudo mac-diag login`.\nOAUTH_ISSUER=%s\nOAUTH_ALLOWED_SUBJECTS=%s\n" % (issuer, subject))
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def launchctl(*args):
    return subprocess.run(["/bin/launchctl"] + list(args), capture_output=True, text=True).returncode == 0


def cmd_login(_args):
    if os.geteuid() != 0:
        sys.exit("mac-diag login: run it with sudo")
    old = read_settings()
    print("The sign-in settings, from the WorkOS dashboard (docs/mac-studio.md, \"Diagnostics connector\").")
    issuer = ask("AuthKit domain, https://...", old.get("OAUTH_ISSUER"), ISSUER_RE, "an https URL")
    subject = ask("Your WorkOS user id, user_...", old.get("OAUTH_ALLOWED_SUBJECTS"), SUBJECT_RE, "a WorkOS user id")
    write_settings(issuer, subject, gid=group_gid())
    print("saved to %s" % SETTINGS)

    joined = os.path.exists(os.path.join(STATE_DIR, "tailscaled.state"))
    hint = " (Enter keeps the node it has)" if joined else ""
    key = getpass.getpass("Tailscale auth key for the %s node, tag:%s%s: " % (NODE_NAME, NODE_NAME, hint)).strip()
    if not key and not joined:
        sys.exit("mac-diag login: no auth key given, and the node has not joined the tailnet")
    if key and not AUTH_KEY_RE.match(key):
        sys.exit("mac-diag login: that is not a Tailscale auth key (tskey-auth-...)")

    # Down while the node joins: two processes cannot share its state.
    launchctl("bootout", "system/" + SERVER_LABEL)
    if key:
        r = subprocess.run(["/usr/bin/sudo", "-n", "-u", SERVER_USER, "-H", "--", SERVER, "-login",
                            "-state-dir", STATE_DIR, "-hostname", NODE_NAME],
                           input=key + "\n", capture_output=True, text=True, timeout=180)
        if r.returncode != 0:
            sys.stderr.write(r.stderr)
            sys.exit("mac-diag login: the node did not join the tailnet; the connector stays down")
        name = r.stdout.strip()
        print("joined the tailnet as %s" % name)
        if not name.startswith(NODE_NAME + "."):
            print("warning: an old %s node holds the name, so this one is %s and its certificate will not"
                  " match the connector URL. Remove the old node in the Tailscale admin console and run"
                  " this again." % (NODE_NAME, name.split(".")[0]))
    if not launchctl("bootstrap", "system", "/Library/LaunchDaemons/%s.plist" % SERVER_LABEL):
        sys.exit("mac-diag login: could not start %s; hl status and hl logs daemon-mac-diag-mcp say why" % SERVER_LABEL)
    print("The connector URL, for claude.ai's custom connector and the WorkOS resource:")
    print(RESOURCE)


def main(argv=None):
    p = argparse.ArgumentParser(prog="mac-diag")
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--slots", default="")
    sub.add_parser("show")
    f = sub.add_parser("refresh")
    f.add_argument("what", nargs="?", choices=["fast", "disk"], default="fast")
    sub.add_parser("login")
    args = p.parse_args(argv)
    if args.cmd == "run" and os.geteuid() != 0:
        sys.exit("mac-diag run: root's, from launchd")
    {"run": cmd_run, "show": cmd_show, "refresh": cmd_refresh, "login": cmd_login}[args.cmd](args)


if __name__ == "__main__":
    main()
