# --- Small helpers -----------------------------------------------------------


def utcnow():
    return dt.datetime.now(dt.timezone.utc)


def iso(t):
    return t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_time(s):
    try:
        t = dt.datetime.fromisoformat((s or "").replace("Z", "+00:00"))
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)


def run(cmd, timeout=60):
    """A command's stdout, or "" when it fails."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout if r.returncode == 0 else ""


def gb(kb):
    """KB to GiB, the unit df -g and the heartbeat use."""
    return None if kb is None else round(kb / 1024 / 1024, 1)


def write_private(path, text):
    """Writes atomically, root only."""
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


# --- Disk --------------------------------------------------------------------


def parse_du(s):
    """`du -k` lines to {path: KB}."""
    out = {}
    for line in s.splitlines():
        kb, _, path = line.partition("\t")
        if kb.strip().isdigit() and path:
            out[path] = int(kb)
    return out


DENIED = ("Operation not permitted", "Permission denied")


def count_denied(stderr):
    """Folders du couldn't read. Even root gets EPERM in privacy-protected
    folders without Full Disk Access, so a total can be short."""
    return sum(1 for line in stderr.splitlines() if any(d in line for d in DENIED))


def du_children(path, timeout=1800):
    """A folder's total, each child's, in KB, from one walk, and how many
    folders it couldn't read. -x stays on the folder's volume. du exits 1
    when it can't read a folder but still prints the rest, so that output
    is kept."""
    try:
        r = subprocess.run(["/usr/bin/du", "-xk", "-d", "1", path], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None, {}, 0
    sizes = parse_du(r.stdout)
    total = sizes.pop(path, None)
    return total, {os.path.basename(p): kb for p, kb in sizes.items()}, count_denied(r.stderr)


def _mtime(path):
    try:
        return os.lstat(path).st_mtime
    except OSError:
        return None


def git_admin_files(path):
    """A worktree's .git is a file naming its admin folder, whose HEAD and
    index change when the worktree is used."""
    try:
        with open(os.path.join(path, ".git")) as f:
            line = f.readline().strip()
    except OSError:
        return []
    if not line.startswith("gitdir: "):
        return []
    gitdir = line[len("gitdir: "):]
    return [os.path.join(gitdir, n) for n in ("HEAD", "index", "logs/HEAD")]


def newest_mtime(path):
    """The newest mtime among an item, its children and grandchildren (up to
    AGE_SCAN_ENTRIES), and a worktree's git admin files. A folder's own mtime
    changes only when its own entries do, so a worktree or DerivedData folder
    in use for a week can still show its creation time; looking two levels
    down catches a new build log or a changed source folder. Still a guess:
    a change deeper down shows nowhere."""
    newest = _mtime(path)
    if newest is None:
        return None
    seen = 0
    paths = git_admin_files(path)
    try:
        kids = os.listdir(path)
    except OSError:
        kids = []
    for kid in kids:
        p = os.path.join(path, kid)
        paths.append(p)
        seen += 1
        if seen >= AGE_SCAN_ENTRIES:
            break
        if os.path.isdir(p) and not os.path.islink(p):
            try:
                grand = os.listdir(p)
            except OSError:
                continue
            for g in grand[:max(0, AGE_SCAN_ENTRIES - seen)]:
                paths.append(os.path.join(p, g))
                seen += 1
    for p in paths:
        t = _mtime(p)
        if t is not None and t > newest:
            newest = t
    return newest


def age_days(path, now):
    t = newest_mtime(path)
    return None if t is None else (now.timestamp() - t) / 86400


def by_age(children, base, now, age=age_days):
    """Counts and sizes per age bucket, plus "unknown". Takes names, returns
    none. Adds KB and converts once, so rounding doesn't build up."""
    names = [n for n, _ in AGE_BUCKETS] + ["unknown"]
    n = dict.fromkeys(names, 0)
    kb_in = dict.fromkeys(names, 0)
    for child, kb in children.items():
        d = age(os.path.join(base, child), now)
        if d is None:
            bucket = "unknown"
        else:
            bucket = next(name for name, limit in AGE_BUCKETS if limit is None or d < limit)
        n[bucket] += 1
        kb_in[bucket] += kb
    out = {name: {"n": n[name], "gb": gb(kb_in[name])} for name, _ in AGE_BUCKETS}
    if n["unknown"]:
        out["unknown"] = {"n": n["unknown"], "gb": gb(kb_in["unknown"])}
    return out


def top_names(children, allowed=None):
    """The largest children by name. A name that fails SAFE_NAME_RE, or is
    not in `allowed` when that is given, is folded into one OTHER line."""
    named, other = {}, 0
    for name, kb in children.items():
        if SAFE_NAME_RE.match(name) and name != OTHER and (allowed is None or name in allowed):
            named[name] = kb
        else:
            other += kb
    if other:
        named[OTHER] = other
    rows = sorted(named.items(), key=lambda kv: -kv[1])
    return [{"name": n, "gb": gb(kb)} for n, kb in rows[:TOP_CHILDREN] if gb(kb) >= MIN_CHILD_GB]


def short_path(path):
    return path.replace(WORKER, "~worker").replace(KYLEJS, "~kylejs")


def scan_category(key, label, path, show, parent, now, du=du_children, age=age_days):
    row = {"key": key, "label": label, "path": short_path(path)}
    if parent:
        row["parent"] = parent
    if key in LOGICAL:
        row["logical"] = True
    if not os.path.isdir(path):
        row["missing"] = True
        return row
    total, children, denied = du(path)
    row["gb"] = gb(total)
    row["n"] = len(children)
    if total is None:
        row["unreadable"] = True
    if denied:
        row["partial"] = denied
    if show == "names":
        row["top"] = top_names(children, CODE_NAMES if key == "code" else None)
    elif show == "ages":
        row["ages"] = by_age(children, path, now, age)
    return row


def scan_worktrees(now, du=du_children, age=age_days):
    """Session worktrees for each repo in WORKTREE_REPOS: counts and sizes by
    age, no names."""
    code, sub = WORKTREES
    rows = []
    for repo in WORKTREE_REPOS:
        path = os.path.join(code, repo, sub)
        if not os.path.isdir(path):
            continue
        total, children, denied = du(path)
        row = {"key": "worktrees", "label": "Session worktrees in %s" % repo,
               "repo": repo, "path": "~worker/code/%s/%s" % (repo, sub), "parent": "code",
               "gb": gb(total), "n": len(children), "ages": by_age(children, path, now, age)}
        if denied:
            row["partial"] = denied
        rows.append(row)
    return rows


PLATFORMS = (("iphone", "iOS"), ("appletv", "tvOS"), ("watch", "watchOS"), ("xr", "visionOS"))


def parse_runtimes(out):
    """Simulator runtimes from `simctl runtime list -j`: their disk images
    are mounted, so du can't size them, and simctl reports each one's size."""
    try:
        rts = json.loads(out)
    except ValueError:
        return None
    if not isinstance(rts, dict):
        return None
    kids = {}
    for r in rts.values():
        plat = (r.get("platformIdentifier") or "").lower()
        name = next((n for k, n in PLATFORMS if k in plat), "other")
        name = "%s %s" % (name, r.get("version") or "?")
        kids[name] = kids.get(name, 0) + int(r.get("sizeBytes") or 0) // 1024
    return {"key": "sim-runtimes", "label": "Simulator runtimes", "path": "simctl runtime list",
            "gb": gb(sum(kids.values())), "n": len(rts), "top": top_names(kids)}


def scan_runtimes():
    return parse_runtimes(run(["/usr/bin/xcrun", "simctl", "runtime", "list", "-j"], timeout=120))


def gib(n_bytes):
    return round(n_bytes / 1024 ** 3, 1)


def parse_apfs(plist_bytes):
    """The container that holds the Data volume: its size and free space,
    and each volume's use, from `diskutil apfs list -plist`, in GiB like du's
    and df -g's figures, so the alert lines and the totals compare."""
    try:
        p = plistlib.loads(plist_bytes)
    except Exception:  # noqa: BLE001 - any parse failure means no data
        return None
    for c in p.get("Containers", []):
        vols = c.get("Volumes", [])
        if not any("Data" in (v.get("Roles") or []) for v in vols):
            continue
        return {
            "container_gb": gib(c.get("CapacityCeiling", 0)),
            "free_gb": gib(c.get("CapacityFree", 0)),
            "volumes": sorted(({"name": v.get("Name"), "roles": v.get("Roles") or [],
                                "gb": gib(v.get("CapacityInUse", 0))} for v in vols),
                              key=lambda v: -v["gb"]),
        }
    return None


def apfs_info():
    try:
        r = subprocess.run(["/usr/sbin/diskutil", "apfs", "list", "-plist"], capture_output=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return parse_apfs(r.stdout) if r.returncode == 0 else None


def count_snapshots():
    out = run(["/usr/bin/tmutil", "listlocalsnapshots", DATA_ROOT])
    return sum(1 for line in out.splitlines() if "com.apple" in line)


def scan(now, du=du_children, age=age_days):
    cats = [scan_category(*c, now=now, du=du, age=age) for c in CATEGORIES]
    cats += scan_worktrees(now, du=du, age=age)
    runtimes = scan_runtimes()
    if runtimes:
        cats.append(runtimes)
    return {"apfs": apfs_info(), "snapshots": count_snapshots(), "categories": cats}


def cat_id(row):
    return row["key"] + ("/" + row["repo"] if "repo" in row else "")


def add_growth(cats, previous, days=None):
    """Each category's change in GB since the last report sent, and per day
    when the gap is known: reports come weekly or when disk runs low, so the
    gap varies."""
    for row in cats:
        before = previous.get(cat_id(row))
        if row.get("gb") is not None and before is not None:
            row["growth_gb"] = round(row["gb"] - before, 1)
            if days:
                row["growth_gb_per_day"] = round(row["growth_gb"] / days, 2)


def add_own(cats):
    """On each category another sits inside: its own space, outside those
    children, so what no child names (salvage, the other caches) shows."""
    for row in cats:
        if row.get("gb") is None:
            continue
        kids = [r for r in cats if r.get("parent") == row["key"] and r.get("gb") is not None]
        if kids:
            row["own_gb"] = round(row["gb"] - sum(r["gb"] for r in kids), 1)


def leaves(cats):
    """Categories no other one names as its parent, largest first, plus a
    "<label>, other" line for a parent whose own space is MIN_OWN_GB or
    more: the ones worth acting on."""
    parents = {r.get("parent") for r in cats}
    rows = [r for r in cats if r["key"] not in parents and r.get("gb")]
    for r in cats:
        if r["key"] in parents and (r.get("own_gb") or 0) >= MIN_OWN_GB:
            rows.append({"key": r["key"], "label": r["label"] + ", other", "path": r["path"],
                         "gb": r["own_gb"], "own": True})
    return sorted(rows, key=lambda r: -r["gb"])


# --- Memory and the trend, from mac-usage ------------------------------------


def usage_summary(now):
    since = (now - dt.timedelta(days=REPORT_DAYS)).strftime("%Y-%m-%d")
    out = run([MAC_USAGE, "report", "--json", "--since", since], timeout=300)
    try:
        return pick_usage(json.loads(out))
    except ValueError:
        return None


def pick_usage(s):
    """The part of mac-usage's summary the report needs: no session names."""
    h = s.get("headroom") or {}
    host = s.get("host") or {}

    def groups(b):
        return None if not b else {k: b.get(k) for k in ("t", "pressure", "swap_gb", "free_pct", "groups_gb", "ci_vms", "sims_booted", "claude_procs")}

    return {
        "memory": h.get("memory"),
        "memory_why": h.get("memory_why"),
        "disk": h.get("disk"),
        "disk_why": h.get("disk_why"),
        "disk_gb_per_day": h.get("disk_gb_per_day"),
        "disk_free_min_gb": h.get("disk_free_min_gb"),
        "swap_written_per_day_gb": h.get("swap_written_per_day_gb"),
        "worst_day": h.get("worst_day"),
        "worst_day_not_normal_min": h.get("worst_day_not_normal_min"),
        "mem_total_gb": h.get("mem_total_gb"),
        "at_peak": groups(h.get("at_peak")),
        "at_worst": groups(h.get("at_worst")),
        "cpu_busy_p95": host.get("cpu_busy_p95"),
        "mem_used_max_gb": host.get("mem_used_max_gb"),
    }


# --- What is due ---------------------------------------------------------------


def report_id(kind, now):
    if kind == "weekly":
        y, w, _ = now.astimezone().isocalendar()
        return "mac-studio-diag-%d-W%02d" % (y, w)
    return "mac-studio-diag-%s-%s" % (now.astimezone().strftime("%Y-%m-%dT%H%M"), kind)


def due(state, now, free_gb):
    """The kind of report due now, or None: critical, then low, then weekly."""
    def since(key):
        t = parse_time(state.get(key))
        return None if t is None else (now - t).total_seconds() / 3600

    if free_gb is not None and free_gb < CRITICAL_FREE_GB:
        h = since("last_critical")
        if h is None or h >= CRITICAL_REPEAT_HOURS:
            return "critical"
    if free_gb is not None and free_gb < LOW_FREE_GB:
        h = since("last_low")
        if h is None or h >= LOW_REPEAT_HOURS:
            return "low"
    local = now.astimezone()
    if report_id("weekly", now) != state.get("last_weekly_id") and local.hour >= WEEKLY_HOUR:
        return "weekly"
    return None


def record_sent(state, kind, rid, now, cats):
    state = dict(state)
    if kind == "weekly":
        state["last_weekly_id"] = rid
    if kind in ("low", "critical"):
        state["last_low"] = iso(now)
    if kind == "critical":
        state["last_critical"] = iso(now)
    state["last_sent_id"] = rid
    state["last_sent"] = iso(now)
    state["sizes_gb"] = {cat_id(r): r["gb"] for r in cats if r.get("gb") is not None}
    return state


# --- The message ---------------------------------------------------------------


HEADLINES = {
    "weekly": "weekly",
    "low": "disk under %d GB free" % LOW_FREE_GB,
    "critical": "disk under %d GB free, critical" % CRITICAL_FREE_GB,
    "manual": "run by hand",
}


def fmt_gb(v):
    return "?" if v is None else ("%.1f GB" % v)


BEGIN = "BEGIN HOMELAB REPORT"
END = "END HOMELAB REPORT"
KEY_RE = re.compile(r"^[0-9a-f]{64}$")


def canonical(report):
    """The bytes the signature covers: the report as compact, sorted JSON, so
    a reader that copies the block can rebuild them whatever its whitespace."""
    return json.dumps(report, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")


def report_sig(key_hex, report):
    """HMAC-SHA256 over canonical(report) with the key in MAIL_FILE. Checks 1
    to 3 in ROUTINE.md show the owner's account sent a mail, which anything
    with its app password or a Gmail connector can do; only the mac studio
    and the reader hold this key."""
    return hmac.new(bytes.fromhex(key_hex), canonical(report), hashlib.sha256).hexdigest()


def sig_value(key_hex, report):
    return "hmac-sha256=" + report_sig(key_hex, report) if key_hex else "none"


def render_text(report, sig="none"):
    a = report.get("apfs") or {}
    u = report.get("usage") or {}
    lines = ["Report-Id: %s" % report["report_id"], "Report-Sig: %s" % sig, "Kind: %s" % report["kind"], ""]
    if a:
        lines.append("Free: %s of %s." % (fmt_gb(a.get("free_gb")), fmt_gb(a.get("container_gb"))))
    if u.get("disk_gb_per_day") is not None:
        lines.append("Free disk changes %+.1f GB a day over the last %d days; mac-usage calls disk %s."
                     % (u["disk_gb_per_day"], REPORT_DAYS, u.get("disk") or "unknown"))
    since = report.get("growth_days")
    lines += ["", "Largest folders (GB%s):" % (", change over the last %.1f days" % since if since else "")]
    for r in leaves(report["categories"])[:12]:
        grow = "" if r.get("growth_gb") is None else " (%+.1f)" % r["growth_gb"]
        notes = [n for n, on in (("du counts APFS clones in full", r.get("logical")),
                                 ("%d folders unreadable" % r.get("partial", 0), r.get("partial"))) if on]
        note = " [%s]" % "; ".join(notes) if notes else ""
        lines.append("  %7.1f%s  %s, %s%s" % (r["gb"], grow, r["label"], r["path"], note))
    if a.get("volumes"):
        lines += ["", "APFS volumes: " + ", ".join("%s %s" % (v["name"], fmt_gb(v["gb"])) for v in a["volumes"])]
    lines.append("Local snapshots: %d" % report.get("snapshots", 0))
    if u:
        lines += ["", "Memory: %s." % (u.get("memory") or "unknown")]
        for why in u.get("memory_why") or []:
            lines.append("  " + why)
    lines += ["",
              "What each category is, and the setting in the homelab repo that trims it:",
              "mac/diagnose/ROUTINE.md.",
              "", BEGIN,
              json.dumps(report, indent=1, sort_keys=True),
              END, ""]
    return "\n".join(lines)


def build_message(address, report, key_hex=None):
    m = email.message.EmailMessage()
    m["From"] = address
    m["To"] = address
    m["Subject"] = "[homelab] mac studio diagnostics: %s (%s)" % (HEADLINES[report["kind"]], report["report_id"])
    m["Date"] = email.utils.formatdate(localtime=True)
    m["Message-ID"] = email.utils.make_msgid(idstring=report["report_id"], domain=address.rpartition("@")[2])
    m["X-Homelab-Report-Id"] = report["report_id"]
    m["X-Homelab-Report-Schema"] = str(REPORT_SCHEMA)
    sig = sig_value(key_hex, report)
    m["X-Homelab-Report-Sig"] = sig
    # 7-bit with lines under 998 characters, so it arrives as sent: quoted-
    # printable would let a mail client rewrap the JSON block.
    text = render_text(report, sig).encode("ascii", "replace").decode("ascii")
    m.set_content(text, cte="7bit")
    return m


def verify_body(body, key_hex):
    """For the reader (ROUTINE.md, check 6): None when the body's Report-Sig
    line matches its JSON block under key_hex, else what is wrong."""
    if not KEY_RE.match(key_hex or ""):
        return "no key: set HOMELAB_DIAG_KEY to the key mac-diagnose login printed"
    lines = [line.rstrip("\r") for line in body.splitlines()]
    sigs = [line[len("Report-Sig: "):].strip() for line in lines if line.startswith("Report-Sig: ")]
    if len(sigs) != 1:
        return "want one Report-Sig line, found %d" % len(sigs)
    if lines.count(BEGIN) != 1 or lines.count(END) != 1 or lines.index(BEGIN) > lines.index(END):
        return "want one %s ... %s block" % (BEGIN, END)
    try:
        report = json.loads("\n".join(lines[lines.index(BEGIN) + 1:lines.index(END)]))
    except ValueError:
        return "the block is not JSON"
    if not isinstance(report, dict):
        return "the block is not a JSON object"
    if not hmac.compare_digest(sigs[0], "hmac-sha256=" + report_sig(key_hex, report)):
        return "the signature does not match"
    return None


# --- Mail settings -------------------------------------------------------------

ADDRESS_RE = re.compile(r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")


def read_mail_file(path=MAIL_FILE, require_root=True):
    """address, password and key from a root-only file, or an error
    message."""
    try:
        st = os.lstat(path)
    except OSError:
        return None, "no mail settings at %s: run sudo mac-diagnose login" % path
    if not stat.S_ISREG(st.st_mode):
        return None, "%s is not a regular file" % path
    if require_root and (st.st_uid != 0 or st.st_mode & 0o077):
        return None, "%s must be owned by root and readable by root alone" % path
    vals = {}
    try:
        with open(path) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                vals[k] = v
    except OSError as e:
        return None, "can't read %s: %s" % (path, e.strerror)
    if not ADDRESS_RE.match(vals.get("address", "")) or not vals.get("password") \
            or not KEY_RE.match(vals.get("key", "")):
        return None, "%s needs address=, password= and key= lines: run sudo mac-diagnose login" % path
    return vals, None


def cmd_login(_args):
    if os.geteuid() != 0:
        sys.exit("mac-diagnose login: run it with sudo")
    address = input("Gmail address the reports go to and come from: ").strip()
    if not ADDRESS_RE.match(address):
        sys.exit("not an email address: %s" % address)
    # Google shows app passwords in four groups of four.
    password = getpass.getpass("App password (myaccount.google.com/apppasswords): ").replace(" ", "")
    if not password:
        sys.exit("no password given")
    # Keep the signing key across logins, so a new app password doesn't
    # mean a new secret in the reader's environment.
    old, _ = read_mail_file()
    key = (old or {}).get("key") or secrets.token_hex(32)
    write_private(MAIL_FILE, "address=%s\npassword=%s\nkey=%s\n" % (address, password, key))
    print("saved to %s, root only." % MAIL_FILE)
    print("Signing key, for the reader's HOMELAB_DIAG_KEY (sudo mac-diagnose key prints it again):")
    print(key)
    print("Send one now with: sudo mac-diagnose mail --now")


def cmd_key(_args):
    if os.geteuid() != 0:
        sys.exit("mac-diagnose key: run it with sudo")
    cfg, err = read_mail_file()
    if err:
        sys.exit("mac-diagnose: " + err)
    print(cfg["key"])


def cmd_verify(_args):
    """Reads a report's body on stdin; exits 0 when its signature is good."""
    err = verify_body(sys.stdin.read(), os.environ.get("HOMELAB_DIAG_KEY", "").strip().lower())
    if err:
        sys.exit("mac-diagnose verify: " + err)
    print("ok")


def send(cfg, msg):
    ctx = ssl.create_default_context(cafile=None if CA_FILE.startswith("@") else CA_FILE)
    with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=60) as s:
        s.starttls(context=ctx)
        s.login(cfg["address"], cfg["password"])
        s.send_message(msg)


# --- Commands ------------------------------------------------------------------


def read_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def build_report(kind, now, state):
    disk = scan(now)
    last = parse_time(state.get("last_sent"))
    days = round((now - last).total_seconds() / 86400, 2) if last else None
    add_growth(disk["categories"], state.get("sizes_gb") or {}, days)
    add_own(disk["categories"])
    rid = report_id(kind, now)
    return {"schema": REPORT_SCHEMA, "report_id": rid, "kind": kind, "host": "mac-studio",
            "generated": iso(now), "previous_report_id": state.get("last_sent_id"),
            "growth_since": state.get("last_sent"), "growth_days": days,
            "apfs": disk["apfs"], "snapshots": disk["snapshots"], "categories": disk["categories"],
            "usage": usage_summary(now)}


def cmd_mail(args):
    now = utcnow()
    state = read_state()
    if args.now:
        kind = "manual"
    else:
        apfs = apfs_info()
        kind = due(state, now, apfs and apfs["free_gb"])
        if kind is None:
            return
    cfg, err = read_mail_file(require_root=not args.dry_run)
    if err and not args.dry_run:
        sys.exit("mac-diagnose: " + err)
    report = build_report(kind, now, state)
    cfg = cfg or {}
    msg = build_message(cfg.get("address", "dry-run@example.invalid"), report, cfg.get("key"))
    if args.dry_run:
        print(msg.as_string())
        return
    send(cfg, msg)
    write_private(STATE_FILE, json.dumps(record_sent(state, kind, report["report_id"], now, report["categories"]),
                                         indent=1, sort_keys=True))
    print("%s sent %s" % (iso(now), report["report_id"]))


def cmd_scan(args):
    now = utcnow()
    disk = scan(now)
    add_own(disk["categories"])
    if args.json:
        print(json.dumps(disk, indent=1, sort_keys=True))
        return
    for r in leaves(disk["categories"]):
        print("%7.1f GB  %s, %s" % (r["gb"], r["label"], r["path"]))
    if os.geteuid() != 0:
        print("(not root: folders it can't read are left out; run it with sudo)")


def main(argv=None):
    p = argparse.ArgumentParser(prog="mac-diagnose")
    sub = p.add_subparsers(dest="cmd", required=True)
    m = sub.add_parser("mail")
    m.add_argument("--dry-run", action="store_true")
    m.add_argument("--now", action="store_true")
    s = sub.add_parser("scan")
    s.add_argument("--json", action="store_true")
    sub.add_parser("login")
    sub.add_parser("key")
    sub.add_parser("verify")
    args = p.parse_args(argv)
    {"mail": cmd_mail, "scan": cmd_scan, "login": cmd_login, "key": cmd_key, "verify": cmd_verify}[args.cmd](args)


if __name__ == "__main__":
    main()
