# --- The judgement -----------------------------------------------------------

# Same lines as mac/claude/heartbeat's min_free_gb and critical_free_gb: the
# heartbeat warns under 150 GB free and calls it critical under 75 GB. A
# change there is a change here.
LOW_FREE_GB = 150
CRITICAL_FREE_GB = 75
# A low-disk report repeats at most this often while disk stays low; a
# critical one, which is more urgent, more often.
LOW_REPEAT_HOURS = 72
CRITICAL_REPEAT_HOURS = 24
# The weekly report goes at the first run in a new ISO week at or after this
# local hour, so it lands on Monday morning, not at 3 a.m.
WEEKLY_HOUR = 9
# The memory and disk trend the report quotes from mac-usage.
REPORT_DAYS = 7
# Children listed per named category, largest first, and the smallest one
# worth a line.
TOP_CHILDREN = 8
MIN_CHILD_GB = 0.5
# Age buckets for counted categories, by the newest modification seen near
# the top of each item (newest_mtime). An item whose age can't be read goes
# in "unknown", not in the oldest bucket.
AGE_BUCKETS = (("under_1d", 1), ("1_to_7d", 7), ("over_7d", None))
# Entries newest_mtime looks at per item, so a worktree's node_modules can't
# make the scan slow.
AGE_SCAN_ENTRIES = 400
# A parent's own space, outside its named children, gets a line in the
# summary from this size.
MIN_OWN_GB = 5.0
REPORT_SCHEMA = 1

