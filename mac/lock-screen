#!/bin/bash
# mac/lock-screen - locks the Mac Studio's screen when nobody should be looking
# at it. A launchd daemon (mac/hosts/mac-studio.nix) runs it as root.
#
# macOS locks the screen when the display sleeps, once `sysadminctl
# -screenLock immediate` has been run for that user. It does not lock when a
# Screen Sharing session ends (Remote Management serves Apple Remote Desktop
# on the same port, so an ARD session counts too): Screen Sharing drives the
# console session itself, so the Studio's own screen comes back on at an
# unlocked desktop, open to anyone at the Studio until the display sleeps, 10
# minutes later. (The FileVault unlock over SSH is different: its login
# already comes up at a locked screen.) This puts the display to sleep at once
# instead, which locks it. It checks every few seconds, and locks when:
#
#   - the last Screen Sharing connection (TCP 5900) closes;
#   - the user at the console changes to someone other than root (the login
#     window) while no Screen Sharing connection is open. That includes a
#     login at the keyboard, which then asks for the password once more;
#   - it starts, if a user is at the console and nobody is connected. launchd
#     may start it after a login, so it cannot wait for a change.
#     An apply that changes this script restarts it, and so locks the screen.
#
# High Performance sessions also use UDP 5900 to 5902. This assumes they keep a
# TCP 5900 connection open too, which docs/mac-studio.md lists as still to
# test.
#
# bash 3.2: this runs under macOS's /bin/bash.
set -u

interval_seconds=3

log() { printf '%s %s\n' "$(/bin/date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }

# Any established TCP connection to local port 5900, over IPv4 or IPv6, on the
# LAN or the tailnet. macOS's netstat puts the port after a dot.
sharing() {
  /usr/sbin/netstat -anp tcp 2>/dev/null |
    /usr/bin/awk '$4 ~ /[.]5900$/ && $6 == "ESTABLISHED" { found = 1 } END { exit !found }'
}

console_user() { /usr/bin/stat -f %Su /dev/console 2>/dev/null || echo root; }

lock() {
  log "locking: $1"
  /usr/bin/pmset displaysleepnow || log "pmset displaysleepnow failed"
}

was_sharing=no
last_user=root
log "started"
while true; do
  now_sharing=no
  if sharing; then now_sharing=yes; fi
  user=$(console_user)

  if [ "$was_sharing" = yes ] && [ "$now_sharing" = no ]; then
    lock "Screen Sharing ended"
  elif [ "$user" != "$last_user" ] && [ "$user" != root ] && [ "$now_sharing" = no ]; then
    lock "$user is at the console"
  fi

  was_sharing=$now_sharing
  last_user=$user
  /bin/sleep "$interval_seconds"
done
