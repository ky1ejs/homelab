# --- Small helpers -----------------------------------------------------------


def utcnow():
    return dt.datetime.now(dt.timezone.utc)


def parse_time(s):
    if not s:
        return None
    try:
        t = dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None
    if t.tzinfo is None:
        t = t.replace(tzinfo=dt.timezone.utc)
    return t


def iso(t):
    return t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(cmd, timeout=30):
    """A command's stdout, or "" when it fails."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout if r.returncode == 0 else ""


def write_json(path, value):
    """Writes atomically, so a reader never sees half a file."""
    d = os.path.dirname(os.path.abspath(path))
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(value, f, separators=(",", ":"), sort_keys=True)
    # mkstemp makes the file 600; the report runs as kylejs.
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def percentile(values, p):
    if not values:
        return None
    v = sorted(values)
    k = (len(v) - 1) * p
    lo, hi = math.floor(k), math.ceil(k)
    return v[lo] + (v[hi] - v[lo]) * (k - lo)


# --- Host sample (root) ------------------------------------------------------


def parse_loadavg(s):
    nums = re.findall(r"[\d.]+", s)
    return [float(x) for x in nums[:3]] if len(nums) >= 3 else None


def parse_top_cpu(s):
    """The last 'CPU usage' line of `top -l 2`: the first sample is since boot."""
    found = None
    for m in re.finditer(r"CPU usage:\s*([\d.]+)% user,\s*([\d.]+)% sys,\s*([\d.]+)% idle", s):
        found = m
    if not found:
        return None
    return {"user": float(found.group(1)), "sys": float(found.group(2)), "idle": float(found.group(3))}


def parse_vm_stat(s):
    """Memory in use as Activity Monitor counts it: app + wired + compressed."""
    m = re.search(r"page size of (\d+) bytes", s)
    if not m:
        return None
    page = int(m.group(1))
    pages = {}
    for line in s.splitlines():
        k, sep, v = line.partition(":")
        if sep and v.strip().rstrip(".").isdigit():
            pages[k.strip()] = int(v.strip().rstrip("."))
    gb = page / 1024 ** 3
    anon = pages.get("Anonymous pages", 0)
    purgeable = pages.get("Pages purgeable", 0)
    wired = pages.get("Pages wired down", 0)
    compressed = pages.get("Pages occupied by compressor", 0)
    app = max(anon - purgeable, 0)
    out = {
        "used_gb": round((app + wired + compressed) * gb, 2),
        "app_gb": round(app * gb, 2),
        "wired_gb": round(wired * gb, 2),
        "compressed_gb": round(compressed * gb, 2),
    }
    # Pages written to swap since boot. A counter, so the difference between
    # two samples is every page swapped out between them, however briefly.
    if "Swapouts" in pages:
        out["swapout_gb"] = round(pages["Swapouts"] * gb, 3)
    return out


def parse_boottime(s):
    """kern.boottime's seconds: '{ sec = 1731600000, usec = 0 } Fri ...'."""
    m = re.search(r"sec = (\d+)", s)
    return int(m.group(1)) if m else None


def parse_swapusage(s):
    m = re.search(r"used = ([\d.]+)M", s)
    return round(float(m.group(1)) / 1024, 2) if m else None


def classify_process(args):
    """Which group a process counts towards, from its command line."""
    a = args.lower()
    if "virtualization.virtualmachine" in a:
        return "vm"
    # Colima's VM is a Virtualization process like a CI VM's, so ps cannot
    # tell them apart. Its Lima host agent marks that it runs; nixpkgs' wrapper
    # names the binary .limactl-wrapped.
    if re.search(r"limactl(-wrapped)? hostagent ", a):
        return "colima"
    if re.search(r"(^|/)tart( |$)", a) or "/softnet" in a:
        return "tart"
    if "claude" in a and ("claude-code" in a or re.search(r"(^|/)claude( |$)", a)):
        return "claude"
    if "xcodebuild" in a or "swift-frontend" in a or "/swift-build" in a:
        return "xcode"
    if "coresimulator" in a or "launchd_sim" in a or "simulator.app" in a:
        return "simulator"
    return None


# launchd_sim by its path, or bare, as argv[0] can be.
LAUNCHD_SIM_RE = re.compile(r"(^|[\s/])launchd_sim( |$)")


def count_booted_sims(s):
    """Booted simulators on the host: each runs its own launchd_sim. The CI
    VMs' simulators run inside the VMs, so they are not here."""
    return sum(1 for line in s.splitlines() if LAUNCHD_SIM_RE.search(line))


MEM_UNITS = {"B": 1, "K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}


def parse_top_mem(s):
    """pid -> GB, from `top -l 1 -stats pid,mem`: each process's physical
    footprint, what Activity Monitor's Memory column shows. Unlike ps's
    resident size it leaves out shared pages, such as the system libraries
    every simulator process maps, so footprints add up where resident sizes
    do not. It includes the process's compressed pages. Values read like
    "1024M+", "12K" or "2.5G"."""
    out = {}
    for line in s.splitlines():
        m = re.match(r"\s*(\d+)\s+([\d.]+)([BKMGT])[+-]?\s*$", line)
        if m:
            out[int(m.group(1))] = float(m.group(2)) * MEM_UNITS[m.group(3)] / 1024 ** 3
    return out


def parse_ppids(s):
    """pid -> parent pid, from `ps -axo pid=,ppid=`."""
    out = {}
    for line in s.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
            out[int(parts[0])] = int(parts[1])
    return out


def _open_under(root, path):
    """A read-only fd for path, a file under folder root, opened one folder at
    a time with no symlink followed and no mount crossed, or None. Another
    user owns every folder from root down, and could make one a link to
    anywhere or mount a share on it, whose stall would hang the reader."""
    rel = os.path.relpath(path, root)
    parts = rel.split(os.sep)
    if rel.startswith("..") or os.path.isabs(rel) or any(p in ("", ".", "..") for p in parts):
        return None
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    try:
        fd = os.open(root, flags | os.O_DIRECTORY)
    except OSError:
        return None
    try:
        dev = os.fstat(fd).st_dev
        for i, part in enumerate(parts):
            last = i == len(parts) - 1
            nfd = os.open(part, flags | (0 if last else os.O_DIRECTORY), dir_fd=fd)
            os.close(fd)
            fd = nfd
            if os.fstat(fd).st_dev != dev:
                raise OSError("crosses a mount")
        out, fd = fd, None
        return out
    except OSError:
        return None
    finally:
        if fd is not None:
            os.close(fd)


def read_small_plist(path, max_bytes=256 * 1024, root=None):
    """A plist from a folder another user controls, or None. The sampler runs
    as root and worker owns these files, so it opens only a regular file, not
    a link or a FIFO, without blocking, and reads at most max_bytes; and a
    malformed file, whatever the parser raises, is None. With root, every
    folder from root down is checked as _open_under says."""
    if root is not None:
        fd = _open_under(root, path)
        if fd is None:
            return None
    else:
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except OSError:
            return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > max_bytes:
            return None
        data = os.read(fd, max_bytes + 1)
        if len(data) > max_bytes:
            return None
        v = plistlib.loads(data)
        return v if isinstance(v, dict) else None
    except Exception:  # noqa: BLE001 - expat, ValueError, and the rest
        return None
    finally:
        os.close(fd)


# A session's ID, as worker-CLAUDE.md and session-cleanup name it: NAME/X for
# a worktree ~/code/NAME/.claude/worktrees/X, any/X for ~/code/any/sessions/X.
SESSION_PATH_RES = (re.compile(r"/code/([^/\s\"']+)/\.claude/worktrees/([^/\s\"']+)"),
                    re.compile(r"/code/(any)/sessions/([^/\s\"']+)"))
UDID = r"[0-9A-Fa-f]{8}-(?:[0-9A-Fa-f]{4}-){3}[0-9A-Fa-f]{12}"
# A simulator's folder: CoreSimulator/Devices for the default set, and
# XCTestDevices for the clones xcodebuild makes to test in parallel.
SIM_DIR_RE = re.compile(r"/(Devices|XCTestDevices)/(%s)/" % UDID)
# The " @ID" a session ends its simulators' names with; a clone's name is
# "Clone N of <name>", so it ends the same way. The shape sweep-sessions checks.
SIM_TAG_RE = re.compile(r" @([A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*)$")


def session_id_of(path):
    """The session whose folder a path, or a command line, names."""
    if not path:
        return None
    for r in SESSION_PATH_RES:
        m = r.search(path)
        if m:
            return "%s/%s" % m.groups()
    return None


def parse_lsof_cwds(s):
    """pid -> working directory, from `lsof -Fn`'s "p<pid>" and "n<path>" lines."""
    cwds, pid = {}, None
    for line in s.splitlines():
        if line.startswith("p"):
            pid = int(line[1:]) if line[1:].isdigit() else None
        elif line.startswith("n") and pid is not None:
            cwds[pid] = line[1:]
    return cwds


def lsof_cwds(pids):
    # lsof exits 1 when one of the pids has gone, with the rest still printed.
    try:
        r = subprocess.run(["/usr/sbin/lsof", "-a", "-d", "cwd", "-Fn", "-p", ",".join(map(str, pids))],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return parse_lsof_cwds(r.stdout)


def sim_session(udid, folder="Devices"):
    """The session a simulator is named for: worker-CLAUDE.md has sessions
    end a simulator's name with " @" and their ID. folder is Devices or
    XCTestDevices."""
    base = ("CoreSimulator", "Devices") if folder == "Devices" else ("XCTestDevices",)
    plist = read_small_plist(os.path.join(WORKER_HOME, "Library", "Developer", *base, udid, "device.plist"),
                             root=WORKER_HOME)
    name = plist.get("name") if plist else None
    m = SIM_TAG_RE.search(name) if isinstance(name, str) else None
    return m.group(1) if m else None


def attribute_sessions(ps, cwd_of=lsof_cwds, sim_owner=sim_session, parents=None):
    """Per session ID: its Xcode processes and their summed CPU percent, and
    its booted simulators and their CPU. An Xcode process belongs to the
    session whose folder its command line names, as Cut's -derivedDataPath
    does, or else the one its working directory is in. A simulator belongs to
    the xcodebuild run that names its UDID (-destination id=...), or else the
    session in its name. A simulator's CPU is that of the processes whose
    command line names its folder (launchd_sim and the apps installed in it)
    and, given parents (pid -> parent pid), of the processes they started,
    such as SpringBoard, which run from the runtime's folder instead. Only
    IDs and totals are kept, never command lines."""
    xcode, sims, unnamed = [], [], []
    for line in ps.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        pid, cpu, _rss, args = parts
        try:
            pid_i, cpu_f = int(pid), float(cpu)
        except ValueError:
            continue
        g = classify_process(args)
        if g == "xcode":
            xcode.append((pid_i, cpu_f, args))
        elif g == "simulator":
            m = SIM_DIR_RE.search(args)
            if m:
                sims.append((pid_i, m.group(2).upper(), m.group(1), cpu_f, bool(LAUNCHD_SIM_RE.search(args))))
            else:
                unnamed.append((pid_i, cpu_f))
    # A process with no folder in its command line counts for the simulator
    # whose launchd_sim it descends from. The shared CoreSimulatorService
    # descends from none.
    by_pid = {pid: (udid, folder) for pid, udid, folder, _, booted in sims if booted}
    for pid, cpu in unnamed if parents else ():
        p, hops = parents.get(pid), 0
        while p and p > 1 and p not in by_pid and hops < 64:
            p, hops = parents.get(p), hops + 1
        if p in by_pid:
            sims.append((pid, by_pid[p][0], by_pid[p][1], cpu, False))
    need = [pid for pid, _, args in xcode if not session_id_of(args)]
    cwds = cwd_of(need) if need else {}
    out = {}

    def acc(sid):
        return out.setdefault(sid, {"xcode_n": 0, "xcode_cpu": 0.0, "sims": 0, "sim_cpu": 0.0})

    owner = {}
    for pid, cpu, args in xcode:
        sid = session_id_of(args) or session_id_of(cwds.get(pid))
        if not sid:
            continue
        a = acc(sid)
        a["xcode_n"] += 1
        a["xcode_cpu"] += cpu
        for u in re.findall(r"\bid=(%s)" % UDID, args):
            owner.setdefault(u.upper(), sid)
    named = {}
    for _pid, udid, folder, cpu, booted in sims:
        if udid not in owner and udid not in named:
            named[udid] = sim_owner(udid, folder)
        sid = owner.get(udid) or named[udid]
        if not sid:
            continue
        a = acc(sid)
        a["sim_cpu"] += cpu
        a["sims"] += booted
    for a in out.values():
        a["xcode_cpu"] = round(a["xcode_cpu"], 1)
        a["sim_cpu"] = round(a["sim_cpu"], 1)
    return out


def parse_ps(s, footprint=None):
    """Per group: process count, summed CPU percent and resident GB, and,
    given footprint (pid -> GB, from parse_top_mem), the summed footprint as
    mem_gb. Only the group totals are kept, and the VMs one by one; never
    command lines."""
    groups = {}
    vms = []
    for line in s.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        pid, cpu, rss_kb, args = parts
        try:
            cpu_f, rss_gb = float(cpu), int(rss_kb) / 1024 ** 2
        except ValueError:
            continue
        g = classify_process(args)
        if not g:
            continue
        acc = groups.setdefault(g, {"n": 0, "cpu": 0.0, "rss_gb": 0.0})
        acc["n"] += 1
        acc["cpu"] += cpu_f
        acc["rss_gb"] += rss_gb
        mem_gb = footprint.get(int(pid)) if footprint and pid.isdigit() else None
        if footprint:
            # A process that exited between ps and top counts as none.
            acc["mem_gb"] = acc.get("mem_gb", 0.0) + (mem_gb or 0.0)
        if g == "vm":
            vm = {"pid": int(pid), "cpu": cpu_f, "rss_gb": round(rss_gb, 2)}
            if mem_gb is not None:
                vm["mem_gb"] = round(mem_gb, 2)
            vms.append(vm)
    for acc in groups.values():
        acc["cpu"] = round(acc["cpu"], 1)
        acc["rss_gb"] = round(acc["rss_gb"], 2)
        if "mem_gb" in acc:
            acc["mem_gb"] = round(acc["mem_gb"], 2)
    return groups, vms


def parse_powermetrics(s):
    out = {}
    for key, label in (("cpu_mw", "CPU Power"), ("gpu_mw", "GPU Power"), ("ane_mw", "ANE Power"),
                       ("combined_mw", "Combined Power (CPU + GPU + ANE)")):
        m = re.search(re.escape(label) + r":\s*([\d.]+)\s*mW", s)
        if m:
            out[key] = float(m.group(1))
    if "combined_mw" not in out and "cpu_mw" in out:
        out["combined_mw"] = out["cpu_mw"] + out.get("gpu_mw", 0) + out.get("ane_mw", 0)
    m = re.search(r"Current pressure level:\s*(\w+)", s)
    if m:
        out["thermal"] = m.group(1)
    return out


def cmd_sample(_args):
    t = utcnow()
    rec = {"t": iso(t)}
    rec["load"] = parse_loadavg(run(["/usr/sbin/sysctl", "-n", "vm.loadavg"]))
    rec["cpu"] = parse_top_cpu(run(["/usr/bin/top", "-l", "2", "-n", "0", "-s", "1"]))
    rec["mem"] = parse_vm_stat(run(["/usr/bin/vm_stat"]))
    total = run(["/usr/sbin/sysctl", "-n", "hw.memsize"]).strip()
    if total.isdigit() and rec["mem"]:
        rec["mem"]["total_gb"] = round(int(total) / 1024 ** 3, 1)
    level = run(["/usr/sbin/sysctl", "-n", "kern.memorystatus_vm_pressure_level"]).strip()
    # 1 normal, 2 warning, 4 critical.
    rec["pressure"] = int(level) if level.isdigit() else None
    # The free memory percentage `memory_pressure` prints: what macOS counts
    # as free or reclaimable without swapping.
    free_pct = run(["/usr/sbin/sysctl", "-n", "kern.memorystatus_level"]).strip()
    rec["mem_free_pct"] = int(free_pct) if free_pct.isdigit() else None
    rec["swap_gb"] = parse_swapusage(run(["/usr/sbin/sysctl", "-n", "vm.swapusage"]))
    # So a restart between two samples is known, and the swap counter's
    # reset with it.
    rec["boot"] = parse_boottime(run(["/usr/sbin/sysctl", "-n", "kern.boottime"]))
    try:
        st = os.statvfs("/System/Volumes/Data")
        rec["disk_free_gb"] = round(st.f_bavail * st.f_frsize / 1024 ** 3, 1)
        rec["disk_total_gb"] = round(st.f_blocks * st.f_frsize / 1024 ** 3, 1)
    except OSError:
        rec["disk_free_gb"] = None
    ps = run(["/bin/ps", "-axo", "pid=,%cpu=,rss=,args="])
    footprint = parse_top_mem(run(["/usr/bin/top", "-l", "1", "-n", "100000", "-stats", "pid,mem"]))
    rec["groups"], rec["vms"] = parse_ps(ps, footprint)
    rec["sims_booted"] = count_booted_sims(ps)
    # Per-session tracing reads files sessions control; whatever goes wrong
    # there must not cost the sample.
    try:
        rec["by_session"] = attribute_sessions(ps, parents=parse_ppids(run(["/bin/ps", "-axo", "pid=,ppid="])))
    except Exception as e:  # noqa: BLE001
        rec["by_session"] = None
        print("tracing sessions failed: %r" % e, file=sys.stderr)
    console = run(["/usr/bin/stat", "-f", "%Su", "/dev/console"]).strip()
    rec["console"] = console or None
    if os.geteuid() == 0:
        pm = run(["/usr/bin/powermetrics", "-n", "1", "-i", "1000",
                  "--samplers", "cpu_power,gpu_power,ane_power,thermal"], timeout=20)
        if not pm:
            pm = run(["/usr/bin/powermetrics", "-n", "1", "-i", "1000",
                      "--samplers", "cpu_power,thermal"], timeout=20)
        rec["power"] = parse_powermetrics(pm) or None
    os.makedirs(HOST_DIR, mode=0o755, exist_ok=True)
    path = os.path.join(HOST_DIR, "host-%s.jsonl" % t.strftime("%Y-%m-%d"))
    with open(path, "a") as f:
        f.write(json.dumps(rec, separators=(",", ":"), sort_keys=True) + "\n")
    os.chmod(path, 0o644)


def load_host_samples(since):
    out = []
    for path in sorted(glob.glob(os.path.join(HOST_DIR, "host-*.jsonl"))):
        day = os.path.basename(path)[5:15]
        if day < since.strftime("%Y-%m-%d"):
            continue
        with open(path) as f:
            for line in f:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                t = parse_time(rec.get("t"))
                if t and t >= since:
                    rec["_t"] = t
                    out.append(rec)
    return out


