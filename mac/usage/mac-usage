def active_intervals(times, gap=IDLE_GAP_SECONDS):
    """Merges sorted timestamps into [start, end] spans with no gap over `gap`
    seconds. A lone entry counts as one minute."""
    spans = []
    for t in sorted(times):
        if spans and (t - spans[-1][1]).total_seconds() <= gap:
            spans[-1][1] = t
        else:
            spans.append([t, t])
    return [[s, max(e, s + dt.timedelta(minutes=1))] for s, e in spans]


# What a tool call counts as: an Xcode build or test run, or a simulator
# command. Cut's scripts run xcodebuild; an MCP server's tools count by the
# server's name.
# Only where a command starts counts, so `sed -n 1,40p ios/scripts/build-app.sh`
# or `rg xcodebuild` does not: at the start, after ; & | ( or a newline, or
# after then, do or else there; then any words that run the next one (env,
# time, exec, nice, nohup, xcrun, caffeinate and its flags, timeout and its
# duration, bash or sh), any VAR=value assignments, and a path.
_CMD_WRAPPER = (r"(?:env|time|exec|nice|nohup|xcrun|bash|sh|zsh|caffeinate(?:\s+-\w+)*"
                r"|timeout(?:\s+-\S+)*\s+\S+)")
CMD_START = (r"(?:^|[;&|(\n])\s*(?:(?:then|do|else)\s+)?"
             r"(?:(?:[A-Za-z_]\w*=\S*\s+)*" + _CMD_WRAPPER + r"\s+)*"
             r"(?:[A-Za-z_]\w*=\S*\s+)*(?:\S*/)?")
XCODE_CMD_RE = re.compile(CMD_START + r"(?:xcodebuild|scripts/(?:build-app|test-modules|verify-app-build|periphery-scan)\.sh)(?=\s|$|[;&|)])")
SIM_CMD_RE = re.compile(CMD_START + r"(?:simctl|idb)(?=\s|$|[;&|)])")
# Bumped when parse_transcript reads more, so cached transcripts are read again.
TRANSCRIPT_VERSION = 4


def tool_kind(item):
    """"xcode", "sim" or None for one tool_use block."""
    name = item.get("name")
    if not isinstance(name, str):
        return None
    if name.startswith("mcp__"):
        server = name.split("__")[1].lower()
        if "xcode" in server:
            return "xcode"
        return "sim" if "simulator" in server or "idb" in server else None
    inp = item.get("input")
    cmd = inp.get("command") if isinstance(inp, dict) else None
    if name != "Bash" or not isinstance(cmd, str):
        return None
    if XCODE_CMD_RE.search(cmd):
        return "xcode"
    return "sim" if SIM_CMD_RE.search(cmd) else None


# Text Claude Code writes as a user record that nobody typed: a local slash
# command and its output, and the note left when a turn is stopped.
NOT_TYPED_RE = re.compile(r"\s*(?:<command-|<local-command-|\[Request interrupted)")


def is_prompt(rec):
    """A message typed to the session, not a tool's result handed back, a
    compaction summary, or a record Claude Code wrote itself."""
    if rec.get("type") != "user" or rec.get("isMeta") or rec.get("isCompactSummary"):
        return False
    content = (rec.get("message") or {}).get("content") if isinstance(rec.get("message"), dict) else None
    if isinstance(content, str):
        return not NOT_TYPED_RE.match(content)
    if not isinstance(content, list):
        return False
    kinds = {c.get("type") for c in content if isinstance(c, dict)}
    if "text" not in kinds or "tool_result" in kinds:
        return False
    texts = [c.get("text") for c in content if isinstance(c, dict) and c.get("type") == "text"]
    return not all(isinstance(t, str) and NOT_TYPED_RE.match(t) for t in texts)


def parse_transcript(path):
    times = []
    cwd = worktree = None
    counts = {"prompts": 0, "tools": 0, "xcode_cmds": 0, "sim_cmds": 0}
    seen = set()
    with open(path, errors="replace") as f:
        for line in f:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                continue
            t = parse_time(rec.get("timestamp"))
            if t:
                times.append(t)
            # The server from the first folder; the worktree from the first
            # that is one, since a session can start in the repo and move in.
            if isinstance(rec.get("cwd"), str):
                if cwd is None:
                    cwd = rec["cwd"]
                if worktree is None:
                    worktree = session_id_of(rec["cwd"])
            if is_prompt(rec):
                counts["prompts"] += 1
            msg = rec.get("message")
            content = msg.get("content") if isinstance(msg, dict) else None
            for item in content if isinstance(content, list) else ():
                if not isinstance(item, dict) or item.get("type") != "tool_use":
                    continue
                # Each call once, should a message be written twice.
                tid = item.get("id")
                if tid is not None and tid in seen:
                    continue
                seen.add(tid)
                counts["tools"] += 1
                kind = tool_kind(item)
                if kind:
                    counts[kind + "_cmds"] += 1
    entry = {
        "spans": [[iso(s), iso(e)] for s, e in active_intervals(times)],
        # First entry to last, idle included.
        "open": [iso(min(times)), iso(max(times))] if times else None,
        # The server folder only: ~/code/<repo> or ~/code/any.
        "server": server_of(cwd),
        "worktree": worktree,
    }
    entry.update(counts)
    return entry


def server_of(cwd):
    if not cwd:
        return None
    m = re.search(r"/code/([^/]+)", cwd)
    return m.group(1) if m else "other"


def session_of(path):
    """The session a transcript belongs to: a subagent's
    <project>/<session>/subagents/x.jsonl belongs to <project>/<session>.jsonl."""
    parts = path.split(os.sep)
    if len(parts) >= 3 and parts[-2] == "subagents":
        return os.sep.join(parts[:-3] + [parts[-3] + ".jsonl"])
    return path


def collect_sessions(state):
    cache = state.setdefault("sessions", {})
    present = set()
    paths = [p for g in transcripts_globs() for p in glob.glob(g)]
    for path in paths:
        try:
            st = os.stat(path)
        except OSError:
            continue
        present.add(path)
        key = "%d:%d:%d" % (TRANSCRIPT_VERSION, st.st_size, int(st.st_mtime))
        if cache.get(path, {}).get("key") == key:
            continue
        try:
            entry = parse_transcript(path)
        except OSError:
            continue
        entry["key"] = key
        entry["session"] = session_of(path)
        cache[path] = entry
    # A transcript Claude Code has since deleted keeps its cached spans, so
    # its hours still count.
    return present


# --- Xcode build and test logs (worker) ---------------------------------------

# Xcode's times count from 1 January 2001.
APPLE_EPOCH = dt.datetime(2001, 1, 1, tzinfo=dt.timezone.utc)


def log_manifests():
    """Every Build and Test log index in the sessions' DerivedData: Cut's
    scripts build into ios/.derivedData (and ios/.derivedData/pr-verification),
    and anything else into Xcode's own ~/Library/Developer/Xcode/DerivedData,
    whose info.plist names the project. sweep-sessions deletes a session's
    DerivedData a day after its last use; the cache keeps what was read."""
    code = os.path.join(WORKER_HOME, "code")
    roots = [os.path.join(code, "*", ".claude", "worktrees", "*"), os.path.join(code, "any", "sessions", "*")]
    paths = set()
    for root in roots:
        for mid in ("", "*"):
            for dd in (".derivedData", "DerivedData"):
                for sub in ("", "*"):
                    paths.update(glob.glob(os.path.join(root, mid, dd, sub, "Logs", "*", "LogStoreManifest.plist")))
    paths.update(glob.glob(os.path.join(WORKER_HOME, "Library", "Developer", "Xcode", "DerivedData", "*", "Logs",
                                        "*", "LogStoreManifest.plist")))
    return sorted(p for p in paths if os.path.basename(os.path.dirname(p)) in ("Build", "Test"))


def manifest_session(path):
    sid = session_id_of(path)
    if sid:
        return sid
    # Xcode's own DerivedData/<project>-<hash>/Logs/<kind>/LogStoreManifest.plist.
    info = read_small_plist(os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(path))), "info.plist"))
    ws = info.get("WorkspacePath") if info else None
    return session_id_of(ws) if isinstance(ws, str) else None


def parse_log_manifest(path):
    """Each log in one LogStoreManifest.plist: build or test, when it started,
    how long it took, and Xcode's status for it ("S" succeeded, "W" with
    warnings, "E" failed). Titles and log files are not read."""
    kind = os.path.basename(os.path.dirname(path)).lower()
    with open(path, "rb") as f:
        m = plistlib.load(f)
    logs = m.get("logs") if isinstance(m, dict) else None
    out = {}
    for uid, log in (logs.items() if isinstance(logs, dict) else ()):
        if not isinstance(log, dict):
            continue
        start, stop = log.get("timeStartedRecording"), log.get("timeStoppedRecording")
        if not all(isinstance(x, (int, float)) for x in (start, stop)) or stop < start:
            continue
        obs = log.get("primaryObservable")
        status = obs.get("highLevelStatus") if isinstance(obs, dict) else None
        status = status or log.get("highLevelStatus")
        out[str(uid)] = {"kind": kind, "start": iso(APPLE_EPOCH + dt.timedelta(seconds=start)),
                         "seconds": round(stop - start, 1), "status": status if isinstance(status, str) else None}
    return out


def collect_builds(state):
    cache = state.setdefault("builds", {})
    for path in log_manifests():
        try:
            st = os.stat(path)
        except OSError:
            continue
        key = "%d:%d" % (st.st_size, int(st.st_mtime))
        if cache.get(path, {}).get("key") == key:
            continue
        try:
            logs = parse_log_manifest(path)
        # A half-written index, or a format Xcode has changed, skips this
        # one index rather than the run.
        except Exception:  # noqa: BLE001
            continue
        # A log Xcode has since dropped from the index still counts.
        old = cache.get(path, {}).get("logs", {})
        cache[path] = {"key": key, "session": manifest_session(path), "logs": dict(old, **logs)}


def cmd_collect(_args):
    state_path = os.path.join(data_dir(), "state.json")
    state = read_json(state_path, {})
    now = utcnow()
    problems = []
    try:
        with open(token_file()) as f:
            gh = GitHub(f.read().strip())
        collect_jobs(gh, state, now, problems)
    # Any failure, an HTTP read cut short included, lands in the report
    # rather than ending the run before what was fetched is saved.
    except Exception as e:  # noqa: BLE001
        problems.append("CI jobs not collected at %s: %s: %s" % (iso(now), type(e).__name__, e))
    try:
        collect_sessions(state)
    except Exception as e:  # noqa: BLE001
        problems.append("agent sessions not collected at %s: %s: %s" % (iso(now), type(e).__name__, e))
    try:
        collect_builds(state)
    except Exception as e:  # noqa: BLE001
        problems.append("Xcode build logs not collected at %s: %s: %s" % (iso(now), type(e).__name__, e))
    state["problems"] = problems
    write_json(state_path, state)
    since = parse_time(HISTORY_FROM + "T00:00:00Z")
    text = render_markdown(build_summary(state, load_host_samples(since), since, now))
    tmp = os.path.join(data_dir(), ".summary.md")
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(data_dir(), "summary.md"))
    for p in problems:
        print(p, file=sys.stderr)


# --- The summary -------------------------------------------------------------


def outcome(j):
    """success, failed (a failure or timeout), or None for the rest, such as a
    cancelled job, which is priced at its own minutes."""
    c = j.get("conclusion")
    if c == "success":
        return "success"
    return "failed" if c in FAILED_CONCLUSIONS else None


def hosted_durations(jobs):
    """The billed minutes of each job on HOSTED_RUNNER that reached a runner,
    by (job_key, outcome): what the same job takes there when it succeeds,
    and when it fails or times out. `price` is the mean, so the long tail
    counts, like a deploy waiting on TestFlight, or the median under
    MEAN_MIN_RUNS runs. The speed comparison uses the median."""
    by_key = {}
    for j in jobs.values():
        if HOSTED_RUNNER not in (j.get("labels") or []) or not outcome(j):
            continue
        mins = billed_minutes(j)
        if mins is not None:
            by_key.setdefault((job_key(j), outcome(j)), []).append(mins)
    out = {}
    for k, v in by_key.items():
        mean, median = statistics.mean(v), statistics.median(v)
        out[k] = {"mean": mean, "median": median, "n": len(v),
                  "price": mean if len(v) >= MEAN_MIN_RUNS else median}
    return out


def summarize_ci(jobs, since, now):
    """CI from the Mac Studio's first job on, or `since` if later. Each Mac
    Studio job that succeeded, failed or timed out is priced at what the same
    job took on HOSTED_RUNNER with the same outcome, where there is history;
    the rest at their own minutes."""
    hosted_by_key = hosted_durations(jobs)
    first_mac = None
    for j in jobs.values():
        if runner_kind(j) == "mac-studio" and billed_minutes(j) is not None:
            c = parse_time(j.get("created_at"))
            if c and (first_mac is None or c < first_mac):
                first_mac = c
    start = max(since, first_mac) if first_mac else since
    kinds = ("mac-studio", "github-macos", "github-linux")
    out = {k: {"jobs": 0, "minutes": 0, "failed": 0, "never_ran": 0, "waits_s": []} for k in kinds}
    mac = out["mac-studio"]
    mac.update({"hosted_minutes": 0.0, "priced_from_history": 0, "priced_at_median": 0,
                "gated_jobs": 0, "gated_hosted_minutes": 0.0})
    by_day = {}
    mac_by_key = {}
    for j in jobs.values():
        kind = runner_kind(j)
        if kind not in out:
            continue
        created = parse_time(j.get("created_at"))
        if not created or created < start or created > now:
            continue
        o = out[kind]
        mins = billed_minutes(j)
        if mins is None:
            if j.get("conclusion") == "cancelled":
                o["never_ran"] += 1
            continue
        o["jobs"] += 1
        o["minutes"] += mins
        if j.get("conclusion") != "success":
            o["failed"] += 1
        started = parse_time(j.get("started_at"))
        o["waits_s"].append(max(0, (started - created).total_seconds()))
        if kind != "mac-studio":
            continue
        key = job_key(j)
        hosted = mins
        h = hosted_by_key.get((key, outcome(j)))
        if h:
            hosted = h["price"]
            mac["priced_from_history"] += 1
            if h["n"] < MEAN_MIN_RUNS:
                mac["priced_at_median"] += 1
        mac["hosted_minutes"] += hosted
        if label_gated(j):
            mac["gated_jobs"] += 1
            mac["gated_hosted_minutes"] += hosted
        day = started.date().isoformat()
        by_day[day] = by_day.get(day, 0) + mins
        if j.get("conclusion") == "success":
            mac_by_key.setdefault(key, []).append(mins)
    for o in out.values():
        w = o.pop("waits_s")
        o["wait_median_s"] = statistics.median(w) if w else None
        o["wait_p90_s"] = percentile(w, 0.9)
        o["wait_max_s"] = max(w) if w else None
    mac["hosted_minutes"] = round(mac["hosted_minutes"], 1)
    mac["gated_hosted_minutes"] = round(mac["gated_hosted_minutes"], 1)
    out["first_mac_job"] = iso(first_mac) if first_mac else None
    out["mac_minutes_by_day"] = dict(sorted(by_day.items()))
    out["speed"] = {}
    for k, v in sorted(mac_by_key.items()):
        h = hosted_by_key.get((k, "success"))
        if h:
            out["speed"][k] = {"mac_median": statistics.median(v), "mac_n": len(v), "hosted_median": h["median"],
                               "hosted_mean": round(h["mean"], 1), "hosted_n": h["n"]}
    return out


def merge_spans(spans):
    """Overlapping (start, end) spans merged into one each."""
    out = []
    for s, e in sorted(spans):
        if out and s <= out[-1][1]:
            out[-1][1] = max(out[-1][1], e)
        else:
            out.append([s, e])
    return out


def span_hours(spans):
    return sum((e - s).total_seconds() for s, e in spans) / 3600


def host_by_session(samples, since, now):
    """Per session ID, from the host samples: the minutes its Xcode processes
    ran, as spans, and their CPU-minutes; the minutes it had a simulator
    booted, and the CPU-minutes of the processes in them. Each sample stands
    for the minute it was taken in. Also the host's Xcode CPU-minutes and
    booted simulator-minutes in the samples that trace sessions, so the share
    traced is known."""
    out = {}
    host_xcode_cpu_min = 0.0
    host_sim_min = 0
    for r in samples:
        t = r.get("_t")
        # None: tracing failed in that sample, so it traced nothing.
        if not t or t < since or t > now or r.get("by_session") is None:
            continue
        host_xcode_cpu_min += (_get(r, "groups", "xcode", "cpu") or 0) / 100
        host_sim_min += r.get("sims_booted") or 0
        for sid, v in (r.get("by_session") or {}).items():
            h = out.setdefault(sid, {"xcode_spans": [], "xcode_cpu_min": 0.0, "sim_min": 0, "sim_cpu_min": 0.0})
            if v.get("xcode_n"):
                h["xcode_spans"].append((t, t + dt.timedelta(minutes=1)))
            h["xcode_cpu_min"] += (v.get("xcode_cpu") or 0) / 100
            # Simulator-minutes: two booted for a minute count two.
            h["sim_min"] += v.get("sims") or 0
            h["sim_cpu_min"] += (v.get("sim_cpu") or 0) / 100
    return out, host_xcode_cpu_min, host_sim_min


def builds_by_session(builds, since, now):
    """Per session ID, or None for logs no session's folder holds: Xcode's
    build and test runs that started from `since` to `now`, the failed ones,
    their seconds, and their spans."""
    out = {}
    seen = set()
    for entry in (builds or {}).values():
        for uid, log in (entry.get("logs") or {}).items():
            kind = log.get("kind")
            start = parse_time(log.get("start"))
            if uid in seen or kind not in ("build", "test") or not start or start < since or start > now:
                continue
            seen.add(uid)
            b = out.setdefault(entry.get("session"), {"build": 0, "build_failed": 0, "build_s": 0.0, "test": 0,
                                                       "test_failed": 0, "test_s": 0.0, "spans": []})
            secs = log.get("seconds") or 0
            b[kind] += 1
            b[kind + "_s"] += secs
            if log.get("status") == "E":
                b[kind + "_failed"] += 1
            b["spans"].append((start, min(now, start + dt.timedelta(seconds=max(secs, 60)))))
    return out


def summarize_sessions(sessions, since, now, samples=(), builds=None):
    """A session is one worktree's (see session_id_of), or a transcript's
    where it has none, with its subagent transcripts counted as part of it,
    so time spent waiting on a subagent counts once. It is active while its
    transcripts are (active_intervals), while its Xcode processes run, and
    during its builds and test runs, so a long build counts. session_hours
    adds up every session's active time, so two sessions at once count twice.
    busy_hours is the time with at least one active, overall and for each
    server. open_hours runs from each session's first entry to its last, idle
    included. A session used Xcode when it ran xcodebuild or a simulator, or a
    tool that does."""
    host, host_xcode_cpu_min, host_sim_min = host_by_session(samples, since, now)
    logs = builds_by_session(builds, since, now)
    # Which session each transcript counts towards: its parent's worktree.
    key_of = {}
    for path, entry in sessions.items():
        parent, wt = entry.get("session") or path, entry.get("worktree")
        if wt and (parent == path or parent not in key_of):
            key_of[parent] = wt

    def new_session(server):
        return {"spans": [], "open": [], "server": server, "prompts": 0, "tools": 0, "xcode_cmds": 0,
                "sim_cmds": 0}

    by_session = {}
    for path, entry in sessions.items():
        mine = []
        for a, b in entry.get("spans", []):
            a, b = parse_time(a), parse_time(b)
            if not a or b < since or a > now:
                continue
            mine.append((max(a, since), min(b, now)))
        if not mine:
            continue
        parent = entry.get("session") or path
        sess = by_session.setdefault(key_of.get(parent, parent), new_session(None))
        sess["spans"].extend(mine)
        o = [parse_time(x) for x in entry.get("open") or ()]
        if len(o) == 2 and all(o):
            sess["open"].append((max(o[0], since), min(o[1], now)))
        # The parent's folder wins; a subagent's is the same worktree or one under it.
        if entry.get("server") and (sess["server"] is None or parent == path):
            sess["server"] = entry["server"]
        if parent == path:
            # A subagent's first message is its task from the session, not a prompt.
            sess["prompts"] += entry.get("prompts", 0)
        for k in ("tools", "xcode_cmds", "sim_cmds"):
            sess[k] += entry.get(k, 0)
    # Builds and runs whose transcripts are gone, or that ran between them.
    for sid in set(host) | set(logs):
        if sid and sid not in by_session:
            by_session[sid] = new_session(sid.split("/")[0])
    spans, server_spans, xcode_spans = [], {}, {}
    by_server, rows = {}, []
    totals = {"open_h": 0.0, "prompts": 0, "tools": 0, "xcode_cmds": 0, "sim_cmds": 0, "xcode_sessions": 0,
              "sim_sessions": 0, "xcode_run_min": 0, "xcode_cpu_min": 0.0, "sim_min": 0, "sim_cpu_min": 0.0}
    for key, sess in by_session.items():
        h = host.get(key, {})
        lg = logs.get(key, {})
        act = merge_spans(sess["spans"] + h.get("xcode_spans", []) + lg.get("spans", []))
        if not act:
            continue
        spans.extend(act)
        srv = sess["server"] or "other"
        server_spans.setdefault(srv, []).extend(act)
        # Active time is open too, as when builds ran past the transcript.
        opened = sess["open"] + [tuple(x) for x in act]
        # A worktree can hold several conversations days apart; the gaps
        # between them were not open.
        open_h = span_hours(merge_spans(opened))
        xcode_run_min = round(span_hours(merge_spans(h.get("xcode_spans", []))) * 60)
        used_xcode = bool(sess["xcode_cmds"] or xcode_run_min or lg.get("build") or lg.get("test"))
        used_sim = bool(sess["sim_cmds"] or h.get("sim_min"))
        b = by_server.setdefault(srv, {"sessions": 0, "hours": 0.0, "xcode_sessions": 0, "xcode_hours": 0.0})
        b["sessions"] += 1
        b["hours"] += span_hours(act)
        if used_xcode or used_sim:
            b["xcode_sessions"] += 1
            b["xcode_hours"] += span_hours(act)
            xcode_spans.setdefault(srv, []).extend(act)
        totals["open_h"] += open_h
        for k in ("prompts", "tools", "xcode_cmds", "sim_cmds"):
            totals[k] += sess[k]
        totals["xcode_sessions"] += used_xcode
        totals["sim_sessions"] += used_sim
        totals["xcode_run_min"] += xcode_run_min
        totals["xcode_cpu_min"] += h.get("xcode_cpu_min", 0.0)
        totals["sim_min"] += h.get("sim_min", 0)
        totals["sim_cpu_min"] += h.get("sim_cpu_min", 0.0)
        # A worktree's ID, or None for a transcript with no worktree.
        rows.append({"session": None if key.startswith("/") else key,
                     "server": srv, "start": iso(act[0][0]), "open_hours": round(open_h, 2),
                     "active_hours": round(span_hours(act), 2), "prompts": sess["prompts"], "tools": sess["tools"],
                     "builds": lg.get("build", 0), "builds_failed": lg.get("build_failed", 0),
                     "tests": lg.get("test", 0), "tests_failed": lg.get("test_failed", 0),
                     "xcode_cpu_hours": round(h.get("xcode_cpu_min", 0.0) / 60, 2),
                     "sim_hours": round(h.get("sim_min", 0) / 60, 2), "xcode": used_xcode or used_sim})
    for srv, b in by_server.items():
        b["busy_hours"] = span_hours(merge_spans(server_spans[srv]))
        b["xcode_busy_hours"] = span_hours(merge_spans(xcode_spans.get(srv, [])))
    session_hours = span_hours(spans)
    events = sorted([(a, 1) for a, _ in spans] + [(e, -1) for _, e in spans], key=lambda x: (x[0], x[1]))
    cur = peak = 0
    for _, d in events:
        cur += d
        peak = max(peak, cur)
    all_logs = {"build": 0, "build_failed": 0, "build_s": 0.0, "test": 0, "test_failed": 0, "test_s": 0.0}
    for lg in logs.values():
        for k in all_logs:
            all_logs[k] += lg[k]
    traced = sum(h["xcode_cpu_min"] for h in host.values())
    rows.sort(key=lambda r: -r["active_hours"])
    return {
        "sessions": sum(b["sessions"] for b in by_server.values()),
        "session_hours": round(session_hours, 2),
        "busy_hours": round(span_hours(merge_spans(spans)), 2),
        "open_hours": round(totals["open_h"], 2),
        "peak_concurrent": peak,
        "prompts": totals["prompts"],
        "tool_calls": totals["tools"],
        "xcode": {
            "sessions": totals["xcode_sessions"],
            "commands": totals["xcode_cmds"],
            "builds": all_logs["build"], "builds_failed": all_logs["build_failed"],
            "build_hours": round(all_logs["build_s"] / 3600, 2),
            "tests": all_logs["test"], "tests_failed": all_logs["test_failed"],
            "test_hours": round(all_logs["test_s"] / 3600, 2),
            "untraced_runs": (logs.get(None) or {}).get("build", 0) + (logs.get(None) or {}).get("test", 0),
            "running_hours": round(totals["xcode_run_min"] / 60, 2),
            "cpu_hours": round(totals["xcode_cpu_min"] / 60, 2),
            # Of the host's Xcode CPU while sessions were traced.
            "traced_pct": round(100 * traced / host_xcode_cpu_min, 1) if host_xcode_cpu_min else None,
        },
        "simulators": {
            "sessions": totals["sim_sessions"],
            "commands": totals["sim_cmds"],
            "booted_hours": round(totals["sim_min"] / 60, 2),
            "cpu_hours": round(totals["sim_cpu_min"] / 60, 2),
            # Of the host's booted simulator-minutes while sessions were traced.
            "traced_pct": round(100 * totals["sim_min"] / host_sim_min, 1) if host_sim_min else None,
        },
        "busiest": rows[:SESSIONS_SHOWN],
        "by_server": {k: {"sessions": v["sessions"], "hours": round(v["hours"], 2),
                          "busy_hours": round(v["busy_hours"], 2), "xcode_sessions": v["xcode_sessions"],
                          "xcode_hours": round(v["xcode_hours"], 2),
                          "xcode_busy_hours": round(v["xcode_busy_hours"], 2)}
                      for k, v in sorted(by_server.items())},
    }


def summarize_host(samples, now):
    if not samples:
        return None

    def vals(f):
        out = []
        for r in samples:
            try:
                v = f(r)
            except (KeyError, TypeError, AttributeError):
                v = None
            if v is not None:
                out.append(v)
        return out

    busy = vals(lambda r: 100 - r["cpu"]["idle"])
    mem = vals(lambda r: r["mem"]["used_gb"])
    total = vals(lambda r: r["mem"]["total_gb"])
    swap = vals(lambda r: r["swap_gb"])
    pressure = vals(lambda r: r["pressure"])
    disk = vals(lambda r: r["disk_free_gb"])
    watts = vals(lambda r: r["power"]["combined_mw"] / 1000)
    thermal = vals(lambda r: r["power"]["thermal"])
    colima = vals(lambda r: 1 if "colima" in r["groups"] else 0)
    vms = vals(lambda r: max(0, r["groups"].get("vm", {}).get("n", 0)
                             - (1 if "colima" in r["groups"] else 0)))
    claude = vals(lambda r: r["groups"].get("claude", {}).get("n", 0))
    first, last = samples[0]["_t"], samples[-1]["_t"]
    # Against now, not the last sample, so a daemon that stopped shows.
    expected = max(1, math.floor((now - first).total_seconds() / 60) + 1)
    avg_w = statistics.mean(watts) if watts else None
    return {
        "first": iso(first),
        "last": iso(last),
        "last_age_min": round((now - last).total_seconds() / 60, 1),
        "samples": len(samples),
        "coverage": round(min(1.0, len(samples) / expected), 3),
        "cpu_busy_avg": round(statistics.mean(busy), 1) if busy else None,
        "cpu_busy_p95": round(percentile(busy, 0.95), 1) if busy else None,
        "mem_used_avg_gb": round(statistics.mean(mem), 1) if mem else None,
        "mem_used_max_gb": round(max(mem), 1) if mem else None,
        "mem_total_gb": total[-1] if total else None,
        "swap_max_gb": max(swap) if swap else None,
        "pressure_not_normal_pct": round(100 * sum(1 for p in pressure if p > 1) / len(pressure), 1)
        if pressure else None,
        "disk_free_min_gb": min(disk) if disk else None,
        "vms_avg": round(statistics.mean(vms), 2) if vms else None,
        "colima_up_pct": round(100 * statistics.mean(colima), 1) if colima else None,
        "claude_procs_max": max(claude) if claude else None,
        "soc_watts_avg": round(avg_w, 1) if avg_w is not None else None,
        "soc_watts_max": round(max(watts), 1) if watts else None,
        "thermal_not_nominal": sum(1 for x in thermal if x.lower() != "nominal"),
        "thermal_samples": len(thermal),
    }


def _get(r, *keys):
    for k in keys:
        if not isinstance(r, dict):
            return None
        r = r.get(k)
    return r


def span_days(times):
    return (max(times) - min(times)).total_seconds() / 86400 if times else 0.0


def coverage(times):
    """Share of the minutes from the first to the last time that have one."""
    if not times:
        return 0.0
    expected = math.floor((max(times) - min(times)).total_seconds() / 60) + 1
    return min(1.0, len(times) / expected)


def breakdown(r):
    """What held memory in one sample, from its process groups: their
    footprints, or their resident memory in samples from before footprints
    were taken."""
    groups = r.get("groups") or {}
    source = "footprint" if any("mem_gb" in v for v in groups.values() if isinstance(v, dict)) else "resident"
    key = "mem_gb" if source == "footprint" else "rss_gb"
    return {
        "t": iso(r["_t"]),
        "used_gb": _get(r, "mem", "used_gb"),
        "compressed_gb": _get(r, "mem", "compressed_gb"),
        "free_pct": r.get("mem_free_pct"),
        "swap_gb": r.get("swap_gb"),
        "pressure": r.get("pressure"),
        "groups_gb": {g: round(_get(groups, g, key) or 0.0, 1) for g in ("vm", "claude", "xcode", "simulator")},
        "groups_source": source,
        "ci_vms": max(0, (_get(groups, "vm", "n") or 0) - (1 if "colima" in groups else 0)),
        "colima": "colima" in groups,
        "claude_procs": _get(groups, "claude", "n") or 0,
        "sims_booted": r.get("sims_booted"),
    }


def disk_trend(samples):
    """Free disk's change in GB a day: the least-squares slope through every
    sample. None under a day, when a cleanup or one build swings it."""
    pts = [(r["_t"].timestamp() / 86400, r["disk_free_gb"]) for r in samples if r.get("disk_free_gb") is not None]
    if len(pts) < 2 or pts[-1][0] - pts[0][0] < 1:
        return None
    mx = statistics.mean(x for x, _ in pts)
    my = statistics.mean(y for _, y in pts)
    den = sum((x - mx) ** 2 for x, _ in pts)
    return round(sum((x - mx) * (y - my) for x, y in pts) / den, 1) if den else None


def pressure_key(r):
    """The worse of two samples: higher pressure, then less free memory."""
    free = r.get("mem_free_pct")
    return (r.get("pressure") or 0, -(100 if free is None else free))


def plural(n, word):
    return "%d %s%s" % (n, word, "" if n == 1 else "es" if word.endswith("s") else "s")


def summarize_headroom(samples):
    """Whether memory and disk are enough, from the host samples: verdicts
    with their reasons, the samples that show what held memory, and one row
    per UTC day."""
    if not samples:
        return None
    days = {}
    swap_total = 0.0
    swap_times = []
    pressure_times = []
    warn = critical = 0
    streak = longest = None  # (first, last) sample times of a stretch
    peak = worst = prev = None
    for r in samples:
        d = days.setdefault(r["_t"].date().isoformat(), {
            "samples": 0, "mem_peak_gb": None, "mem_free_pct_min": None, "warn_min": 0,
            "critical_min": 0, "swap_written_gb": None, "swap_peak_gb": None, "vms_max": 0,
            "claude_procs_max": 0, "sims_max": None, "disk_free_min_gb": None})
        d["samples"] += 1

        def low(key, v):
            if v is not None and (d[key] is None or v < d[key]):
                d[key] = v

        def high(key, v):
            if v is not None and (d[key] is None or v > d[key]):
                d[key] = v

        used = _get(r, "mem", "used_gb")
        high("mem_peak_gb", used)
        low("mem_free_pct_min", r.get("mem_free_pct"))
        high("swap_peak_gb", r.get("swap_gb"))
        low("disk_free_min_gb", r.get("disk_free_gb"))
        high("sims_max", r.get("sims_booted"))
        b = breakdown(r)
        high("vms_max", b["ci_vms"])
        high("claude_procs_max", b["claude_procs"])
        if used is not None and (peak is None or used > _get(peak, "mem", "used_gb")):
            peak = r

        p = r.get("pressure")
        if p is not None:
            pressure_times.append(r["_t"])
            if p >= PRESSURE_CRITICAL:
                critical += 1
                d["critical_min"] += 1
            elif p >= PRESSURE_WARN:
                warn += 1
                d["warn_min"] += 1
            if worst is None or pressure_key(r) > pressure_key(worst):
                worst = r
        gap = prev is not None and (r["_t"] - prev["_t"]).total_seconds() > MAX_SAMPLE_GAP_SECONDS
        if p is not None and p >= PRESSURE_WARN:
            streak = (r["_t"], r["_t"]) if streak is None or gap else (streak[0], r["_t"])
            if longest is None or streak[1] - streak[0] > longest[1] - longest[0]:
                longest = streak
        else:
            streak = None

        # Pages swapped out since boot. After a restart, everything the
        # counter holds was written since the last sample.
        cur = _get(r, "mem", "swapout_gb")
        if cur is not None:
            swap_times.append(r["_t"])
            before = _get(prev, "mem", "swapout_gb") if prev else None
            if before is not None:
                restarted = (r.get("boot") and prev.get("boot") and r["boot"] != prev["boot"]) or cur < before
                written = cur if restarted else cur - before
                swap_total += written
                d["swap_written_gb"] = (d["swap_written_gb"] or 0.0) + written
        prev = r

    for d in days.values():
        if d["swap_written_gb"] is not None:
            d["swap_written_gb"] = round(d["swap_written_gb"], 2)

    first, last = samples[0]["_t"], samples[-1]["_t"]
    swap_days = span_days(swap_times)
    # At least an hour, so two samples a second apart can't divide by zero.
    swap_per_day = round(swap_total / max(swap_days, 1 / 24.0), 2) if len(swap_times) > 1 else None
    total = next((_get(r, "mem", "total_gb") for r in reversed(samples) if _get(r, "mem", "total_gb")), None)
    disk_total = next((r["disk_total_gb"] for r in reversed(samples) if r.get("disk_total_gb")), None)
    disk_free = [r["disk_free_gb"] for r in samples if r.get("disk_free_gb") is not None]
    disk_min = min(disk_free) if disk_free else None
    free_pct = [r["mem_free_pct"] for r in samples if r.get("mem_free_pct") is not None]
    compressed = [_get(r, "mem", "compressed_gb") for r in samples if _get(r, "mem", "compressed_gb") is not None]
    worst_day = max(days.items(), key=lambda kv: kv[1]["warn_min"] + kv[1]["critical_min"])
    worst_day_min = worst_day[1]["warn_min"] + worst_day[1]["critical_min"]
    longest_min = round((longest[1] - longest[0]).total_seconds() / 60) + 1 if longest else 0

    # Each verdict waits for its own readings: pressure goes back to the
    # daemon's first sample, the swap counter starts at a later apply.
    early = []
    if span_days(pressure_times) < HEADROOM_MIN_DAYS:
        early.append("%.1f days of pressure samples" % span_days(pressure_times))
    elif coverage(pressure_times) < HEADROOM_MIN_COVERAGE:
        early.append("pressure samples for only %.0f%% of minutes" % (100 * coverage(pressure_times)))
    if swap_days < HEADROOM_MIN_DAYS:
        early.append("%.1f days of swap writes" % swap_days)

    mem_why, mem = [], "enough"
    if critical:
        mem_why.append("pressure reached critical in %s" % plural(critical, "sample"))
    if worst_day_min >= MEM_SHORT_WARN_MIN_PER_DAY:
        mem_why.append("%s at warning or worse on %s, %d or more in a day is short"
                       % (plural(worst_day_min, "minute"), worst_day[0], MEM_SHORT_WARN_MIN_PER_DAY))
    if swap_per_day is not None and swap_per_day >= MEM_SHORT_SWAP_GB_PER_DAY:
        mem_why.append("%s GB a day swapped out, %s or more is short" % (swap_per_day, MEM_SHORT_SWAP_GB_PER_DAY))
    if mem_why:
        mem = "short"
    else:
        if warn:
            mem_why.append("pressure reached warning in %s, never critical, at most %d minutes in a day"
                           % (plural(warn, "sample"), worst_day_min))
        if swap_per_day is not None and swap_per_day >= MEM_TIGHT_SWAP_GB_PER_DAY:
            mem_why.append("%s GB a day swapped out, %s or more is tight" % (swap_per_day, MEM_TIGHT_SWAP_GB_PER_DAY))
        if mem_why:
            mem = "tight"
        elif pressure_times:
            mem_why.append("pressure stayed normal in all %s" % plural(len(pressure_times), "sample"))
            if swap_per_day is not None:
                mem_why.append("%s GB a day swapped out" % swap_per_day)
        else:
            mem, mem_why = "unknown", ["no samples with a pressure level"]

    slope = disk_trend(samples)
    disk_why, disk = [], "unknown"
    disk_early = []
    if disk_min is not None:
        latest = disk_free[-1]

        def days_to(level):
            return round((latest - level) / -slope) if slope is not None and slope < 0 and latest > level else None

        to_tight, to_short = days_to(DISK_TIGHT_FREE_GB), days_to(DISK_SHORT_FREE_GB)
        disk_why.append("%s GB free at the lowest" % disk_min)
        if slope is None:
            disk_early.append("under a day of free-disk samples for a trend")
        else:
            disk_why.append("%+.1f GB a day" % slope)
            if span_days([r["_t"] for r in samples if r.get("disk_free_gb") is not None]) < HEADROOM_MIN_DAYS:
                disk_early.append("the trend spans under %d days" % HEADROOM_MIN_DAYS)
        if disk_min < DISK_SHORT_FREE_GB or (to_short is not None and to_short <= DISK_SHORT_HORIZON_DAYS):
            disk = "short"
        elif disk_min < DISK_TIGHT_FREE_GB or (to_tight is not None and to_tight <= DISK_TIGHT_HORIZON_DAYS):
            disk = "tight"
        else:
            disk = "enough"
        if to_tight is not None:
            disk_why.append("%d GB in about %d days at that rate" % (DISK_TIGHT_FREE_GB, to_tight))
        disk_why.append("the heartbeat warns under %d GB and calls it critical under %d GB"
                        % (DISK_TIGHT_FREE_GB, DISK_SHORT_FREE_GB))

    return {
        "host_days": round((last - first).total_seconds() / 86400, 2),
        "memory": mem,
        "memory_why": mem_why,
        "memory_too_early": early,
        "disk": disk,
        "disk_why": disk_why,
        "disk_too_early": disk_early,
        "mem_total_gb": total,
        "pressure_samples": len(pressure_times),
        "pressure_coverage": round(coverage(pressure_times), 3),
        "warn_samples": warn,
        "critical_samples": critical,
        "worst_day": worst_day[0],
        "worst_day_not_normal_min": worst_day_min,
        "longest_not_normal_min": longest_min,
        "longest_not_normal_from": iso(longest[0]) if longest else None,
        "swap_written_gb": round(swap_total, 2) if len(swap_times) > 1 else None,
        "swap_written_per_day_gb": swap_per_day,
        "swap_counted_from": iso(swap_times[0]) if swap_times else None,
        "mem_free_pct_min": min(free_pct) if free_pct else None,
        "compressed_max_gb": max(compressed) if compressed else None,
        "disk_free_min_gb": disk_min,
        "disk_total_gb": disk_total,
        "disk_gb_per_day": slope,
        "at_peak": breakdown(peak) if peak else None,
        # Only when pressure left normal: then it shows what ran at the
        # moment that set the verdict, which the GB peak may not.
        "at_worst": breakdown(worst) if worst is not None and worst["pressure"] >= PRESSURE_WARN else None,
        "days": dict(sorted(days.items())),
    }


def payback(value_per_month, power_per_month):
    net = value_per_month - (power_per_month or 0.0)
    return round(PURCHASE_NET_USD / net, 1) if net > 0 else None


def money_model(ci, agents, host, start, data_end):
    """Value per month at the pace from `start`, the first Mac Studio job or
    --since if later, to the last collect, so a collect that stops leaves the
    pace where it was. `ci` and `agents` cover the same span. Agent sessions
    are priced apart, as a range (see HOSTED_MAC_SESSION_USD_PER_MIN), and
    two paybacks add each end of it."""
    mac = ci["mac-studio"]
    # At least a day, so one busy hour isn't stretched to a month.
    ci_days = max(1.0, (data_end - start).total_seconds() / 86400) if ci.get("first_mac_job") else None

    def per_month(usd):
        return round(usd / ci_days * DAYS_PER_MONTH, 2) if ci_days else 0.0

    power_month = None
    if host and host.get("soc_watts_avg") is not None:
        power_month = round(host["soc_watts_avg"] / 1000 * 24 * DAYS_PER_MONTH * ELECTRICITY_USD_PER_KWH, 2)
    value = round(mac["hosted_minutes"] * HOSTED_USD_PER_MIN, 2)
    gated = round(mac["gated_hosted_minutes"] * HOSTED_USD_PER_MIN, 2)
    mine = [v for k, v in agents["by_server"].items() if k in MAC_SESSION_SERVERS]
    # Only the sessions that used Xcode or a simulator: the rest would run
    # on Linux. Low: one Mac whenever any is active. High: one per session.
    low_min = round(60 * sum(v["xcode_busy_hours"] for v in mine), 1)
    high_min = round(60 * sum(v["xcode_hours"] for v in mine), 1)
    low = round(low_min * HOSTED_MAC_SESSION_USD_PER_MIN, 2)
    high = round(high_min * HOSTED_MAC_SESSION_USD_PER_MIN, 2)

    def with_sessions(ci_usd):
        if not ci_days:
            return {"low": None, "high": None}
        # The low end of sessions gives the longer payback.
        return {"low": payback(per_month(ci_usd + low), power_month),
                "high": payback(per_month(ci_usd + high), power_month)}

    return {
        "start": iso(start),
        "ci_days": round(ci_days, 2) if ci_days else None,
        "usd_per_min": HOSTED_USD_PER_MIN,
        "value_usd": value,
        "value_per_month_usd": per_month(value),
        "payback_months": payback(per_month(value), power_month) if ci_days else None,
        "gated_value_usd": gated,
        "gated_per_month_usd": per_month(gated),
        "gated_payback_months": payback(per_month(gated), power_month) if ci_days else None,
        "own_minutes_value_usd": round(mac["minutes"] * HOSTED_USD_PER_MIN, 2),
        "session_usd_per_min": HOSTED_MAC_SESSION_USD_PER_MIN,
        "sessions_priced": sum(v["xcode_sessions"] for v in mine),
        "sessions_all": sum(v["sessions"] for v in mine),
        # Every Cut session, Xcode or not, for comparison.
        "sessions_all_low_usd": round(60 * sum(v["busy_hours"] for v in mine) * HOSTED_MAC_SESSION_USD_PER_MIN, 2),
        "sessions_all_high_usd": round(60 * sum(v["hours"] for v in mine) * HOSTED_MAC_SESSION_USD_PER_MIN, 2),
        "sessions_low_minutes": low_min,
        "sessions_high_minutes": high_min,
        "sessions_low_usd": low,
        "sessions_high_usd": high,
        "sessions_low_per_month_usd": per_month(low),
        "sessions_high_per_month_usd": per_month(high),
        "with_sessions_payback_months": with_sessions(value),
        "gated_with_sessions_payback_months": with_sessions(gated),
        "power_per_month_usd": power_month,
        "fallback_usd": round(ci["github-macos"]["minutes"] * HOSTED_USD_PER_MIN, 2),
        # Billed minutes over the minutes both slots were up since the first
        # job: rounding makes it a little high.
        "slot_use_pct": round(100 * mac["minutes"] / (CI_SLOTS * ci_days * 1440), 1) if ci_days else None,
    }


def build_summary(state, samples, since, now):
    last_collect = parse_time(state.get("last_collect"))
    data_end = min(now, last_collect) if last_collect else now
    ci = summarize_ci(state.get("jobs", {}), since, data_end)
    # CI, sessions and the pace's days all run from the same start.
    first_mac = parse_time(ci.get("first_mac_job"))
    start = max(since, first_mac) if first_mac else since
    agents = summarize_sessions(state.get("sessions", {}), start, data_end, samples, state.get("builds"))
    host = summarize_host(samples, now)
    ci_age_h = round((now - last_collect).total_seconds() / 3600, 2) if last_collect else None
    return {
        "generated": iso(now),
        "since": iso(since),
        "last_collect": iso(last_collect) if last_collect else None,
        "ci_age_hours": ci_age_h,
        "ci_stale": ci_age_h is None or ci_age_h > STALE_CI_HOURS,
        "host_stale": host is None or host["last_age_min"] > STALE_HOST_MINUTES,
        "problems": state.get("problems", []),
        "ci": ci,
        "agents": agents,
        "host": host,
        "headroom": summarize_headroom(samples),
        "money": money_model(ci, agents, host, start, data_end),
    }


def fmt_wait(s):
    if s is None:
        return "-"
    return "%.0f s" % s if s < 120 else "%.1f min" % (s / 60)


def fmt_age_hours(h):
    return "%.0f min" % (h * 60) if h < 2 else "%.1f h" % h


def fmt_months(m):
    if m is None:
        return "never at this pace"
    return "under a month" if m < 1 else "%.1f months" % m


def fmt_range(r):
    """A payback range: the high end of the value pays back first."""
    a, b = fmt_months(r["high"]), fmt_months(r["low"])
    return a if a == b else "%s to %s" % (a, b)


def fmt(v, unit=""):
    return "-" if v is None else "%s%s" % (v, unit)


PRESSURE_NAMES = {1: "normal", 2: "warning", 4: "critical"}


def render_breakdown(label, p):
    g = p["groups_gb"]
    parts = ["VMs %s GB (%d CI%s)" % (g["vm"], p["ci_vms"], ", Colima" if p["colima"] else ""),
             "Claude %s GB (%s)" % (g["claude"], plural(p["claude_procs"], "process")),
             "Xcode %s GB" % g["xcode"],
             "simulators %s GB (%s booted)" % (g["simulator"], fmt(p["sims_booted"]))]
    if p["groups_source"] == "footprint":
        # Footprints count each process's own pages once, compressed ones
        # included, so the rest of used is the kernel's wired memory and the
        # processes outside these groups.
        other = (p["used_gb"] or 0) - sum(g.values())
        tail = ("macOS and everything else about %.1f GB. %s GB of the used memory is compressed"
                % (other, fmt(p["compressed_gb"])) if other >= 0
                else "the parts add up to more than used, which footprints should not: treat them as rough")
    else:
        # Resident memory leaves out compressed and swapped pages and counts
        # shared ones in each process, so the remainder is a rough figure.
        parts.append("compressed %s GB" % fmt(p["compressed_gb"]))
        other = (p["used_gb"] or 0) - sum(g.values()) - (p["compressed_gb"] or 0)
        tail = ("other about %.1f GB (by resident memory, approximate)" % other if other >= 0
                else "the parts add up to more than used, since this older sample has resident memory, which "
                     "counts shared pages in each process")
    return "- %s at %s: %s GB used, pressure %s, %s free. %s; %s." % (
        label, p["t"], fmt(p["used_gb"]), PRESSURE_NAMES.get(p["pressure"], "-"), fmt(p["free_pct"], "%"),
        ", ".join(parts), tail)


def render_headroom(h):
    """The keep-or-return section: is 64 GB and 1 TB enough."""
    out = ["## Memory and disk headroom", ""]
    if not h:
        return out + ["No host samples yet.", ""]

    def verdict(v, early):
        return "%s so far, too early to call (%s)" % (v, "; ".join(early)) if early and v != "unknown" else v

    of = " for %s GB" % h["mem_total_gb"] if h["mem_total_gb"] is not None else ""
    out.append("- Memory%s: %s, because %s." % (of, verdict(h["memory"], h["memory_too_early"]),
                                                "; ".join(h["memory_why"])))
    of = " (%s GB)" % h["disk_total_gb"] if h["disk_total_gb"] is not None else ""
    out.append("- Disk%s: %s, because %s." % (of, verdict(h["disk"], h["disk_too_early"]),
                                              "; ".join(h["disk_why"]) or "no samples with free disk"))
    out.append("- Reading memory: used is what apps, the kernel and the compressor hold, as Activity Monitor counts "
               "it, and runs high on a Mac by design. Compressed is what macOS squeezed instead of swapping. Pressure "
               "is macOS's own call on whether memory is short, and the one the heartbeat alerts on. Beszel charts "
               "used memory only, averaged over each point unless set to Max, so it shows neither of the other two.")
    out.append("")
    if h["at_worst"]:
        out.append(render_breakdown("Worst pressure", h["at_worst"]))
    if h["at_peak"]:
        out.append(render_breakdown("Most memory used", h["at_peak"]))
    out.append("- Pressure: warning in %d and critical in %d of %s, from %.0f%% of minutes. Longest stretch at "
               "warning or worse: %s%s." % (h["warn_samples"], h["critical_samples"],
                                            plural(h["pressure_samples"], "sample"), 100 * h["pressure_coverage"],
                                            plural(h["longest_not_normal_min"], "minute"),
                                            ", from %s" % h["longest_not_normal_from"] if h["longest_not_normal_from"] else ""))
    if h["swap_written_per_day_gb"] is not None:
        out.append("- Swap written: %s GB since %s, %s GB a day." % (h["swap_written_gb"], h["swap_counted_from"],
                                                                     h["swap_written_per_day_gb"]))
    else:
        out.append("- Swap written: no samples with the counter yet.")
    out.append("- Free memory as macOS counts it: %s at the lowest. Compressed memory peak %s."
               % (fmt(h["mem_free_pct_min"], "%"), fmt(h["compressed_max_gb"], " GB")))
    out.append("")
    out.append("| Day (UTC) | Memory peak GB | Free memory low | Warning / critical min | Swap written GB | "
               "Swap peak GB | CI VMs max | Claude processes max | Simulators max | Disk free low GB |")
    out.append("|---|---|---|---|---|---|---|---|---|---|")
    for day, d in h["days"].items():
        out.append("| %s | %s | %s | %d / %d | %s | %s | %d | %d | %s | %s |" % (
            day, fmt(d["mem_peak_gb"]), fmt(d["mem_free_pct_min"], "%"), d["warn_min"], d["critical_min"],
            fmt(d["swap_written_gb"]), fmt(d["swap_peak_gb"]), d["vms_max"], d["claude_procs_max"],
            fmt(d["sims_max"]), fmt(d["disk_free_min_gb"])))
    out.append("")
    return out


def fmt_log_runs(n, word, failed, hours):
    return "%s%s (%.1f hours)" % (plural(n, word), ", %d failed" % failed if failed else "", hours)


def fmt_runs(n, failed):
    return "%d (%d failed)" % (n, failed) if failed else str(n)


def render_sessions(ag):
    x, sim = ag["xcode"], ag["simulators"]
    out = ["## Agent sessions", ""]
    out.append("%d sessions, %.1f hours with at least one active, %.1f session-hours in all, at most %d at once."
               % (ag["sessions"], ag["busy_hours"], ag["session_hours"], ag["peak_concurrent"]))
    out.append("")
    if ag["open_hours"]:
        out.append("- Open %.1f session-hours, first entry to last; active %.1f (%.0f%%). The rest is waiting for "
                   "the next prompt, or idle." % (ag["open_hours"], ag["session_hours"],
                                                  100 * min(1.0, ag["session_hours"] / ag["open_hours"])))
    out.append("- %s typed, %s." % (plural(ag["prompts"], "prompt"), plural(ag["tool_calls"], "tool call")))
    line = ("- Xcode, in %s: %s and %s, from Xcode's logs; %s running xcodebuild or Cut's build scripts."
            % (plural(x["sessions"], "session"),
               fmt_log_runs(x["builds"], "build", x["builds_failed"], x["build_hours"]),
               fmt_log_runs(x["tests"], "test run", x["tests_failed"], x["test_hours"]),
               plural(x["commands"], "command")))
    if x["untraced_runs"]:
        n = x["untraced_runs"]
        line += " %s in no session's folder." % ("1 run was" if n == 1 else "%d runs were" % n)
    out.append(line)
    if x["traced_pct"] is not None:
        out.append("- Xcode processes ran %.1f hours across sessions, using %.1f CPU-hours (one core for an hour "
                   "each). %.0f%% of the host's Xcode CPU was traced to a session." %
                   (x["running_hours"], x["cpu_hours"], x["traced_pct"]))
    line = "- Simulators, in %s: booted %.1f simulator-hours, using %.1f CPU-hours; %s." % (
        plural(sim["sessions"], "session"), sim["booted_hours"], sim["cpu_hours"],
        plural(sim["commands"], "simulator command"))
    if sim.get("traced_pct") is not None:
        line += " %.0f%% of the host's booted simulator time was traced to a session." % sim["traced_pct"]
    out.append(line)
    for k, v in ag["by_server"].items():
        out.append("- %s: %d sessions, %.1f session-hours; %d used Xcode or a simulator, %.1f session-hours"
                   % (k, v["sessions"], v["hours"], v["xcode_sessions"], v["xcode_hours"]))
    out.append("")
    if ag["busiest"]:
        out.append("Busiest sessions, by active hours:")
        out.append("")
        out.append("| Session | Started (UTC) | Open h | Active h | Prompts | Builds | Tests | Xcode CPU-h | "
                   "Simulator h |")
        out.append("|---|---|---|---|---|---|---|---|---|")
        for r in ag["busiest"]:
            out.append("| %s | %s | %.1f | %.1f | %d | %s | %s | %.1f | %.1f |" % (
                r["session"] or "%s, no worktree" % r["server"], r["start"][:16].replace("T", " "),
                r["open_hours"], r["active_hours"], r["prompts"], fmt_runs(r["builds"], r["builds_failed"]),
                fmt_runs(r["tests"], r["tests_failed"]), r["xcode_cpu_hours"], r["sim_hours"]))
        out.append("")
    return out


