# Copy to .env on the NAS and chmod 600. .env is gitignored at the repo root.
#
#   cp .env.example .env && chmod 600 .env
#
# Unlike the other stacks, docker-compose.yml does NOT pass this whole file to
# every container. Each service is handed only the variables it names, so the
# SMTP password reaches the reporter and nothing else. A variable added here
# does nothing until a service in docker-compose.yml names it.

# Published by .github/workflows/build-monitoring.yml. This is the weekly
# reporter only; Beszel and the socket proxy are pinned by digest in
# docker-compose.yml and do not read this.
IMAGE=ghcr.io/ky1ejs/homelab/monitoring:latest

# Enables provenance verification in `homelab deploy`, as for the other stacks.
GITHUB_OWNER=ky1ejs

# Must match every other stack. See obsidian-vault/DECISIONS.md#identity-1002-not-1000.
APP_UID=1002
APP_GID=100

# Where the hub's database, the agent's identity, the shared socket and the
# disk-usage probe live. Four subdirectories, created by README.md step 1:
# hub/, agent/, socket/, fs-probe/ -- all owned by APP_UID:APP_GID.
#
# On the CE_ volume, like everything else here, so it stays inside the
# encrypted set. The data is metrics, not notes, but the hub's database also
# holds the admin password hash and the SMTP password you type into its
# settings page. Deliberately outside obsidian/, which
# obsidian-vault/ARCHITECTURE.md#volumes enumerates for the other stack.
#
# fs-probe/ must be on the DATA volume, because its free space is what the
# "disk data" graph and the weekly report's projection measure.
MON_DATA_HOST_PATH=/share/CE_CACHEDEV4_DATA/monitoring

# --- The dashboard ---------------------------------------------------------

# The hub binds 127.0.0.1:${MON_PORT}. `tailscale serve` on the host puts it at
# MON_APP_URL with a real certificate:
#
#   tailscale serve --bg --https 8443 http://127.0.0.1:8091
#
# 8091 because the dashboard has 8088, and a different HTTPS port (8443) rather
# than a path under the dashboard's 443 because Beszel's front end assumes it
# owns the root of its origin.
MON_PORT=8091

# The URL Serve answers on. Used for links in Beszel's alert emails and in the
# weekly report. No trailing slash.
MON_APP_URL=https://kyles-nas.tail3df177.ts.net:8443

# FIRST START ONLY. Creates the hub's first user and the PocketBase superuser
# (the /_/ settings page, where SMTP for alert emails is configured), both with
# this email and password.
#
# MON_ADMIN_EMAIL must be your Tailscale login -- the same value as
# DASH_ALLOWED_LOGINS in dashboard/.env. The hub signs you in by matching the
# Tailscale-User-Login header Serve adds against this email, so with them equal
# you never type the password at all. Keep the password in 1Password anyway:
# it is the way in to /_/, and the way in if Serve is not in front.
#
# Ignored once any user exists. Blank both and the hub asks you to create an
# account on first visit instead.
MON_ADMIN_EMAIL=
MON_ADMIN_PASSWORD=

# The hub's public key, which the agent uses to decide who may read the socket.
# Generated by the hub on its first start; README.md step 4 says where to copy
# it from. The agent restarts in a loop until this is set, which is expected
# during setup and nothing else.
MON_HUB_KEY=

# Optional dead-man's switch. The hub POSTs here every 60 seconds. Point it at a
# Healthchecks.io check (free tier; period 5 min, grace 10 min) and Healthchecks
# emails you when the posts stop -- which happens when the hub dies, the NAS
# loses power, or the internet connection drops. It is the only alert in this
# stack that can fire when the NAS is off, because it is the only one that is
# not on the NAS. Blank disables it.
MON_HEARTBEAT_URL=

# --- The weekly report -----------------------------------------------------

# The reporter's own Beszel account, role `readonly`. NOT the admin account:
# the reporter refuses to run as anything but readonly, so a leaked .env gives
# away a login that can look at graphs and nothing else. README.md step 6
# creates it.
REPORT_BESZEL_EMAIL=
REPORT_BESZEL_PASSWORD=

# "<weekday> HH:MM" in the NAS's local time. Monday morning, so the week it
# covers is a whole working week plus the weekend before it.
REPORT_SCHEDULE=Mon 08:00

# Who it goes to, and who it says it is from. REPORT_TO takes a
# comma-separated list. With Gmail, REPORT_FROM must be the Gmail account (or
# an alias verified on it), or Gmail rewrites it.
REPORT_FROM=
REPORT_TO=

# SMTP submission. Port 587 needs STARTTLS and 465 is implicit TLS; the
# reporter refuses to send over any connection that is not encrypted.
#
# For Gmail: smtp.gmail.com, 587, your address as the username, and an APP
# PASSWORD as the password (Google Account > Security > 2-Step Verification >
# App passwords). Your real password will not work, and should not be here.
# The same four values go into the hub's /_/ mail settings for alert emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional. Pinged after each report is built AND sent. Point it at a second
# Healthchecks.io check with a period of 7 days and a grace of 1 day, and a
# Monday with no email becomes a Tuesday alert instead of a silence nobody
# notices. Blank disables it.
REPORT_PING_URL=

# --- Memory ----------------------------------------------------------------
#
# Small, and deliberately set: this host already overcommits (the other
# stacks' limits add up to more than its free RAM -- README.md#the-host), and
# monitoring is the wrong thing to be the cause of that getting worse. On an
# idle test run the hub used 13 MB, the agent 5 MB and the proxy 3 MB; the
# hub's limit leaves room for a month of history and page loads on top.
BESZEL_MEM_LIMIT=256m
BESZEL_AGENT_MEM_LIMIT=128m
DOCKER_PROXY_MEM_LIMIT=32m
REPORT_MEM_LIMIT=64m
