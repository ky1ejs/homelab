# Copy to .env on the NAS and chmod 600. .env is gitignored at the repo root.
#
#   cp .env.example .env && chmod 600 .env

# Published by .github/workflows/build-vault-mcp.yml. Pin to a digest once the
# stack is stable; `latest` is fine while iterating.
IMAGE=ghcr.io/ky1ejs/homelab/vault-mcp:latest

# Same encrypted volume and the same paths as the obsidian-vault stack. All the
# vault paths must stay on the CE_ volume or they silently leave the encrypted
# set — see obsidian-vault/ARCHITECTURE.md#invariants.
VAULT_HOST_PATH=/share/CE_CACHEDEV4_DATA/obsidian/vault
SNAPSHOT_HOST_PATH=/share/CE_CACHEDEV4_DATA/obsidian/snapshots

# Tailscale node identity for the Funnel sidecar. Not the vault, but losing it
# re-registers a new node and changes the public hostname — which changes the
# connector URL you configured in Claude. Keep it on the encrypted volume: it is
# a live tailnet credential.
# Deliberately outside obsidian/, which ARCHITECTURE.md#volumes enumerates for
# the other stack — a sixth directory in there would silently falsify that list.
# Same CE_ volume, so it stays inside the encrypted set.
TS_STATE_HOST_PATH=/share/CE_CACHEDEV4_DATA/vault-mcp/ts-state

# Must match the vault's owner and the image build args. A real QNAP account —
# see obsidian-vault/DECISIONS.md#identity-1002-not-1000.
APP_UID=1002
APP_GID=100

# --- Authentication --------------------------------------------------------
#
# See README.md#how-this-authenticates.

# OAuth 2.1 against a hosted authorization server (WorkOS AuthKit). The only
# way in; the server refuses to start without OAUTH_ISSUER.
# No shared secret in a URL or a settings page, tokens expire, and
# access can be revoked from a dashboard -- which a static secret can never be.
# WorkOS is free to 1M monthly active users; this vault has one.
#
# OAUTH_ISSUER is your AuthKit domain. OAUTH_RESOURCE must equal the connector
# URL EXACTLY, path included: the client compares it with the URL you typed and
# rejects the metadata document if they differ by so much as a trailing slash.
OAUTH_ISSUER=
OAUTH_RESOURCE=

# There is no shared-secret fallback. A static header token and a URL-borne
# secret both shipped here and were removed: neither expired, neither could be
# revoked, and an auth path nobody exercises is where the one real hole in this
# server was found. See README.md#two-schemes-that-shipped-and-were-removed.

# Tailscale auth key, from the admin console. Prefer a tagged, non-ephemeral,
# reusable=false key; the node persists via TS_STATE_HOST_PATH.
# Funnel additionally requires HTTPS enabled on the tailnet and the funnel
# nodeAttr granted to this node's tag. See README.md#in-the-tailscale-admin-console.
TS_AUTHKEY=

# Becomes the public hostname: https://<TS_HOSTNAME>.<your-tailnet>.ts.net/mcp
# Changing it changes the connector URL.
TS_HOSTNAME=vault-mcp
TS_EXTRA_ARGS=--advertise-tags=tag:vault-mcp

# Where capture_note writes, relative to the vault root. The server refuses to
# start if this lands somewhere it may not write — inside MCP_EXCLUDE, on
# CLAUDE.md, or on a non-markdown path.
CAPTURE_NOTE=Inbox.md

# Folders and notes this connector cannot see: not searched, not listed, not
# readable, not writable. Comma-separated, relative to the vault root, matched
# case-insensitively, and a folder covers everything beneath it.
#
# This is the one control here that is NOT mirrored from vault-claude's tool
# policy, and the asymmetry is the point. vault-claude reads the whole vault
# with Bash, WebFetch and WebSearch denied, so a clipped article carrying
# instructions has no way out. The client on this end is claude.ai, whose tool
# surface is not ours to configure and does have web access — so the leg to
# remove here is the untrusted content, not the egress.
#
# List the folders where material you did not write lands: clippings, forwarded
# mail, shared notes. Removing an entry is a one-line change if voice turns out
# to need it. See README.md#what-voice-cannot-see.
#
# Startup WARNS about an entry matching nothing, because a typo here protects
# nothing while every other check still passes.
# Set to Clippings on 2026-08-12: web clippings are content written by strangers
# and pasted verbatim, the highest-risk folder by some margin. `4. Inbox` was the
# original candidate and was deliberately NOT excluded -- it holds material worth
# reading aloud, and a rule that hides notes you need is a rule you remove.
#
# That leaves a gap on purpose: unvetted material reaching a note outside these
# folders -- a forwarded email pasted into a project note -- is not covered.
MCP_EXCLUDE=Clippings

# capture_note stamps local wall-clock time. Leave this unset and the container
# runs UTC, so a thought captured at 9pm gets filed under tomorrow's date.
TZ=America/New_York

# Empty on the Funnel path — Funnel does not forward the caller's public IP, so
# any value here rejects every request. Set it only behind a proxy that does
# (Cloudflare: 160.79.104.0/21, with MCP_CLIENT_IP_HEADER=CF-Connecting-IP).
MCP_ALLOWED_CIDRS=
